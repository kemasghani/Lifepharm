    {% render 'lp-referral-nudge' %}
    <!-- Stamped -->
    <script>function myInit(){ StampedFn.init({ apiKey: '9ad7ae72-fc06-4606-9d55-3fe5a0e312d5', sId: '301382' }); }</script>
    {%- comment -%}LP: third-party widgets that are not needed for the first view (Stamped reviews, the Clinicians' Choice badge) start once the page is parsed and its first image has loaded, on the first touch, or after 4 seconds at the latest (D-090). Referral, Exigo and subscription scripts are not delayed.{%- endcomment -%}
    <script>
      (function () {
        var started = false;
        function fill() { document.querySelectorAll('template[data-lp-after-view]').forEach(function (t) { t.replaceWith(t.content); }); }
        function start() {
          if (started) return; started = true;
          events.forEach(function (e) { removeEventListener(e, start, true); });
          fill();
          var s = document.createElement('script'); s.async = true; s.onload = myInit; s.src = 'https://cdn1.stamped.io/files/widget.min.js'; document.body.appendChild(s);
          document.addEventListener('product:rerender', function () { setTimeout(fill, 0); }, true);
        }
        function afterImage() {
          var img = document.querySelector('main img[fetchpriority="high"]');
          var paint = function () { requestAnimationFrame(function () { setTimeout(start, 0); }); };
          if (!img || img.complete) { paint(); return; }
          img.addEventListener('load', paint, { once: true }); img.addEventListener('error', paint, { once: true });
        }
        var events = ['pointerdown', 'keydown', 'touchstart', 'scroll'];
        events.forEach(function (e) { addEventListener(e, start, { capture: true, passive: true }); });
        setTimeout(start, 4000);
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', afterImage, { once: true }); else afterImage();
      })();
    </script>
