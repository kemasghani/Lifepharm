<!doctype html>

<html lang="{{ request.locale.iso_code }}" dir="{% render 'direction' %}">
  <head>
    {%- comment -%}charset and viewport come first, before the app snippets (the consent rules alone are 67 KB). The browser needs the viewport to choose the right file for a preloaded image; when it was further down, phones were treated as a 980px screen.{%- endcomment -%}
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height">
    {%- comment -%}A section whose image is the largest thing in the first view leaves its preload links between two markers (see sections/lp-home-hero.liquid). They are printed here, before the app snippets, so the browser starts that download first. The layout cannot read a section's settings, which is why the section hands them over this way.{%- endcomment -%}
    {%- if content_for_layout contains '<!--lp-head ' -%}
      {{ content_for_layout | split: '<!--lp-head ' | last | split: ' lp-head-->' | first }}
    {%- endif %}
    {% render 'skio-head' %}
	{% render 'pandectes-rules' %}
    <meta name="theme-color" content="{{ settings.header_background }}">

    {%- comment -%}LP: a title that does not already name the brand gets it as a suffix ("Science | LifePharm"), so no page shows a one-word title in search results.{%- endcomment -%}
    {%- comment -%}LP: the main pages have a written search title and description (locales, lp.seo.pages), used until the merchant sets their own in the page's SEO fields.{%- endcomment -%}
    {%- liquid
      assign lp_seo_title = ''
      assign lp_seo_description = ''
      assign lp_seo_alias = ''
      if request.page_type == 'page'
        case template.suffix
          when 'science'
            assign lp_seo_title = 'lp.seo.pages.science.title' | t
            assign lp_seo_description = 'lp.seo.pages.science.description' | t
          when 'our-studies'
            assign lp_seo_title = 'lp.seo.pages.science.title' | t
            assign lp_seo_description = 'lp.seo.pages.science.description' | t
          when 'company'
            assign lp_seo_title = 'lp.seo.pages.company.title' | t
            assign lp_seo_description = 'lp.seo.pages.company.description' | t
          when 'join-us'
            assign lp_seo_title = 'lp.seo.pages.join_us.title' | t
            assign lp_seo_description = 'lp.seo.pages.join_us.description' | t
          when 'contact'
            assign lp_seo_title = 'lp.seo.pages.contact.title' | t
            assign lp_seo_description = 'lp.seo.pages.contact.description' | t
          when 'faq'
            assign lp_seo_title = 'lp.seo.pages.faq.title' | t
            assign lp_seo_description = 'lp.seo.pages.faq.description' | t
          when 'reviews'
            assign lp_seo_title = 'lp.seo.pages.reviews.title' | t
            assign lp_seo_description = 'lp.seo.pages.reviews.description' | t
        endcase
        # a title the merchant has already written out in full stays
        if page_title.size >= 30
          assign lp_seo_title = ''
        endif
      endif
      # Our Studies shows the Science page (the two were merged); it names Science as the original.
      if request.page_type == 'page' and template.suffix == 'our-studies'
        assign lp_seo_alias = shop.url | append: routes.root_url | append: 'pages/science' | replace: '//pages', '/pages'
      endif
    -%}
    <title>{% if lp_seo_title != blank %}{{ lp_seo_title }}{% elsif page_title == blank %}{{ shop.name }}{% else %}{{ page_title }}{% if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif %}{% if page_title.size < 52 %}{% unless page_title contains 'LifePharm' %} | LifePharm{% if request.page_type == 'collection' and page_title.size < 30 %} Official Store{% endif %}{% endunless %}{% endif %}{% endif %}</title>

    {%- comment -%}LP: a collection or a homepage with no description of its own gets one line made of real facts; a description longer than a search result shows is cut at a word.{%- endcomment -%}
    {%- liquid
      assign lp_meta_description = page_description
      assign lp_page_description_size = page_description | size
      if lp_seo_description != blank and lp_page_description_size < 50
        assign lp_meta_description = lp_seo_description
      endif
      if lp_meta_description == blank and request.page_type == 'collection'
        assign lp_meta_description = 'lp.seo.collection_description' | t: title: collection.title
      endif
      # the homepage description is a store setting (Online Store > Preferences); a store that has none gets the written one
      if lp_meta_description == blank and request.page_type == 'index'
        assign lp_meta_description = 'lp.seo.home_description' | t
      endif
      assign lp_meta_description = lp_meta_description | strip_html | strip_newlines | strip | truncatewords: 26
    -%}
    {%- if lp_meta_description != blank -%}
      {%- comment -%}escape_once: a written description comes out of the t filter with its apostrophe already encoded; escape would encode it a second time.{%- endcomment -%}
      <meta name="description" content="{{ lp_meta_description | escape_once }}">
    {%- endif -%}

    <link rel="canonical" href="{{ lp_seo_alias | default: canonical_url }}">
    {%- if request.page_type == 'product' and product.price_max == 0 -%}<meta name="robots" content="noindex">{%- endif -%}

    {%- if settings.favicon -%}
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 96 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180 }}">
    {%- endif -%}

    {%- comment -%}Few prefetch to increase performance on commonly used third-parties{%- endcomment -%}
    <link rel="preconnect" href="https://cdn.shopify.com">
    {%- comment -%}Exigo shared-cart service: open the connection early so "Share Your Cart" does not pay for DNS + TLS on the click{%- endcomment -%}
    <link rel="preconnect" href="https://lpshopify.azurewebsites.net" crossorigin>
    <link rel="dns-prefetch" href="https://productreviews.shopifycdn.com">

    {%- comment -%}The fonts chosen in the theme settings are not preloaded: every text uses the self-hosted Playfair Display and Metropolis below, so preloading the settings fonts only took bandwidth from the first image.{%- endcomment -%}

    {%- render 'social-meta-tags' -%}
    {%- render 'microdata-schema' -%}
    {%- render 'css-variables' -%}
    {%- render 'js-variables' -%}

    <script type="importmap">
      {%- comment -%}On Safari 16.3 and lower, a polyfill is used to load importmap{%- endcomment -%}
      {
        "imports": {
          "vendor": "{{ 'vendor.min.js' | asset_url }}",
          "theme": "{{ 'theme.js' | asset_url }}",
          "photoswipe": "{{ 'photoswipe.min.js' | asset_url }}"
        }
      }
    </script>

    <script type="module" src="{{ 'vendor.min.js' | asset_url }}"></script>
    <script type="module" src="{{ 'theme.js' | asset_url }}"></script>

    {{ content_for_header }}

    {{- 'theme.css' | asset_url | stylesheet_tag: preload: true -}}
    {%- comment -%}custom.css is a few rules: printed in the page so it is not one more file the first paint waits for.{%- endcomment -%}
    <style>{{ 'custom.css' | inline_asset_content }}</style>
    <style>
      @font-face { font-family: "Playfair Display"; src: url({{ 'playfair-display-regular.woff2' | asset_url }}) format("woff2"); font-weight: 400; font-style: normal; font-display: swap; }
      @font-face { font-family: "Metropolis"; src: url({{ 'metropolis-light.woff2' | asset_url }}) format("woff2"); font-weight: 100 349; font-style: normal; font-display: swap; }
      @font-face { font-family: "Metropolis"; src: url({{ 'metropolis-regular.woff2' | asset_url }}) format("woff2"); font-weight: 350 499; font-style: normal; font-display: swap; }
      @font-face { font-family: "Metropolis"; src: url({{ 'metropolis-semibold.woff2' | asset_url }}) format("woff2"); font-weight: 500 699; font-style: normal; font-display: swap; }
      @font-face { font-family: "Metropolis"; src: url({{ 'metropolis-extrabold.woff2' | asset_url }}) format("woff2"); font-weight: 700 900; font-style: normal; font-display: swap; }
    </style>
    {{ 'playfair-display-regular.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'metropolis-regular.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
