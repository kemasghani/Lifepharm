    {%- comment -%}Design Packs styles only on a page that has one of its sections (class prefix dsgn-pck). These sections live in page templates, not in the header or footer group.{%- endcomment -%}
    {%- if content_for_layout contains 'dsgn-pck' -%}
      {{ 'design-pack-styles.css' | asset_url | stylesheet_tag: preload: true }}
    {%- endif -%}
        {%- comment -%} Stamped reviews: six per page, so the two-column grid always ends on a full row. The attribute has to be on the widget before Stamped starts. {%- endcomment -%}
        <script>
          (function () {
            function setTake() {
              var widget = document.getElementById('stamped-main-widget');
              if (widget && !widget.hasAttribute('data-take-reviews')) widget.setAttribute('data-take-reviews', '6');
              return !!widget;
            }
            if (setTake()) return;
            var observer = new MutationObserver(function () { if (setTake()) observer.disconnect(); });
            observer.observe(document.documentElement, { childList: true, subtree: true });
            document.addEventListener('DOMContentLoaded', function () { setTake(); observer.disconnect(); });
          })();
        </script>
      </head>


