customerId;\n      if(!isCustomer) {\n        customerKey = getCookie(referralCookieName);\n      }\n        $.ajax({\n            type: 'POST',\n            url: apiUrl + '/api/SharedCart/AddSharedCartToShopifyId?externalCustomerId=' + customerKey + \"&shopUrl=\" + shopUrl,\n            contentType: \"application/json\",\n            data: JSON.stringify(json),\n            success: function (key) {\n                var urlHost = \"https://\" + window.location.host;\n                var urlPath = \"?cart=\" + key + \"&ref=\" + getCookie(referralCookieName);\n                var noneEncodedUrl = urlHost + urlPath;\n                var encodedUrl = encodeURIComponent(urlPath);\n                $(\"#carturl\").val(noneEncodedUrl);\n                $(\".sharecart-facebook\").attr(\"href\", \"https://www.facebook.com/sharer/sharer.php?u=\" + urlHost + encodedUrl);\n                $(\".sharecart-linkedin\").attr(\"href\", \"https://www.linkedin.com/shareArticle?mini=true&url=\" + urlHost + encodedUrl);\n                openModal(\"#sharecart-modal\", true);\n            }\n        });\n    })\n    .catch(function (error) {\n        console.error('Error retreiving cart: ', error);\n        return \"\";\n    });\n}\nasync function initializeShareCart() {\n    $(\".share-cart-link\").on(\"click\", function () {\n        console.log(\"cilcked\");\n        createShareCartLink2();\n    });\n    $(\".copy-cart-link\").on(\"click\", function () {\n        var text = $(\"#cart-url\").val();\n        copy(text);\n    });\n    $(\"#sharecart-link\").on(\"click\", function () {\n      console.log(\"shareCart clicked\");\n        var text = $(\"#carturl\").val();\n        const tooltip = document.getElementById('copy-tooltip');\n        return new Promise((resolve, reject) => {\n            navigator.clipboard.writeText(text).then(() => {\n              \n                tooltip.classList.add('show');\n                setTimeout(() => {\n                    tooltip.classList.remove('show');\n                }, 2000);\n            }).catch(function (error) {\n                tooltip.html('Failed to copy link');\n                setTimeout(() => {\n                    tooltip.classList.remove('show');\n                }, 2000);\n            });\n        });\n    });\n}\nfunction getCartCookie() {\n    let name = \"CartCopied=\";\n    let decodedCookie = decodeURIComponent(document.cookie);\n    let ca = decodedCookie.split(';');\n    for (let i = 0; i < ca.length; i++) {\n        let c = ca[i];\n        while (c.charAt(0) == ' ') {\n            c = c.substring(1);\n        }\n        if (c.indexOf(name) == 0) {\n            return c.substring(name.length, c.length);\n        }\n    }\n}\ndocument.addEventListener(\"DOMContentLoaded\", function (e) {\n    setTimeout(function () {\n        logCart();\n        initializeShareCart();\n    }, 3000);\n    if (getUrlVars()[\"cart\"] != undefined) {\n        createCart(getUrlVars()[\"cart\"]);\n    } else {\n        document.cookie = 'CartCopied=; Max-Age=0; path=/;';\n    }\n});\n</script>",
