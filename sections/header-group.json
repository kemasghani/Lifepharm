      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "<script>\nconsole.log(\"{{shop.permanent_domain}}\")\n      var countryCode = '{{localization.country.iso_code}}';\n      var cultureCode = '{{ localization.language.iso_code }}';\n      var currencyCode = '{{ localization.country.currency.iso_code }}';\n      var isCustomer = {{ customer.has_account | default: false}};\n      var customerId = {{ customer.id | default: 0 }};\n      var exigoCustomerTypeId = {{ customer.metafields.Exigo.CustomerTypeId | default: 0 }};\n      var exigoId = {{ customer.metafields.Exigo.CustomerId | default: 0 }};\n      var _referral = \"{{ customer.metafields.Exigo.Referral | default: \"CorpOrphan\" }}\";\n      var exigoWebalias = '{{ customer.metafields.Exigo.Webalias | default: \"\" }}';\n      var pointAccountId = {{ customer.metafields.Exigo.PointAccountId | default: 1 }};\nvar Exigo = {\n    Settings: {\n        ShopUrl: \"{{ shop.permanent_domain}}\",\n        ApiUrl: \"https://lpshopify.azurewebsites.net\",\n        BackofficeUrl: \"https://mylifepharmoffice.com\",\n        SilentLoginUrl: \"/account/silentlogin?token=\",\n        StorePublicUrl: \"{{ shop.url}}\",\n        CheckoutUrl: \"\",//\"https://localhost:44348\",\n        DebugCheckoutUrl: \"https://localhost:44348\",\n        DebugApiUrl: \"https://localhost:44341\",\n        ReferralCookieName: \"refId\",\n        LoginCookie: \"ExigoSilentLogin\",\n        SyncCookie: \"ExigoCustomerSyncing\",\n        ReferralParameter: \"ref\",\n        DefaultWebalias: \"retaildirect\",\n        EnableEnrollerSearch: true,\n        RetailCustomerType: 1,\n        HasParty: false,\n        AffiliatePoints: {\n            UseAffiliatePoints: true,\n        },\n        Enrollment: {\n            Enable: true,\n            ForceEnrollmentFlow: true\n        }\n    },\n    Actions: {\n        SetEnrollerSearch: function () {\n            setEnrollerSearch();\n        },\n        AddReferralToUrl: function () {\n            addReferralToUrl();\n        },\n        SearchForEnroller: function (query) {\n            searchForEnroller(query);\n        },\n        Checkout: {\n            GetProductPrices: function (priceType, sku) {\n                getProductPrices(priceType, sku);\n            },\n            CalculateCart: function (priceType, cartType) {\n                calculateCart(priceType, cartType);\n            }\n        },\n        AffiliatePoints: {\n            GetPoints: function (callback) {\n                getPoints(callback);\n            },\n            SpendPoints: function (value) {\n                addPointsToCart(value);\n            },\n            GetEligibleRewards: function (callback) {\n                getEligibleRewards(callback);\n            },\n            GetAllEligibleRewards: function (callback) {\n                getAllEligibleRewards(callback);\n            },\n            GetAllAffiliateRewards: function (callback) {\n                getAllAffiliateRewards(callback);\n            },\n            CreateAffiliateReward: function (callback, id) {\n                createAffiliateReward(callback, id);\n            }\n        }\n    },\n    Initialize: function () {\n        initialize();\n    }\n}\n</script>\n\n{%- liquid\n  assign exigo_defer = 'defer'\n  if template.name == 'cart'\n    assign exigo_defer = ''\n  endif\n-%}\n<script src=\"https://ajax.googleapis.com/ajax/libs/jquery/1.9.1/jquery.min.js\" {{ exigo_defer }}></script>\n<script src=\"https://lpshopify.azurewebsites.net/staticfiles/exigoscript.js?v=2\" {{ exigo_defer }}></script>",
        "background": "",
