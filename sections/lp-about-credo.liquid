<section class="lp-ab-credo" aria-labelledby="lp-ab-credo-{{ section.id }}">
  <div class="container">
    <header class="lp-ab-head">
      {%- if section.settings.eyebrow != blank -%}<p class="lp-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 id="lp-ab-credo-{{ section.id }}" class="h1">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="lp-ab-head__text">{{ section.settings.text }}</div>{%- endif -%}
    </header>
    <ul class="lp-ab-credo__list" role="list" data-lp-reveal>
      {%- for block in section.blocks -%}
        <li class="lp-ab-credo__item" {{ block.shopify_attributes }}>
          <span class="lp-ab-credo__icon" aria-hidden="true">
            {%- if block.settings.icon != blank -%}{{ block.settings.icon | image_url: width: 160 | image_tag: loading: 'lazy', alt: '', width: 56, height: 56 }}{%- endif -%}
          </span>
          <h3 class="lp-ab-credo__title">{{ block.settings.title | escape }}</h3>
          <div class="lp-ab-credo__text">{{ block.settings.text }}</div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
.lp-ab-credo { padding-block: var(--lp-section-gap); background: rgb(var(--lp-sand)); }
.lp-ab-credo__list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1rem, 2vw, 1.5rem); margin: 0; padding: 0; list-style: none; }
.lp-ab-credo__item { display: grid; align-content: start; gap: .875rem; padding: clamp(1.5rem, 2.5vw, 2.25rem); border-radius: var(--lp-radius); background: #fff; box-shadow: var(--lp-shadow-1); }
.lp-ab-credo__icon { display: grid; place-items: center; width: 64px; height: 64px; border-radius: 18px; background: rgb(var(--lp-amber) / .1); }
.lp-ab-credo__icon img { width: 40px; height: 40px; object-fit: contain; }
.lp-ab-credo__title { margin: 0; font-size: 1.125rem; font-weight: 600; line-height: 1.35; color: rgb(var(--lp-ink)); }
.lp-ab-credo__text { font-size: .9375rem; line-height: 1.65; color: rgb(var(--lp-muted)); }
.lp-ab-credo__text p { margin: 0; }
@media (max-width: 899px) { .lp-ab-credo__list { grid-template-columns: 1fr; } }
{% endstylesheet %}

{% schema %}
{
  "name": "LP About: credo",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What We Stand For" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>Our <em>Credo</em></p>" },
    { "type": "richtext", "id": "text", "label": "Text" }
  ],
  "blocks": [
    { "type": "item", "name": "Promise", "settings": [
      { "type": "image_picker", "id": "icon", "label": "Icon" },
      { "type": "text", "id": "title", "label": "Title", "default": "For Communities" },
      { "type": "richtext", "id": "text", "label": "Text" }
    ] }
  ],
  "presets": [{ "name": "LP About: credo" }]
}
{% endschema %}
