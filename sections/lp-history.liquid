{%- comment -%}
  Company history timeline (About Us). All milestones show as icons on one rail; choosing one opens its text
  in the panel below (Letisha: "show all the icons and if you click on them it'll open the text box").
  Tabs pattern: arrow keys move between milestones. Without JS every milestone text is listed.
{%- endcomment -%}
<section class="lp-hx" aria-labelledby="lp-hx-{{ section.id }}">
  <div class="container">
    <header class="lp-hx__head">
      {%- if section.settings.eyebrow != blank -%}<p class="lp-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 id="lp-hx-{{ section.id }}" class="h1 lp-hx__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="lp-hx__sub">{{ section.settings.text | escape }}</p>{%- endif -%}
    </header>

    <lp-history class="lp-hx__body">
      <div class="lp-hx__rail-wrap">
        <div class="lp-hx__rail" role="tablist" aria-label="{{ section.settings.rail_label | escape }}" style="--lp-hx-n: {{ section.blocks.size }}">
          {%- for block in section.blocks -%}
            <button type="button" role="tab" class="lp-hx__node" id="lp-hx-tab-{{ section.id }}-{{ forloop.index0 }}" aria-controls="lp-hx-panel-{{ section.id }}-{{ forloop.index0 }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" {% unless forloop.first %}tabindex="-1"{% endunless %} {{ block.shopify_attributes }}>
              <span class="lp-hx__icon">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 192 | image_tag: width: 72, height: 72, widths: '96,144,192', sizes: '72px', loading: 'lazy', alt: '' }}
                {%- endif -%}
              </span>
              <span class="lp-hx__date">{{ block.settings.date | escape }}</span>
            </button>
          {%- endfor -%}
        </div>
      </div>

      <div class="lp-hx__panels">
        {%- for block in section.blocks -%}
          <article class="lp-hx__panel" role="tabpanel" id="lp-hx-panel-{{ section.id }}-{{ forloop.index0 }}" aria-labelledby="lp-hx-tab-{{ section.id }}-{{ forloop.index0 }}" tabindex="0" {% unless forloop.first %}data-collapsed{% endunless %}>
            <div class="lp-hx__panel-icon" aria-hidden="true">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 192 | image_tag: width: 112, height: 112, loading: 'lazy', alt: '' }}
              {%- endif -%}
            </div>
            <div class="lp-hx__panel-copy">
              <p class="lp-hx__panel-date">{{ block.settings.date | escape }}</p>
              <p class="lp-hx__panel-text">{{ block.settings.text | escape }}</p>
            </div>
          </article>
        {%- endfor -%}
        <div class="lp-hx__nav">
          <button type="button" class="lp-hx__arrow" data-dir="-1" aria-label="{{ section.settings.prev_label | escape }}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg></button>
          <span class="lp-hx__count" aria-hidden="true"><span data-current>1</span> / {{ section.blocks.size }}</span>
          <button type="button" class="lp-hx__arrow" data-dir="1" aria-label="{{ section.settings.next_label | escape }}"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
        </div>
      </div>
    </lp-history>

    {%- if section.settings.disclaimer != blank -%}<p class="lp-hx__disclaimer">{{ section.settings.disclaimer | escape }}</p>{%- endif -%}
  </div>
</section>

<script>
  if (!customElements.get('lp-history')) {
    customElements.define('lp-history', class extends HTMLElement {
      connectedCallback() {
        this.rail = this.querySelector('.lp-hx__rail');
        this.tabs = [...this.querySelectorAll('[role="tab"]')];
        this.panels = [...this.querySelectorAll('[role="tabpanel"]')];
        this.current = this.querySelector('[data-current]');
        this.index = 0;
        this.classList.add('is-ready');
        this.tabs.forEach((tab, i) => tab.addEventListener('click', () => this.select(i)));
        this.rail.addEventListener('keydown', (e) => {
          const move = { ArrowRight: 1, ArrowLeft: -1 }[e.key];
          if (e.key === 'Home') { e.preventDefault(); this.select(0, true); }
          else if (e.key === 'End') { e.preventDefault(); this.select(this.tabs.length - 1, true); }
          else if (move) { e.preventDefault(); this.select((this.index + move + this.tabs.length) % this.tabs.length, true); }
        });
        this.querySelectorAll('.lp-hx__arrow').forEach((b) => b.addEventListener('click', () => this.select((this.index + Number(b.dataset.dir) + this.tabs.length) % this.tabs.length)));
        this.select(0);
      }
      select(i, focus) {
        this.index = i;
        this.tabs.forEach((tab, n) => { tab.setAttribute('aria-selected', String(n === i)); tab.tabIndex = n === i ? 0 : -1; tab.classList.toggle('is-past', n < i); });
        this.panels.forEach((p, n) => p.toggleAttribute('data-collapsed', n !== i));
        if (this.current) this.current.textContent = i + 1;
        this.rail.style.setProperty('--lp-hx-p', this.tabs.length > 1 ? i / (this.tabs.length - 1) : 0);
        const tab = this.tabs[i];
        if (focus) tab.focus({ preventScroll: true });
        if (this.rail.scrollWidth > this.rail.clientWidth) {
          const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
          this.rail.scrollTo({ left: tab.offsetLeft - (this.rail.clientWidth - tab.offsetWidth) / 2, behavior: reduce ? 'auto' : 'smooth' });
        }
      }
    });
  }
</script>

{% stylesheet %}
.lp-hx { padding-block: var(--lp-section-gap); background: rgb(var(--lp-ivory)); }
.lp-hx__head { display: grid; justify-items: center; gap: .9rem; max-width: 56rem; margin: 0 auto clamp(2rem, 4vw, 3.5rem); text-align: center; }
.lp-hx__title { margin: 0; color: rgb(var(--lp-ink)); }
.lp-hx__title em { font-style: normal; color: rgb(var(--lp-amber-deep)); }
.lp-hx__sub { margin: 0; max-width: 56ch; font-size: 1.0625rem; line-height: 1.6; color: rgb(var(--lp-ink)); }
.lp-hx__body { display: block; }
.lp-hx__rail-wrap { margin-inline: calc(-1 * var(--container-gutter, 1.25rem)); }
.lp-hx__rail { --lp-hx-p: 0; position: relative; display: flex; gap: .5rem; overflow-x: auto; padding: 8px var(--container-gutter, 1.25rem) .5rem; scroll-padding-inline: var(--container-gutter, 1.25rem); scrollbar-width: none; -webkit-overflow-scrolling: touch; }
.lp-hx__rail::-webkit-scrollbar { display: none; }
.lp-hx .lp-hx__node { position: relative; z-index: 1; flex: none; display: grid; justify-items: center; align-content: start; gap: .6rem; width: calc((100vw - var(--container-gutter, 1.25rem) - 3 * .5rem) / 3.5); min-width: 5.25rem; padding: 0; border: 0; background: none; color: rgb(var(--lp-ink)); font: inherit; cursor: pointer; -webkit-tap-highlight-color: transparent; }
.lp-hx__icon { display: grid; place-items: center; width: 72px; height: 72px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 1px rgb(var(--lp-ink) / .22); transition: box-shadow 200ms ease-out, transform 250ms cubic-bezier(.16, 1, .3, 1); }
.lp-hx__icon img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; display: block; }
.lp-hx__date { font-size: .75rem; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; line-height: 1.2; white-space: nowrap; color: rgb(var(--lp-ink)); }
.lp-hx__node[aria-selected="true"] .lp-hx__icon { box-shadow: 0 0 0 3px rgb(var(--lp-amber)), 0 0 0 9px rgb(var(--lp-amber) / .18); transform: scale(1.04); }
.lp-hx__node[aria-selected="true"] .lp-hx__date { color: rgb(var(--lp-amber-deep)); }
@media (hover: hover) { .lp-hx__node:hover .lp-hx__icon { box-shadow: 0 0 0 2px rgb(var(--lp-amber)); } .lp-hx__node[aria-selected="true"]:hover .lp-hx__icon { box-shadow: 0 0 0 3px rgb(var(--lp-amber)), 0 0 0 9px rgb(var(--lp-amber) / .18); } }
.lp-hx__node:focus-visible { outline: none; }
.lp-hx__node:focus-visible .lp-hx__icon { outline: 2px solid rgb(var(--lp-amber-deep)); outline-offset: 4px; }
.lp-hx__panels { position: relative; display: grid; margin-top: clamp(1.25rem, 3vw, 2rem); }
.lp-hx__panel { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; align-items: center; padding: clamp(1.25rem, 3vw, 2.25rem); padding-bottom: 4.75rem; border-radius: var(--lp-radius-lg); background: #fff4e6; box-shadow: inset 0 0 0 1px rgb(var(--lp-ink) / .12); }
.lp-hx__panel + .lp-hx__panel { margin-top: .75rem; }
lp-history.is-ready .lp-hx__panel { grid-area: 1 / 1; margin-top: 0; }
lp-history.is-ready .lp-hx__panel[data-collapsed] { visibility: hidden; opacity: 0; }
lp-history.is-ready .lp-hx__panel { transition: opacity 250ms ease-out; }
.lp-hx__panel:focus-visible { outline: 2px solid rgb(var(--lp-amber-deep)); outline-offset: 3px; }
.lp-hx__panel-icon { display: none; }
.lp-hx__panel-copy { display: grid; gap: .5rem; }
.lp-hx__panel-date { margin: 0; font-size: clamp(1.75rem, 4vw, 2.75rem); font-weight: 800; letter-spacing: -.01em; line-height: 1; text-transform: uppercase; color: rgb(var(--lp-amber-deep)); }
.lp-hx__panel-text { margin: 0; max-width: 60ch; font-size: clamp(1rem, 1.4vw, 1.1875rem); line-height: 1.6; color: rgb(var(--lp-ink)); }
.lp-hx__nav { display: none; }
lp-history.is-ready .lp-hx__nav { position: absolute; right: clamp(1.25rem, 3vw, 2.25rem); bottom: 1.1rem; display: flex; align-items: center; gap: .75rem; }
.lp-hx__arrow { display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 1px solid rgb(var(--lp-ink) / .35); border-radius: 50%; background: #fff; color: rgb(var(--lp-ink)); cursor: pointer; transition: background-color 200ms ease-out, border-color 200ms ease-out; }
.lp-hx__arrow:hover { background: rgb(var(--lp-amber)); border-color: rgb(var(--lp-amber)); color: #1f1e20; }
.lp-hx__arrow:focus-visible { outline: 2px solid rgb(var(--lp-amber-deep)); outline-offset: 2px; }
.lp-hx__count { min-width: 3.5rem; text-align: center; font-size: .8125rem; font-weight: 700; font-variant-numeric: tabular-nums; color: rgb(var(--lp-ink)); }
.lp-hx__disclaimer { max-width: 86ch; margin: 1.5rem auto 0; text-align: center; font-size: .75rem; line-height: 1.55; color: rgb(var(--lp-muted)); }
@media (min-width: 700px) {
  .lp-hx__panel { grid-template-columns: 112px minmax(0, 1fr); gap: clamp(1.25rem, 3vw, 2.5rem); padding-bottom: clamp(1.25rem, 3vw, 2.25rem); padding-right: 13rem; min-height: 11rem; }
  .lp-hx__panel-icon { display: block; width: 112px; height: 112px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 1px rgb(var(--lp-ink) / .22); }
  .lp-hx__panel-icon img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; display: block; }
  lp-history.is-ready .lp-hx__nav { bottom: 50%; transform: translateY(50%); }
}
@media (min-width: 1100px) {
  .lp-hx__rail-wrap { margin-inline: 0; }
  .lp-hx__rail { display: grid; grid-template-columns: repeat(var(--lp-hx-n), minmax(0, 1fr)); gap: 0; overflow: visible; padding: 8px 0 .5rem; }
  .lp-hx__rail::before, .lp-hx__rail::after { content: ""; position: absolute; top: calc(8px + 36px); left: calc(50% / var(--lp-hx-n)); height: 2px; border-radius: 2px; }
  .lp-hx__rail::before { right: calc(50% / var(--lp-hx-n)); background: rgb(var(--lp-ink) / .14); }
  .lp-hx__rail::after { width: calc((100% - 100% / var(--lp-hx-n)) * var(--lp-hx-p)); background: rgb(var(--lp-amber)); transition: width 400ms cubic-bezier(.16, 1, .3, 1); }
  .lp-hx .lp-hx__node { width: auto; min-width: 0; }
}
@media (prefers-reduced-motion: reduce) { .lp-hx__icon, .lp-hx__rail::after, lp-history.is-ready .lp-hx__panel, .lp-hx__arrow { transition: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "LP · History timeline",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "A Timeline Of How <em>LifePharm</em> Came To Be" },
    { "type": "text", "id": "text", "label": "Subheading" },
    { "type": "text", "id": "rail_label", "label": "Timeline label (screen readers)", "default": "Company milestones" },
    { "type": "text", "id": "prev_label", "label": "Previous label (screen readers)", "default": "Previous milestone" },
    { "type": "text", "id": "next_label", "label": "Next label (screen readers)", "default": "Next milestone" },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer" }
  ],
  "blocks": [
    {
      "type": "event",
      "name": "Milestone",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Icon or photo (square)" },
        { "type": "text", "id": "date", "label": "Date", "default": "2020" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [ { "name": "LP · History timeline" } ],
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
