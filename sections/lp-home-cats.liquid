<section class="lp-cats" aria-labelledby="lp-cats-title-{{ section.id }}">
  <div class="container">
    <header class="lp-cats__head">
      {%- if section.settings.eyebrow != blank -%}<p class="lp-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 id="lp-cats-title-{{ section.id }}" class="h1">{{ section.settings.heading }}</h2>
    </header>
    <ul class="lp-cats__list" role="list" data-lp-reveal>
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign p = block.settings.product
          assign url = block.settings.url
          if url == blank and p != blank
            assign url = p.url
          elsif url == blank and c != blank
            assign url = c.url
          endif
          assign img = block.settings.image
          if img == blank and c != blank
            assign img = c.image | default: c.products.first.featured_image
          endif
          if img == blank and p != blank
            assign img = p.featured_image
          endif
          assign title = block.settings.title
          if title == blank and c != blank
            assign title = c.title
          endif
          if title == blank and p != blank
            assign title = p.title
          endif
        -%}
        <li class="lp-cats__item" {{ block.shopify_attributes }}>
          <a href="{{ url | default: routes.all_products_collection_url }}" class="lp-cats__link">
            <span class="lp-cats__media">
              {%- if img != blank -%}
                {{ img | image_url: width: 400, height: 400, crop: 'center' | image_tag: loading: 'lazy', widths: '200,300,400', sizes: '(min-width: 1000px) 180px, 30vw', class: 'lp-cats__img', alt: '' }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'lp-cats__img' }}
              {%- endif -%}
              {%- if block.settings.badge != blank -%}<span class="lp-cats__badge">{{ block.settings.badge | escape }}</span>{%- endif -%}
            </span>
            <span class="lp-cats__title">{{ title | escape }}</span>
            {%- if c != blank and p == blank -%}
              <span class="lp-cats__count">{{ c.products_count }} {{ section.settings.count_label | escape }}</span>
            {%- elsif block.settings.caption != blank -%}
              <span class="lp-cats__count">{{ block.settings.caption | escape }}</span>
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
.lp-cats { padding-block: var(--lp-section-gap); background: rgb(var(--lp-ivory)); }
.lp-cats__head { display: grid; gap: .5rem; justify-items: center; text-align: center; margin-block-end: clamp(1.75rem, 3.5vw, 2.75rem); }
.lp-cats__head > * { margin: 0; }
.lp-cats__head h2 em { font-style: normal; color: rgb(var(--lp-amber)); }
.lp-cats__list { display: grid; grid-auto-flow: column; grid-auto-columns: 6.25rem; gap: 1rem; margin: 0; padding: 0 0 .5rem; list-style: none; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
.lp-cats__list::-webkit-scrollbar { display: none; }
@media (min-width: 1000px) { .lp-cats__list { grid-auto-flow: row; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1.5rem; overflow: visible; } }
.lp-cats__item { scroll-snap-align: start; }
.lp-cats__link { display: grid; justify-items: center; gap: .35rem; text-align: center; color: inherit; text-decoration: none; }
.lp-cats__media { position: relative; display: block; width: 100%; max-width: 11rem; aspect-ratio: 1; border-radius: 50%; overflow: hidden; background: rgb(var(--lp-sand)); box-shadow: 0 0 0 1px var(--lp-hairline); margin-block-end: .5rem; }
.lp-cats__img { width: 100%; height: 100%; object-fit: cover; transition: transform 900ms var(--lp-ease); }
@media (hover: hover) { .lp-cats__link:hover .lp-cats__img { transform: scale(1.06); } .lp-cats__link:hover .lp-cats__title { color: rgb(var(--lp-amber-deep)); } }
.lp-cats__badge { position: absolute; left: 50%; bottom: .6rem; transform: translateX(-50%); padding: .25rem .6rem; border-radius: 999px; background: rgb(var(--lp-amber)); color: #1F1E20; font-size: .625rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; white-space: nowrap; }
.lp-cats__title { font-weight: 600; font-size: .9375rem; transition: color var(--lp-dur-2) var(--lp-ease); }
.lp-cats__count { font-size: .8125rem; color: rgb(var(--lp-muted)); }
{% endstylesheet %}

{% schema %}
{
  "name": "LP Home categories",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our range" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by <em>category</em>" },
    { "type": "text", "id": "count_label", "label": "Product count label", "default": "products" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "product", "id": "product", "label": "Or a product" },
        { "type": "url", "id": "url", "label": "Custom link" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "text", "id": "badge", "label": "Badge" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "LP Home categories" }]
}
{% endschema %}
