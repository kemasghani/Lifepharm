<section class="lp-hfaq" aria-labelledby="lp-hfaq-title-{{ section.id }}">
  <div class="container lp-hfaq__grid">
    <div class="lp-hfaq__main">
      {%- if section.settings.eyebrow != blank -%}<p class="lp-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 id="lp-hfaq-title-{{ section.id }}" class="h1 lp-hfaq__title">{{ section.settings.heading }}</h2>
      <div class="lp-hfaq__list">
        {%- for block in section.blocks -%}
          <details class="lp-hfaq__item" {{ block.shopify_attributes }}{% if forloop.first %} open{% endif %}>
            <summary class="lp-hfaq__q">
              <span>{{ block.settings.question | escape }}</span>
              <span class="lp-hfaq__icon" aria-hidden="true"></span>
            </summary>
            <div class="lp-hfaq__a">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>

    <aside class="lp-hfaq__help">
      <span class="lp-hfaq__help-icon">{% render 'lp-icon', name: 'chat', size: 24 %}</span>
      <h3 class="lp-hfaq__help-title">{{ section.settings.help_heading | escape }}</h3>
      <p>{{ section.settings.help_text | escape }}</p>
      <a href="{{ section.settings.help_url }}" class="button lp-hfaq__help-cta" data-lp-chat>{{ section.settings.help_label | escape }}</a>
    </aside>
  </div>
</section>

<script>
  document.querySelectorAll('[data-lp-chat]').forEach(function (el) {
    el.addEventListener('click', function (e) {
      if (window.GorgiasChat && typeof window.GorgiasChat.open === 'function') { e.preventDefault(); window.GorgiasChat.open(); }
    });
  });
</script>

{% stylesheet %}
.lp-hfaq { padding-block: var(--lp-section-gap); background: rgb(var(--lp-ivory)); }
.lp-hfaq__grid { display: grid; gap: 2rem; }
@media (min-width: 1000px) { .lp-hfaq__grid { grid-template-columns: minmax(0, 1fr) 22rem; gap: clamp(3rem, 6vw, 6rem); align-items: start; } }
.lp-hfaq__main > .lp-eyebrow { margin: 0 0 .5rem; }
.lp-hfaq__title { margin: 0 0 1.5rem; }
.lp-hfaq__title em { font-style: normal; color: rgb(var(--lp-amber)); }
.lp-hfaq__list { display: grid; gap: .625rem; }
.lp-hfaq__item { border-radius: var(--lp-radius-sm); background: #fff; box-shadow: 0 0 0 1px var(--lp-hairline); transition: background var(--lp-dur-2) var(--lp-ease); }
.lp-hfaq__item[open] { background: rgb(var(--lp-ink)); color: #fff; box-shadow: none; }
.lp-hfaq__q { display: flex; justify-content: space-between; align-items: center; gap: 1rem; min-height: 56px; padding: .9rem 1.25rem; font-weight: 600; cursor: pointer; list-style: none; }
.lp-hfaq__q::-webkit-details-marker { display: none; }
.lp-hfaq__icon { position: relative; flex: none; width: 28px; height: 28px; border-radius: 50%; background: rgb(var(--lp-sand)); }
.lp-hfaq__icon::before, .lp-hfaq__icon::after { content: ""; position: absolute; inset: 50% auto auto 50%; width: 12px; height: 1.5px; background: rgb(var(--lp-ink)); transform: translate(-50%, -50%); transition: transform var(--lp-dur-2) var(--lp-ease); }
.lp-hfaq__icon::after { transform: translate(-50%, -50%) rotate(90deg); }
.lp-hfaq__item[open] .lp-hfaq__icon { background: rgb(var(--lp-amber)); }
.lp-hfaq__item[open] .lp-hfaq__icon::after { transform: translate(-50%, -50%) rotate(0deg); }
.lp-hfaq__a { padding: 0 1.25rem 1.25rem; line-height: 1.65; color: rgb(255 255 255 / .82); }
.lp-hfaq__a p { margin: 0; }
.lp-hfaq__help { position: sticky; top: 7rem; display: grid; gap: .75rem; justify-items: center; padding: 2rem 1.5rem; border-radius: var(--lp-radius); background: rgb(var(--lp-sand)); text-align: center; }
.lp-hfaq__help > * { margin: 0; }
.lp-hfaq__help-icon { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 50%; background: rgb(var(--lp-ink)); color: rgb(var(--lp-amber)); }
.lp-hfaq__help-title { font-size: 1.25rem; }
.lp-hfaq__help p { color: rgb(var(--lp-ink) / .75); line-height: 1.55; }
.lp-hfaq__help-cta { margin-block-start: .5rem; }
@media (prefers-reduced-motion: reduce) { .lp-hfaq__item, .lp-hfaq__icon::before, .lp-hfaq__icon::after { transition: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "LP Home FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Good to know" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, <em>answered</em>" },
    { "type": "text", "id": "help_heading", "label": "Help card heading", "default": "Still unsure?" },
    { "type": "text", "id": "help_text", "label": "Help card text", "default": "Our team is happy to help you choose." },
    { "type": "text", "id": "help_label", "label": "Help card button", "default": "Chat with our team" },
    { "type": "url", "id": "help_url", "label": "Help card link", "info": "Opens live chat when available, otherwise this link." }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [{ "name": "LP Home FAQ" }]
}
{% endschema %}
