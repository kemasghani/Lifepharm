{%- liquid
  assign product = section.settings.product
  assign from_price = 999999999
  if product != blank
    for variant in product.variants
      assign alloc = variant.selling_plan_allocations | first
      assign p = variant.price
      if alloc != blank
        assign p = alloc.price
      endif
      if p < from_price
        assign from_price = p
      endif
    endfor
  endif
-%}

<section class="lp-hh" aria-labelledby="lp-hh-title-{{ section.id }}">
  <div class="container lp-hh__grid">
    <div class="lp-hh__media">
      <div class="lp-hh__frame">
        {%- if section.settings.image != blank -%}
          {%- if section.settings.mobile_image != blank -%}
            {%- comment -%}
              One picture element: the browser downloads the phone photo or the desktop photo, never both.
                1st source  viewport 700px and up: the desktop photo.
                2nd source  a narrower viewport on a large device (fold-out phone, tablet in split view, small desktop window): the phone photo up to 1400px.
                img         phones: the phone photo up to 800px, which is 2x or more on every phone (the widest slot is 390px).

              The photo is the largest thing in the first view and this tag sits behind half of the HTML, so the two common cases
              (phone, desktop) are preloaded from the top of <head>: the comment below carries two link tags, and layout/theme.liquid
              prints what is between the lp-head markers right after the viewport tag (D-085). A link tag can do what Shopify's
              preload header cannot (L-077): carry fetchpriority and a media condition, and be read after the viewport is known.
              Each link repeats the srcset and sizes of the source it stands for, so the preloaded file is the file the picture uses.
            {%- endcomment -%}
            {%- liquid
              assign hero_m = section.settings.mobile_image
              assign hero_d = section.settings.image

              assign hero_p_srcset = ''
              assign hero_m_srcset = ''
              assign hero_m_ladder = '400,480,560,640,720,800,1000,1200,1400' | split: ','
              for w in hero_m_ladder
                assign hero_w = w | plus: 0
                if hero_w > hero_m.width
                  break
                endif
                assign hero_m_srcset = hero_m | image_url: width: hero_w | append: ' ' | append: hero_w | append: 'w, ' | prepend: hero_m_srcset
                if hero_w <= 800
                  assign hero_p_srcset = hero_m_srcset
                endif
              endfor
              assign hero_m_srcset = hero_m_srcset | strip | remove_last: ','
              assign hero_p_srcset = hero_p_srcset | strip | remove_last: ','

              comment
                Desktop photo: the ladder stops at the file's own width, and that width is the last candidate, so a large screen gets
                every pixel the upload has and no candidate claims more pixels than the file holds.
              endcomment
              assign hero_d_srcset = ''
              assign hero_d_top = 0
              assign hero_d_ladder = '600,720,800,900,1000,1100,1200,1320,1400,1600,1800,2000' | split: ','
              for w in hero_d_ladder
                assign hero_w = w | plus: 0
                if hero_w > hero_d.width
                  break
                endif
                assign hero_d_top = hero_w
                assign hero_d_srcset = hero_d | image_url: width: hero_w | append: ' ' | append: hero_w | append: 'w, ' | prepend: hero_d_srcset
              endfor
              if hero_d_top < hero_d.width and hero_d.width <= 2400
                assign hero_d_srcset = hero_d | image_url: width: hero_d.width | append: ' ' | append: hero_d.width | append: 'w, ' | prepend: hero_d_srcset
              endif
              assign hero_d_srcset = hero_d_srcset | strip | remove_last: ','
              assign hero_d_sizes = '(min-width: 1000px) 50vw, 100vw'
            -%}
            <!--lp-head <link rel="preload" as="image" fetchpriority="high" media="(max-width: 699.98px) and (max-device-width: 519.98px)" imagesrcset="{{ hero_p_srcset | escape }}" imagesizes="400px"><link rel="preload" as="image" fetchpriority="high" media="(min-width: 700px)" imagesrcset="{{ hero_d_srcset | escape }}" imagesizes="{{ hero_d_sizes }}"> lp-head-->
            <picture>
              <source media="(min-width: 700px)" sizes="{{ hero_d_sizes }}" srcset="{{ hero_d_srcset | escape }}">
              <source media="(min-device-width: 520px)" sizes="100vw" srcset="{{ hero_m_srcset | escape }}">
              {{ hero_m | image_url: width: 800 | image_tag: loading: 'eager', fetchpriority: 'high', srcset: hero_p_srcset, sizes: '400px', class: 'lp-hh__img' }}
            </picture>
          {%- else -%}
            {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 1000px) 50vw, (min-resolution: 3dppx) 67vw, 100vw', widths: '400,480,560,640,720,800,900,1000,1100,1200,1320,1400', class: 'lp-hh__img' }}
          {%- endif -%}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'lp-hh__img' }}
        {%- endif -%}
      </div>

      {%- if product != blank -%}
        <a href="{{ product.url }}" class="lp-hh__card">
          <span class="lp-hh__card-media">
            {%- assign card_img = section.settings.card_image | default: product.featured_image -%}
            {{ card_img | image_url: width: 240 | image_tag: loading: 'eager', widths: '120,240', sizes: '80px', class: 'lp-hh__card-img', alt: '' }}
          </span>
          <span class="lp-hh__card-body">
            <span class="lp-hh__card-label">{{ section.settings.card_label | escape }}</span>
            <span class="lp-hh__card-name">{{ product.title | escape }}</span>
            <span class="lp-hh__card-price">{{ section.settings.price_prefix | escape }} <strong>{{ from_price | money }}</strong></span>
          </span>
          <span class="lp-hh__card-go" aria-hidden="true">{% render 'lp-icon', name: 'arrow', size: 18 %}</span>
        </a>
      {%- endif -%}
    </div>

    <div class="lp-hh__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="lp-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 id="lp-hh-title-{{ section.id }}" class="h0 lp-hh__title">{{ section.settings.heading }}</h1>

      {%- liquid
        capture lp_reviews
          render 'lp-review-count'
        endcapture
        assign rating_text = section.settings.rating_text | replace: '[reviews]', lp_reviews
        if section.settings.rating_text contains '[reviews]' and lp_reviews == blank
          assign rating_text = blank
        endif
      -%}
      {%- if rating_text != blank -%}
        <p class="lp-hh__rating">
          <span class="lp-hh__stars" aria-hidden="true">{%- for i in (1..5) -%}{% render 'lp-icon', name: 'star', size: 16 %}{%- endfor -%}</span>
          <span>{{ rating_text }}</span>
        </p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="lp-hh__chips" role="list">
          {%- for block in section.blocks -%}
            <li class="lp-hh__chip" {{ block.shopify_attributes }}>
              {% render 'lp-icon', name: block.settings.icon, size: 18 %}
              <span>{{ block.settings.text | escape }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="lp-hh__text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.benefit_1 != blank or section.settings.benefit_2 != blank or section.settings.benefit_3 != blank -%}
        <ul class="lp-hh__benefits" role="list">
          {%- if section.settings.benefit_1 != blank -%}<li>{% render 'lp-icon', name: 'check', size: 18 %}<span>{{ section.settings.benefit_1 }}</span></li>{%- endif -%}
          {%- if section.settings.benefit_2 != blank -%}<li>{% render 'lp-icon', name: 'check', size: 18 %}<span>{{ section.settings.benefit_2 }}</span></li>{%- endif -%}
          {%- if section.settings.benefit_3 != blank -%}<li>{% render 'lp-icon', name: 'check', size: 18 %}<span>{{ section.settings.benefit_3 }}</span></li>{%- endif -%}
        </ul>
      {%- endif -%}

      <div class="lp-hh__actions">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_url | default: routes.all_products_collection_url }}" class="button button--xl lp-hh__cta">
            <span>{{ section.settings.button_label | escape }}</span>
            {% render 'lp-icon', name: 'arrow', size: 18 %}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          {%- if section.settings.secondary_style == 'link' -%}
            <a href="{{ section.settings.secondary_url }}" class="lp-hh__link">{{ section.settings.secondary_label | escape }}</a>
          {%- else -%}
            <a href="{{ section.settings.secondary_url }}" class="button button--xl button--outline">{{ section.settings.secondary_label | escape }}</a>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
.lp-hh { background: rgb(var(--lp-ivory)); padding-block: clamp(.75rem, 2vw, 2rem) clamp(2.5rem, 5vw, 4.5rem); }
.lp-hh__grid { display: grid; gap: 1.25rem; align-items: center; }
@media (min-width: 1000px) { .lp-hh__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2.5rem, 5vw, 5rem); } .lp-hh__media { order: 2; } }
.lp-hh__media { position: relative; }
.lp-hh__frame { border-radius: var(--lp-radius-lg); overflow: hidden; background: rgb(var(--lp-sand)); aspect-ratio: 2 / 1; }
@media (min-width: 700px) { .lp-hh__frame { aspect-ratio: 5 / 4; } }
.lp-hh__img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
.lp-hh__frame picture { display: contents; }
.lp-hh__card { position: absolute; left: .75rem; bottom: .75rem; display: flex; align-items: center; gap: .75rem; padding: .5rem .6rem .5rem .5rem; border-radius: var(--lp-radius); background: rgb(255 255 255 / .94); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); box-shadow: var(--lp-shadow-2); color: rgb(var(--lp-ink)); text-decoration: none; max-width: calc(100% - 1.5rem); }
@media (max-width: 699px) { .lp-hh__card { position: relative; left: auto; bottom: auto; margin: -1.5rem .75rem 0; max-width: none; } }
@media (min-width: 1000px) { .lp-hh__card { left: -1.75rem; bottom: 2rem; padding: .7rem .8rem .7rem .7rem; } }
.lp-hh__card-media { flex: none; display: grid; place-items: center; width: 56px; height: 56px; border-radius: var(--lp-radius-sm); background: rgb(var(--lp-sand)); overflow: hidden; }
@media (min-width: 700px) { .lp-hh__card-media { width: 76px; height: 76px; } }
.lp-hh__card-img { width: 88%; height: 88%; object-fit: contain; }
.lp-hh__card-body { display: grid; gap: .1rem; min-width: 0; }
.lp-hh__card-label { font-size: .625rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: rgb(var(--lp-amber)); }
.lp-hh__card-name { font-size: .9375rem; font-weight: 700; letter-spacing: .02em; }
.lp-hh__card-price { font-size: .8125rem; color: rgb(var(--lp-muted)); }
.lp-hh__card-price strong { color: rgb(var(--lp-ink)); }
.lp-hh__card-go { flex: none; display: grid; place-items: center; width: 40px; height: 40px; margin-inline-start: .25rem; border-radius: 50%; background: rgb(var(--lp-amber)); color: #1F1E20; transition: transform var(--lp-dur-2) var(--lp-ease); }
@media (hover: hover) { .lp-hh__card:hover .lp-hh__card-go { transform: translateX(3px); } }
.lp-hh__copy { display: grid; gap: .875rem; justify-items: start; max-width: 36rem; }
.lp-hh__copy > * { margin: 0; }
.lp-hh h1.lp-hh__title { font-size: clamp(2rem, 3.6vw, 3.5rem); }
.lp-hh__title em { font-style: normal; color: rgb(var(--lp-amber)); }
.lp-hh__rating { display: inline-flex; align-items: center; gap: .6rem; font-size: .875rem; color: rgb(var(--lp-ink) / .8); }
.lp-hh__stars { display: inline-flex; gap: 1px; color: rgb(var(--lp-amber)); }
.lp-hh__stars svg { fill: currentColor; }
.lp-hh__chips { display: flex; flex-wrap: wrap; gap: .4rem; margin: 0; padding: 0; list-style: none; }
.lp-hh__chip { display: inline-flex; align-items: center; gap: .35rem; padding: .35rem .7rem; border-radius: 999px; background: #fff; box-shadow: 0 0 0 1px var(--lp-hairline); font-size: .75rem; font-weight: 500; white-space: nowrap; }
.lp-hh__chip svg { color: rgb(var(--lp-amber)); }
.lp-hh__text { font-size: clamp(1rem, 1.15vw, 1.125rem); line-height: 1.6; color: rgb(var(--lp-ink) / .75); }
.lp-hh__text p { margin: 0; }
.lp-hh__benefits { display: grid; gap: .45rem; margin: 0; padding: 0; list-style: none; font-size: clamp(.9375rem, 1.1vw, 1.0625rem); line-height: 1.45; color: rgb(var(--lp-ink) / .85); }
.lp-hh__benefits li { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: .6rem; align-items: start; }
.lp-hh__benefits svg { margin-block-start: .15em; padding: 3px; border-radius: 50%; background: rgb(var(--lp-amber)); color: #1F1E20; }
.lp-hh__actions { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1.5rem; padding-block-start: .25rem; }
.lp-hh__link { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; color: rgb(var(--lp-ink)); text-decoration: underline; text-underline-offset: 4px; }
.lp-hh__cta svg { transition: transform var(--lp-dur-2) var(--lp-ease); }
@media (hover: hover) { .lp-hh__cta:hover svg { transform: translateX(4px); } }
@media (max-width: 699px) {
  /* Mobile: one calm column. Image, headline, proof, three benefits, one button, then the trust chips on a single row that scrolls sideways */
  .lp-hh__frame { aspect-ratio: 16 / 9; }
  .lp-hh__card { display: none; }
  .lp-hh__copy { gap: .625rem; padding-block-start: .25rem; }
  .lp-hh__text, .lp-hh__link { display: none; }
  .lp-hh__benefits { gap: .4rem; font-size: .9375rem; }
  .lp-hh__actions { padding-block-start: .375rem; justify-self: stretch; }
  .lp-hh__actions .button { flex: 1 1 100%; padding-inline: 1.25rem; }
  .lp-hh__chips { order: 2; justify-self: stretch; flex-wrap: nowrap; gap: .5rem; min-width: 0; margin-inline: calc(var(--container-gutter, 1.25rem) * -1); padding: .25rem var(--container-gutter, 1.25rem); overflow-x: auto; scroll-snap-type: x proximity; scroll-padding-inline: var(--container-gutter, 1.25rem); scrollbar-width: none; }
  .lp-hh__chips::-webkit-scrollbar { display: none; }
  .lp-hh__chip { flex: none; padding: .4rem .75rem; font-size: .75rem; scroll-snap-align: start; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "LP Home hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image (desktop)" },
    { "type": "image_picker", "id": "mobile_image", "label": "Image (mobile)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Wrap a word in <em> to colour it.", "default": "Feel good at <em>every age</em>" },
    { "type": "inline_richtext", "id": "rating_text", "label": "Rating text" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "inline_richtext", "id": "benefit_1", "label": "Benefit 1" },
    { "type": "inline_richtext", "id": "benefit_2", "label": "Benefit 2" },
    { "type": "inline_richtext", "id": "benefit_3", "label": "Benefit 3" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop best sellers" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label" },
    { "type": "url", "id": "secondary_url", "label": "Secondary button link" },
    { "type": "select", "id": "secondary_style", "label": "Secondary button style", "default": "outline", "options": [{ "value": "outline", "label": "Outline button" }, { "value": "link", "label": "Text link" }] },
    { "type": "header", "content": "Featured product card" },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "image_picker", "id": "card_image", "label": "Card image", "info": "Transparent PNG works best." },
    { "type": "text", "id": "card_label", "label": "Card label", "default": "Our best seller" },
    { "type": "text", "id": "price_prefix", "label": "Price prefix", "default": "From" }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Trust chip",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "shield", "options": [
          { "value": "shield", "label": "Shield" }, { "value": "badge", "label": "Badge" }, { "value": "flag", "label": "Flag" },
          { "value": "truck", "label": "Truck" }, { "value": "flask", "label": "Flask" }, { "value": "leaf", "label": "Leaf" },
          { "value": "refresh", "label": "Refresh" }, { "value": "check", "label": "Check" }
        ] },
        { "type": "text", "id": "text", "label": "Text", "default": "60-day money-back guarantee" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "LP Home hero" }]
}
{% endschema %}
