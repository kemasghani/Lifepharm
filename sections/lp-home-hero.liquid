{%- liquid
  assign product = section.settings.product
  assign from_price = 999999999
  if product != blank
    for variant in product.variants
      assign alloc = variant.selling_plan_allocations | first
      assign p = variant.price
      if alloc != blank
        assign p = alloc.price
      endif
      if p < from_price
        assign from_price = p
      endif
    endfor
  endif
-%}

<section class="lp-hh" aria-labelledby="lp-hh-title-{{ section.id }}">
  <div class="container lp-hh__grid">
    <div class="lp-hh__media">
      <div class="lp-hh__frame">
        {%- if section.settings.image != blank -%}
          {%- if section.settings.mobile_image != blank -%}
            {{ section.settings.mobile_image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '400,600,800,1000,1400', class: 'lp-hh__img lp-hh__img--mobile' }}
          {%- endif -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 1000px) 50vw, 100vw', widths: '600,800,1000,1200,1400', class: 'lp-hh__img lp-hh__img--desktop' }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'lp-hh__img' }}
        {%- endif -%}
      </div>

      {%- if product != blank -%}
        <a href="{{ product.url }}" class="lp-hh__card">
          <span class="lp-hh__card-media">
            {%- assign card_img = section.settings.card_image | default: product.featured_image -%}
            {{ card_img | image_url: width: 240 | image_tag: loading: 'eager', widths: '120,240', sizes: '80px', class: 'lp-hh__card-img', alt: '' }}
          </span>
          <span class="lp-hh__card-body">
            <span class="lp-hh__card-label">{{ section.settings.card_label | escape }}</span>
            <span class="lp-hh__card-name">{{ product.title | escape }}</span>
            <span class="lp-hh__card-price">{{ section.settings.price_prefix | escape }} <strong>{{ from_price | money }}</strong></span>
          </span>
          <span class="lp-hh__card-go" aria-hidden="true">{% render 'lp-icon', name: 'arrow', size: 18 %}</span>
        </a>
      {%- endif -%}
    </div>

    <div class="lp-hh__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="lp-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 id="lp-hh-title-{{ section.id }}" class="h0 lp-hh__title">{{ section.settings.heading }}</h1>

      {%- if section.settings.rating_text != blank -%}
        <p class="lp-hh__rating">
          <span class="lp-hh__stars" aria-hidden="true">{%- for i in (1..5) -%}{% render 'lp-icon', name: 'star', size: 16 %}{%- endfor -%}</span>
          <span>{{ section.settings.rating_text }}</span>
        </p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="lp-hh__chips" role="list">
          {%- for block in section.blocks -%}
            <li class="lp-hh__chip" {{ block.shopify_attributes }}>
              {% render 'lp-icon', name: block.settings.icon, size: 18 %}
              <span>{{ block.settings.text | escape }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="lp-hh__text">{{ section.settings.text }}</div>
      {%- endif -%}

      <div class="lp-hh__actions">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_url | default: routes.all_products_collection_url }}" class="button button--xl lp-hh__cta">
            <span>{{ section.settings.button_label | escape }}</span>
            {% render 'lp-icon', name: 'arrow', size: 18 %}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a href="{{ section.settings.secondary_url }}" class="button button--xl button--outline">{{ section.settings.secondary_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
.lp-hh { background: rgb(var(--lp-ivory)); padding-block: clamp(.75rem, 2vw, 2rem) clamp(2.5rem, 5vw, 4.5rem); }
.lp-hh__grid { display: grid; gap: 1.25rem; align-items: center; }
@media (min-width: 1000px) { .lp-hh__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2.5rem, 5vw, 5rem); } .lp-hh__media { order: 2; } }
.lp-hh__media { position: relative; }
.lp-hh__frame { border-radius: var(--lp-radius-lg); overflow: hidden; background: rgb(var(--lp-sand)); aspect-ratio: 2 / 1; }
@media (min-width: 700px) { .lp-hh__frame { aspect-ratio: 5 / 4; } }
.lp-hh__img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
.lp-hh__img--mobile + .lp-hh__img--desktop { display: none; }
@media (min-width: 700px) { .lp-hh__img--mobile { display: none; } .lp-hh__img--mobile + .lp-hh__img--desktop { display: block; } }
.lp-hh__card { position: absolute; left: .75rem; bottom: .75rem; display: flex; align-items: center; gap: .75rem; padding: .5rem .6rem .5rem .5rem; border-radius: var(--lp-radius); background: rgb(255 255 255 / .94); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); box-shadow: var(--lp-shadow-2); color: rgb(var(--lp-ink)); text-decoration: none; max-width: calc(100% - 1.5rem); }
@media (min-width: 1000px) { .lp-hh__card { left: -1.75rem; bottom: 2rem; padding: .7rem .8rem .7rem .7rem; } }
.lp-hh__card-media { flex: none; display: grid; place-items: center; width: 56px; height: 56px; border-radius: var(--lp-radius-sm); background: rgb(var(--lp-sand)); overflow: hidden; }
@media (min-width: 700px) { .lp-hh__card-media { width: 76px; height: 76px; } }
.lp-hh__card-img { width: 88%; height: 88%; object-fit: contain; }
.lp-hh__card-body { display: grid; gap: .1rem; min-width: 0; }
.lp-hh__card-label { font-size: .625rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: rgb(var(--lp-amber-deep)); }
.lp-hh__card-name { font-size: .9375rem; font-weight: 700; letter-spacing: .02em; }
.lp-hh__card-price { font-size: .8125rem; color: rgb(var(--lp-muted)); }
.lp-hh__card-price strong { color: rgb(var(--lp-ink)); }
.lp-hh__card-go { flex: none; display: grid; place-items: center; width: 40px; height: 40px; margin-inline-start: .25rem; border-radius: 50%; background: rgb(var(--lp-amber)); color: #1F1E20; transition: transform var(--lp-dur-2) var(--lp-ease); }
@media (hover: hover) { .lp-hh__card:hover .lp-hh__card-go { transform: translateX(3px); } }
.lp-hh__copy { display: grid; gap: .875rem; justify-items: start; max-width: 36rem; }
.lp-hh__copy > * { margin: 0; }
.lp-hh h1.lp-hh__title { font-size: clamp(2rem, 3.6vw, 3.5rem); }
.lp-hh__title em { font-style: normal; color: rgb(var(--lp-amber-deep)); }
.lp-hh__rating { display: inline-flex; align-items: center; gap: .6rem; font-size: .875rem; color: rgb(var(--lp-ink) / .8); }
.lp-hh__stars { display: inline-flex; gap: 1px; color: rgb(var(--lp-amber)); }
.lp-hh__stars svg { fill: currentColor; }
.lp-hh__chips { display: flex; flex-wrap: wrap; gap: .4rem; margin: 0; padding: 0; list-style: none; }
.lp-hh__chip { display: inline-flex; align-items: center; gap: .35rem; padding: .35rem .7rem; border-radius: 999px; background: #fff; box-shadow: 0 0 0 1px var(--lp-hairline); font-size: .75rem; font-weight: 500; white-space: nowrap; }
.lp-hh__chip svg { color: rgb(var(--lp-amber-deep)); }
.lp-hh__text { font-size: clamp(1rem, 1.15vw, 1.125rem); line-height: 1.6; color: rgb(var(--lp-ink) / .75); }
.lp-hh__text p { margin: 0; }
.lp-hh__actions { display: flex; flex-wrap: wrap; gap: .75rem; padding-block-start: .25rem; }
.lp-hh__cta svg { transition: transform var(--lp-dur-2) var(--lp-ease); }
@media (hover: hover) { .lp-hh__cta:hover svg { transform: translateX(4px); } }
@media (max-width: 699px) {
  .lp-hh__copy { gap: .7rem; }
  .lp-hh__text { display: none; }
  .lp-hh__chip { padding: .3rem .6rem; font-size: .71875rem; }
  .lp-hh__actions .button { flex: 1 1 auto; padding-inline: 1.25rem; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "LP Home hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image (desktop)" },
    { "type": "image_picker", "id": "mobile_image", "label": "Image (mobile)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Wrap a word in <em> to colour it.", "default": "Feel good at <em>every age</em>" },
    { "type": "inline_richtext", "id": "rating_text", "label": "Rating text" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop best sellers" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label" },
    { "type": "url", "id": "secondary_url", "label": "Secondary button link" },
    { "type": "header", "content": "Featured product card" },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "image_picker", "id": "card_image", "label": "Card image", "info": "Transparent PNG works best." },
    { "type": "text", "id": "card_label", "label": "Card label", "default": "Our best seller" },
    { "type": "text", "id": "price_prefix", "label": "Price prefix", "default": "From" }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Trust chip",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "shield", "options": [
          { "value": "shield", "label": "Shield" }, { "value": "badge", "label": "Badge" }, { "value": "flag", "label": "Flag" },
          { "value": "truck", "label": "Truck" }, { "value": "flask", "label": "Flask" }, { "value": "leaf", "label": "Leaf" },
          { "value": "refresh", "label": "Refresh" }, { "value": "check", "label": "Check" }
        ] },
        { "type": "text", "id": "text", "label": "Text", "default": "60-day money-back guarantee" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "LP Home hero" }]
}
{% endschema %}
