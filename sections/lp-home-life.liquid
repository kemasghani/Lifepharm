<section class="lp-life" aria-labelledby="lp-life-title-{{ section.id }}">
  <div class="container">
    <header class="lp-life__head">
      {%- if section.settings.eyebrow != blank -%}<p class="lp-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 id="lp-life-title-{{ section.id }}" class="h1">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="lp-life__intro">{{ section.settings.text | escape }}</p>{%- endif -%}
    </header>
    <ul class="lp-life__list lp-life__list--{{ section.blocks.size }}" role="list" data-lp-reveal>
      {%- for block in section.blocks -%}
        {%- liquid
          assign p = block.settings.product
          assign img = block.settings.image
          assign url = block.settings.url
          if url == blank and p != blank
            assign url = p.url
          endif
          assign title = block.settings.title
          if title == blank and p != blank
            assign title = p.title
          endif
          if img == blank and p != blank
            assign img = p.featured_image
          endif
          assign alt = img.alt | default: title
        -%}
        <li class="lp-life__item" {{ block.shopify_attributes }}>
          <a href="{{ url | default: routes.all_products_collection_url }}" class="lp-life__card">
            <span class="lp-life__media">
              {%- if img != blank -%}
                {{ img | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '300,450,600,800,1000,1200', sizes: '(min-width: 1200px) 230px, (min-width: 1000px) 22vw, (min-width: 700px) 30vw, 62vw', class: 'lp-life__img', alt: alt }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'lp-life__img' }}
              {%- endif -%}
            </span>
            <span class="lp-life__body">
              {%- if title != blank -%}<span class="lp-life__title">{{ title | escape }}</span>{%- endif -%}
              {%- if block.settings.caption != blank -%}<span class="lp-life__caption">{{ block.settings.caption | escape }}</span>{%- endif -%}
              {%- if section.settings.link_label != blank -%}
                <span class="lp-life__link">
                  {{- section.settings.link_label | escape -}}
                  {% render 'lp-icon', name: 'arrow', size: 14 %}
                </span>
              {%- endif -%}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
.lp-life { padding-block: var(--lp-section-gap); background: #fff; }
.lp-life__head { display: grid; gap: .5rem; justify-items: center; text-align: center; margin-block-end: clamp(1.75rem, 3vw, 2.75rem); }
.lp-life__head > * { margin: 0; }
.lp-life__head em { font-style: normal; color: rgb(var(--lp-amber)); }
.lp-life__intro { max-width: 34rem; color: rgb(var(--lp-muted)); font-size: 1rem; line-height: 1.6; }
.lp-life__list { display: grid; grid-auto-flow: column; grid-auto-columns: 62%; gap: .875rem; margin: 0 calc(var(--container-gutter, 1.25rem) * -1); padding: 0 var(--container-gutter, 1.25rem) .25rem; list-style: none; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--container-gutter, 1.25rem); scrollbar-width: none; -webkit-overflow-scrolling: touch; }
.lp-life__list::-webkit-scrollbar { display: none; }
.lp-life__item { min-width: 0; scroll-snap-align: start; }
@media (min-width: 700px) { .lp-life__list { grid-auto-columns: 30%; gap: 1.125rem; } }
@media (min-width: 1000px) { .lp-life__list { grid-auto-columns: 22%; } }
@media (min-width: 1200px) {
  .lp-life__list { grid-auto-flow: row; grid-auto-columns: auto; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: clamp(1rem, 1.5vw, 1.375rem); margin: 0; padding: 0; overflow: visible; }
  .lp-life__list--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .lp-life__list--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .lp-life__list--5 { grid-template-columns: repeat(5, minmax(0, 1fr)); }
}
.lp-life__card { display: grid; grid-template-rows: auto 1fr; gap: .875rem; height: 100%; color: rgb(var(--lp-ink)); text-decoration: none; border-radius: var(--lp-radius); cursor: pointer; }
.lp-life__card:focus-visible { outline: 2px solid rgb(var(--lp-ink)); outline-offset: 4px; }
.lp-life__media { position: relative; display: block; aspect-ratio: 4 / 5; overflow: hidden; border-radius: var(--lp-radius); background: rgb(var(--lp-sand)); }
.lp-life__img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 900ms var(--lp-ease); }
.lp-life__body { display: grid; grid-template-rows: auto 1fr auto; gap: .25rem; padding-inline: .125rem; }
.lp-life__title { font-size: 1rem; font-weight: 600; line-height: 1.3; transition: color var(--lp-dur-2) var(--lp-ease); }
.lp-life__caption { font-size: .875rem; line-height: 1.5; color: rgb(var(--lp-muted)); }
.lp-life__link { display: inline-flex; align-items: center; gap: .375rem; min-height: 1.75rem; margin-block-start: .25rem; font-size: .8125rem; font-weight: 600; }
.lp-life__link svg { transition: transform var(--lp-dur-2) var(--lp-ease); }
@media (hover: hover) {
  .lp-life__card:hover .lp-life__img { transform: scale(1.04); }
  .lp-life__card:hover .lp-life__title { color: rgb(var(--lp-amber-deep)); }
  .lp-life__card:hover .lp-life__link svg { transform: translateX(4px); }
}
@media (prefers-reduced-motion: reduce) {
  .lp-life__img, .lp-life__link svg { transition: none; }
  .lp-life__card:hover .lp-life__img, .lp-life__card:hover .lp-life__link svg { transform: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "LP Home daily life",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "In daily life" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Wherever your <em>day takes you</em>" },
    { "type": "text", "id": "text", "label": "Intro text" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop now" }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "url", "id": "url", "label": "Custom link" },
        { "type": "text", "id": "title", "label": "Title", "info": "Leave empty to use the product title" },
        { "type": "text", "id": "caption", "label": "Caption" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "LP Home daily life" }]
}
{% endschema %}
