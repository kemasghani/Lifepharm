{%- liquid
  assign product = section.settings.product
  assign best_unit = 999999999
  if product != blank
    for variant in product.variants
      assign count = variant.title | split: ' ' | first | plus: 0
      if count > 0
        assign alloc = variant.selling_plan_allocations | first
        assign p = variant.price
        if alloc != blank
          assign p = alloc.price
        endif
        assign unit = p | divided_by: count
        if unit < best_unit
          assign best_unit = unit
        endif
      endif
    endfor
  endif
  assign threshold = section.settings.free_delivery_threshold | times: 100
-%}

<section id="{{ section.settings.anchor | default: 'lp-offer' | handleize }}" class="lp-offer" aria-labelledby="lp-offer-title-{{ section.id }}">
  <div class="container">
    <header class="lp-offer__head">
      {%- if section.settings.eyebrow != blank -%}<p class="lp-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 id="lp-offer-title-{{ section.id }}" class="h1">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="lp-offer__intro">{{ section.settings.text }}</div>{%- endif -%}
    </header>

    {%- if product != blank -%}
      <ul class="lp-offer__grid" role="list" data-lp-reveal>
        {%- for variant in product.variants -%}
          {%- liquid
            assign alloc = variant.selling_plan_allocations | first
            assign price = variant.price
            if alloc != blank
              assign price = alloc.price
            endif
            assign count = variant.title | split: ' ' | first | plus: 0
            assign unit = 0
            if count > 0
              assign unit = price | divided_by: count
            endif
            assign image = variant.featured_image | default: product.featured_image
          -%}
          <li class="lp-offer__card{% if unit > 0 and unit == best_unit %} is-best{% endif %}">
            {%- if unit > 0 and unit == best_unit -%}
              <span class="lp-offer__flag">{{ section.settings.best_label | escape }}</span>
            {%- elsif price >= threshold and threshold > 0 -%}
              <span class="lp-offer__flag lp-offer__flag--soft">{{ section.settings.free_label | escape }}</span>
            {%- endif -%}
            <div class="lp-offer__media">
              {{ image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(min-width: 1000px) 25vw, 80vw', widths: '300,450,600', class: 'lp-offer__img' }}
            </div>
            <div class="lp-offer__body">
              <h3 class="lp-offer__name">{{ variant.title | escape }}</h3>
              <p class="lp-offer__price">
                <strong>{{ price | money }}</strong>
                {%- if variant.price > price -%}<s>{{ variant.price | money }}</s>{%- endif -%}
              </p>
              <p class="lp-offer__meta">
                {%- if alloc != blank -%}{{ section.settings.sub_label | escape }}{%- else -%}{{ section.settings.oneoff_label | escape }}{%- endif -%}
                {%- if unit > 0 %} · {{ unit | money }} {{ section.settings.unit_label | escape }}{%- endif -%}
              </p>
              <a href="{{ variant.url }}" class="button {% if unit > 0 and unit == best_unit %}{% else %}button--outline {% endif %}lp-offer__cta">
                {{- section.settings.button_label | escape -}}
                <span class="sr-only">: {{ product.title | escape }}, {{ variant.title | escape }}</span>
              </a>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.footnote != blank -%}
      <p class="lp-offer__foot">{% render 'lp-icon', name: 'refresh', size: 18 %}<span>{{ section.settings.footnote }}</span></p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.lp-offer { padding-block: var(--lp-section-gap); background: rgb(var(--lp-sand) / .55); scroll-margin-top: 6rem; }
.lp-offer__head { display: grid; gap: .75rem; justify-items: center; text-align: center; max-width: 44rem; margin: 0 auto clamp(2rem, 4vw, 3rem); }
.lp-offer__head > * { margin: 0; }
.lp-offer__head h2 em { font-style: normal; color: rgb(var(--lp-amber)); }
.lp-offer__intro { color: rgb(var(--lp-ink) / .72); line-height: 1.6; }
.lp-offer__intro p { margin: 0; }
.lp-offer__grid { display: grid; gap: 1rem; margin: 0; padding: 0; list-style: none; }
@media (min-width: 700px) { .lp-offer__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; } }
.lp-offer__card { position: relative; display: grid; grid-template-columns: 7rem minmax(0, 1fr); gap: 1rem; align-items: center; padding: 1rem; border-radius: var(--lp-radius); background: #fff; box-shadow: 0 0 0 1px var(--lp-hairline); }
@media (min-width: 700px) { .lp-offer__card { grid-template-columns: 1fr; padding: 1.25rem 1.25rem 1.5rem; align-items: start; } }
.lp-offer__card.is-best { box-shadow: 0 0 0 2px rgb(var(--lp-amber)), var(--lp-shadow-2); }
.lp-offer__flag { position: absolute; top: 0; left: 50%; transform: translate(-50%, -50%); padding: .35rem .8rem; border-radius: 999px; background: rgb(var(--lp-amber)); color: #1F1E20; font-size: .6875rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; white-space: nowrap; }
.lp-offer__flag--soft { background: rgb(var(--lp-ink)); color: #fff; }
.lp-offer__media { border-radius: var(--lp-radius-sm); background: linear-gradient(180deg, #fff, rgb(var(--lp-sand) / .7)); aspect-ratio: 1; overflow: hidden; }
.lp-offer__img { width: 100%; height: 100%; object-fit: contain; mix-blend-mode: multiply; }
.lp-offer__body { display: grid; gap: .35rem; justify-items: start; }
.lp-offer__body > * { margin: 0; }
.lp-offer__name { font-size: 1.0625rem; }
.lp-offer__price { display: flex; align-items: baseline; gap: .5rem; }
.lp-offer__price strong { font-size: 1.375rem; font-weight: 700; }
.lp-offer__price s { color: rgb(var(--lp-muted)); font-size: .9375rem; }
.lp-offer__meta { font-size: .8125rem; color: rgb(var(--lp-muted)); }
.lp-offer__cta { margin-block-start: .5rem; width: 100%; }
.lp-offer__foot { display: flex; justify-content: center; align-items: center; gap: .5rem; margin: 1.75rem 0 0; font-size: .875rem; color: rgb(var(--lp-ink) / .75); text-align: center; }
.lp-offer__foot svg { flex: none; color: rgb(var(--lp-amber-deep)); }
{% endstylesheet %}

{% schema %}
{
  "name": "LP Home offer",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "lp-offer" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Choose your supply" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Subscribe and <em>save 25%</em>" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "best_label", "label": "Best value label", "default": "Best value" },
    { "type": "text", "id": "free_label", "label": "Free delivery label", "default": "Free UK delivery" },
    { "type": "number", "id": "free_delivery_threshold", "label": "Free delivery threshold", "default": 150 },
    { "type": "text", "id": "sub_label", "label": "Subscription price label", "default": "With Subscribe & Save" },
    { "type": "text", "id": "oneoff_label", "label": "One-off price label", "default": "One-off purchase" },
    { "type": "text", "id": "unit_label", "label": "Per unit label", "default": "per capsule" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Choose" },
    { "type": "inline_richtext", "id": "footnote", "label": "Footnote" }
  ],
  "presets": [{ "name": "LP Home offer" }]
}
{% endschema %}
