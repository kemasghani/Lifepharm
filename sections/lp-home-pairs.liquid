<section class="lp-pairs" aria-labelledby="lp-pairs-title-{{ section.id }}">
  <div class="container">
    <header class="lp-pairs__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="lp-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 id="lp-pairs-title-{{ section.id }}" class="h1">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.text != blank -%}<div class="lp-pairs__intro">{{ section.settings.text }}</div>{%- endif -%}
    </header>

    <ul class="lp-pairs__grid" role="list" data-lp-reveal>
      {%- for block in section.blocks -%}
        {%- assign product = block.settings.product -%}
        {%- if product != blank -%}
          {%- liquid
            assign alloc = product.selected_or_first_available_variant.selling_plan_allocations | first
            assign price = product.price_min
            if alloc != blank
              assign price = alloc.price
            endif
          -%}
          <li class="lp-pairs__card" style="--lp-accent: {{ block.settings.accent }}" {{ block.shopify_attributes }}>
            <a href="{{ product.url }}" class="lp-pairs__link">
              <div class="lp-pairs__media">
                {{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 1000px) 30vw, 80vw', widths: '350,500,700', class: 'lp-pairs__img' }}
              </div>
              <div class="lp-pairs__body">
                <h3 class="lp-pairs__name">{{ product.title | escape }}</h3>
                {%- if block.settings.text != blank -%}<p class="lp-pairs__text">{{ block.settings.text | escape }}</p>{%- endif -%}
                <p class="lp-pairs__price">
                  <span>{{ section.settings.price_prefix | escape }} <strong>{{ price | money }}</strong></span>
                  <span class="lp-pairs__go" aria-hidden="true">{% render 'lp-icon', name: 'arrow', size: 18 %}</span>
                </p>
              </div>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
.lp-pairs { padding-block: var(--lp-section-gap); background: rgb(var(--lp-ivory)); }
.lp-pairs__head { display: grid; gap: 1rem; margin-block-end: clamp(1.75rem, 3.5vw, 2.75rem); }
@media (min-width: 1000px) { .lp-pairs__head { grid-template-columns: 1fr minmax(0, 26rem); align-items: end; gap: 3rem; } }
.lp-pairs__head h2 { margin: .5rem 0 0; }
.lp-pairs__head h2 em { font-style: normal; color: rgb(var(--lp-amber-deep)); }
.lp-pairs__head .lp-eyebrow { margin: 0; }
.lp-pairs__intro { color: rgb(var(--lp-ink) / .72); line-height: 1.6; }
.lp-pairs__intro p { margin: 0; }
.lp-pairs__grid { display: grid; gap: 1rem; margin: 0; padding: 0; list-style: none; }
@media (min-width: 700px) { .lp-pairs__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; } }
.lp-pairs__card { border-radius: var(--lp-radius); background: #fff; box-shadow: 0 0 0 1px var(--lp-hairline); overflow: hidden; transition: box-shadow var(--lp-dur-3) var(--lp-ease), transform var(--lp-dur-3) var(--lp-ease); }
@media (hover: hover) { .lp-pairs__card:hover { transform: translateY(-4px); box-shadow: 0 0 0 1px var(--lp-hairline), var(--lp-shadow-2); } .lp-pairs__card:hover .lp-pairs__go { transform: translateX(4px); } }
.lp-pairs__link { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); height: 100%; color: inherit; text-decoration: none; }
@media (min-width: 700px) { .lp-pairs__link { grid-template-columns: 1fr; } }
.lp-pairs__media { position: relative; background: linear-gradient(180deg, #fff, rgb(var(--lp-sand))); aspect-ratio: 1; }
.lp-pairs__media::after { content: ""; position: absolute; inset: auto 0 0 0; height: 4px; background: var(--lp-accent); }
.lp-pairs__img { width: 100%; height: 100%; object-fit: contain; mix-blend-mode: multiply; }
.lp-pairs__body { display: grid; gap: .4rem; align-content: start; padding: 1rem 1.125rem 1.25rem; }
.lp-pairs__body > * { margin: 0; }
.lp-pairs__name { font-size: 1.0625rem; }
.lp-pairs__text { font-size: .875rem; line-height: 1.5; color: rgb(var(--lp-muted)); }
.lp-pairs__price { display: flex; justify-content: space-between; align-items: center; margin-block-start: .25rem !important; font-size: .875rem; color: rgb(var(--lp-muted)); }
.lp-pairs__price strong { color: rgb(var(--lp-ink)); font-size: 1rem; }
.lp-pairs__go { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: rgb(var(--lp-amber)); color: #1F1E20; transition: transform var(--lp-dur-2) var(--lp-ease); }
{% endstylesheet %}

{% schema %}
{
  "name": "LP Home pairs",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Complete your routine" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Often bought <em>with Laminine</em>" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "price_prefix", "label": "Price prefix", "default": "From" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "text", "label": "Short description" },
        { "type": "color", "id": "accent", "label": "Product colour", "default": "#F18A00" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "LP Home pairs" }]
}
{% endschema %}
