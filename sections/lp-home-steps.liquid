<section class="lp-steps" aria-labelledby="lp-steps-title-{{ section.id }}">
  <div class="container">
    <header class="lp-steps__head">
      {%- if section.settings.eyebrow != blank -%}<p class="lp-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 id="lp-steps-title-{{ section.id }}" class="h1">{{ section.settings.heading }}</h2>
    </header>

    <ol class="lp-steps__list" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign img = block.settings.image
          assign vid = block.settings.video
          assign mp4_url = ''
          assign mp4_width = 0
          if vid != blank
            for source in vid.sources
              if source.format == 'mp4' and source.width > mp4_width
                assign mp4_url = source.url
                assign mp4_width = source.width
              endif
            endfor
          endif
        -%}
        <li class="lp-steps__item" {{ block.shopify_attributes }}>
          <div class="lp-steps__media">
            {%- if img != blank -%}
              {{ img | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,600,800,1000,1200', sizes: '(min-width: 1000px) 30vw, 80vw', class: 'lp-steps__img' }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'lp-steps__img' }}
            {%- endif -%}
            {%- if mp4_url != blank -%}
              <video class="lp-steps__video" muted playsinline preload="none" tabindex="-1" aria-hidden="true" data-lp-play-once>
                <source src="{{ mp4_url }}" type="video/mp4">
              </video>
            {%- endif -%}
            <span class="lp-steps__num" aria-hidden="true">{{ forloop.index }}</span>
          </div>
          <div class="lp-steps__body">
            <h3 class="lp-steps__title"><span class="visually-hidden">{{ section.settings.step_label | escape }} {{ forloop.index }}: </span>{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}<div class="lp-steps__text">{{ block.settings.text }}</div>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>

    {%- if section.settings.button_label != blank -%}
      <div class="lp-steps__foot">
        <a href="{{ section.settings.button_url | default: routes.all_products_collection_url }}" class="button button--xl lp-steps__cta">
          <span>{{ section.settings.button_label | escape }}</span>
          {% render 'lp-icon', name: 'arrow', size: 18 %}
        </a>
        {%- if section.settings.note != blank -%}<p class="lp-steps__note">{{ section.settings.note | escape }}</p>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.lp-steps { padding-block: var(--lp-section-gap); background: #fff; }
.lp-steps__head { display: grid; gap: .5rem; justify-items: center; text-align: center; margin-block-end: clamp(1.75rem, 3vw, 2.75rem); }
.lp-steps__head > * { margin: 0; }
.lp-steps__head em { font-style: normal; color: rgb(var(--lp-amber)); }
.lp-steps__list { display: grid; grid-auto-flow: column; grid-auto-columns: 78%; gap: 1rem; margin: 0 calc(var(--container-gutter, 1.25rem) * -1); padding: 0 var(--container-gutter, 1.25rem) .25rem; list-style: none; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--container-gutter, 1.25rem); scrollbar-width: none; }
.lp-steps__list::-webkit-scrollbar { display: none; }
.lp-steps__item { display: grid; align-content: start; gap: 1rem; min-width: 0; scroll-snap-align: start; }
@media (min-width: 700px) {
  .lp-steps__list { grid-auto-flow: row; grid-auto-columns: auto; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1rem, 2.2vw, 2rem); margin: 0; padding: 0; overflow: visible; }
}
.lp-steps__media { position: relative; aspect-ratio: 4 / 3; border-radius: var(--lp-radius); background: rgb(var(--lp-sand)); }
.lp-steps__img, .lp-steps__video { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover; border-radius: inherit; }
.lp-steps__video { opacity: 0; transition: opacity 300ms ease-out; pointer-events: none; }
.lp-steps__video.is-playing { opacity: 1; }
.lp-steps__num { position: absolute; left: 1rem; bottom: -1.125rem; display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 50%; background: rgb(var(--lp-amber)); color: #1F1E20; font-family: var(--heading-font-family); font-size: 1.375rem; line-height: 1; box-shadow: 0 0 0 4px #fff; }
.lp-steps__body { display: grid; gap: .4rem; padding: .75rem .25rem 0; }
.lp-steps__body > * { margin: 0; }
.lp-steps__title { font-family: var(--text-font-family); font-size: 1.1875rem; font-weight: 600; line-height: 1.3; letter-spacing: 0; text-transform: none; color: rgb(var(--lp-ink)); }
.lp-steps__text { font-size: .9375rem; line-height: 1.6; color: rgb(var(--lp-muted)); }
.lp-steps__text p { margin: 0; }
.lp-steps__foot { display: grid; gap: .75rem; justify-items: center; margin-block-start: clamp(1.75rem, 3vw, 2.5rem); text-align: center; }
.lp-steps__note { margin: 0; font-size: .8125rem; color: rgb(var(--lp-muted)); }
.lp-steps__cta svg { transition: transform var(--lp-dur-2) var(--lp-ease); }
@media (hover: hover) { .lp-steps__cta:hover svg { transform: translateX(4px); } }
{% endstylesheet %}

{% javascript %}
(() => {
  const videos = document.querySelectorAll('video[data-lp-play-once]');
  if (!videos.length || !('IntersectionObserver' in window)) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  const io = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      const video = entry.target;
      io.unobserve(video);
      video.addEventListener('playing', () => video.classList.add('is-playing'), { once: true });
      const attempt = video.play();
      if (attempt && attempt.catch) attempt.catch(() => {});
    });
  }, { threshold: 0.6 });
  videos.forEach((video) => io.observe(video));
})();
{% endjavascript %}

{% schema %}
{
  "name": "LP Home steps",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Wrap a word in <em> to colour it.", "default": "Three steps to <em>feeling good</em>" },
    { "type": "text", "id": "step_label", "label": "Step label (screen readers)", "default": "Step" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "text", "id": "note", "label": "Note under the button" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Shown first, and when motion is reduced. Use the last frame of the clip." },
        { "type": "video", "id": "video", "label": "Clip", "info": "Optional. Plays once, without sound, when the card scrolls into view." },
        { "type": "text", "id": "title", "label": "Title", "default": "Choose your routine" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "LP Home steps", "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }] }]
}
{% endschema %}
