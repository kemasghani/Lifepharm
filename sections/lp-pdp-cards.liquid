{%- liquid
  assign style = section.settings.style
  assign n = section.blocks.size
  assign cols = section.settings.columns
  if n < cols
    assign cols = n
  endif
-%}

{%- if n > 0 -%}
<section class="lp-cards lp-cards--{{ style }} lp-cards--bg-{{ section.settings.background }}">
  <div class="container">
    <header class="lp-cards__head">
      {%- if section.settings.eyebrow != blank -%}<p class="lp-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="h1 lp-cards__title">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="lp-cards__intro">{{ section.settings.text }}</div>{%- endif -%}
    </header>

    <ol class="lp-cards__list" role="list" style="--lp-cards-cols: {{ cols }}" {% if style == 'image' %}data-lp-reveal{% endif %}>
      {%- for block in section.blocks -%}
        {%- liquid
          assign lp_img = block.settings.image
          if lp_img == blank and block.settings.mf_image != blank
            assign lp_keys = block.settings.mf_image | split: ','
            for lp_key in lp_keys
              assign lp_k = lp_key | strip
              if product.metafields.custom[lp_k] != blank
                assign lp_img = product.metafields.custom[lp_k].value
                break
              endif
            endfor
          endif
          if lp_img == blank and block.settings.media_index > 0
            assign lp_mi = block.settings.media_index | minus: 1
            assign lp_img = product.media[lp_mi].preview_image
          endif
        -%}
        <li class="lp-cards__card" {{ block.shopify_attributes }}>
          {%- if style == 'image' and lp_img != blank -%}
            <div class="lp-cards__media">
              {{ lp_img | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(min-width: 1000px) 30vw, 85vw', widths: '400,600,800,1000', alt: block.settings.title }}
            </div>
          {%- endif -%}
          <div class="lp-cards__body">
            {%- case style -%}
              {%- when 'number' -%}
                <span class="lp-cards__num" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
              {%- when 'icon' -%}
                <span class="lp-cards__icon" aria-hidden="true">{% render 'lp-icon', name: block.settings.icon, size: 22 %}</span>
            {%- endcase -%}
            {%- if block.settings.label != blank -%}<span class="lp-cards__label">{{ block.settings.label | escape }}</span>{%- endif -%}
            {%- if block.settings.title != blank -%}<h3 class="lp-cards__card-title">{{ block.settings.title | escape }}</h3>{%- endif -%}
            {%- if block.settings.text != blank -%}<div class="lp-cards__text">{{ block.settings.text }}</div>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>

    {%- if section.settings.disclaimer != blank -%}
      <p class="lp-cards__disclaimer">{{ section.settings.disclaimer | escape }}</p>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% stylesheet %}
.lp-cards { padding-block: var(--lp-section-gap); }
.lp-cards--bg-sand { background: rgb(var(--lp-sand)); }
.lp-cards--bg-white { background: #fff; }
/* A tinted band closes a little tighter than it opens: its last line is a card row or a small footnote, and a full gap under that reads as empty. */
.lp-cards:is(.lp-cards--bg-sand, .lp-cards--bg-white) { padding-block-end: calc(var(--lp-section-gap) * .6); }
.lp-cards__head { display: grid; justify-items: center; gap: .9rem; text-align: center; margin-block-end: clamp(2rem, 4.5vw, 3.75rem); }
.lp-cards__title { max-width: 20ch; letter-spacing: -.02em; text-wrap: balance; text-align: center; }
.lp-cards__intro { max-width: 60ch; color: rgb(var(--lp-muted)); line-height: 1.65; }
.lp-cards__intro p { margin: 0; }

/* Mobile: one row that scrolls sideways; the next card is cut so it is clear there is more */
.lp-cards__list { display: grid; grid-auto-flow: column; grid-auto-columns: 82%; gap: 1rem; margin: 0 calc(-1 * var(--container-gutter, 20px)); padding: 0 var(--container-gutter, 20px) .5rem; list-style: none; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--container-gutter, 20px); scrollbar-width: none; overscroll-behavior-x: contain; }
.lp-cards__list::-webkit-scrollbar { display: none; }
.lp-cards__card { scroll-snap-align: start; }
@media (min-width: 700px) and (max-width: 999px) { .lp-cards__list { grid-auto-columns: 46%; } }
@media (min-width: 1000px) {
  .lp-cards__list { grid-auto-flow: row; grid-auto-columns: auto; grid-template-columns: repeat(var(--lp-cards-cols, 3), minmax(0, 1fr)); gap: clamp(1rem, 1.8vw, 1.5rem); margin: 0; padding: 0; overflow: visible; }
}

.lp-cards__card { display: grid; grid-template-rows: auto 1fr; overflow: hidden; border-radius: var(--lp-radius-lg); background: #fff; box-shadow: inset 0 0 0 1px var(--lp-hairline), var(--lp-shadow-1); }
.lp-cards--bg-white .lp-cards__card { background: rgb(var(--lp-ivory)); }
.lp-cards__media { position: relative; aspect-ratio: 4 / 3; background: rgb(var(--lp-sand)); }
.lp-cards__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
.lp-cards__body { display: grid; align-content: start; justify-items: start; gap: .6rem; padding: clamp(1.25rem, 2.2vw, 1.75rem); }
.lp-cards__num { display: grid; place-items: center; width: 44px; height: 44px; margin-block-end: .35rem; border-radius: 50%; background: rgb(var(--lp-amber) / .14); color: rgb(var(--lp-ink)); font-size: .875rem; font-weight: 800; letter-spacing: .04em; font-variant-numeric: tabular-nums; }
.lp-cards__icon { display: grid; place-items: center; width: 44px; height: 44px; margin-block-end: .35rem; border-radius: 50%; background: rgb(var(--lp-amber) / .14); color: rgb(var(--lp-amber)); }
.lp-cards__label { font-size: .75rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: rgb(var(--lp-muted)); }
.lp-cards__card-title { margin: 0; font-family: var(--text-font-family); font-size: 1.125rem; font-weight: 600; letter-spacing: -.01em; line-height: 1.3; }
.lp-cards__text { color: rgb(var(--lp-ink) / .8); font-size: .9688rem; line-height: 1.6; }
.lp-cards__text p { margin: 0; }
.lp-cards__text p + p { margin-block-start: .6rem; }
.lp-cards__disclaimer { max-width: 80ch; margin: clamp(1.5rem, 3vw, 2.25rem) auto 0; text-align: center; font-size: .75rem; line-height: 1.55; color: rgb(var(--lp-muted)); text-wrap: balance; }
{% endstylesheet %}

{% schema %}
{
  "name": "LP · PDP cards",
  "tag": "div",
  "class": "lp-pdp-section",
  "settings": [
    { "type": "select", "id": "style", "label": "Card style", "default": "image", "options": [
      { "value": "image", "label": "Image on top" }, { "value": "number", "label": "Numbered" }, { "value": "icon", "label": "Icon" }
    ] },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "select", "id": "background", "label": "Background", "default": "none", "options": [
      { "value": "none", "label": "Page (ivory)" }, { "value": "sand", "label": "Sand" }, { "value": "white", "label": "White" }
    ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Intro" },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Used by the Image on top style" },
        { "type": "text", "id": "mf_image", "label": "Or image from product metafield", "info": "Key in the custom namespace; separate several with commas" },
        { "type": "range", "id": "media_index", "label": "Or product image number", "min": 0, "max": 12, "step": 1, "default": 0 },
        { "type": "select", "id": "icon", "label": "Icon", "info": "Used by the Icon style", "default": "sparkle", "options": [
          { "value": "sparkle", "label": "Sparkle" }, { "value": "bolt", "label": "Energy" }, { "value": "heart", "label": "Heart" },
          { "value": "moon", "label": "Moon" }, { "value": "leaf", "label": "Leaf" }, { "value": "drop", "label": "Drop" },
          { "value": "cell", "label": "Cell" }, { "value": "shield", "label": "Shield" }, { "value": "flask", "label": "Flask" },
          { "value": "refresh", "label": "Refresh" }, { "value": "clock", "label": "Clock" }, { "value": "check", "label": "Check" },
          { "value": "truck", "label": "Travel" }, { "value": "star", "label": "Star" }, { "value": "dna", "label": "DNA" }
        ] },
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [ { "name": "LP · PDP cards" } ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
