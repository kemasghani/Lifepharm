{%- liquid
  assign mf = product.metafields.custom
  assign certs = mf.value_5.value | split: ','
  assign heading = section.settings.heading | default: product.title
-%}

{%- if certs.size > 0 or section.blocks.size > 0 -%}
<section class="lp-cmp">
  <div class="container">
    <div class="lp-cmp__grid">
      <div class="lp-cmp__intro">
        {%- if section.settings.eyebrow != blank -%}<p class="lp-eyebrow lp-cmp__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="h1 lp-cmp__title">{{ section.settings.prefix | escape }} <em>{{ heading }}</em> {{ section.settings.suffix | escape }}</h2>
        {%- if section.settings.text != blank -%}<div class="lp-cmp__text">{{ section.settings.text }}</div>{%- endif -%}
      </div>

      <div class="lp-cmp__table" role="table" aria-label="{{ section.settings.prefix | escape }} {{ product.title | escape }}">
        <div class="lp-cmp__row lp-cmp__row--head" role="row">
          <span role="columnheader" class="lp-cmp__feat"><span class="sr-only">{{ section.settings.feature_label | escape }}</span></span>
          <span role="columnheader" class="lp-cmp__us"><span class="lp-cmp__label lp-cmp__label--us">{{ product.title | split: ' ' | first | escape }}</span></span>
          <span role="columnheader" class="lp-cmp__them"><span class="lp-cmp__label">{{ section.settings.other_label | escape }}</span></span>
        </div>
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <div class="lp-cmp__row" role="row" {{ block.shopify_attributes }}>
              <span role="cell" class="lp-cmp__feat">{{ block.settings.feature | escape }}</span>
              <span role="cell" class="lp-cmp__us"><span class="lp-cmp__yes">{% render 'lp-icon', name: 'check', size: 14 %}<span class="sr-only">Yes</span></span></span>
              <span role="cell" class="lp-cmp__them">
                {%- if block.settings.other != blank -%}
                  <span class="lp-cmp__them-text">{{ block.settings.other | escape }}</span>
                {%- else -%}
                  <span class="lp-cmp__no" aria-hidden="true"></span><span class="sr-only">{{ section.settings.other_value | escape }}</span>
                {%- endif -%}
              </span>
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for cert in certs limit: 7 -%}
            <div class="lp-cmp__row" role="row">
              <span role="cell" class="lp-cmp__feat">{{ cert | strip | escape }}</span>
              <span role="cell" class="lp-cmp__us"><span class="lp-cmp__yes">{% render 'lp-icon', name: 'check', size: 14 %}<span class="sr-only">Yes</span></span></span>
              <span role="cell" class="lp-cmp__them"><span class="lp-cmp__no" aria-hidden="true"></span><span class="sr-only">{{ section.settings.other_value | escape }}</span></span>
            </div>
          {%- endfor -%}
          {%- if section.settings.guarantee_row != blank -%}
            <div class="lp-cmp__row" role="row">
              <span role="cell" class="lp-cmp__feat">{{ section.settings.guarantee_row | escape }}</span>
              <span role="cell" class="lp-cmp__us"><span class="lp-cmp__yes">{% render 'lp-icon', name: 'check', size: 14 %}<span class="sr-only">Yes</span></span></span>
              <span role="cell" class="lp-cmp__them"><span class="lp-cmp__no" aria-hidden="true"></span><span class="sr-only">{{ section.settings.other_value | escape }}</span></span>
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{% stylesheet %}
/* Panel: LifePharm style-guide light grey (Pantone 423 #888B8D). Text is ink for contrast (4.8:1); white is used only at heading size (3.4:1, AA large). */
.lp-cmp { --lp-cmp-bg: 136 139 141; --lp-cmp-fg: 31 30 32; position: relative; overflow: hidden; padding-block: var(--lp-section-gap); background: rgb(var(--lp-cmp-bg)); color: rgb(var(--lp-cmp-fg)); }
.lp-cmp__grid { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(1.75rem, 3.5vw, 3rem); }
.lp-cmp__intro { display: grid; gap: 1rem; max-width: 48rem; }
.lp-cmp .lp-cmp__eyebrow { color: rgb(var(--lp-cmp-fg)); }
.lp-cmp__title { color: rgb(var(--lp-cmp-fg)); letter-spacing: -.02em; text-wrap: balance; }
.lp-cmp__title em { color: #fff; }
.lp-cmp__text { color: rgb(var(--lp-cmp-fg)); line-height: 1.65; max-width: 44ch; }
.lp-cmp__table { --lp-cmp-pad: clamp(1rem, 2vw, 1.5rem); --lp-cmp-us: clamp(104px, 16vw, 148px); --lp-cmp-them: clamp(96px, 14vw, 136px); position: relative; display: grid; padding: .5rem var(--lp-cmp-pad); border-radius: var(--lp-radius-lg); background: rgb(255 255 255 / .16); border: 1px solid rgb(255 255 255 / .32); }
.lp-cmp__table::before { content: ""; position: absolute; top: .5rem; bottom: .5rem; right: calc(var(--lp-cmp-pad) + var(--lp-cmp-them)); width: var(--lp-cmp-us); border-radius: var(--lp-radius); background: rgb(var(--lp-ivory)); box-shadow: var(--lp-shadow-1); pointer-events: none; }
.lp-cmp__row { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) var(--lp-cmp-us) var(--lp-cmp-them); align-items: stretch; }
.lp-cmp__row > span { display: flex; align-items: center; min-height: 56px; }
.lp-cmp__row:not(:last-child) > .lp-cmp__feat, .lp-cmp__row:not(:last-child) > .lp-cmp__them { border-bottom: 1px solid rgb(var(--lp-cmp-fg) / .14); }
.lp-cmp__row--head > span { min-height: 52px; }
.lp-cmp__feat { padding-block: .75rem; padding-inline-end: 1rem; font-size: .9375rem; font-weight: 500; line-height: 1.35; color: rgb(var(--lp-cmp-fg)); text-wrap: pretty; }
.lp-cmp__us, .lp-cmp__them { justify-content: center; text-align: center; }
.lp-cmp__label { font-size: .6875rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; line-height: 1.25; color: rgb(var(--lp-cmp-fg)); }
.lp-cmp__label--us { color: rgb(var(--lp-amber-deep)); }
.lp-cmp__them-text { font-size: .8125rem; color: rgb(var(--lp-cmp-fg)); }
.lp-cmp__yes { display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: rgb(var(--lp-amber)); color: #1f1e20; }
.lp-cmp__yes .lp-icon { stroke-width: 2.6; }
.lp-cmp__no { position: relative; display: inline-block; width: 26px; height: 26px; border-radius: 50%; box-shadow: inset 0 0 0 1.5px rgb(var(--lp-cmp-fg) / .4); }
.lp-cmp__no::before { content: ""; position: absolute; inset: 50% auto auto 50%; width: 10px; height: 1.5px; border-radius: 1px; background: rgb(var(--lp-cmp-fg) / .7); transform: translate(-50%, -50%); }
@media (max-width: 699px) {
  .lp-cmp__table { --lp-cmp-pad: 1rem; --lp-cmp-us: 84px; --lp-cmp-them: 68px; }
  .lp-cmp__row > span { min-height: 50px; }
  .lp-cmp__row--head > span { min-height: 48px; }
  .lp-cmp__feat { font-size: .875rem; padding-inline-end: .75rem; }
  .lp-cmp__label { font-size: .625rem; letter-spacing: .08em; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "LP · PDP comparison",
  "tag": "div",
  "class": "lp-pdp-section",
  "settings": [
    { "type": "paragraph", "content": "Rows are built from the product's Certifications metafield. Add blocks to write custom rows instead." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A higher standard" },
    { "type": "text", "id": "prefix", "label": "Heading before product name", "default": "How" },
    { "type": "inline_richtext", "id": "heading", "label": "Product name override" },
    { "type": "text", "id": "suffix", "label": "Heading after product name", "default": "compares" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Held to standards many brands never publish, and backed by our 60-day money-back guarantee.</p>" },
    { "type": "text", "id": "feature_label", "label": "Feature column label", "default": "Feature" },
    { "type": "text", "id": "other_label", "label": "Comparison column label", "default": "Typical brands" },
    { "type": "text", "id": "other_value", "label": "Comparison value", "default": "Not always" },
    { "type": "text", "id": "guarantee_row", "label": "Extra row", "default": "60-day money-back guarantee" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature" },
        { "type": "text", "id": "other", "label": "Comparison value" }
      ]
    }
  ],
  "presets": [ { "name": "LP · PDP comparison" } ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
