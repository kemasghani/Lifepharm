{%- liquid
  assign mf = product.metafields.custom
  assign bg_image = section.settings.image | default: mf.image_benefits.value
  if bg_image == blank and product.media.size > 2
    assign bg_image = product.media[2].preview_image
  endif
  assign heading = section.settings.heading
  assign icons = 'sparkle,dna,heart,moon,leaf,bolt' | split: ','
  assign benefits_html = mf.text_benefits | metafield_tag | replace: ' — ', ', ' | replace: '—', ', '
  assign benefit_items = benefits_html | split: '<li'
  assign show_disclaimer = false
  if benefits_html contains '*'
    assign show_disclaimer = true
  endif
-%}

{%- if section.blocks.size > 0 or benefit_items.size > 1 -%}
<section class="lp-hl">
  <div class="container">
    <div class="lp-hl__grid{% if bg_image == blank %} lp-hl__grid--solo{% endif %}">
      {%- if bg_image != blank -%}
        <div class="lp-hl__media" data-lp-reveal>
          {{ bg_image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(min-width: 1000px) 40vw, 100vw', widths: '600,800,1000,1200,1600', class: 'lp-hl__img', alt: '' }}
        </div>
      {%- endif -%}

      <div class="lp-hl__content">
        <header class="lp-hl__head">
          {%- if section.settings.eyebrow != blank -%}<p class="lp-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
          {%- if heading != blank -%}<h2 class="h1 lp-hl__title">{{ heading }}</h2>{%- endif -%}
        </header>

        <ul class="lp-hl__cards" role="list">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              <li class="lp-hl__card" {{ block.shopify_attributes }}>
                <span class="lp-hl__icon" aria-hidden="true">{% render 'lp-icon', name: block.settings.icon, size: 22 %}</span>
                <div class="lp-hl__card-body">
                  {%- if block.settings.title != blank -%}<h3 class="lp-hl__card-title">{{ block.settings.title | escape }}</h3>{%- endif -%}
                  {%- if block.settings.text != blank -%}<p class="lp-hl__card-text">{{ block.settings.text | escape }}</p>{%- endif -%}
                </div>
              </li>
            {%- endfor -%}
          {%- else -%}
            {%- for raw in benefit_items offset: 1 limit: 4 -%}
              {%- liquid
                assign item = raw | prepend: '<li' | split: '</li>' | first
                assign card_title = ''
                if item contains '<strong>'
                  assign card_title = item | split: '<strong>' | last | split: '</strong>' | first | strip_html | remove: ':' | strip
                  assign card_text = item | split: '</strong>' | last | strip_html | remove_first: ':' | strip
                else
                  assign card_text = item | strip_html | strip
                endif
                assign icon_index = forloop.index0
              -%}
              <li class="lp-hl__card">
                <span class="lp-hl__icon" aria-hidden="true">{% render 'lp-icon', name: icons[icon_index], size: 22 %}</span>
                <div class="lp-hl__card-body">
                  {%- if card_title != blank -%}<h3 class="lp-hl__card-title">{{ card_title }}</h3>{%- endif -%}
                  <p class="lp-hl__card-text">{{ card_text | truncatewords: 26 }}</p>
                </div>
              </li>
            {%- endfor -%}
          {%- endif -%}
        </ul>

        {%- if show_disclaimer and section.settings.disclaimer != blank -%}
          <p class="lp-hl__disclaimer">{{ section.settings.disclaimer | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{% stylesheet %}
.lp-hl { padding-block: var(--lp-section-gap); }
.lp-hl__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 4.5rem); align-items: center; }
@media (min-width: 1000px) { .lp-hl__grid { grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); } .lp-hl__grid--solo { grid-template-columns: minmax(0, 1fr); } }
.lp-hl__media { overflow: hidden; border-radius: var(--lp-radius-lg); aspect-ratio: 16 / 10; background: rgb(var(--lp-sand)); }
@media (min-width: 1000px) { .lp-hl__media { aspect-ratio: 4 / 5; } }
.lp-hl__img { display: block; width: 100%; height: 100%; object-fit: cover; }
.lp-hl__content { display: grid; gap: clamp(1.25rem, 2.5vw, 2rem); }
.lp-hl__head { display: grid; gap: .75rem; }
.lp-hl__title { max-width: 18ch; letter-spacing: -.02em; text-wrap: balance; }
.lp-hl__cards { display: grid; grid-template-columns: minmax(0, 1fr); gap: .75rem; margin: 0; padding: 0; list-style: none; }
@media (min-width: 700px) { .lp-hl__cards { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; } }
.lp-hl__card { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 1rem; align-items: start; padding: 1.15rem 1.25rem; border: 1px solid var(--lp-hairline); border-radius: var(--lp-radius); background: #fff; }
.lp-hl__icon { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: rgb(var(--lp-amber) / .14); color: rgb(var(--lp-amber-deep)); }
.lp-hl__card-body { display: grid; gap: .3rem; padding-block-start: .15rem; }
.lp-hl__card-title { margin: 0; font-family: var(--text-font-family); font-size: 1rem; font-weight: 600; letter-spacing: -.01em; line-height: 1.35; }
.lp-hl__card-text { margin: 0; color: rgb(var(--lp-ink) / .78); font-size: .9375rem; line-height: 1.55; }
.lp-hl__disclaimer { margin: 0; font-size: .75rem; line-height: 1.5; color: rgb(var(--lp-muted)); max-width: 70ch; }
{% endstylesheet %}

{% schema %}
{
  "name": "LP · PDP highlights",
  "tag": "div",
  "class": "lp-pdp-section",
  "settings": [
    { "type": "paragraph", "content": "Cards are filled from the product's Benefits metafield. Add blocks to write custom cards instead." },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to the product's benefits image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Support that works with your body, not against it." },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer", "default": "*These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease." }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "sparkle", "options": [
          { "value": "sparkle", "label": "Sparkle" }, { "value": "dna", "label": "DNA" }, { "value": "heart", "label": "Heart" },
          { "value": "moon", "label": "Moon" }, { "value": "leaf", "label": "Leaf" }, { "value": "bolt", "label": "Energy" },
          { "value": "drop", "label": "Drop" }, { "value": "cell", "label": "Cell" }, { "value": "shield", "label": "Shield" }, { "value": "flask", "label": "Flask" }
        ] },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [ { "name": "LP · PDP highlights" } ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
