{%- liquid
  assign mf = product.metafields.custom
  assign side_image = section.settings.image | default: mf.image_ingredients.value
  if side_image == blank
    assign side_image = product.featured_media.preview_image
  endif
  assign heading = section.settings.heading
  if heading == blank
    assign heading = mf.header_6.value | strip
    assign heading_up = heading | upcase
    if heading == heading_up
      assign heading = heading | downcase | capitalize
    endif
  endif
  assign desc_html = mf.product_description | metafield_tag | replace: ' — ', ', ' | replace: '—', ', '
  assign desc_paras = desc_html | split: '</p>'
  assign concerns = mf.health_concern_filter.value
-%}

<section class="lp-how">
  <div class="container">
    <div class="lp-how__frame{% if side_image == blank %} lp-how__frame--solo{% endif %}" data-lp-edge-bg>
      <div class="lp-how__copy">
        {%- if section.settings.eyebrow != blank -%}<p class="lp-eyebrow lp-how__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if heading != blank -%}<h2 class="h1 lp-how__title">{{ heading }}</h2>{%- endif -%}

        <div class="lp-how__text">
          {%- if section.settings.text != blank -%}
            {{ section.settings.text }}
          {%- else -%}
            {%- assign first_para = desc_paras | first | split: '<p' | last | remove_first: '>' -%}<p>{{ first_para }}</p>
          {%- endif -%}
        </div>

        {%- if concerns != blank -%}
          <div class="lp-how__supports">
            <span class="lp-how__supports-label">{{ section.settings.supports_label | escape }}</span>
            <ul class="lp-how__chips" role="list">
              {%- for c in concerns -%}
                {%- assign c_label = c | replace: 'Joint pain', 'Joint comfort' | replace: 'Joint Pain', 'Joint comfort' | replace: 'joint pain', 'joint comfort' -%}
                <li class="lp-how__chip">{{ c_label | escape }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if section.settings.link_label != blank -%}
          <a href="#lp-formula" class="lp-how__link">{{ section.settings.link_label | escape }}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        {%- endif -%}
      </div>

      {%- if side_image != blank -%}
        <div class="lp-how__media">
          {{ side_image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 1000px) 45vw, 100vw', widths: '500,700,900,1100,1400', class: 'lp-how__img', alt: side_image.alt | default: product.title }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
.lp-how { padding-block: clamp(1rem, 2vw, 1.5rem) var(--lp-section-gap); }
.lp-how__frame { --lp-how-bg: rgb(var(--lp-sand)); --lp-how-fg: 31 30 32; position: relative; overflow: hidden; display: grid; grid-template-columns: minmax(0, 1fr); border-radius: var(--lp-radius-lg); background: var(--lp-how-bg); color: rgb(var(--lp-how-fg)); transition: background-color 400ms ease-out; }
.lp-how__frame[data-tone="dark"] { --lp-how-fg: 255 255 255; }
@media (min-width: 1000px) { .lp-how__frame { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); min-height: clamp(520px, 44vw, 660px); } .lp-how__frame--solo { grid-template-columns: minmax(0, 1fr); min-height: 0; } }
.lp-how__copy { position: relative; z-index: 1; display: grid; align-content: center; justify-items: start; gap: 1.1rem; padding: clamp(1.75rem, 4.5vw, 4.5rem); }
.lp-how .lp-how__eyebrow { color: rgb(var(--lp-how-fg) / .78); }
.lp-how .lp-how__title { max-width: 16ch; color: rgb(var(--lp-how-fg)); letter-spacing: -.02em; text-wrap: balance; }
.lp-how__text { max-width: 46ch; color: rgb(var(--lp-how-fg) / .88); font-size: 1rem; line-height: 1.65; }
.lp-how__text p { margin: 0; }
.lp-how__supports { display: grid; gap: .6rem; }
.lp-how__supports-label { font-size: .75rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: rgb(var(--lp-how-fg) / .78); }
.lp-how__chips { display: flex; flex-wrap: wrap; gap: .4rem; margin: 0; padding: 0; list-style: none; }
.lp-how__chip { padding: .4rem .85rem; border-radius: 999px; border: 1px solid rgb(var(--lp-how-fg) / .35); color: rgb(var(--lp-how-fg)); font-size: .8125rem; font-weight: 600; }
.lp-how__link { display: inline-flex; align-items: center; gap: .4rem; min-height: 44px; color: rgb(var(--lp-how-fg)); font-weight: 600; font-size: .9375rem; text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1.5px; }
.lp-how__link svg { transition: transform 200ms ease-out; }
.lp-how__link:hover svg { transform: translateX(4px); }
.lp-how__media { position: relative; order: -1; aspect-ratio: 4 / 3; }
@media (min-width: 1000px) { .lp-how__media { order: 0; aspect-ratio: auto; } }
.lp-how__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; }
@media (min-width: 1000px) { .lp-how__img { object-fit: contain; object-position: right center; } }
@media (max-width: 699px) { .lp-how .lp-how__title { font-size: clamp(1.75rem, 8.4vw, 2.25rem); overflow-wrap: normal; hyphens: none; } .lp-how__copy { padding-block-start: .5rem; } }
{% endstylesheet %}

{% schema %}
{
  "name": "LP · PDP how it works",
  "tag": "div",
  "class": "lp-pdp-section",
  "settings": [
    { "type": "paragraph", "content": "Heading, text and 'Supports' chips are filled from the product's metafields. Fill a field to override. The panel colour is matched to the edge of the image automatically." },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to the product's ingredients image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it works" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "supports_label", "label": "Supports label", "default": "Supports" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "See what’s inside" }
  ],
  "presets": [ { "name": "LP · PDP how it works" } ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
