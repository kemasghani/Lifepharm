{%- liquid
  assign mf = product.metafields.custom
  assign phases = '1,2,3' | split: ','
  assign has_phase = false
  assign phase_count = 0
  for n in phases
    assign content_key = 'phase_' | append: n | append: '_content'
    if mf[content_key] != blank
      assign phase_count = phase_count | plus: 1
    endif
  endfor
  if phase_count > 0
    assign has_phase = true
  endif
  assign last_k = phase_count | minus: 1
-%}

{%- if has_phase -%}
<section class="lp-tl">
  <div class="container">
    <header class="lp-tl__head">
      {%- if section.settings.eyebrow != blank -%}<p class="lp-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="h1 lp-tl__title">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<p class="lp-tl__sub">{{ section.settings.subheading | escape }}</p>{%- endif -%}
    </header>

    <ol class="lp-tl__cols" role="list" style="--lp-tl-n: {{ phase_count }}">
      {%- for n in phases -%}
        {%- liquid
          assign content_key = 'phase_' | append: n | append: '_content'
          assign heading_key = 'phase_' | append: n | append: '_heading'
          assign label_key = 'phase_' | append: n | append: '_nav_label'
          assign image_key = 'phase_' | append: n | append: '_image'
          assign p_content = mf[content_key]
          if p_content == blank
            continue
          endif
          assign p_heading = mf[heading_key].value | split: '<p' | first | strip_html | strip
          assign p_label = mf[label_key].value | default: p_heading
          assign p_image = mf[image_key].value
          if p_image == blank
            assign media_index = forloop.index | plus: 2
            assign p_image = product.media[media_index].preview_image
          endif
        -%}
        <li class="lp-tl__card">
          {%- if p_image != blank -%}
            <div class="lp-tl__card-media">
              {{ p_image | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(min-width: 1000px) 30vw, 100vw', widths: '400,600,800,1000', alt: '' }}
            </div>
          {%- endif -%}
          <div class="lp-tl__card-body">
            <span class="lp-tl__card-label">{{ p_label | escape }}</span>
            {%- capture panel_id -%}lp-tl-{{ section.id }}-{{ n }}{%- endcapture -%}
            <h3 class="lp-tl__panel-title">
              <button type="button" class="lp-tl__toggle" aria-expanded="false" aria-controls="{{ panel_id }}" data-lp-tl-toggle>
                <span class="lp-tl__toggle-text">{% if p_heading != blank and p_heading != p_label %}{{ p_heading | downcase | escape }}{% else %}{{ p_label | escape }}{% endif %}</span>
                <span class="lp-tl__chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span>
              </button>
            </h3>
            <div class="lp-tl__panel" id="{{ panel_id }}">
              <div class="lp-tl__panel-inner">
                <div class="lp-tl__item-text">{{ p_content | metafield_tag | replace: ' — ', ', ' | replace: '—', ', ' }}</div>
              </div>
            </div>
          </div>
        </li>
      {%- endfor -%}
    </ol>

  </div>
</section>
{%- endif -%}

{% stylesheet %}
.lp-tl { padding-block: 0 var(--lp-section-gap); }
.lp-tl__head { display: grid; justify-items: center; gap: .9rem; text-align: center; margin-block-end: clamp(2.5rem, 5vw, 4.5rem); }
.lp-tl__title { max-width: 18ch; letter-spacing: -.02em; text-wrap: balance; text-align: center; }
.lp-tl__sub { color: rgb(var(--lp-muted)); margin: 0; }
.lp-tl__cols { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(1rem, 2vw, 1.5rem); margin: 0 0 clamp(1.25rem, 2.5vw, 2rem); padding: 0; list-style: none; }
@media (min-width: 1000px) { .lp-tl__cols { grid-template-columns: repeat(var(--lp-tl-n, 3), minmax(0, 1fr)); } }
.lp-tl__card { display: grid; grid-template-rows: auto 1fr; overflow: hidden; border-radius: var(--lp-radius-lg); background: #fff; box-shadow: inset 0 0 0 1px var(--lp-hairline), var(--lp-shadow-1); }
.lp-tl__card-media { position: relative; aspect-ratio: 4 / 3; background: rgb(var(--lp-sand)); }
.lp-tl__card-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
.lp-tl__card-body { display: grid; align-content: start; justify-items: start; gap: .7rem; padding: clamp(1.1rem, 2vw, 1.5rem); }
.lp-tl__card-label { padding: .3rem .8rem; border-radius: 999px; background: rgb(var(--lp-ink)); color: #fff; font-size: .8125rem; font-weight: 600; line-height: 1.25; }
.lp-tl__panel-title { justify-self: stretch; margin: 0; font-family: var(--text-font-family); font-size: 1.125rem; font-weight: 600; letter-spacing: -.01em; text-transform: capitalize; }
.lp-tl__item-text { color: rgb(var(--lp-ink)); line-height: 1.65; font-size: 1rem; }
.lp-tl__item-text p { margin: 0; }
.lp-tl__item-text p + p { margin-block-start: .75rem; }
/* Description dropdown: the title row is the button; the panel opens with a height (0fr to 1fr) and fade transition */
.lp-tl__card { align-self: start; }
.lp-tl__toggle { display: flex; align-items: center; justify-content: space-between; gap: 1rem; width: 100%; min-height: 44px; margin: -.25rem 0; padding: .25rem 0; border: 0; background: none; color: rgb(var(--lp-ink)); font: inherit; text-align: start; text-transform: inherit; letter-spacing: inherit; cursor: pointer; -webkit-tap-highlight-color: transparent; }
.lp-tl__toggle:focus-visible { outline: 2px solid rgb(var(--lp-amber-deep)); outline-offset: 4px; border-radius: 6px; }
.lp-tl__chev { flex: none; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: rgb(var(--lp-sand)); color: rgb(var(--lp-ink)); transition: transform 320ms cubic-bezier(.16, 1, .3, 1), background-color 200ms ease-out, color 200ms ease-out; }
@media (hover: hover) { .lp-tl__toggle:hover .lp-tl__chev { background: rgb(var(--lp-amber) / .18); } }
.lp-tl__toggle[aria-expanded="true"] .lp-tl__chev { transform: rotate(180deg); background: rgb(var(--lp-amber)); color: #1f1e20; }
.lp-tl__panel { display: grid; grid-template-rows: 0fr; justify-self: stretch; margin-block-start: -.7rem; visibility: hidden; transition: grid-template-rows 360ms cubic-bezier(.16, 1, .3, 1), margin-block-start 360ms cubic-bezier(.16, 1, .3, 1), visibility 0s linear 360ms; }
.lp-tl__panel-inner { min-height: 0; overflow: hidden; }
.lp-tl__panel .lp-tl__item-text { padding-block-start: .15rem; opacity: 0; transform: translateY(-6px); transition: opacity 220ms ease-out, transform 360ms cubic-bezier(.16, 1, .3, 1); }
.lp-tl__panel.is-open { grid-template-rows: 1fr; margin-block-start: 0; visibility: visible; transition: grid-template-rows 360ms cubic-bezier(.16, 1, .3, 1), margin-block-start 360ms cubic-bezier(.16, 1, .3, 1), visibility 0s; }
.lp-tl__panel.is-open .lp-tl__item-text { opacity: 1; transform: none; transition-delay: 60ms; }
@media (prefers-reduced-motion: reduce) {
  .lp-tl__panel, .lp-tl__panel .lp-tl__item-text, .lp-tl__chev { transition: none !important; }
}
{% endstylesheet %}

<script>
  (() => {
    if (window.lpTlToggle) return;
    window.lpTlToggle = true;
    document.addEventListener('click', (event) => {
      const button = event.target.closest('[data-lp-tl-toggle]');
      if (!button) return;
      const panel = document.getElementById(button.getAttribute('aria-controls'));
      if (!panel) return;
      const open = button.getAttribute('aria-expanded') !== 'true';
      button.setAttribute('aria-expanded', String(open));
      panel.classList.toggle('is-open', open);
    });
  })();
</script>

{% schema %}
{
  "name": "LP · PDP results timeline",
  "tag": "div",
  "class": "lp-pdp-section",
  "settings": [
    { "type": "paragraph", "content": "Phases and images come from the product's timeline metafields (phase 1 to 3). How to Use lives in the buy-box accordion." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What to expect" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Benefits that <em>build over time</em>" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Take it daily and the benefits build. Here’s what to look for, and when." },
    { "type": "text", "id": "next_label", "label": "Next step label", "default": "What comes next" }
  ],
  "presets": [ { "name": "LP · PDP results timeline" } ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
