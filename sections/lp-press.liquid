{%- if section.blocks.size > 0 -%}
<section class="lp-press" aria-label="{{ section.settings.label | escape }}">
  <div class="container">
    {%- if section.settings.label != blank -%}<p class="lp-eyebrow lp-press__label">{{ section.settings.label | escape }}</p>{%- endif -%}
    <ul class="lp-press__list" role="list">
      {%- for block in section.blocks -%}
        <li class="lp-press__item" {{ block.shopify_attributes }}>
          {%- if block.settings.logo != blank -%}
            {%- capture logo -%}{{ block.settings.logo | image_url: width: 320 | image_tag: loading: 'lazy', class: 'lp-press__logo', alt: block.settings.logo.alt | default: block.settings.name, widths: '160,240,320', sizes: '160px' }}{%- endcapture -%}
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" target="_blank" rel="noopener">{{ logo }}</a>{%- else -%}{{ logo }}{%- endif -%}
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}

{% stylesheet %}
.lp-press { padding-block: clamp(1.25rem, 3vw, 2.25rem); border-block: 1px solid var(--lp-hairline); background: #fff; }
.lp-press__label { margin: 0 0 1rem; text-align: center; color: rgb(var(--lp-muted)); }
.lp-press__list { display: flex; align-items: center; gap: clamp(1.75rem, 5vw, 4.5rem); margin: 0 calc(-1 * var(--container-gutter, 1rem)); padding: 0 var(--container-gutter, 1rem); list-style: none; overflow-x: auto; scrollbar-width: none; scroll-snap-type: x proximity; }
.lp-press__list::-webkit-scrollbar { display: none; }
@media (min-width: 1000px) { .lp-press__list { justify-content: center; overflow: visible; margin: 0; padding: 0; } }
.lp-press__item { flex: none; scroll-snap-align: start; }
.lp-press__logo { display: block; width: auto; height: clamp(26px, 3vw, 36px); max-width: 160px; object-fit: contain; filter: grayscale(1) contrast(1.15); mix-blend-mode: multiply; opacity: .78; transition: opacity 200ms ease-out; }
.lp-press__item a:hover .lp-press__logo { opacity: 1; }
{% endstylesheet %}

{% schema %}
{
  "name": "LP · Press logos",
  "tag": "div",
  "class": "lp-home-section",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "As featured in" }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "limit": 10,
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo" },
        { "type": "text", "id": "name", "label": "Publication name" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [ { "name": "LP · Press logos" } ]
}
{% endschema %}
