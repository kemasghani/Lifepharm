<section class="lp-sci-ch" id="{{ section.settings.anchor | default: 'how-it-works' | handleize }}" aria-labelledby="lp-sci-ch-{{ section.id }}">
  <div class="container">
    <header class="lp-sci-ch__head">
      {%- if section.settings.eyebrow != blank -%}<p class="lp-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 id="lp-sci-ch-{{ section.id }}" class="h1 lp-sci-ch__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="lp-sci-ch__intro">{{ section.settings.text }}</div>{%- endif -%}
    </header>

    <lp-sci-steps class="lp-sci-ch__body">
      <div class="lp-sci-ch__stage" aria-hidden="true">
        <div class="lp-sci-ch__frame">
          {%- for block in section.blocks -%}
            {%- if block.settings.image != blank -%}
              <img class="lp-sci-ch__stage-img" data-stage="{{ forloop.index0 }}" src="{{ block.settings.image | image_url: width: 1200 }}" srcset="{{ block.settings.image | image_url: width: 700 }} 700w, {{ block.settings.image | image_url: width: 1200 }} 1200w" sizes="(min-width: 1000px) 44vw, 1px" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy" alt="">
            {%- endif -%}
          {%- endfor -%}
          <span class="lp-sci-ch__counter"><span data-current>01</span> / {{ section.blocks.size | prepend: '0' | slice: -2, 2 }}</span>
        </div>
      </div>

      <ol class="lp-sci-ch__list" role="list">
        {%- for block in section.blocks -%}
          <li class="lp-sci-ch__item" data-step="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <span class="lp-sci-ch__num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <div class="lp-sci-ch__copy">
              {%- if block.settings.image != blank -%}
                <div class="lp-sci-ch__media">
                  {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(min-width: 1000px) 1px, 100vw', widths: '500,800,1000', class: 'lp-sci-ch__img', alt: block.settings.image.alt | default: '' }}
                </div>
              {%- endif -%}
              <h3 class="lp-sci-ch__item-title">{{ block.settings.title | escape }}</h3>
              <div class="lp-sci-ch__text">{{ block.settings.text }}</div>
            </div>
          </li>
        {%- endfor -%}
      </ol>
    </lp-sci-steps>
  </div>
</section>

<script>
  if (!customElements.get('lp-sci-steps')) {
    customElements.define('lp-sci-steps', class extends HTMLElement {
      connectedCallback() {
        this.steps = [...this.querySelectorAll('[data-step]')];
        this.imgs = [...this.querySelectorAll('[data-stage]')];
        this.current = this.querySelector('[data-current]');
        this.set(0);
        if (!('IntersectionObserver' in window)) return;
        this.io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) this.set(Number(e.target.dataset.step)); });
        }, { rootMargin: '-45% 0px -45% 0px' });
        this.steps.forEach((s) => this.io.observe(s));
      }
      disconnectedCallback() { if (this.io) this.io.disconnect(); }
      set(i) {
        this.steps.forEach((s, n) => s.classList.toggle('is-active', n === i));
        this.imgs.forEach((img) => img.classList.toggle('is-active', Number(img.dataset.stage) === i));
        if (this.current) this.current.textContent = String(i + 1).padStart(2, '0');
      }
    });
  }
</script>

{% stylesheet %}
.lp-sci-ch { padding-block: var(--lp-section-gap); background: rgb(var(--lp-sand)); scroll-margin-top: calc(var(--sticky-area-height, 80px) + 16px); }
.lp-sci-ch__head { display: grid; gap: 1rem; max-width: 46rem; margin-bottom: clamp(2rem, 5vw, 4rem); }
.lp-sci-ch__title { margin: 0; color: rgb(var(--lp-ink)); }
.lp-sci-ch__title em { font-style: normal; color: rgb(var(--lp-amber-deep)); }
.lp-sci-ch__intro { font-size: 1.0625rem; line-height: 1.65; color: rgb(var(--lp-ink)); max-width: 52ch; }
.lp-sci-ch__intro p { margin: 0; }
.lp-sci-ch__body { display: block; }
.lp-sci-ch__stage { display: none; }
.lp-sci-ch__list { display: grid; gap: clamp(2.25rem, 6vw, 3rem); margin: 0; padding: 0; list-style: none; }
.lp-sci-ch__item { display: grid; grid-template-columns: minmax(0, 1fr); gap: .75rem; }
.lp-sci-ch__num { font-family: var(--lp-serif); font-size: clamp(2.25rem, 4vw, 3.25rem); line-height: 1; color: rgb(var(--lp-amber-deep)); }
.lp-sci-ch__copy { display: grid; gap: .8rem; }
.lp-sci-ch__media { position: relative; overflow: hidden; aspect-ratio: 4 / 3; margin-bottom: .4rem; border-radius: var(--lp-radius-lg); background: rgb(var(--lp-stone)); }
.lp-sci-ch__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.lp-sci-ch__item-title { margin: 0; font-size: clamp(1.375rem, 2.4vw, 2rem); letter-spacing: -.015em; color: rgb(var(--lp-ink)); }
.lp-sci-ch__text { max-width: 46ch; font-size: 1.0625rem; line-height: 1.7; color: rgb(var(--lp-ink)); }
.lp-sci-ch__text p { margin: 0 0 .75rem; }
.lp-sci-ch__text p:last-child { margin-bottom: 0; }
.lp-sci-ch__text ul { display: grid; gap: .55rem; margin: .5rem 0 0; padding: 0; list-style: none; }
.lp-sci-ch__text li { position: relative; padding-left: 1.7rem; font-weight: 500; }
.lp-sci-ch__text li::before { content: ""; position: absolute; left: 0; top: .5em; width: 14px; height: 8px; border-left: 2px solid rgb(var(--lp-amber-deep)); border-bottom: 2px solid rgb(var(--lp-amber-deep)); transform: rotate(-45deg); }
@media (min-width: 1000px) {
  .lp-sci-ch__body { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(3rem, 6vw, 6rem); align-items: start; }
  .lp-sci-ch__stage { display: block; position: sticky; top: calc(var(--sticky-area-height, 80px) + 24px); }
  .lp-sci-ch__frame { position: relative; overflow: hidden; aspect-ratio: 1 / 1.05; max-height: calc(100vh - var(--sticky-area-height, 80px) - 48px); width: 100%; border-radius: var(--lp-radius-lg); background: rgb(var(--lp-stone)); }
  .lp-sci-ch__stage-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 500ms ease-out; }
  .lp-sci-ch__stage-img.is-active, .lp-sci-ch__stage-img:first-child:not(.is-active):only-child { opacity: 1; }
  .lp-sci-ch__counter { position: absolute; left: 1rem; bottom: 1rem; padding: .4rem .75rem; border-radius: 999px; background: rgb(255 255 255 / .94); font-size: .75rem; font-weight: 800; letter-spacing: .1em; color: rgb(var(--lp-ink)); font-variant-numeric: tabular-nums; }
  .lp-sci-ch__media { display: none; }
  .lp-sci-ch__list { gap: 0; }
  .lp-sci-ch__item { grid-template-columns: 5.5rem minmax(0, 1fr); gap: 0; min-height: 62vh; align-content: center; padding-block: 2.5rem; border-top: 1px solid rgb(var(--lp-ink) / .14); }
  .lp-sci-ch__item:last-child { border-bottom: 1px solid rgb(var(--lp-ink) / .14); }
  .lp-sci-ch__num { color: rgb(var(--lp-ink) / .3); transition: color 300ms ease-out; }
  .lp-sci-ch__item.is-active .lp-sci-ch__num { color: rgb(var(--lp-amber-deep)); }
  lp-sci-steps:not(:defined) .lp-sci-ch__stage-img:first-of-type { opacity: 1; }
}
@media (prefers-reduced-motion: reduce) { .lp-sci-ch__stage-img, .lp-sci-ch__num { transition: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "LP · Science chapters",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "how-it-works" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it works" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "From egg to <em>renewal</em>" },
    { "type": "richtext", "id": "text", "label": "Intro" }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "Chapter",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Chapter title" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [ { "name": "LP · Science chapters" } ],
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
