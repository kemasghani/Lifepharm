{%- comment -%} Science page top, after Dropbox "LifePharm_Science_Page-Desktop.jpg": full-bleed hero + orange proof band. {%- endcomment -%}
<section class="lp-sci-hero" aria-labelledby="lp-sci-hero-{{ section.id }}">
  <div class="lp-sci-hero__stage">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 1000px) 62vw, 100vw', widths: '600,900,1200,1500,1800', class: 'lp-sci-hero__img', alt: section.settings.image.alt | default: section.settings.image_alt }}
    {%- endif -%}
    <div class="container lp-sci-hero__inner">
      <div class="lp-sci-hero__copy">
        {%- if section.settings.eyebrow != blank -%}<p class="lp-sci-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h1 id="lp-sci-hero-{{ section.id }}" class="h0 lp-sci-hero__title">{{ section.settings.heading }}</h1>
        {%- if section.settings.text != blank -%}<div class="lp-sci-hero__text">{{ section.settings.text }}</div>{%- endif -%}
        <nav class="lp-sci-hero__jump" aria-label="{{ section.settings.jump_label | escape }}">
          {%- if section.settings.link_1_label != blank -%}<a class="button button--primary lp-sci-hero__btn" href="{{ section.settings.link_1_url }}">{{ section.settings.link_1_label | escape }}</a>{%- endif -%}
          {%- if section.settings.link_2_label != blank -%}<a class="lp-sci-hero__link" href="{{ section.settings.link_2_url }}">{{ section.settings.link_2_label | escape }}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg></a>{%- endif -%}
        </nav>
      </div>
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="lp-sci-hero__band">
      <ul class="container lp-sci-hero__facts" role="list">
        {%- for block in section.blocks -%}
          <li class="lp-sci-hero__fact" {{ block.shopify_attributes }}>{{ block.settings.value | escape }} {{ block.settings.label | escape }}</li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
.lp-sci-hero { background: rgb(var(--lp-ivory)); }
.lp-sci-hero__stage { position: relative; overflow: hidden; display: grid; background: linear-gradient(180deg, #e3edec 0%, #f0f9f8 100%); }
.lp-sci-hero__img { display: block; width: 100%; height: auto; aspect-ratio: 1100 / 780; object-fit: cover; object-position: center bottom; }
.lp-sci-hero__inner { position: relative; padding-block: 1.75rem 2.25rem; }
.lp-sci-hero__copy { display: grid; gap: 1rem; justify-items: start; max-width: 38rem; }
.lp-sci-hero__eyebrow { margin: 0; font-size: clamp(.8125rem, 1.1vw, 1rem); font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: #1f1e20; }
.lp-sci-hero .lp-sci-hero__title { margin: 0; max-width: 14ch; font-size: clamp(2.5rem, 4.6vw, 4.25rem); line-height: 1.04 !important; color: #1f1e20; overflow-wrap: normal; hyphens: none; }
.lp-sci-hero__title em { font-style: normal; color: rgb(var(--lp-amber-deep)); }
.lp-sci-hero__text { max-width: 40ch; font-size: clamp(1rem, 1.2vw, 1.125rem); line-height: 1.6; color: #1f1e20; }
.lp-sci-hero__text p { margin: 0; }
.lp-sci-hero__jump { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1.75rem; margin-top: .5rem; }
.lp-sci-hero .lp-sci-hero__btn { border-radius: 999px; text-transform: uppercase; letter-spacing: .04em; white-space: nowrap; }
.lp-sci-hero__link { display: inline-flex; align-items: center; gap: .4rem; min-height: 44px; font-weight: 600; color: #1f1e20; text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1.5px; }
.lp-sci-hero__band { background: rgb(var(--lp-amber)); color: #1f1e20; }
.lp-sci-hero__facts { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: .35rem 0; margin: 0 auto; padding-block: .9rem; list-style: none; }
.lp-sci-hero__fact { font-size: clamp(.8125rem, 1.25vw, 1.0625rem); font-weight: 800; letter-spacing: .03em; text-transform: uppercase; text-align: center; }
.lp-sci-hero__fact + .lp-sci-hero__fact::before { content: ""; display: inline-block; width: 2px; height: .9em; margin-inline: clamp(.75rem, 2vw, 1.75rem); background: currentColor; vertical-align: -.08em; }
@media (min-width: 1000px) {
  .lp-sci-hero__stage { min-height: clamp(480px, 40.6vw, 780px); align-items: center; }
  .lp-sci-hero__img { position: absolute; right: 0; bottom: 0; width: 62%; height: 100%; aspect-ratio: auto; object-position: right bottom; -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 22%); mask-image: linear-gradient(90deg, transparent 0, #000 22%); }
  .lp-sci-hero__inner { padding-block: 4rem; }
}
@media (max-width: 699px) { .lp-sci-hero__fact { flex-basis: 100%; } .lp-sci-hero__fact + .lp-sci-hero__fact::before { display: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "LP · Science hero",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Regeneration Company" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Cellular Renewal Starts <em>Here</em>" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    { "type": "text", "id": "card_value", "label": "Unused (previous layout)" },
    { "type": "text", "id": "card_label", "label": "Unused (previous layout)" },
    { "type": "text", "id": "jump_label", "label": "Jump links label (screen readers)", "default": "On this page" },
    { "type": "text", "id": "link_1_label", "label": "Button label", "default": "Explore the science" },
    { "type": "text", "id": "link_1_url", "label": "Button link", "default": "#how-it-works" },
    { "type": "text", "id": "link_2_label", "label": "Link label", "default": "See the studies" },
    { "type": "text", "id": "link_2_url", "label": "Link URL", "default": "#studies" }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Proof band item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon (not shown)", "default": "flask", "options": [
          { "value": "flask", "label": "Flask" }, { "value": "badge", "label": "Badge" }, { "value": "star", "label": "Star" },
          { "value": "shield", "label": "Shield" }, { "value": "dna", "label": "DNA" }, { "value": "cell", "label": "Cell" }
        ] },
        { "type": "text", "id": "value", "label": "Value", "default": "18+" },
        { "type": "text", "id": "label", "label": "Label", "default": "clinical studies" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [ { "name": "LP · Science hero" } ],
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
