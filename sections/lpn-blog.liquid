{%- paginate blog.articles by 13 -%}
  <section class="lpn-blog">
    <div class="lpn-wrap">
      <header class="lpn-blog__head">
        <nav class="lpn-crumbs" aria-label="Breadcrumb">
          <a href="{{ routes.root_url }}">{{ 'lpn.home' | t }}</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{{ blog.title | escape }}</span>
        </nav>
        <h1 class="lpn-blog__title">{{ blog.title | escape }}</h1>
        <p class="lpn-blog__count">{{ 'lpn.articles_count' | t: count: blog.articles_count }}{% if current_tags %} · {{ current_tags | join: ', ' | escape }}{% endif %}</p>
      </header>

      <div class="lpn-blog__tools">
        {%- if section.settings.menu != blank -%}
          <ul class="lpn-pills" role="list" aria-label="{{ 'lpn.menu' | t }}">
            {%- for link in section.settings.menu.links -%}
              {%- if link.url != routes.root_url -%}
                <li><a class="lpn-pill" href="{{ link.url }}"{% if link.url == blog.url %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
        <form class="lpn-search" action="{{ routes.search_url }}" method="get" role="search">
          <input type="hidden" name="type" value="article">
          <label class="sr-only" for="lpn-blog-search">{{ 'lpn.search_placeholder' | t }}</label>
          <svg width="18" height="18" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="7"/><path d="m15.5 15.5 4 4"/></svg>
          <input id="lpn-blog-search" type="search" name="q" placeholder="{{ 'lpn.search_placeholder' | t }}" autocomplete="off">
        </form>
      </div>

      {%- if blog.articles.size > 0 -%}
        {%- for article in blog.articles limit: 1 -%}
          <div class="lpn-blog__feature">
            {%- render 'lpn-card', article: article, layout: 'feature', show_excerpt: true, show_topic: false, eager: true, heading_tag: 'h2' -%}
          </div>
        {%- endfor -%}
        <ul class="lpn-grid lpn-grid--compact" role="list">
          {%- for article in blog.articles offset: 1 -%}
            <li>{%- render 'lpn-card', article: article, show_topic: false, show_excerpt: true -%}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <nav class="lpn-pages" aria-label="{{ 'lpn.page' | t: page: paginate.current_page }}">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" aria-label="{{ 'lpn.previous' | t }}"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M13 8H3m4-4L3 8l4 4"/></svg></a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}">{{ part.title }}</a>
            {%- elsif part.title == paginate.current_page -%}
              <span aria-current="page">{{ part.title }}</span>
            {%- else -%}
              <span>{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" aria-label="{{ 'lpn.next' | t }}"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 8h10m-4-4 4 4-4 4"/></svg></a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "News topic page",
  "tag": "div",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Topics menu", "default": "main-menu" }
  ]
}
{% endschema %}
