<footer class="lpn-footer">
  <div class="lpn-wrap">
    <div class="lpn-footer__top">
      <div class="lpn-footer__brand">
        <a class="lpn-footer__logo" href="{{ routes.root_url }}">
          <img src="{{ 'lpn-logo-mono.png' | asset_url }}" alt="{{ shop.name | escape }}" width="660" height="184" loading="lazy">
        </a>
        {%- if section.settings.tagline != blank -%}
          <p class="lpn-footer__tagline">{{ section.settings.tagline | escape }}</p>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'links' -%}
          <nav class="lpn-footer__col" aria-label="{{ block.settings.title | escape }}" {{ block.shopify_attributes }}>
            <p class="lpn-footer__title">{{ block.settings.title | escape }}</p>
            <ul>
              {%- for i in (1..4) -%}
                {%- assign label_key = 'label_' | append: i -%}
                {%- assign url_key = 'url_' | append: i -%}
                {%- if block.settings[label_key] != blank and block.settings[url_key] != blank -%}
                  <li><a href="{{ block.settings[url_key] }}">{{ block.settings[label_key] | escape }}</a></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </nav>
        {%- elsif block.settings.menu != blank -%}
          <nav class="lpn-footer__col" aria-label="{{ block.settings.title | escape }}" {{ block.shopify_attributes }}>
            <p class="lpn-footer__title">{{ block.settings.title | escape }}</p>
            <ul>
              {%- for link in block.settings.menu.links -%}
                {%- if link.url != routes.root_url -%}
                  <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.disclaimer != blank -%}
      <p class="lpn-footer__disclaimer">{{ section.settings.disclaimer | escape }}</p>
    {%- endif -%}

    <div class="lpn-footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</p>
      <ul class="lpn-footer__social">
        {%- if settings.social_facebook_link != blank -%}<li><a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener">Facebook</a></li>{%- endif -%}
        {%- if settings.social_instagram_link != blank -%}<li><a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener">Instagram</a></li>{%- endif -%}
        {%- if settings.social_youtube_link != blank -%}<li><a href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener">YouTube</a></li>{%- endif -%}
        {%- if settings.social_tiktok_link != blank -%}<li><a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener">TikTok</a></li>{%- endif -%}
      </ul>
    </div>
  </div>
</footer>

{% stylesheet %}
.lpn-footer { margin-block-start: var(--lpn-gap); padding-block: clamp(4.8rem, 6vw, 7.2rem) 3.2rem; background: rgb(var(--lp-sand)); color: rgb(var(--lp-ink)); border-radius: 2.4rem 2.4rem 0 0; }
.lpn-footer__top { display: grid; grid-template-columns: minmax(0, 1.4fr) repeat(auto-fit, minmax(16rem, 1fr)); gap: 4rem; }
.lpn-footer__logo { display: inline-block; line-height: 0; }
.lpn-footer__logo img { width: 150px; height: auto; }
.lpn-footer__tagline { max-width: 35.2rem; margin: 2rem 0 0; font-family: var(--lpn-serif); font-size: 2.2rem; line-height: 1.3; }
.lpn-footer__title { margin: 0 0 1.2rem; font-size: 1.1rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: rgb(var(--lp-ink)); }
.lpn-footer__col ul, .lpn-footer__social { margin: 0; padding: 0; list-style: none; }
.lpn-footer__col a, .lpn-footer__social a { display: inline-flex; align-items: center; min-height: 36px; font-size: 1.5rem; color: rgb(var(--lp-ink)); text-decoration: none; }
.lpn-footer a:hover { text-decoration: underline; text-underline-offset: 3px; }
.lpn-footer a:focus-visible { outline: 2px solid rgb(var(--lp-amber-deep)); outline-offset: 2px; border-radius: 0.4rem; }
.lpn-footer__disclaimer { max-width: 96rem; margin: clamp(4rem, 5vw, 5.6rem) 0 0; font-size: 1.3rem; line-height: 1.6; color: rgb(var(--lp-muted)); }
.lpn-footer__bottom { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1.6rem; margin-block-start: 2.4rem; padding-block-start: 2.4rem; border-top: 1px solid rgb(var(--lp-line)); font-size: 1.3rem; color: rgb(var(--lp-muted)); }
.lpn-footer__bottom p { margin: 0; }
.lpn-footer__social { display: flex; gap: 2rem; }
.lpn-footer__social a { font-size: 1.3rem; color: rgb(var(--lp-muted)); }
@media (max-width: 749px) {
  .lpn-footer__top { grid-template-columns: 1fr 1fr; }
  .lpn-footer__brand { grid-column: 1 / -1; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "LifePharm News footer",
  "tag": "div",
  "class": "lpn-footer-section",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Ideas for living well, at every age." },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Topics" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    },
    {
      "type": "links",
      "name": "Links",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "LifePharm" },
        { "type": "text", "id": "label_1", "label": "Link 1 label" },
        { "type": "url", "id": "url_1", "label": "Link 1" },
        { "type": "text", "id": "label_2", "label": "Link 2 label" },
        { "type": "url", "id": "url_2", "label": "Link 2" },
        { "type": "text", "id": "label_3", "label": "Link 3 label" },
        { "type": "url", "id": "url_3", "label": "Link 3" },
        { "type": "text", "id": "label_4", "label": "Link 4 label" },
        { "type": "url", "id": "url_4", "label": "Link 4" }
      ]
    }
  ],
  "max_blocks": 3
}
{% endschema %}
