{%- liquid
  assign handles = section.settings.blogs | split: ','
  assign pool = blogs[handles.first].articles
  for h in handles offset: 1
    assign h = h | strip
    if blogs[h] != blank
      assign pool = pool | concat: blogs[h].articles
    endif
  endfor
  assign pool = pool | sort: 'published_at' | reverse
-%}
<section class="lpn-section">
  <div class="lpn-wrap">
    <div class="lpn-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="lpn-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="lpn-head__title">{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.link_url != blank -%}
        <a class="lpn-link" href="{{ section.settings.link_url }}">{{ section.settings.link_label | escape }} <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 8h10m-4-4 4 4-4 4"/></svg></a>
      {%- endif -%}
    </div>
    <ul class="lpn-grid lpn-grid--compact" role="list">
      {%- for article in pool offset: section.settings.offset limit: section.settings.count -%}
        <li>{%- render 'lpn-card', article: article, show_excerpt: true -%}</li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "News latest stories",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Just Published" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Latest Stories" },
    { "type": "text", "id": "blogs", "label": "Blogs", "info": "Blog handles separated by commas.", "default": "health,nutrition,science,beauty,products,recipes,business,news" },
    { "type": "range", "id": "offset", "label": "Skip the newest", "info": "Set to 1 when the hero already features the newest article.", "min": 0, "max": 3, "step": 1, "default": 1 },
    { "type": "range", "id": "count", "label": "Articles", "min": 3, "max": 12, "step": 3, "default": 6 },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View All" },
    { "type": "url", "id": "link_url", "label": "Link" }
  ],
  "presets": [{ "name": "News latest stories" }]
}
{% endschema %}
