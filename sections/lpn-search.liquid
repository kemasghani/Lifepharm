{%- paginate search.results by 12 -%}
  <section class="lpn-blog">
    <div class="lpn-wrap">
      <header class="lpn-blog__head">
        <h1 class="lpn-blog__title">{{ 'lpn.search' | t }}</h1>
        {%- if search.performed -%}
          <p class="lpn-blog__count">{{ 'lpn.articles_count' | t: count: search.results_count }} · “{{ search.terms | escape }}”</p>
        {%- endif -%}
      </header>

      <form class="lpn-search lpn-search--page" action="{{ routes.search_url }}" method="get" role="search">
        <input type="hidden" name="type" value="article">
        <label class="sr-only" for="lpn-search-page">{{ 'lpn.search_placeholder' | t }}</label>
        <svg width="18" height="18" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="7"/><path d="m15.5 15.5 4 4"/></svg>
        <input id="lpn-search-page" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'lpn.search_placeholder' | t }}" autocomplete="off"{% unless search.performed %} autofocus{% endunless %}>
      </form>

      {%- if search.performed -%}
        <ul class="lpn-grid lpn-grid--compact" role="list">
          {%- for item in search.results -%}
            {%- if item.object_type == 'article' -%}
              <li>{%- render 'lpn-card', article: item, show_excerpt: true -%}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        {%- if paginate.pages > 1 -%}
          <nav class="lpn-pages" aria-label="{{ 'lpn.page' | t: page: paginate.current_page }}">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" aria-label="{{ 'lpn.previous' | t }}">&larr;</a>{%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- elsif part.title == paginate.current_page -%}<span aria-current="page">{{ part.title }}</span>{%- else -%}<span>{{ part.title }}</span>{%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}" aria-label="{{ 'lpn.next' | t }}">&rarr;</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- endif -%}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "News search",
  "tag": "div",
  "settings": []
}
{% endschema %}
