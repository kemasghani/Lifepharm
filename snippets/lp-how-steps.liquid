{% doc %}
  Renders the product's How to Use, When to Take and Tip (custom metafields header_2/value_2,
  header_3/value_3, header_4/value_4) for the buy-box How to Use accordion: the two instructions
  as a small vertical stepper, the tip as a highlighted note.

  @param {product} product - The product whose metafields supply the steps

  @example
  {% render 'lp-how-steps', product: product %}
{% enddoc %}
{%- liquid
  assign mf = product.metafields.custom
  assign use_h = mf.header_2.value | default: 'How to Use' | remove: ':' | strip
  if use_h == 'How to Use' or use_h == 'How to use' or use_h == 'How To Use'
    assign use_h = 'Daily Use'
  endif
  assign use_v = mf.value_2.value | default: mf.how_to_use.value
-%}
{%- if use_v != blank -%}
  <div class="lp-howto">
    <ol class="lp-howto__steps" role="list">
      <li class="lp-howto__step">
        <span class="lp-howto__marker">{% render 'lp-icon', name: 'pill', size: 18 %}</span>
        <div class="lp-howto__body">
          <p class="lp-howto__title">{{ use_h | escape }}</p>
          <p class="lp-howto__text">{{ use_v | replace: ' — ', ', ' | replace: '—', ', ' | escape }}</p>
        </div>
      </li>
      {%- if mf.value_3 != blank -%}
        <li class="lp-howto__step">
          <span class="lp-howto__marker">{% render 'lp-icon', name: 'clock', size: 18 %}</span>
          <div class="lp-howto__body">
            <p class="lp-howto__title">{{ mf.header_3.value | default: 'When to Take' | remove: ':' | strip | escape }}</p>
            <p class="lp-howto__text">{{ mf.value_3.value | replace: ' — ', ', ' | replace: '—', ', ' | escape }}</p>
          </div>
        </li>
      {%- endif -%}
    </ol>
    {%- if mf.value_4 != blank -%}
      <aside class="lp-howto__tip">
        <span class="lp-howto__tip-icon">{% render 'lp-icon', name: 'bulb', size: 18 %}</span>
        <div>
          <p class="lp-howto__tip-label">{{ mf.header_4.value | default: 'Tip' | remove: ':' | strip | escape }}</p>
          <p class="lp-howto__tip-text">{{ mf.value_4.value | replace: ' - ', ', ' | replace: ' — ', ', ' | replace: '—', ', ' | escape }}</p>
        </div>
      </aside>
    {%- endif -%}
  </div>
{%- endif -%}
