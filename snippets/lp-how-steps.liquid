{% doc %}
  Renders the product's How to Use, When to Take and Tip steps (custom metafields header_2/value_2,
  header_3/value_3, header_4/value_4) as a compact list for the buy-box How to Use accordion.

  @param {product} product - The product whose metafields supply the steps

  @example
  {% render 'lp-how-steps', product: product %}
{% enddoc %}
{%- liquid
  assign mf = product.metafields.custom
  assign use_h = mf.header_2.value | default: 'How to Use'
  assign use_v = mf.value_2.value | default: mf.how_to_use.value
-%}
{%- if use_v != blank -%}
  <ul class="lp-how-steps" role="list">
    <li class="lp-how-steps__item">
      <span class="lp-how-steps__icon">{% render 'lp-icon', name: 'pill', size: 20 %}</span>
      <div><p class="lp-how-steps__title">{{ use_h | remove: ':' | strip | escape }}</p><p class="lp-how-steps__text">{{ use_v | replace: ' — ', ', ' | replace: '—', ', ' | escape }}</p></div>
    </li>
    {%- if mf.value_3 != blank -%}
      <li class="lp-how-steps__item">
        <span class="lp-how-steps__icon">{% render 'lp-icon', name: 'clock', size: 20 %}</span>
        <div><p class="lp-how-steps__title">{{ mf.header_3.value | default: 'When to Take' | remove: ':' | strip | escape }}</p><p class="lp-how-steps__text">{{ mf.value_3.value | replace: ' — ', ', ' | replace: '—', ', ' | escape }}</p></div>
      </li>
    {%- endif -%}
    {%- if mf.value_4 != blank -%}
      <li class="lp-how-steps__item">
        <span class="lp-how-steps__icon">{% render 'lp-icon', name: 'bulb', size: 20 %}</span>
        <div><p class="lp-how-steps__title">{{ mf.header_4.value | default: 'Tip' | remove: ':' | strip | escape }}</p><p class="lp-how-steps__text">{{ mf.value_4.value | replace: ' - ', ', ' | replace: ' — ', ', ' | replace: '—', ', ' | escape }}</p></div>
      </li>
    {%- endif -%}
  </ul>
{%- endif -%}

{% stylesheet %}
.lp-how-steps { display: grid; gap: .9rem; margin: 0; padding: 0; list-style: none; }
.lp-how-steps__item { display: grid; grid-template-columns: 36px minmax(0, 1fr); gap: .75rem; align-items: start; }
.lp-how-steps__item + .lp-how-steps__item { padding-block-start: .9rem; border-top: 1px solid rgb(var(--lp-ink) / .08); }
.lp-how-steps__icon { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: rgb(var(--lp-sand)); color: rgb(var(--lp-amber-deep)); }
.lp-how-steps__title { margin: .35rem 0 0; font-weight: 600; font-size: .9375rem; color: rgb(var(--lp-ink)); }
.lp-how-steps__text { margin: .15rem 0 0; color: rgb(var(--lp-muted)); font-size: .9rem; line-height: 1.55; }
{% endstylesheet %}
