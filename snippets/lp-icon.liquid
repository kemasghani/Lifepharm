{% doc %}
  Renders a line icon from the LifePharm premium icon set.

  @param {string} name - Icon name: shield, flag, flask, badge, truck, leaf, star, lock, chat, refresh, heart, sparkle, arrow
  @param {number} [size] - Pixel size, defaults to 24

  @example
  {% render 'lp-icon', name: 'shield', size: 20 %}
{% enddoc %}
{%- assign size = size | default: 24 -%}
<svg class="lp-icon lp-icon--{{ name }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'shield' -%}
      <path d="M12 22s8-3.6 8-10V5l-8-3-8 3v7c0 6.4 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>
    {%- when 'flag' -%}
      <path d="M4 22V4"/><path d="M4 4h12l-2 4 2 4H4"/>
    {%- when 'flask' -%}
      <path d="M9 3h6"/><path d="M10 3v6L4.5 18.5A2 2 0 0 0 6.2 21.5h11.6a2 2 0 0 0 1.7-3L14 9V3"/><path d="M7.5 15h9"/>
    {%- when 'badge' -%}
      <circle cx="12" cy="9" r="6"/><path d="m9 14.5-1.5 7L12 19l4.5 2.5-1.5-7"/><path d="m9.8 9 1.5 1.5 3-3"/>
    {%- when 'truck' -%}
      <path d="M3 6h11v10H3z"/><path d="M14 10h4l3 3v3h-7"/><circle cx="7" cy="18" r="2"/><circle cx="17.5" cy="18" r="2"/>
    {%- when 'leaf' -%}
      <path d="M5 21c0-9 5-15 15-16-1 10-7 15-15 16z"/><path d="M5 21 13 13"/>
    {%- when 'star' -%}
      <path d="m12 2.8 2.8 5.8 6.4.9-4.6 4.5 1.1 6.3L12 17.3l-5.7 3 1.1-6.3L2.8 9.5l6.4-.9z"/>
    {%- when 'lock' -%}
      <rect x="4" y="10" width="16" height="11" rx="2.5"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>
    {%- when 'chat' -%}
      <path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-4.8A8 8 0 1 1 21 12z"/>
    {%- when 'refresh' -%}
      <path d="M3 12a9 9 0 0 1 15.5-6.3L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15.5 6.3L3 16"/><path d="M3 21v-5h5"/>
    {%- when 'heart' -%}
      <path d="M20.8 5.6a5.4 5.4 0 0 0-7.7 0L12 6.7l-1.1-1.1a5.4 5.4 0 0 0-7.7 7.7L12 22l8.8-8.7a5.4 5.4 0 0 0 0-7.7z"/>
    {%- when 'sparkle' -%}
      <path d="M12 3v4M12 17v4M3 12h4M17 12h4"/><path d="m12 8 1.4 2.6L16 12l-2.6 1.4L12 16l-1.4-2.6L8 12l2.6-1.4z"/>
    {%- else -%}
      <path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>
  {%- endcase -%}
</svg>
