{% doc %}
  Renders a line icon from the LifePharm premium icon set.

  @param {string} name - Icon name: pill, bulb, calendar, shield, flag, flag-us, seal-guarantee, seal-nsf, seal-usa, seal-flask, flask, badge, truck, leaf, star, lock, chat, refresh, heart, sparkle, arrow, dna, moon, bolt, drop, check, clock, cell
  @param {number} [size] - Pixel size, defaults to 24

  @example
  {% render 'lp-icon', name: 'shield', size: 20 %}
{% enddoc %}
{%- assign size = size | default: 24 -%}
<svg class="lp-icon lp-icon--{{ name }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'pill' -%}
      <path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z"/><path d="m8.5 8.5 7 7"/>
    {%- when 'bulb' -%}
      <path d="M9 18h6M10 22h4"/><path d="M15.1 14c.2-1 .7-1.7 1.4-2.5A5.5 5.5 0 1 0 7.5 11.5c.7.8 1.2 1.5 1.4 2.5"/>
    {%- when 'calendar' -%}
      <rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M8 3v4M16 3v4M3.5 10h17"/>
    {%- when 'dna' -%}
      <path d="M7 3c0 6 10 6 10 12s-10 6-10 6"/><path d="M17 3c0 6-10 6-10 12"/><path d="M8.5 7h7M8.5 17h7M10 12h4"/>
    {%- when 'moon' -%}
      <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/>
    {%- when 'bolt' -%}
      <path d="M13 2 4 14h7l-1 8 9-12h-7l1-8z"/>
    {%- when 'drop' -%}
      <path d="M12 2.5s6.5 7 6.5 12a6.5 6.5 0 0 1-13 0c0-5 6.5-12 6.5-12z"/>
    {%- when 'check' -%}
      <path d="m5 12.5 4.5 4.5L19 7.5"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
    {%- when 'cell' -%}
      <circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3.2"/><circle cx="6.5" cy="9" r=".6"/><circle cx="17" cy="15.5" r=".6"/><circle cx="15.5" cy="7.5" r=".6"/>
    {%- when 'shield' -%}
      <path d="M12 22s8-3.6 8-10V5l-8-3-8 3v7c0 6.4 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>
    {%- when 'flag' -%}
      <path d="M4 22V4"/><path d="M4 4h12l-2 4 2 4H4"/>
    {%- when 'seal-guarantee' -%}
      <circle cx="12" cy="9.4" r="3.7"/><path d="M5.93 14.14A7.7 7.7 0 0 1 4.53 7.54"/><path d="M5.33 5.55A7.7 7.7 0 0 1 18.67 5.55"/><path d="M19.47 7.54A7.7 7.7 0 0 1 18.07 14.14"/><path d="M2.93 8.64L4.53 7.54L5.73 9.04"/><path d="M16.57 13.04L18.07 14.14L19.77 13.54"/><path d="M5.4 15.9Q12 14.7 18.6 15.9V19.7Q12 18.5 5.4 19.7Z"/><path d="M5.4 16.9H2L3.5 18.8L2 20.7H6.5L5.4 19.7M18.6 16.9H22L20.5 18.8L22 20.7H17.5L18.6 19.7"/>
    {%- when 'seal-nsf' -%}
      <circle cx="12" cy="12" r="10.6"/><circle cx="12" cy="12" r="7.4"/><text x="12" y="14.05" text-anchor="middle" font-size="5.7" font-weight="800" letter-spacing="-.2" fill="currentColor" stroke="none" font-family="inherit">NSF</text>
    {%- when 'seal-usa' -%}
      <circle cx="12" cy="12" r="10.6"/><circle cx="12" cy="12" r="7.6"/><clipPath id="lp-ic-usa"><circle cx="12" cy="12" r="6.8"/></clipPath><g clip-path="url(#lp-ic-usa)"><path d="M11.6 4V12.4M11.6 7.4H20M11.6 9.9H20M4 12.6H20M4 15.6H20"/></g><path d="m8.2 6.9.55 1.15 1.25.15-.92.86.24 1.24-1.12-.62-1.1.62.23-1.24-.92-.86 1.25-.15z" fill="currentColor" stroke="none"/>
    {%- when 'seal-flask' -%}
      <circle cx="12" cy="12" r="10.6"/><path d="M9.3 9.9H14.7M10.4 9.9V12.6L7.3 17.4Q6.6 18.9 8.2 18.9H15.8Q17.4 18.9 16.7 17.4L13.6 12.6V9.9"/><path d="M9.1 15.5Q10.4 14.1 11.8 14.8Q12.9 15.3 14.3 14.7L15 15.1L16.1 17.2Q16.5 18 15.6 18H8.4Q7.5 18 7.9 17.2Z" fill="currentColor" stroke="none"/><g fill="currentColor" stroke="none"><circle cx="10.5" cy="6.4" r=".95"/><circle cx="13.4" cy="5.1" r=".8"/><circle cx="13" cy="8" r=".72"/></g>
    {%- when 'flag-us' -%}
      <rect x="3" y="5" width="18" height="13" rx="1.5"/><path d="M3 10.5h18M3 14.5h18M11 5v5.5"/><path d="m7 6.6.5 1.1 1.2.1-.9.8.3 1.2L7 9.2l-1.1.6.3-1.2-.9-.8 1.2-.1z" fill="currentColor" stroke="none"/>
    {%- when 'flask' -%}
      <path d="M9 3h6"/><path d="M10 3v6L4.5 18.5A2 2 0 0 0 6.2 21.5h11.6a2 2 0 0 0 1.7-3L14 9V3"/><path d="M7.5 15h9"/>
    {%- when 'badge' -%}
      <circle cx="12" cy="9" r="6"/><path d="m9 14.5-1.5 7L12 19l4.5 2.5-1.5-7"/><path d="m9.8 9 1.5 1.5 3-3"/>
    {%- when 'truck' -%}
      <path d="M3 6h11v10H3z"/><path d="M14 10h4l3 3v3h-7"/><circle cx="7" cy="18" r="2"/><circle cx="17.5" cy="18" r="2"/>
    {%- when 'leaf' -%}
      <path d="M5 21c0-9 5-15 15-16-1 10-7 15-15 16z"/><path d="M5 21 13 13"/>
    {%- when 'star' -%}
      <path d="m12 2.8 2.8 5.8 6.4.9-4.6 4.5 1.1 6.3L12 17.3l-5.7 3 1.1-6.3L2.8 9.5l6.4-.9z"/>
    {%- when 'lock' -%}
      <rect x="4" y="10" width="16" height="11" rx="2.5"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>
    {%- when 'chat' -%}
      <path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-4.8A8 8 0 1 1 21 12z"/>
    {%- when 'refresh' -%}
      <path d="M3 12a9 9 0 0 1 15.5-6.3L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15.5 6.3L3 16"/><path d="M3 21v-5h5"/>
    {%- when 'heart' -%}
      <path d="M20.8 5.6a5.4 5.4 0 0 0-7.7 0L12 6.7l-1.1-1.1a5.4 5.4 0 0 0-7.7 7.7L12 22l8.8-8.7a5.4 5.4 0 0 0 0-7.7z"/>
    {%- when 'sparkle' -%}
      <path d="M12 3v4M12 17v4M3 12h4M17 12h4"/><path d="m12 8 1.4 2.6L16 12l-2.6 1.4L12 16l-1.4-2.6L8 12l2.6-1.4z"/>
    {%- else -%}
      <path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>
  {%- endcase -%}
</svg>
