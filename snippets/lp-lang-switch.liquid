{% doc %}
  Header language selector. It drives the Weglot app (JavaScript integration), so a choice translates the page in
  place and keeps the URL. The list comes from Weglot itself, so languages added in the Weglot dashboard appear
  here without a theme change. The element stays hidden until Weglot has loaded.

  @param {string} [id] - Unique id when the selector is rendered more than once (default "lp-lang")
  @param {string} [align] - "start" opens the panel from the left edge of the button, otherwise from the right

  @example
  {% render 'lp-lang-switch', id: 'lp-lang-mobile', align: 'start' %}
{% enddoc %}
{%- assign uid = id | default: 'lp-lang' -%}

<lp-lang-switch class="lp-lang{% if align == 'start' %} lp-lang--start{% endif %}" data-wg-notranslate hidden>
  <button type="button" class="lp-lang__btn" aria-haspopup="listbox" aria-expanded="false" aria-controls="{{ uid }}-panel" aria-label="{{ 'general.localization.change_language_accessibility_text' | t | escape }}">
    <svg class="lp-lang__globe" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ settings.icon_stroke_width | default: 1.5 }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a14 14 0 0 1 0 18a14 14 0 0 1 0-18z"/></svg>
    <span class="lp-lang__current" data-lp-lang-current>EN</span>
    <svg class="lp-lang__chev" width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m2 3.5 3 3 3-3"/></svg>
  </button>

  <div class="lp-lang__panel" id="{{ uid }}-panel" hidden>
    <p class="lp-lang__title" id="{{ uid }}-title">{{ 'general.localization.language' | t }}</p>
    <ul class="lp-lang__list" role="listbox" aria-labelledby="{{ uid }}-title" data-lp-lang-list></ul>
  </div>
</lp-lang-switch>

{% stylesheet %}
.lp-lang { position: relative; display: block; }
.lp-lang[hidden] { display: none; }
.lp-lang__btn { display: inline-flex; align-items: center; gap: .375rem; min-width: 44px; min-height: 44px; padding: 0 .375rem; border-radius: 999px; color: inherit; cursor: pointer; transition: background-color 200ms ease-out, color 200ms ease-out; }
.lp-lang__btn:hover, .lp-lang__btn[aria-expanded="true"] { background: rgb(var(--lp-ink) / .06); }
.lp-lang__btn:focus-visible { outline: 2px solid rgb(var(--lp-amber-deep)); outline-offset: 2px; }
.lp-lang__current { font-size: .8125rem; font-weight: 600; letter-spacing: .06em; line-height: 1; }
.lp-lang__chev { opacity: .6; transition: transform 200ms ease-out; }
.lp-lang__btn[aria-expanded="true"] .lp-lang__chev { transform: rotate(180deg); }

.lp-lang__panel { position: absolute; z-index: 30; inset-block-start: calc(100% + .5rem); inset-inline-end: -.5rem; width: min(25rem, calc(100vw - 2rem)); max-height: min(38rem, calc(100dvh - 7rem)); overflow-y: auto; overscroll-behavior: contain; padding: 1.25rem 1rem 1rem; background: #fff; color: rgb(var(--lp-ink)); border: 1px solid rgb(var(--lp-ink) / .08); border-radius: 1rem; box-shadow: 0 18px 40px -18px rgb(var(--lp-ink) / .28), 0 2px 6px rgb(var(--lp-ink) / .05); opacity: 0; transform: translateY(-6px); transition: opacity 180ms ease-out, transform 180ms cubic-bezier(.16, 1, .3, 1); }
.lp-lang__panel.is-open { opacity: 1; transform: none; }
.lp-lang--start .lp-lang__panel { inset-inline-end: auto; inset-inline-start: -.5rem; }
.lp-lang__title { margin: 0 .5rem .75rem; font-size: .6875rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: rgb(var(--lp-amber)); }
.lp-lang__list { display: grid; grid-template-columns: 1fr 1fr; gap: .125rem .25rem; margin: 0; padding: 0; list-style: none; }
.lp-lang__opt { display: flex; white-space: nowrap; align-items: center; justify-content: space-between; gap: .5rem; min-height: 44px; padding: 0 .625rem; border-radius: .625rem; font-size: .875rem; line-height: 1.2; cursor: pointer; transition: background-color 150ms ease-out; }
.lp-lang__opt:hover, .lp-lang__opt:focus-visible { background: rgb(var(--lp-ink) / .05); outline: none; }
.lp-lang__opt:focus-visible { box-shadow: inset 0 0 0 2px rgb(var(--lp-amber-deep)); }
.lp-lang__opt[aria-selected="true"] { font-weight: 600; background: rgb(var(--lp-amber) / .1); }
.lp-lang__opt-code { flex: none; font-size: .6875rem; font-weight: 600; letter-spacing: .06em; color: rgb(var(--lp-muted)); }
.lp-lang__opt[aria-selected="true"] .lp-lang__opt-code { color: rgb(var(--lp-ink)); }

@media (max-width: 699px) {
  .lp-lang__btn { padding: 0; justify-content: center; }
  .lp-lang__current, .lp-lang__chev { display: none; }
  .lp-lang__panel, .lp-lang--start .lp-lang__panel { position: fixed; inset-block-start: var(--lp-lang-top, 4rem); inset-inline: 1rem; width: auto; max-height: calc(100dvh - var(--lp-lang-top, 4rem) - 1rem); }
}
@media (prefers-reduced-motion: reduce) {
  .lp-lang__panel, .lp-lang__chev, .lp-lang__btn { transition: none; }
}
{% endstylesheet %}

{% javascript %}
if (!customElements.get('lp-lang-switch')) {
  class LpLangSwitch extends HTMLElement {
    connectedCallback() {
      this.button = this.querySelector('.lp-lang__btn');
      this.panel = this.querySelector('.lp-lang__panel');
      this.list = this.querySelector('[data-lp-lang-list]');
      this.current = this.querySelector('[data-lp-lang-current]');
      let tries = 0;
      const wait = () => {
        const wg = window.Weglot;
        if (wg && wg.initialized && wg.options) return this.setup(wg);
        if (wg && typeof wg.on === 'function' && !this.listening) { this.listening = true; wg.on('initialized', () => this.setup(window.Weglot)); }
        if (++tries < 40) window.setTimeout(wait, 250);
      };
      wait();
    }

    setup(wg) {
      if (this.ready || !wg.options) return;
      this.ready = true;
      this.wg = wg;
      const from = wg.options.language_from;
      const others = (wg.options.languages || []).filter((l) => l.enabled !== false && l.public !== false).map((l) => l.language_to);
      const name = (code) => { try { return wg.getLanguageName(code) || code.toUpperCase(); } catch (e) { return code.toUpperCase(); } };
      const codes = [from].concat(others.sort((a, b) => name(a).localeCompare(name(b))));
      this.list.innerHTML = '';
      codes.forEach((code) => {
        const li = document.createElement('li');
        li.className = 'lp-lang__opt';
        li.setAttribute('role', 'option');
        li.tabIndex = -1;
        li.dataset.code = code;
        li.lang = code;
        const label = document.createElement('span');
        label.textContent = name(code);
        const tag = document.createElement('span');
        tag.className = 'lp-lang__opt-code';
        tag.textContent = code.toUpperCase();
        li.append(label, tag);
        this.list.append(li);
      });
      this.options = [...this.list.children];
      this.sync(wg.getCurrentLang());
      if (typeof wg.on === 'function') wg.on('languageChanged', (lang) => this.sync(lang));

      this.button.addEventListener('click', () => (this.panel.hidden ? this.open() : this.close()));
      this.list.addEventListener('click', (event) => {
        const opt = event.target.closest('.lp-lang__opt');
        if (opt) this.choose(opt.dataset.code);
      });
      this.list.addEventListener('keydown', (event) => this.onKey(event));
      this.button.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown') { event.preventDefault(); this.open(); }
      });
      document.addEventListener('click', (event) => { if (!this.panel.hidden && !this.contains(event.target)) this.close(); });
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && !this.panel.hidden) { this.close(); this.button.focus(); } });
      this.hidden = false;
    }

    sync(code) {
      if (!code) return;
      this.current.textContent = code.toUpperCase();
      this.options.forEach((o) => o.setAttribute('aria-selected', String(o.dataset.code === code)));
    }

    open() {
      const header = this.closest('header') || this.closest('.header');
      if (header) this.style.setProperty('--lp-lang-top', `${Math.round(header.getBoundingClientRect().bottom) + 8}px`);
      this.panel.hidden = false;
      this.button.setAttribute('aria-expanded', 'true');
      requestAnimationFrame(() => {
        this.panel.classList.add('is-open');
        const selected = this.options.find((o) => o.getAttribute('aria-selected') === 'true') || this.options[0];
        if (selected) selected.focus({ preventScroll: false });
      });
    }

    close() {
      this.panel.classList.remove('is-open');
      this.button.setAttribute('aria-expanded', 'false');
      this.panel.hidden = true;
    }

    choose(code) {
      this.close();
      this.button.focus();
      if (code && this.wg && code !== this.wg.getCurrentLang()) this.wg.switchTo(code);
    }

    onKey(event) {
      const index = this.options.indexOf(document.activeElement);
      const cols = 2;
      const move = { ArrowDown: cols, ArrowUp: -cols, ArrowRight: 1, ArrowLeft: -1, Home: -Infinity, End: Infinity }[event.key];
      if (move !== undefined) {
        event.preventDefault();
        const next = Math.max(0, Math.min(this.options.length - 1, index + move));
        this.options[next].focus();
      } else if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        if (index > -1) this.choose(this.options[index].dataset.code);
      } else if (event.key === 'Tab') {
        this.close();
      }
    }
  }
  customElements.define('lp-lang-switch', LpLangSwitch);
}
{% endjavascript %}
