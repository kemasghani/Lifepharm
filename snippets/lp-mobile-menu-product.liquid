{% doc %}
  Product row inside the mobile menu category panel.

  @param {product} product - The product to show
  @param {string} url - Link for the row

  @example
  {% render 'lp-mobile-menu-product', product: product, url: product.url %}
{% enddoc %}

{%- if product != blank -%}
  {%- liquid
    assign variant = product.selected_or_first_available_variant
    assign is_best = false
    for tag in product.tags
      assign t = tag | downcase | replace: ' ', '-'
      if t == 'best-seller' or t == 'bestseller'
        assign is_best = true
      endif
    endfor
  -%}
  <li>
    <a class="lp-menu__product" href="{{ url }}">
      <span class="lp-menu__product-media">
        {%- if product.featured_media -%}
          {{ product.featured_media | image_url: width: 160 | image_tag: loading: 'lazy', width: 64, height: 64, alt: '' }}
        {%- endif -%}
      </span>
      <span class="lp-menu__product-body">
        {%- if is_best -%}<span class="lp-menu__badge">Best seller</span>{%- endif -%}
        <span class="lp-menu__product-title">{{ product.title | escape }}</span>
        <span class="lp-menu__price">
          {{ variant.price | money }}
          {%- if variant.compare_at_price > variant.price -%}<s>{{ variant.compare_at_price | money }}</s>{%- endif -%}
        </span>
      </span>
      <svg class="lp-menu__chev" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
    </a>
  </li>
{%- endif -%}
