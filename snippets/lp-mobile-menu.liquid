{% doc %}
  Mobile navigation (Figma "Menu" and "Open"). Level 1 lists the Shop categories with images.
  Level 2 shows a promo card and the category's products. Replaces Impact's sidebar navigation drawer.

  @param {object} menu - The main menu linklist
  @param {object} settings - The header section settings

  @example
  {% render 'lp-mobile-menu', menu: main_menu, settings: section.settings %}
{% enddoc %}

{%- liquid
  assign shop_link = nil
  for link in menu.links
    if link.links.size > 0 and shop_link == nil
      assign shop_link = link
    endif
  endfor
  assign all_url = routes.all_products_collection_url
-%}

<div class="lp-menu" id="lp-menu" data-lp-menu hidden aria-label="{{ 'header.general.menu' | t | escape }}">
  <div class="lp-menu__track" data-lp-menu-track>
    <section class="lp-menu__panel" data-lp-menu-panel="root" aria-labelledby="lp-menu-title">
      <h2 class="lp-menu__title" id="lp-menu-title">{{ settings.lp_menu_heading | default: 'Shop by category' | escape }}</h2>

      {%- if shop_link -%}
        <ul class="lp-menu__cats" role="list">
          {%- for cat in shop_link.links -%}
            {%- liquid
              assign image_key = 'lp_menu_image_' | append: forloop.index
              assign cat_image = settings[image_key]
              if cat_image == blank and cat.type == 'collection_link'
                assign cat_image = cat.object.featured_image
              endif
            -%}
            <li>
              <button type="button" class="lp-menu__cat" data-lp-menu-open="cat-{{ forloop.index }}" aria-controls="lp-menu-cat-{{ forloop.index }}">
                <span class="lp-menu__cat-media">
                  {%- if cat_image != blank -%}
                    {{ cat_image | image_url: width: 160, height: 160, crop: 'center' | image_tag: loading: 'lazy', width: 80, height: 80, alt: '' }}
                  {%- endif -%}
                </span>
                <span class="lp-menu__cat-label">{{ cat.title | escape }}</span>
                <svg class="lp-menu__chev" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
              </button>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <a class="button lp-menu__cta" href="{{ all_url }}">{{ settings.lp_menu_all_label | default: 'Shop all' | escape }}</a>

      <ul class="lp-menu__links" role="list">
        {%- for link in menu.links -%}
          {%- if link.links.size == 0 -%}
            <li><a href="{{ link.url }}" class="lp-menu__link">{{ link.title | escape }}</a></li>
          {%- endif -%}
        {%- endfor -%}
        <li><a href="{{ routes.search_url }}" class="lp-menu__link" aria-controls="search-drawer">{{ 'header.general.search' | t }}</a></li>
        {%- if shop.customer_accounts_enabled -%}
          <li><a href="{{ routes.account_url }}" class="lp-menu__link">{{ 'header.general.account' | t }}</a></li>
        {%- endif -%}
      </ul>
    </section>

    {%- if shop_link -%}
      {%- for cat in shop_link.links -%}
        <section class="lp-menu__panel lp-menu__panel--sub" id="lp-menu-cat-{{ forloop.index }}" data-lp-menu-panel="cat-{{ forloop.index }}" aria-labelledby="lp-menu-cat-title-{{ forloop.index }}" hidden>
          <button type="button" class="lp-menu__back" data-lp-menu-back>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 6-6 6 6 6"/></svg>
            {{ settings.lp_menu_back_label | default: 'All categories' | escape }}
          </button>

          {%- if settings.lp_promo_heading != blank -%}
            <a class="lp-menu__promo" href="{{ settings.lp_promo_link | default: all_url }}">
              <span class="lp-menu__promo-copy">
                <span class="lp-menu__promo-title">{{ settings.lp_promo_heading | escape }}</span>
                {%- if settings.lp_promo_text != blank -%}<span class="lp-menu__promo-text">{{ settings.lp_promo_text | escape }}</span>{%- endif -%}
              </span>
              {%- if settings.lp_promo_image != blank -%}
                {{ settings.lp_promo_image | image_url: width: 240 | image_tag: loading: 'lazy', class: 'lp-menu__promo-img', alt: '' }}
              {%- else -%}
                <img class="lp-menu__promo-img" src="{{ 'lp-menu-promo.png' | asset_url }}" alt="" width="120" height="145" loading="lazy">
              {%- endif -%}
            </a>
          {%- endif -%}

          <h2 class="lp-menu__title" id="lp-menu-cat-title-{{ forloop.index }}">{{ settings.lp_menu_cat_prefix | default: 'Shop' | escape }} {{ cat.title | escape }}</h2>

          {%- liquid
            assign items = cat.links
            assign from_collection = false
            if items.size == 0 and cat.type == 'collection_link'
              assign from_collection = true
            endif
          -%}
          <ul class="lp-menu__products" role="list">
            {%- if from_collection -%}
              {%- for product in cat.object.products limit: 6 -%}
                {%- render 'lp-mobile-menu-product', product: product, url: product.url -%}
              {%- endfor -%}
            {%- else -%}
              {%- for item in items -%}
                {%- if item.type == 'product_link' -%}
                  {%- render 'lp-mobile-menu-product', product: item.object, url: item.url -%}
                {%- else -%}
                  <li><a class="lp-menu__link" href="{{ item.url }}">{{ item.title | escape }}</a></li>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </ul>

          <a class="button lp-menu__cta" href="{{ cat.url }}">{{ settings.lp_menu_all_label | default: 'Shop all' | escape }} {{ cat.title | escape }}</a>
        </section>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
.lp-burger { position: relative; display: block; width: 22px; height: 16px; }
.lp-burger i { position: absolute; left: 0; width: 100%; height: 1.5px; border-radius: 2px; background: currentColor; transition: transform 320ms cubic-bezier(.16, 1, .3, 1), opacity 200ms ease-out, top 320ms cubic-bezier(.16, 1, .3, 1); }
.lp-burger i:nth-child(1) { top: 0; }
.lp-burger i:nth-child(2) { top: 7px; }
.lp-burger i:nth-child(3) { top: 14px; }
[aria-expanded="true"] > .lp-burger i:nth-child(1) { top: 7px; transform: rotate(45deg); }
[aria-expanded="true"] > .lp-burger i:nth-child(2) { opacity: 0; transform: scaleX(.4); }
[aria-expanded="true"] > .lp-burger i:nth-child(3) { top: 7px; transform: rotate(-45deg); }

.lp-menu { position: fixed; z-index: 19; left: 0; right: 0; top: var(--lp-menu-top, 100px); bottom: 0; overflow: hidden; background: #fff; color: rgb(var(--lp-ink)); opacity: 0; transform: translateY(-8px); transition: opacity 260ms ease-out, transform 360ms cubic-bezier(.16, 1, .3, 1); }
.lp-menu.is-open { opacity: 1; transform: none; }
.lp-menu[hidden] { display: none; }
.lp-menu__track { position: relative; height: 100%; }
.lp-menu__panel { position: absolute; inset: 0; overflow-y: auto; overscroll-behavior: contain; display: flex; flex-direction: column; gap: 1rem; padding: 1.5rem 1rem calc(2rem + env(safe-area-inset-bottom)); background: #fff; transition: transform 420ms cubic-bezier(.16, 1, .3, 1), opacity 260ms ease-out; }
.lp-menu__panel[hidden] { display: none; }
.lp-menu__panel > * { flex-shrink: 0; }
.lp-menu__panel--sub { transform: translateX(100%); }
.lp-menu.is-sub .lp-menu__panel[data-lp-menu-panel="root"] { transform: translateX(-24%); opacity: 0; }
.lp-menu.is-sub .lp-menu__panel--sub.is-active { transform: none; }
.lp-menu__title { margin: .25rem 0 .25rem; font-size: 2rem; }
.lp-menu__cats, .lp-menu__products, .lp-menu__links { display: grid; gap: .5rem; margin: 0; padding: 0; list-style: none; }
.lp-menu .lp-menu__cat { display: grid; grid-template-columns: 72px minmax(0, 1fr) 20px; align-items: center; gap: 1rem; width: 100%; min-height: 96px; padding: .75rem 1rem .75rem .75rem; border: 0; border-radius: 4px; background: #f2f2f2; color: inherit; font: inherit; text-align: start; cursor: pointer; transition: background-color 160ms ease-out; }
.lp-menu .lp-menu__cat:hover { background: #ebebeb; }
.lp-menu .lp-menu__cat:active { background: #e4e4e4; }
.lp-menu__cat-media { width: 72px; height: 72px; overflow: hidden; border-radius: 2px; background: #e6e6e6; }
.lp-menu__cat-media img { display: block; width: 100%; height: 100%; object-fit: cover; }
.lp-menu__cat-label { font-size: 1.0625rem; font-weight: 700; letter-spacing: -.005em; }
.lp-menu__chev { color: rgb(var(--lp-ink)); }
.lp-menu__cta.button { width: 100%; min-height: 48px; margin-block-start: .5rem; font-size: 1.0625rem; font-weight: 700; }
.lp-menu__links { gap: 0; margin-block-start: .5rem; }
.lp-menu__link { display: flex; align-items: center; min-height: 44px; font-size: 1rem; font-weight: 700; color: inherit; text-decoration: none; }
.lp-menu .lp-menu__back { display: inline-flex; align-items: center; gap: .35rem; align-self: flex-start; min-height: 44px; padding: 0 .5rem 0 0; border: 0; background: none; color: rgb(var(--lp-muted)); font: inherit; font-size: .875rem; font-weight: 600; cursor: pointer; }
.lp-menu__back:hover { color: rgb(var(--lp-ink)); }
.lp-menu__promo { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) 88px; align-items: stretch; gap: .75rem; margin-inline: -1rem; padding: 1.25rem 0 0 1.25rem; overflow: hidden; background: radial-gradient(120% 140% at 85% 30%, #1d3f9a 0%, #0b2063 45%, #061338 100%); color: #fff; text-decoration: none; }
.lp-menu__promo-copy { display: grid; align-content: start; gap: .5rem; padding-block-end: 1.25rem; }
.lp-menu__promo-title { font-family: var(--lp-serif); font-size: 1.625rem; line-height: 1.05; text-transform: uppercase; }
.lp-menu__promo-text { font-size: .8125rem; line-height: 1.45; color: rgb(255 255 255 / .86); }
.lp-menu__promo-img { align-self: end; width: 88px; height: auto; filter: drop-shadow(0 12px 18px rgb(0 0 0 / .45)); }
.lp-menu__product { display: grid; grid-template-columns: 64px minmax(0, 1fr) 20px; align-items: center; gap: 1rem; min-height: 88px; padding: .625rem 1rem .625rem .625rem; border: 1px solid #ececec; border-radius: 4px; color: inherit; text-decoration: none; transition: border-color 160ms ease-out, box-shadow 160ms ease-out; }
.lp-menu__product:hover { border-color: #dcdcdc; box-shadow: 0 6px 18px -12px rgb(var(--lp-ink) / .4); }
.lp-menu__product-media { position: relative; width: 64px; height: 64px; }
.lp-menu__product-media img { width: 100%; height: 100%; object-fit: contain; }
.lp-menu__product-body { display: grid; gap: .2rem; min-width: 0; }
.lp-menu__badge { justify-self: start; margin-block-end: .15rem; padding: .2rem .45rem; border-radius: 2px; background: rgb(var(--lp-amber)); color: #1f1e20; font-size: .6875rem; font-weight: 800; letter-spacing: .02em; }
.lp-menu__product-title { font-size: 1rem; font-weight: 700; line-height: 1.25; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.lp-menu__price { display: flex; flex-wrap: wrap; align-items: baseline; gap: .4rem; font-size: .9375rem; font-weight: 700; }
.lp-menu__price s { color: rgb(var(--lp-muted)); font-weight: 400; font-size: .875rem; }
@media (min-width: 1000px) { .lp-menu { display: none !important; } }
@media (prefers-reduced-motion: reduce) {
  .lp-menu, .lp-menu__panel, .lp-burger i { transition: none !important; }
}
{% endstylesheet %}
