{% doc %}
  Checkout confirmation that asks whether an IBO referred the shopper (replaces the old slide-in and floating tab,
  2026-11-18). Shown when Checkout is pressed, only if the Teqnavi referral app is present, no referrer is set yet,
  and the shopper has not ticked "Don't show this again". "Add My Referrer" opens the app's own enroller search,
  so attribution logic stays in the app. Logic: initReferralCheckout in assets/lp-premium.js.

  @example
  {% render 'lp-referral-nudge' %}
{% enddoc %}

{%- unless request.design_mode -%}
<dialog class="lp-refq" data-lp-refq aria-labelledby="lp-refq-title" aria-describedby="lp-refq-text">
  <button type="button" class="lp-refq__close" data-lp-refq-close aria-label="{{ 'general.accessibility.close' | t | escape }}">
    <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M1 1l10 10M11 1 1 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
  </button>
  <div class="lp-refq__art" aria-hidden="true">
    <video class="lp-refq__video" muted playsinline preload="none" poster="{{ 'lp-referral-poster.jpg' | asset_url }}" width="160" height="160">
      <source data-src="{{ 'lp-referral-anim.mp4' | asset_url }}" type="video/mp4">
    </video>
  </div>
  <p class="lp-refq__eyebrow">{{ 'lp.referral.eyebrow' | t }}</p>
  <p class="lp-refq__title" id="lp-refq-title">{{ 'lp.referral.title' | t }}</p>
  <p class="lp-refq__text" id="lp-refq-text">{{ 'lp.referral.text' | t }}</p>
  <div class="lp-refq__actions">
    <button type="button" class="button lp-refq__add" data-lp-refq-add>{{ 'lp.referral.add' | t }}</button>
    <button type="button" class="lp-refq__skip" data-lp-refq-skip>{{ 'lp.referral.skip' | t }}</button>
  </div>
  <label class="lp-refq__never">
    <input type="checkbox" data-lp-refq-never>
    <span class="lp-refq__box" aria-hidden="true"><svg width="10" height="10" viewBox="0 0 12 12"><path d="m2 6.5 2.5 2.5L10 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
    <span>{{ 'lp.referral.never' | t }}</span>
  </label>
</dialog>
{%- endunless -%}

{% stylesheet %}
.shopify-section:has(.referral-banner) .section { padding: 0 !important; background: none !important; }
div.referral-banner.referral-banner:not(#lp-none) { padding: 0 !important; }
.referral-banner { height: 0 !important; min-height: 0 !important; padding: 0 !important; background: none !important; overflow: visible !important; }
.referral-banner__row { display: none !important; }

/* Referral question at checkout: a quiet, centred card in the top layer */
.lp-refq { width: min(26rem, calc(100vw - 32px)); max-height: calc(100dvh - 32px); padding: 2rem 1.75rem 1.5rem; border: 0; border-radius: 24px; background: #fff; color: rgb(var(--lp-ink)); text-align: center; box-shadow: 0 30px 80px -24px rgb(var(--lp-ink) / .35); overflow: auto; }
.lp-refq::backdrop { background: rgb(var(--lp-ink) / .45); backdrop-filter: blur(2px); }
.lp-refq[open] { animation: lp-refq-in 320ms cubic-bezier(.16, 1, .3, 1); }
.lp-refq[open]::backdrop { animation: lp-refq-fade 240ms ease-out; }
@keyframes lp-refq-in { from { opacity: 0; transform: translateY(14px) scale(.98); } to { opacity: 1; transform: none; } }
@keyframes lp-refq-fade { from { opacity: 0; } to { opacity: 1; } }
.lp-refq__close { position: absolute; top: .875rem; right: .875rem; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 999px; border: 1px solid rgb(var(--lp-ink) / .12); background: #fff; color: rgb(var(--lp-ink)); cursor: pointer; transition: background-color 160ms ease-out, border-color 160ms ease-out; }
@media (hover: hover) { .lp-refq__close:hover { background: rgb(var(--lp-sand)); border-color: transparent; } }
.lp-refq__art { width: 88px; aspect-ratio: 1; margin: 0 auto 1rem; border-radius: 20px; overflow: hidden; background: rgb(var(--lp-sand)); }
.lp-refq__video { display: block; width: 100%; height: 100%; object-fit: cover; }
.lp-refq__eyebrow { margin: 0 0 .5rem; font-size: .6875rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: rgb(var(--lp-amber)); }
.lp-refq__title { margin: 0 0 .5rem; font-family: var(--lp-serif); font-weight: 400; font-size: 1.625rem; line-height: 1.2; text-wrap: balance; }
.lp-refq__text { margin: 0 auto 1.5rem; max-width: 30ch; font-size: .9375rem; line-height: 1.55; color: rgb(var(--lp-muted)); }
.lp-refq__actions { display: grid; gap: .5rem; }
.lp-refq__add.button { width: 100%; min-height: 52px; }
button.lp-refq__skip:not(#lp-none) { width: 100%; min-height: 52px; padding: 0 1rem; border-radius: var(--button-border-radius, 999px); border: 0; background: transparent; box-shadow: inset 0 0 0 1px rgb(var(--lp-ink) / .18); color: rgb(var(--lp-ink)); font: inherit; font-size: .9375rem; font-weight: 600; cursor: pointer; transition: box-shadow 160ms ease-out, background-color 160ms ease-out; }
@media (hover: hover) { button.lp-refq__skip:not(#lp-none):hover { box-shadow: inset 0 0 0 1.5px rgb(var(--lp-ink)); } }
.lp-refq__never { position: relative; display: inline-flex; align-items: center; gap: .5rem; min-height: 44px; margin-top: .75rem; font-size: .8125rem; color: rgb(var(--lp-muted)); cursor: pointer; user-select: none; }
.lp-refq__never input { position: absolute; opacity: 0; width: 1px; height: 1px; }
.lp-refq__box { display: grid; place-items: center; width: 18px; height: 18px; border-radius: 5px; border: 1.5px solid rgb(var(--lp-ink) / .35); background: #fff; color: transparent; transition: background-color 160ms ease-out, border-color 160ms ease-out, color 160ms ease-out; }
.lp-refq__never input:checked + .lp-refq__box { background: rgb(var(--lp-ink)); border-color: rgb(var(--lp-ink)); color: #fff; }
.lp-refq__never input:focus-visible + .lp-refq__box { outline: 2px solid rgb(var(--lp-amber-deep)); outline-offset: 2px; }
.lp-refq :is(.lp-refq__close, .lp-refq__add, .lp-refq__skip):focus-visible { outline: 2px solid rgb(var(--lp-amber-deep)); outline-offset: 2px; }
@media (max-width: 480px) {
  .lp-refq { width: 100vw; max-width: 100vw; margin: auto 0 0; padding: 1.75rem 1.25rem calc(1rem + env(safe-area-inset-bottom)); border-radius: 24px 24px 0 0; }
  .lp-refq[open] { animation-name: lp-refq-up; }
  @keyframes lp-refq-up { from { transform: translateY(100%); } to { transform: none; } }
}
@media (prefers-reduced-motion: reduce) { .lp-refq[open], .lp-refq[open]::backdrop { animation: none; } }
{% endstylesheet %}
