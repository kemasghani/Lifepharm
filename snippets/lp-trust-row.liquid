{% doc %}
  Renders the LifePharm reassurance grid shown under the product buy buttons: six tiles,
  one consistent line-icon style (lp-icon) in brand orange; the first four are the brand badge motifs drawn as line icons.

  @example
  {% render 'lp-trust-row' %}
{% enddoc %}
{%- liquid
  assign t_keys = 'guarantee|tested|made|studied|shipping|secure' | split: '|'
  assign t_icons = 'trust-guarantee|trust-nsf|trust-usa|trust-flask|truck|lock' | split: '|'
-%}
<ul class="lp-trust-row" role="list">
  {%- for key in t_keys -%}
    {%- liquid
      assign i = forloop.index0
      assign label_key = 'lp.trust.' | append: key
    -%}
    <li class="lp-trust-row__item">
      <span class="lp-trust-row__icon">{% render 'lp-icon', name: t_icons[i], size: 20 %}</span>
      <span>{{ label_key | t }}</span>
    </li>
  {%- endfor -%}
</ul>
