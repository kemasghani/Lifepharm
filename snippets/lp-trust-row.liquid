{% doc %}
  Renders the LifePharm reassurance grid shown under the product buy buttons, in one consistent
  line-icon style (lp-icon) in brand orange; the first four redraw the brand badges (rings included)
  as line icons, measured against the original artwork.

  The three product claims (Fully NSF Tested, Made in the USA, Clinically Studied) show only on a
  product tagged "Nutritionals", the range those claims are made for. Every other product shows the
  guarantee, delivery and checkout tiles. The delivery tile reads the store's own free delivery
  threshold (Theme settings > Cart) in the store's currency, so no store shows another market's line.

  @param {product} product - The product being viewed

  @example
  {% render 'lp-trust-row', product: product %}
{% enddoc %}
{%- liquid
  assign t_keys = 'guarantee|tested|made|studied|shipping|secure' | split: '|'
  assign t_icons = 'seal-guarantee|seal-nsf|seal-usa|seal-flask|truck|lock' | split: '|'
  assign claim_keys = 'tested|made|studied'

  assign show_claims = false
  if product.tags contains 'Nutritionals'
    assign show_claims = true
  endif

  assign threshold = settings.cart_free_shipping_threshold | times: 100
  assign threshold_text = threshold | money_without_trailing_zeros | strip_html
  assign shipping_key = 'lp.trust.shipping'
  if shop.currency == 'GBP'
    assign shipping_key = 'lp.trust.shipping_gbp'
  elsif shop.currency == 'USD'
    assign shipping_key = 'lp.trust.shipping_usd'
  endif
-%}
<ul class="lp-trust-row" role="list">
  {%- for key in t_keys -%}
    {%- liquid
      assign i = forloop.index0
      assign label_key = 'lp.trust.' | append: key
      if claim_keys contains key and show_claims == false
        continue
      endif
      if key == 'shipping'
        if settings.cart_show_free_shipping_threshold == false or threshold <= 0
          continue
        endif
      endif
    -%}
    <li class="lp-trust-row__item">
      <span class="lp-trust-row__icon">{% render 'lp-icon', name: t_icons[i], size: 20 %}</span>
      {%- if key == 'shipping' -%}
        <span>{{ shipping_key | t: amount: threshold_text }}</span>
      {%- else -%}
        <span>{{ label_key | t }}</span>
      {%- endif -%}
    </li>
  {%- endfor -%}
</ul>
