{% doc %}
  Renders one of LifePharm's trust seals as a crisp inline SVG, redrawn from the brand's badge artwork.
  Colour follows currentColor; text uses the page font (Metropolis).

  @param {string} name - Seal: guarantee, usa, nsf, flask
  @param {number} [size] - Rendered size in pixels (default 56)

  @example
  {% render 'lp-trust-seal', name: 'nsf', size: 56 %}
{% enddoc %}
<svg class="lp-seal" width="{{ size | default: 56 }}" height="{{ size | default: 56 }}" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
  {%- when 'guarantee' -%}
      <path id="lp-seal-g" d="M25.53 52.41A27 27 0 1 1 74.47 52.41" fill="none" stroke="none"/>
      <circle cx="50" cy="41" r="17"/>
<path d="M17.77 61.14A38 38 0 0 1 12.58 34.4"/><path d="M8.38 37.6L12.58 34.4L15.98 38.6"/>
<path d="M87.42 34.4A38 38 0 0 1 82.23 61.14"/><path d="M78.33 57.74L82.23 61.14L86.73 58.94"/>
      <path d="M19 70Q50 64 81 70V83Q50 77 19 83Z"/>
      <path d="M19 73H5L10.5 80L5 87H23L19 83M81 73H95L89.5 80L95 87H77L81 83"/>
      <g fill="currentColor" stroke="none" font-family="inherit">
        <text x="50" y="44.8" text-anchor="middle" font-size="10.5" font-weight="800" letter-spacing="-.3">100%</text>
        <text font-size="7" font-weight="800" letter-spacing=".7"><textPath href="#lp-seal-g" startOffset="50%" text-anchor="middle">60-DAY MONEY BACK</textPath></text>
        <text x="50" y="79" text-anchor="middle" font-size="7" font-weight="800" letter-spacing=".9">GUARANTEE</text>
      </g>
  {%- when 'usa' -%}
      <circle cx="50" cy="50" r="46"/>
      <clipPath id="lp-seal-u"><circle cx="50" cy="50" r="38"/></clipPath>
      <circle cx="50" cy="50" r="38"/>
      <g clip-path="url(#lp-seal-u)"><path d="M48 4V52"/><path d="M48 20H96"/><path d="M48 28H96"/><path d="M48 36H96"/><path d="M48 44H96"/><path d="M4 52H96"/><path d="M4 60H96"/><path d="M4 68H96"/><path d="M4 76H96"/><path d="M4 84H96"/></g>
      <path d="M31.0 24.5L28.88 30.09L22.92 30.37L27.58 34.11L26.0 39.88L31.0 36.6L36.0 39.88L34.42 34.11L39.08 30.37L33.12 30.09Z"/>
  {%- when 'nsf' -%}
      <path id="lp-seal-n" d="M22.5 74.76A37 37 0 1 1 77.5 74.76" fill="none" stroke="none"/>
      <circle cx="50" cy="50" r="46"/>
      <circle cx="50" cy="50" r="29"/>
      <g fill="currentColor" stroke="none" font-family="inherit">
        <text font-size="7.4" font-weight="800" letter-spacing=".55"><textPath href="#lp-seal-n" startOffset="50%" text-anchor="middle">NATIONAL SANITATION FOUNDATION</textPath></text>
        <text x="49" y="58" text-anchor="middle" font-size="23" font-weight="800" letter-spacing="-1.2">NSF</text>
        <text x="67.5" y="61" font-size="4.6" font-weight="800">®</text>
      </g>
  {%- when 'flask' -%}
      <circle cx="50" cy="50" r="46"/>
      <path d="M42 36H58M44.5 36V48.5L32.6 70.2Q30.6 75 35.8 75H64.2Q69.4 75 67.4 70.2L55.5 48.5V36"/>
      <path d="M37.5 63.2Q42 59.6 46.4 62.4Q50.6 65 54.2 61.6Q57.8 58.6 62.3 61.9L65.1 67.4Q66.7 71.6 63.1 71.6H36.9Q33.3 71.6 34.9 67.4Z" fill="currentColor" stroke="none"/>
      <circle cx="47" cy="27" r="2.6"/><circle cx="53.6" cy="21.6" r="2.3"/><circle cx="54" cy="29.6" r="2"/>
  {%- endcase -%}
</svg>
