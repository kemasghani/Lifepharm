          "type": "video",
          "settings": {
            "external_video_url": "https://www.youtube.com/watch?v=9dquXo21eG4",
            "poster_image": "shopify://shop_images/fgf-2_lifepharm_761cd22d-e140-4206-a7f0-bc28bcc7dd8e.jpg",
