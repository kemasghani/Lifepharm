<script>
  var AVG_ORDER = 150;
  // Illustrative network model: each person refers ~3, earnings summed across 6 levels
  // at rates 20/15/5/3/2/1  ->  multiplier per personal referral
  var MULT = 0.20 + 3*0.15 + 9*0.05 + 27*0.03 + 81*0.02 + 243*0.01; // = 5.96
  function money(n){ return '$' + Math.round(n).toLocaleString('en-US'); }
  var slider = document.getElementById('slider');
  var peopleNum = document.getElementById('peopleNum');
  var earnNum = document.getElementById('earnNum');
  var notePeople = document.getElementById('notePeople');
  function update(){
    var n = parseInt(slider.value,10);
    peopleNum.textContent = n;
    notePeople.textContent = n;
    earnNum.textContent = money(n * AVG_ORDER * MULT);
  }
  slider.addEventListener('input', update);
  update();

  document.querySelectorAll('.qa button').forEach(function(btn){
    btn.addEventListener('click', function(){
      var item = btn.parentElement;
      var isOpen = item.classList.contains('open');
      document.querySelectorAll('.qa').forEach(function(q){ q.classList.remove('open'); q.querySelector('.sign').textContent='+'; });
      if(!isOpen){ item.classList.add('open'); item.querySelector('.sign').textContent='×'; }
    });
  });

  // Scroll reveal
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
  }, {threshold:0.12});
  document.querySelectorAll('.reveal').forEach(function(el){ io.observe(el); });

  /* ===== Signup ===== */
  /* Signup now goes through the UpPromote registration form
     (lifefunds.lifepharm.com/register). After registration, UpPromote's
     "affiliate created" webhook → Azure Function → Klaviyo texts the
     personal referral link. No direct client-side capture on this page. */

  /* ===== Language selector → live Weglot translations ===== */
  (function () {
    var langSelect = document.getElementById('langSelect');
    if (!langSelect) return;
    function nativeName(code) {
      try { var n = new Intl.DisplayNames([code], { type: 'language' }).of(code); return n ? (n.charAt(0).toUpperCase() + n.slice(1)) : code; }
      catch (e) { return code; }
    }
    function build() {
      var W = window.Weglot; if (!W) return;
      var orig = (W.options && (W.options.language_from || 'en')) || 'en';
      var langs = (W.options && W.options.languages)
        ? W.options.languages.filter(function (l) { return l.enabled && !l.deleted_at; }).map(function (l) { return l.language_to; })
        : [];
      // LifePharm priority markets first, then any other enabled Weglot languages
      var priority = ['en','es','ko','ru','id','hu','de','fr','it','pl','uk','ro','nl','zh','ja'];
      var all = [orig].concat(langs).filter(function (v, i, a) { return a.indexOf(v) === i; });
      var ordered = priority.filter(function (c) { return all.indexOf(c) !== -1; });
      all.forEach(function (c) { if (ordered.indexOf(c) === -1) ordered.push(c); });
      langSelect.innerHTML = '';
      ordered.forEach(function (c) { var o = document.createElement('option'); o.value = c; o.textContent = nativeName(c); langSelect.appendChild(o); });
      try { langSelect.value = (W.getCurrentLang && W.getCurrentLang()) || orig; } catch (e) {}
      langSelect.onchange = function () { if (window.Weglot && Weglot.switchTo) Weglot.switchTo(langSelect.value); };
    }
    // Weglot loads site-wide via the theme; poll briefly until it's ready.
    var tries = 0;
    var iv = setInterval(function () {
      tries++;
      if (window.Weglot && window.Weglot.initialized) { clearInterval(iv); build(); }
      else if (tries > 30) { clearInterval(iv); } // ~15s: Weglot not present (e.g. local preview) — leave English-only
    }, 500);
  })();
</script>
</body>
</html>
