{% layout none %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>LifePharm Ambassador Program — Earn From the Wellness Boom</title>
<meta name="description" content="Earn extra income as a LifePharm Ambassador. Free to join, nothing to buy, no experience needed — share products people already love and get paid.">
<meta property="og:title" content="LifePharm Ambassador Program — Earn Your Share">
<meta property="og:description" content="Free to join. Nothing to buy. Share wellness products people already want and earn — up to 50% across your network.">
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary_large_image">
<!-- TODO: add <meta property="og:image" content="https://<hosted-url>/share.jpg"> once the page is hosted, for a rich social unfurl -->
<meta name="theme-color" content="#F58220">
<style>
  @font-face{font-family:'Metropolis';src:url('{{ 'Metropolis-Regular.otf' | asset_url }}') format('opentype');font-weight:400;font-style:normal;font-display:swap;}
  @font-face{font-family:'Metropolis';src:url('{{ 'Metropolis-Medium.otf' | asset_url }}') format('opentype');font-weight:500;font-style:normal;font-display:swap;}
  @font-face{font-family:'Metropolis';src:url('{{ 'Metropolis-SemiBold.otf' | asset_url }}') format('opentype');font-weight:600;font-style:normal;font-display:swap;}
  @font-face{font-family:'Metropolis';src:url('{{ 'Metropolis-Bold.otf' | asset_url }}') format('opentype');font-weight:700;font-style:normal;font-display:swap;}
  @font-face{font-family:'Metropolis';src:url('{{ 'Metropolis-ExtraBold.otf' | asset_url }}') format('opentype');font-weight:800;font-style:normal;font-display:swap;}
  @font-face{font-family:'Metropolis';src:url('{{ 'Metropolis-Black.otf' | asset_url }}') format('opentype');font-weight:900;font-style:normal;font-display:swap;}

  :root{
    --orange:#F58220; --orange-dark:#d96e12;
    --ink:#2b2b2b; --gray:#4D4D4D; --muted:#6f6a63;
    --bg:#FBF9F5; --card:#FFFFFF; --line:#2b2b2b; --soft:#EAE5DB;
    --shadow:0 10px 30px rgba(0,0,0,.08);
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{margin:0;background:var(--bg);color:var(--ink);font-family:'Metropolis',system-ui,-apple-system,Segoe UI,Roboto,sans-serif;font-size:21px;line-height:1.7;-webkit-font-smoothing:antialiased;}
  h1,h2,h3{font-family:'Metropolis',system-ui,sans-serif;line-height:1.1;letter-spacing:-.5px;}
  .wrap{width:100%;max-width:1120px;margin:0 auto;padding:0 20px;}
  .accent{color:var(--orange);}
  .center{text-align:center;}

  nav{position:sticky;top:0;z-index:50;background:rgba(251,249,245,.92);backdrop-filter:blur(8px);border-bottom:2px solid var(--soft);}
  .nav-inner{display:flex;align-items:center;justify-content:space-between;padding:14px 20px;max-width:1120px;margin:0 auto;}
  .brand{font-weight:800;font-size:1.5rem;color:var(--ink);display:flex;align-items:center;gap:10px;text-decoration:none;}
  .brand .dot{width:16px;height:16px;border-radius:50%;background:var(--orange);display:inline-block;}
  .logo{height:36px;width:auto;display:block;}
  .foot-logo{height:40px;margin-bottom:14px;}
  .btn{display:inline-flex;align-items:center;gap:10px;font-weight:700;font-size:1.15rem;background:var(--orange);color:#fff;text-decoration:none;padding:15px 28px;border-radius:14px;border:none;box-shadow:0 8px 20px rgba(245,130,32,.30);transition:transform .12s ease, box-shadow .12s ease;cursor:pointer;}
  .btn:hover{transform:translateY(-2px);box-shadow:0 12px 26px rgba(245,130,32,.42);}
  .btn:active{transform:translateY(0);box-shadow:0 6px 16px rgba(245,130,32,.30);}
  .btn.small{padding:10px 18px;font-size:1rem;}
  .btn.big{font-size:1.4rem;padding:20px 40px;}

  header{padding:66px 0 40px;}
  .badge{display:inline-block;font-weight:700;font-size:.9rem;letter-spacing:1.5px;text-transform:uppercase;color:var(--orange-dark);background:#fff7ef;border:1px solid #f0ddc7;border-radius:999px;padding:8px 18px;}
  h1{font-size:clamp(2.7rem,8vw,5rem);font-weight:800;margin:26px 0 22px;}
  .lead{font-size:clamp(1.3rem,3.4vw,1.7rem);color:var(--gray);max-width:620px;font-weight:600;}
  .subtle{font-size:1.15rem;color:var(--muted);max-width:560px;margin-top:14px;}
  .hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:40px;align-items:center;}
  .hero-cta{margin-top:34px;display:flex;flex-wrap:wrap;gap:14px;align-items:center;}
  .stack{display:flex;flex-direction:column;gap:20px;}
  .stat-card{background:#fff;border:1px solid #ececec;border-radius:22px;padding:26px 28px;box-shadow:var(--shadow);}
  .stat-card .k{font-weight:800;font-size:clamp(2.2rem,6.5vw,3.2rem);color:var(--ink);line-height:1;}
  .stat-card .k .accent{color:var(--orange);}
  .stat-card .l{font-weight:600;color:var(--muted);font-size:1.05rem;margin-top:8px;}
  .stat-card.pop{background:var(--orange);border-color:var(--line);}
  .stat-card.pop .k,.stat-card.pop .l{color:#fff;}

  section{padding:60px 0;}
  .sec-head{text-align:center;margin-bottom:44px;}
  h2{font-size:clamp(2.1rem,5.6vw,3.4rem);font-weight:800;}
  .sec-head p{font-size:1.25rem;color:var(--muted);margin-top:10px;font-weight:600;}

  /* demand */
  .demand-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;}
  .demand-card{background:#fff;border:1px solid #ececec;border-radius:22px;padding:30px 26px;box-shadow:var(--shadow);text-align:center;}
  .demand-card .num{font-weight:900;color:var(--orange);font-size:clamp(2.8rem,8vw,3.8rem);line-height:1;}
  .demand-card .cap{font-weight:700;color:var(--ink);font-size:1.1rem;margin-top:10px;line-height:1.4;}
  .src{text-align:center;color:var(--muted);font-size:.95rem;margin-top:22px;font-weight:600;}
  .demand-line{text-align:center;font-weight:800;font-size:clamp(1.5rem,4.5vw,2.2rem);max-width:760px;margin:36px auto 0;}

  /* garden / analogy */
  .band{background:var(--ink);color:#fff;border-radius:28px;padding:48px 40px;}
  .band h2{color:#fff;text-align:center;}
  .band .analogy{font-size:clamp(1.25rem,3.2vw,1.6rem);color:#f0ede7;max-width:780px;margin:20px auto 0;text-align:center;font-weight:600;line-height:1.6;}
  .band .analogy strong{color:var(--orange);}

  /* levels visual */
  .levels-card{background:#fff;border:1px solid #ececec;border-radius:24px;box-shadow:var(--shadow);padding:36px 30px;max-width:900px;margin:36px auto 0;text-align:center;}
  .l1-big{font-weight:900;color:var(--orange);font-size:clamp(3rem,10vw,4.6rem);line-height:1;}
  .l1-cap{font-weight:700;font-size:1.15rem;margin-top:4px;}
  .l1-sub{color:var(--muted);font-weight:600;margin-top:6px;}
  .chips{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin:26px 0 6px;}
  .chip{background:#fff8ef;border:1px solid #f0ddc7;border-radius:12px;padding:8px 12px;font-weight:800;min-width:56px;}
  .chip small{display:block;font-weight:600;color:var(--muted);font-size:.7rem;letter-spacing:.5px;}
  .l-total{margin-top:20px;font-weight:800;font-size:clamp(1.4rem,4vw,2rem);}
  .l-total .big{color:var(--orange);}

  /* possible */
  .grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;}
  .poss{background:#fff;border:1px solid #ececec;border-radius:22px;padding:28px 22px;box-shadow:var(--shadow);text-align:center;}
  .poss .step{font-weight:700;letter-spacing:1px;color:var(--muted);text-transform:uppercase;font-size:.9rem;}
  .poss .amt{font-weight:900;font-size:clamp(2.4rem,7vw,3rem);color:var(--orange);line-height:1;margin:10px 0 6px;}
  .poss .desc{font-weight:600;color:var(--gray);font-size:1.05rem;}
  .poss .stepname{font-weight:800;font-size:1.3rem;margin:4px 0 8px;}
  .poss .stepnum{font-weight:900;color:var(--orange);font-size:clamp(2.6rem,7vw,3.2rem);line-height:1;}

  /* calculator */
  .calc{background:#fff;border:1px solid #ececec;border-radius:26px;padding:40px 36px;box-shadow:var(--shadow);max-width:820px;margin:0 auto;}
  .calc-top{display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;margin-bottom:14px;}
  .calc-people{display:flex;align-items:center;gap:16px;}
  .calc-people .ico{width:64px;height:64px;border-radius:18px;background:var(--orange);color:#fff;border:1px solid #ececec;display:flex;align-items:center;justify-content:center;font-size:1.9rem;}
  .calc-people .num{font-weight:800;font-size:clamp(2.4rem,7vw,3.2rem);line-height:1;}
  .calc-people .lbl,.calc-amt .lbl{color:var(--muted);font-weight:700;text-transform:uppercase;letter-spacing:1px;font-size:.85rem;}
  .calc-amt{text-align:right;}
  .calc-amt .num{font-weight:900;color:var(--orange);font-size:clamp(2.6rem,8vw,3.8rem);line-height:1;}
  input[type=range]{-webkit-appearance:none;appearance:none;width:100%;height:14px;border-radius:999px;background:#efece4;border:1px solid #ececec;outline:none;margin:20px 0 6px;}
  input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;appearance:none;width:38px;height:38px;border-radius:50%;background:var(--orange);border:3px solid var(--line);cursor:pointer;box-shadow:2px 2px 0 var(--line);}
  input[type=range]::-moz-range-thumb{width:38px;height:38px;border-radius:50%;background:var(--orange);border:3px solid var(--line);cursor:pointer;}
  .range-ends{display:flex;justify-content:space-between;color:var(--muted);font-weight:700;}
  .calc-note{text-align:center;color:var(--muted);margin-top:20px;font-weight:600;font-size:1.02rem;}
  .calc-note strong{color:var(--ink);}

  /* easy */
  .easy-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;max-width:860px;margin:0 auto;}
  .easy{background:#fff;border:1px solid #ececec;border-radius:20px;padding:24px 26px;box-shadow:var(--shadow);display:flex;align-items:center;gap:16px;}
  .easy .h{font-size:1.9rem;flex-shrink:0;}
  .easy .t{font-weight:800;font-size:1.2rem;}
  .easy .s{font-weight:600;color:var(--muted);font-size:1rem;}

  /* products (compact) */
  .lineup{width:100%;max-width:820px;margin:0 auto 26px;background:#fff;border:1px solid #ececec;border-radius:24px;box-shadow:var(--shadow);padding:24px;}
  .lineup img{width:100%;height:auto;display:block;}
  .name-pills{display:flex;flex-wrap:wrap;justify-content:center;gap:12px;}
  .name-pills span{background:#fff;border:1px solid #ececec;border-radius:999px;padding:9px 20px;font-weight:700;box-shadow:0 4px 14px rgba(0,0,0,.05);}

  /* product showcase (redesigned) */
  .awards{display:flex;flex-wrap:wrap;justify-content:center;gap:16px;margin-bottom:44px;}
  .award{display:flex;flex-direction:column;align-items:center;gap:10px;background:#fff;border:1px solid #ececec;border-radius:18px;box-shadow:var(--shadow);padding:18px 14px;width:150px;text-align:center;}
  .award img{height:58px;width:auto;object-fit:contain;}
  .award .award-ico{height:58px;display:flex;align-items:center;font-size:2.4rem;}
  .award span{font-weight:700;font-size:.82rem;color:var(--gray);line-height:1.35;text-transform:uppercase;letter-spacing:.5px;}
  .prod-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;}
  .prod-card{background:#fff;border:1px solid #ececec;border-radius:20px;box-shadow:var(--shadow);padding:20px 16px;text-align:center;transition:transform .2s ease, box-shadow .2s ease;}
  .prod-card:hover{transform:translateY(-6px);box-shadow:0 18px 40px rgba(0,0,0,.12);}
  .prod-img{aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;padding:8px;margin-bottom:10px;}
  .prod-img img{max-width:100%;max-height:100%;object-fit:contain;animation:float 5s ease-in-out infinite;transition:transform .3s ease;}
  .prod-card:hover .prod-img img{animation-play-state:paused;transform:scale(1.08);}
  .prod-card:nth-child(2) .prod-img img{animation-delay:.6s;}
  .prod-card:nth-child(3) .prod-img img{animation-delay:1.2s;}
  .prod-card:nth-child(4) .prod-img img{animation-delay:1.8s;}
  .prod-card:nth-child(5) .prod-img img{animation-delay:2.4s;}
  .pname{font-weight:800;font-size:1.15rem;}
  .ptag{font-weight:600;color:var(--muted);font-size:.95rem;margin-top:2px;}
  @keyframes float{0%,100%{transform:translateY(0);}50%{transform:translateY(-8px);}}
  .rating-line{text-align:center;font-weight:700;font-size:1.15rem;color:var(--gray);margin-top:36px;}
  .rating-line .stars{color:var(--orange);letter-spacing:2px;}
  .duo{display:flex;align-items:center;justify-content:center;gap:22px;flex-wrap:wrap;max-width:860px;margin:0 auto;}
  .duo-card{flex:1 1 300px;max-width:360px;background:#fff;border:1px solid #ececec;border-radius:22px;box-shadow:var(--shadow);padding:26px 22px;text-align:center;transition:transform .2s ease, box-shadow .2s ease;}
  .duo-card:hover{transform:translateY(-6px);box-shadow:0 18px 40px rgba(0,0,0,.12);}
  .duo-img{height:230px;display:flex;align-items:center;justify-content:center;margin-bottom:14px;}
  .duo-img img{max-width:100%;max-height:100%;object-fit:contain;animation:float 5s ease-in-out infinite;}
  .duo-card:last-child .duo-img img{animation-delay:1.2s;}
  .duo-plus{font-size:2.6rem;font-weight:900;color:var(--orange);flex:0 0 auto;}
  .duo-name{font-weight:800;font-size:1.35rem;}
  .duo-tag{font-weight:600;color:var(--muted);font-size:1rem;margin-top:8px;line-height:1.45;}
  .duo-line{text-align:center;font-weight:700;font-size:clamp(1.2rem,3.4vw,1.5rem);margin:34px auto 0;max-width:660px;}
  .more-note{text-align:center;color:var(--muted);font-weight:600;margin-top:16px;}
  .award-ico svg,.easy .h svg{stroke:var(--orange);fill:none;display:block;}
  .award-ico svg{width:46px;height:46px;}
  .easy .h svg{width:34px;height:34px;}
  .trust-strip{display:flex;flex-wrap:wrap;justify-content:center;gap:10px 26px;padding:16px 20px;background:#fff;border-top:1px solid var(--soft);border-bottom:1px solid var(--soft);font-weight:700;color:var(--gray);}
  .trust-strip span:first-child{color:var(--orange);letter-spacing:2px;}
  .compare{display:flex;align-items:stretch;justify-content:center;gap:20px;flex-wrap:wrap;max-width:900px;margin:0 auto;}
  .compare-card{flex:1 1 320px;max-width:400px;border-radius:22px;padding:32px 28px;text-align:center;border:1px solid #ececec;box-shadow:var(--shadow);background:#fff;}
  .compare-card.dim{opacity:.9;}
  .compare-card.win{border:2px solid var(--orange);}
  .compare-card .ct{font-weight:700;color:var(--muted);font-size:.95rem;text-transform:uppercase;letter-spacing:.5px;}
  .compare-card .cbig{font-weight:900;font-size:clamp(2.6rem,7vw,3.4rem);line-height:1;margin:14px 0 4px;}
  .compare-card.dim .cbig{color:var(--gray);}
  .compare-card.win .cbig{color:var(--orange);}
  .compare-card .csub{font-weight:800;font-size:1.3rem;}
  .compare-card .cnote{font-weight:600;color:var(--muted);margin-top:12px;font-size:1rem;line-height:1.4;}
  .vs{align-self:center;font-weight:900;color:var(--muted);font-size:1.3rem;}
  .reviews{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;}
  .review{background:#fff;border:1px solid #ececec;border-radius:22px;box-shadow:var(--shadow);padding:28px 26px;}
  .review .stars{color:var(--orange);letter-spacing:2px;font-size:1.2rem;}
  .review .q{font-size:1.1rem;font-weight:600;color:var(--ink);margin:12px 0 16px;line-height:1.55;}
  .review .who{color:var(--muted);font-weight:700;}
  .proof-note{text-align:center;color:var(--muted);font-weight:600;font-size:.95rem;margin:26px auto 0;max-width:760px;}
  .stats-band{display:flex;flex-wrap:wrap;justify-content:center;gap:24px 56px;margin-bottom:40px;text-align:center;}
  .stat-big{min-width:170px;}
  .stat-big .num{font-weight:900;color:var(--orange);font-size:clamp(2.4rem,7vw,3.6rem);line-height:1;}
  .stat-big .lbl{font-weight:700;color:var(--gray);margin-top:8px;font-size:1.02rem;}
  .awards-note{text-align:center;color:var(--muted);font-weight:600;font-size:.88rem;margin:18px auto 0;max-width:720px;line-height:1.5;}
  .mid-cta{text-align:center;padding:0 20px 8px;}
  .sticky-cta{display:none!important;}
  .reveal{opacity:0;transform:translateY(26px);transition:opacity .7s ease, transform .7s ease;}
  .reveal.in{opacity:1;transform:none;}
  @media(prefers-reduced-motion:reduce){.prod-img img{animation:none;}.reveal{opacity:1;transform:none;transition:none;}}

  /* faq */
  .faq{max-width:820px;margin:0 auto;display:flex;flex-direction:column;gap:16px;}
  .qa{background:#fff;border:1px solid #ececec;border-radius:18px;box-shadow:var(--shadow);overflow:hidden;}
  .qa button{width:100%;text-align:left;background:none;border:none;cursor:pointer;font-family:'Metropolis',sans-serif;font-weight:700;font-size:1.3rem;color:var(--ink);padding:22px 26px;display:flex;justify-content:space-between;align-items:center;gap:16px;}
  .qa .sign{color:var(--orange);font-size:1.8rem;line-height:1;flex-shrink:0;}
  .qa .ans{max-height:0;overflow:hidden;transition:max-height .3s ease;}
  .qa .ans p{padding:0 26px 24px;margin:0;color:var(--gray);font-weight:600;font-size:1.15rem;border-top:2.5px dashed var(--soft);padding-top:18px;}
  .qa.open .ans{max-height:420px;}
  .qa.open .sign{transform:rotate(45deg);}

  .final{text-align:center;padding:78px 0;}
  .final h2{max-width:760px;margin:0 auto 18px;}
  .final p{font-size:1.3rem;color:var(--gray);font-weight:600;margin-bottom:34px;}

  footer{border-top:1px solid var(--soft);padding:52px 0 40px;background:#fff;}
  .foot-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:36px;}
  .foot-brand .brand{font-size:1.6rem;margin-bottom:12px;}
  .foot-brand p{color:var(--muted);font-weight:600;max-width:280px;}
  .foot-col h4{font-weight:700;text-transform:uppercase;letter-spacing:1px;font-size:.95rem;color:var(--ink);margin:0 0 14px;}
  .foot-col a{display:block;color:var(--gray);text-decoration:none;font-weight:600;margin-bottom:10px;}
  .foot-col a:hover{color:var(--orange);}
  .disclaimer{max-width:1120px;margin:40px auto 0;padding:24px 20px 0;border-top:2px solid var(--soft);color:var(--muted);font-size:.95rem;font-weight:600;line-height:1.6;}

  @media(max-width:900px){
    .hero-grid{grid-template-columns:1fr;}
    .demand-grid,.grid3{grid-template-columns:1fr;}
    .prod-grid{grid-template-columns:repeat(3,1fr);}
    .reviews{grid-template-columns:1fr;}
  }
  @media(max-width:560px){
    body{font-size:20px;}
    header{padding:42px 0 20px;}
    .easy-grid{grid-template-columns:1fr;}
    .prod-grid{grid-template-columns:repeat(2,1fr);}
    .foot-grid{grid-template-columns:1fr;}
    .calc-amt{text-align:left;}
    .nav-links{display:none;}
  }

  /* --- added: language selector, prominent reassurance, phone signup --- */
  .nav-right{display:flex;align-items:center;gap:14px;}
  .lang-select{font-family:'Metropolis',sans-serif;font-weight:700;font-size:.95rem;color:var(--gray);background:#fff;border:1px solid #e3ddd2;border-radius:10px;padding:9px 12px;cursor:pointer;}
  .reassure{font-size:clamp(1.02rem,2.6vw,1.22rem);color:var(--ink);font-weight:800;margin-top:16px;line-height:1.55;max-width:600px;}
  .reassure .ok{color:var(--orange);font-weight:900;}
  .hero-note{font-size:.98rem;color:var(--muted);font-weight:600;margin-top:10px;}
  .join-form{max-width:640px;margin:0 auto;}
  .join-row{display:flex;gap:10px;align-items:stretch;justify-content:center;flex-wrap:nowrap;}
  #countryCode{font-family:'Metropolis',sans-serif;font-weight:700;font-size:1.1rem;border:2px solid var(--soft);border-radius:14px;padding:0 12px;background:#fff;cursor:pointer;}
  #phoneInput{flex:1 1 auto;min-width:0;font-family:'Metropolis',sans-serif;font-size:1.25rem;font-weight:600;border:2px solid var(--soft);border-radius:14px;padding:16px 18px;outline:none;}
  #phoneInput:focus{border-color:var(--orange);}
  .join-consent{font-size:.8rem;color:var(--muted);font-weight:600;max-width:560px;margin:16px auto 0;line-height:1.5;}
  .join-msg{font-weight:800;margin-top:14px;min-height:1.2em;}
  .join-msg.ok{color:#1a8a4a;}
  .join-msg.err{color:#c0392b;}
  .join-alt{margin-top:20px;font-weight:600;color:var(--muted);}
  .join-alt a{color:var(--orange-dark);font-weight:800;}
  /* Hide the site-wide "VIP ACCESS" email-capture (Alia) on THIS page only */
  [id^="alia-root-"],[id^="alia-popup-root"],[id^="alia-u"]{display:none!important;visibility:hidden!important;}
