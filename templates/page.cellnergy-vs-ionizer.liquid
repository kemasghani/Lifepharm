{% layout 'lp' %}
{% comment %}
  CELLNERGY vs. the $7,000 water ionizer (warm / comparison-led). Layout: lp.
  Checkout: JS adds item(s) via /cart/add.js then redirects to /discount/CODE?redirect=/checkout
  (bypasses a store app that mangles /cart permalinks). Codes to create in Shopify > Discounts (fixed $ off):
    SWAP10  -> 1 Bottle  (-$10)
    SWAP20  -> 3 Bottles (-$20)
  Variants: single 53040002400565 | triple 53003471388981 | diffuser 53049168167221.
  Images: 16 webp + pH video load from Shopify Files CDN; bbb/bottle/ph-thumb/truemed from Theme Assets.
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700;800&family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --orange:#F58220; --orange-dk:#CC6A12; --orange-soft:#FFF3E6;
    --ink:#211E1B; --gray:#403C37; --muted:#6E6860;
    --bg:#FFFFFF; --cream:#FBF7F1; --line:#E7E0D7; --ok:#237A4E;
    --shadow-sm:0 2px 10px rgba(43,38,32,.07);
    --shadow:0 12px 34px rgba(43,38,32,.12);
    --shadow-lg:0 28px 64px rgba(43,38,32,.20);
    --radius:16px; --radius-lg:26px;
    --serif:'Playfair Display',Georgia,serif;
    --sans:'Montserrat',-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;
    --maxw:1120px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{font-family:var(--sans);color:var(--gray);background:var(--bg);line-height:1.68;font-size:17.5px;-webkit-font-smoothing:antialiased}
  h1,h2,h3{font-family:var(--serif);color:var(--ink);line-height:1.14;font-weight:700}
  strong{color:var(--ink);font-weight:700}
  a{color:inherit;text-decoration:none}
  img{max-width:100%;display:block}
  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px}
  .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:var(--orange);color:#fff;font-family:var(--sans);font-weight:700;font-size:18px;padding:17px 34px;border-radius:999px;border:none;cursor:pointer;transition:transform .2s,background .2s,box-shadow .2s;box-shadow:0 10px 24px rgba(245,130,32,.32)}
  .btn:hover{background:var(--orange-dk);transform:translateY(-2px);box-shadow:0 16px 30px rgba(245,130,32,.42)}
  .btn:focus-visible{outline:3px solid #F9B679;outline-offset:2px}
  .btn.big{font-size:19px;padding:19px 42px}.btn.block{width:100%}
  .strike{color:var(--muted);text-decoration:line-through;font-weight:600}
  .price{color:var(--orange);font-weight:800}
  .section{padding:82px 0}
  .center{text-align:center}
  .lead{font-size:21px;color:var(--gray);max-width:640px;line-height:1.6}
  .center .lead{margin-left:auto;margin-right:auto}
  h2.h{font-size:clamp(30px,4.6vw,48px)}
  .kicker-line{width:56px;height:4px;background:var(--orange);border-radius:2px;margin:18px auto 24px}
  .reveal{opacity:0;transform:translateY(24px);transition:opacity .6s ease,transform .6s ease}
  .reveal.in{opacity:1;transform:none}
  @media (prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none;transition:none}.btn,.stepcard{transition:none!important}.marquee-track{animation:none!important}}
  header{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.94);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
  .announce{background:var(--ink);color:#fff;display:flex;align-items:center;justify-content:center;gap:14px;padding:9px 16px;font-size:14px;font-weight:600;text-align:center}
  .announce b{color:var(--orange);font-weight:800}
  .announce s{color:#b9b2a8;font-weight:500;margin-left:2px}
  .announce a{background:var(--orange);color:var(--ink);padding:6px 14px;border-radius:999px;font-weight:800;font-size:13px;text-decoration:none;white-space:nowrap}
  @media(max-width:520px){.announce{font-size:12.5px;gap:10px;padding:8px 12px}.announce a{padding:5px 11px}}
  .nav{display:flex;align-items:center;justify-content:space-between;height:66px}
  .logo{font-family:var(--serif);font-weight:800;font-size:23px;color:var(--ink)}
  .logo span{display:block;font-family:var(--sans);font-weight:600;font-size:9px;letter-spacing:.28em;color:var(--muted);margin-top:-3px}
  .nav-right{display:flex;align-items:center;gap:18px}
  .nav-note{font-size:13px;font-weight:600;color:var(--gray)}
  .nav .btn{padding:12px 24px;font-size:15px;box-shadow:none}
  @media(max-width:640px){.nav-note{display:none}}

  /* HERO: split — white text panel left, photo right feathered */
  .herobanner{display:flex;align-items:stretch;min-height:600px;background:#fff;overflow:hidden}
  .hero-copy{flex:0 0 47%;display:flex;flex-direction:column;justify-content:center;padding:56px 46px 56px max(24px,5.5vw);position:relative;z-index:2}
  .hero-media{flex:1;position:relative;overflow:hidden}
  .hero-media img{width:100%;height:100%;object-fit:cover;object-position:center}
  .hero-media::before{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,#fff 0%,rgba(255,255,255,.82) 7%,rgba(255,255,255,0) 26%)}
  .hero-copy h1{font-size:clamp(36px,4.2vw,54px);font-weight:800;letter-spacing:-.015em;color:var(--ink)}
  .hero-copy .lead{margin-top:20px;font-size:20px}
  .cta-row{margin-top:30px;display:flex;align-items:center;gap:16px;flex-wrap:wrap}
  .deal{font-size:15px;font-weight:600;color:var(--gray)}
  .stars{display:inline-flex;gap:2px;vertical-align:middle}
  .trustrow{margin-top:24px;display:flex;gap:14px;flex-wrap:wrap;align-items:center;font-size:14px;font-weight:600;color:var(--gray)}
  .trustrow .dot{width:5px;height:5px;border-radius:50%;background:#C9C1B5}
  .jumps{margin-top:26px;display:flex;gap:12px;flex-wrap:wrap}
  .jump{font-weight:600;font-size:14.5px;color:var(--ink);background:#fff;border:1px solid var(--line);padding:11px 18px;border-radius:999px;transition:border-color .2s,transform .2s;box-shadow:var(--shadow-sm)}
  .jump:hover{border-color:var(--orange);transform:translateY(-2px)}
  .jump.primary{border-color:var(--orange);color:var(--orange-dk)}
  .herodeal{margin-top:18px;display:inline-flex;align-self:flex-start;align-items:center;gap:12px;flex-wrap:wrap;background:var(--orange-soft);border:1px solid #F6D6AE;border-radius:14px;padding:7px 18px}
  .hd-was{font-size:22px;color:var(--muted);text-decoration:line-through;font-weight:600}
  .hd-now{font-family:var(--serif);font-size:34px;font-weight:800;color:var(--orange);line-height:1}
  .hd-save{background:var(--orange);color:#fff;font-weight:800;font-size:13px;padding:7px 13px;border-radius:999px}
  @media(max-width:820px){
    .herobanner{display:block;position:relative;min-height:600px}
    .hero-media{position:absolute;inset:0;width:100%;height:100%}
    .hero-media img{object-position:center 55%}
    .hero-media::before{display:block;background:linear-gradient(180deg,#fff 0%,rgba(255,255,255,.93) 30%,rgba(255,255,255,.4) 56%,rgba(255,255,255,0) 78%)}
    .hero-copy{position:relative;z-index:2;padding:36px 24px 44px;max-width:100%}
  }

  .marquee{background:var(--ink);overflow:hidden;padding:18px 0}
  .marquee-track{display:flex;align-items:center;width:max-content;animation:scroll 30s linear infinite}
  .marquee:hover .marquee-track{animation-play-state:paused}
  @keyframes scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}
  .mitem{display:flex;align-items:center;gap:10px;margin-right:56px;color:#F1EEEA;font-weight:700;font-size:15px;white-space:nowrap}
  .mitem img{height:26px;width:auto;opacity:1}
  .mitem img.badge{filter:none;opacity:1;height:30px;background:#fff;padding:3px 7px;border-radius:6px}
  .mitem svg{width:20px;height:20px;stroke:var(--orange)}
  .bridge{background:var(--cream)}
  .bridge .close{margin-top:16px;font-family:var(--serif);font-size:clamp(20px,2.6vw,27px);color:var(--ink)}
  .bridge .close .price{color:var(--orange)}
  .bridge-copy{max-width:720px;margin:0 auto}
  .bridge-copy p{font-size:18px;line-height:1.6;color:var(--gray);margin:0 0 16px}
  .bridge-copy p:last-child{margin-bottom:0}
  .bridge-punch{font-family:var(--serif);font-size:clamp(22px,3vw,28px)!important;color:var(--ink)!important;font-weight:700;line-height:1.2;margin:22px 0!important}
  .bridge-final{color:var(--ink)!important;font-weight:600;font-size:19px!important}
  .panels{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;max-width:1000px;margin:0 auto}
  .panels figure{position:relative;border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow-sm);aspect-ratio:1/1}
  .panels img{width:100%;height:100%;object-fit:cover;transition:transform .5s ease}
  .panels figure:hover img{transform:scale(1.06)}
  .panels figcaption{position:absolute;left:0;right:0;bottom:0;padding:16px;background:linear-gradient(180deg,transparent,rgba(33,30,27,.66));color:#fff;font-weight:700;font-size:15px}
  @media(max-width:640px){.panels{grid-template-columns:1fr;max-width:420px}}
  @media (prefers-reduced-motion:reduce){.panels img{transition:none}}
  .waysolution{margin-top:30px}
  .ws-inner{display:flex;align-items:stretch;background:var(--ink);color:#fff;border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-lg)}
  .ws-photo{flex:0 0 44%;position:relative;min-height:360px}
  .ws-photo img{width:100%;height:100%;object-fit:cover;position:absolute;inset:0}
  .ws-text{flex:1;padding:46px 50px;align-self:center}
  .ws-text .wstag{display:inline-block;background:var(--orange);color:#fff;font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;padding:6px 14px;border-radius:999px;margin-bottom:14px}
  .ws-text h3{color:#fff;font-size:31px;margin-bottom:20px;line-height:1.14}
  .ws-bullets{list-style:none;margin:0;padding:0}
  .ws-bullets li{display:flex;align-items:flex-start;gap:11px;color:#EAE6E0;font-size:17px;margin-bottom:13px;font-weight:500}
  .ws-bullets li:last-child{margin-bottom:0;color:#fff;font-weight:800}
  .ws-bullets svg{width:21px;height:21px;stroke:var(--orange);fill:none;stroke-width:2.6;flex-shrink:0;margin-top:2px}
  @media(max-width:760px){.ws-inner{flex-direction:column}.ws-photo{flex:none;min-height:280px}.ws-text{padding:30px 26px}}
  /* warm-only: smarter option, no dark box — sits on the beige panel */
  .smarter-warm{display:grid;grid-template-columns:.9fr 1.1fr;gap:48px;align-items:center}
  .sw-photo{border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-lg)}
  .sw-photo img{width:100%;height:100%;object-fit:cover;display:block;aspect-ratio:4/5}
  .sw-text .wstag{display:inline-block;background:var(--orange);color:#fff;font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;padding:6px 14px;border-radius:999px;margin-bottom:16px}
  .sw-text h2{font-size:34px;margin-bottom:6px;line-height:1.12}
  .sw-sub{font-size:19px;color:var(--gray);font-weight:600;margin-bottom:22px}
  .sw-bullets{list-style:none;margin:0;padding:0}
  .sw-bullets li{display:flex;align-items:flex-start;gap:11px;color:var(--ink);font-size:17px;margin-bottom:13px;font-weight:500}
  .sw-bullets svg{width:21px;height:21px;stroke:var(--orange);fill:none;stroke-width:2.6;flex-shrink:0;margin-top:2px}
  .sw-offer{display:flex;align-items:center;gap:18px;margin-top:26px;flex-wrap:wrap}
  .sw-price{font-size:18px;color:var(--ink);font-weight:700}
  .sw-price b{color:var(--orange);font-size:23px}
  @media(max-width:820px){.smarter-warm{grid-template-columns:1fr;gap:26px}.sw-photo img{aspect-ratio:16/10}}
  .difftech{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:32px}
  .tchip{display:flex;align-items:center;gap:9px;background:#fff;border:1px solid var(--line);border-radius:999px;padding:13px 24px;font-weight:600;font-size:15.5px;color:var(--ink);box-shadow:var(--shadow-sm);transition:transform .25s,background .25s,box-shadow .25s}
  .tchip:hover{transform:scale(1.07);background:var(--orange-soft);box-shadow:0 0 0 3px rgba(245,130,32,.22),0 10px 22px rgba(245,130,32,.2)}
  .tchip svg{width:20px;height:20px;stroke:var(--orange);fill:none;stroke-width:2}
  .cmp-scroll{overflow-x:auto;padding:8px 0 4px}
  .cmp{display:flex;gap:0;min-width:680px;max-width:880px;margin:40px auto 0;align-items:stretch}
  .col{flex:1;display:flex;flex-direction:column}
  .col.labels{flex:1.2}
  .col.us{flex:1.16;background:var(--orange);border-radius:22px;box-shadow:var(--shadow-lg);transform:translateY(-14px);z-index:2;color:#fff;padding-bottom:14px}
  .chead{height:200px;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;gap:10px;padding:16px 8px}
  .ptile{width:104px;height:104px;border-radius:16px;background:#fff;border:1px solid var(--line);display:flex;align-items:center;justify-content:center;overflow:hidden;box-shadow:0 6px 16px rgba(43,38,32,.10)}
  .ptile img{width:100%;height:100%;object-fit:contain;padding:6px}
  .cname{font-family:var(--serif);font-weight:800;font-size:16px;color:var(--ink);text-align:center;line-height:1.1}
  .col.us .cname{color:#fff}
  .ctag{font-size:10.5px;font-weight:800;letter-spacing:.08em;padding:5px 13px;border-radius:999px;background:var(--ink);color:#fff}
  .col.us .ctag{background:#fff;color:var(--orange)}
  .crow{min-height:94px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:12px 10px;border-top:1px solid var(--line);font-size:14.5px;line-height:1.35;color:var(--gray)}
  .col.us .crow{border-top:1px solid rgba(255,255,255,.28);color:#fff;font-weight:600}
  .col.labels .crow{align-items:flex-start;text-align:left;font-weight:700;color:var(--ink)}
  .crow.head-sp{min-height:200px;border-top:none}
  .bigp{font-family:var(--serif);font-weight:800;font-size:27px;color:var(--ink)}
  .col.us .bigp{color:#fff}
  .yes{color:var(--orange);font-weight:800;font-size:22px}.col.us .yes{color:#fff}
  .no{color:#BDB6AC;font-weight:800;font-size:22px}
  .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:44px}
  .stepcard{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:32px 26px;text-align:center;box-shadow:var(--shadow-sm);transition:transform .3s cubic-bezier(.2,.7,.2,1),box-shadow .3s}
  .stepcard:hover{transform:scale(1.05) translateY(-5px);box-shadow:var(--shadow)}
  .stepcard .n{font-family:var(--serif);font-weight:800;font-size:42px;color:var(--orange);line-height:1}
  .stepcard h3{font-size:21px;margin:12px 0 8px}.stepcard p{font-size:16.5px}
  @media(max-width:820px){.steps{grid-template-columns:1fr}}
  .conv-grid{display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:center}
  @media(max-width:860px){.conv-grid{grid-template-columns:1fr;gap:28px}}
  .proof{background:var(--cream)}
  .rhead{display:flex;flex-direction:column;align-items:center;gap:6px;margin-bottom:8px}
  .rhead .num{font-family:var(--serif);font-weight:800;font-size:40px;color:var(--ink)}
  .reviews-sub{text-align:center;font-size:16px;color:var(--gray);margin:-2px auto 26px;max-width:560px}
  .tgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;margin:0 auto 8px;max-width:920px}
  .revcard{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:24px;box-shadow:var(--shadow-sm)}
  .revcard .rvstars{margin-bottom:10px}
  .revcard p{font-size:16.5px;color:var(--ink);line-height:1.6}
  .rvwho{display:flex;align-items:center;gap:12px;margin-top:16px}
  .avatar{width:42px;height:42px;border-radius:50%;background:var(--orange-soft);color:var(--orange-dk);font-weight:800;font-size:15px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
  .rvname{font-weight:700;font-size:14px;color:var(--ink);line-height:1.3}
  .verified{display:block;font-weight:600;font-size:12.5px;color:var(--ok)}
  @media(max-width:760px){.tgrid{grid-template-columns:1fr}}
  .rev-divider{text-align:center;font-size:12px;font-weight:800;letter-spacing:.14em;color:var(--muted);text-transform:uppercase;margin:36px 0 22px}
  #stamped-main-widget{max-width:920px;margin:0 auto}
  #stamped-main-widget .stamped-fa-star:before,#stamped-main-widget .stamped-fa-star-half:before{color:var(--orange)!important}
  #stamped-main-widget .stamped-summary-actions-newreview,#stamped-main-widget .stamped-button,#stamped-main-widget button.stamped-button{background:var(--orange)!important;border-color:var(--orange)!important;color:#fff!important}
  .stamped-fallback{text-align:center;margin-top:20px}
  .stamped-fallback a{display:inline-block;padding:13px 26px;border:2px solid var(--orange);color:var(--orange-dk);border-radius:999px;font-weight:700;font-size:16px}
  .offer-wrap{display:grid;grid-template-columns:.92fr 1.08fr;gap:40px;align-items:stretch;max-width:980px;margin:44px auto 0}
  .offer-photo{border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow)}
  .offer-photo img{width:100%;height:100%;object-fit:cover;min-height:480px}
  @media(max-width:860px){.offer-wrap{grid-template-columns:1fr;gap:24px}.offer-photo img{min-height:260px}}
  .offer-card{background:#fff;border:1px solid var(--line);border-radius:var(--radius-lg);padding:30px;box-shadow:var(--shadow)}
  .offer-card .otop{font-size:16px;color:var(--gray);margin-bottom:18px}.otop b{color:var(--ink)}
  .plans{display:grid;grid-template-columns:1fr 1fr;gap:14px}
  .plan{position:relative;border:2px solid var(--line);border-radius:16px;padding:18px 14px;text-align:center;cursor:pointer;transition:border-color .2s,background .2s}
  .plan:hover{border-color:#F3C79B}
  .plan.sel{border-color:var(--orange);background:var(--orange-soft)}
  .plan .pt{font-weight:700;color:var(--ink);font-size:16px}
  .plan .pp{font-family:var(--serif);font-weight:800;font-size:27px;color:var(--orange);margin-top:4px}
  .plan .bv{position:absolute;top:-11px;left:50%;transform:translateX(-50%);background:var(--orange);color:#fff;font-size:10.5px;font-weight:800;letter-spacing:.06em;padding:4px 12px;border-radius:999px}
  .pricebar{display:flex;align-items:center;gap:16px;justify-content:center;margin:26px 0 26px;flex-wrap:wrap}
  .pricebar .now{font-family:var(--serif);font-weight:800;font-size:62px;color:var(--orange);line-height:1}
  .pricebar .was{font-size:28px}
  .save{background:var(--orange);color:#fff;font-weight:800;font-size:15px;padding:9px 16px;border-radius:999px;box-shadow:0 6px 16px rgba(245,130,32,.3)}
  .guar{display:flex;align-items:center;justify-content:center;gap:8px;margin-top:18px;font-weight:700;font-size:15px;color:var(--ink)}
  .guar svg{width:18px;height:18px;stroke:var(--orange);fill:none;stroke-width:2}
  .fineprint{font-size:13px;color:var(--muted);text-align:center;margin-top:10px}
  .addon{display:flex;gap:12px;align-items:flex-start;background:var(--cream);border:1px solid var(--line);border-radius:14px;padding:16px;margin-top:22px}
  .addon input{width:22px;height:22px;margin-top:1px;accent-color:var(--orange);flex-shrink:0;cursor:pointer}
  .addon label{font-size:14.5px;color:var(--gray);line-height:1.5}
  .addon a{color:var(--orange-dk);font-weight:700;text-decoration:underline}
  .whatget{margin-top:24px;border-top:1px solid var(--line);padding-top:20px}
  .whatget .lab{font-size:12px;font-weight:800;letter-spacing:.12em;color:var(--muted);margin-bottom:12px}
  .wg{display:flex;align-items:center;gap:10px;font-size:15.5px;color:var(--ink);margin-bottom:10px}
  .wg svg{width:17px;height:17px;stroke:var(--orange);fill:none;stroke-width:2.5;flex-shrink:0}
  .truemed{display:flex;align-items:center;gap:8px;margin-top:14px;font-size:14px;color:var(--gray);font-weight:600}.truemed img{height:21px}
  .sub-disc{font-size:12px;color:var(--muted);margin-top:16px;line-height:1.6}
  .faq{max-width:760px;margin:40px auto 0}
  .q{border-bottom:1px solid var(--line)}
  .q button{width:100%;background:none;border:none;text-align:left;padding:24px 0;font-family:var(--serif);font-weight:700;font-size:21px;color:var(--ink);cursor:pointer;display:flex;justify-content:space-between;gap:16px}
  .q button:focus-visible{outline:2px solid var(--orange);outline-offset:3px}
  .q .a{max-height:0;overflow:hidden;transition:max-height .3s ease;color:var(--gray);font-size:16.5px}
  .q .a p{padding-bottom:24px}.q.open .a{max-height:340px}
