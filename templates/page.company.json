        "liquid_Q44ApT": {
          "type": "liquid",
          "settings": {
            "liquid": "<h2>Life Starts with <span style=\"color: #FF8F00\">Leadership</span></h2>\n<style>\nh2 {text-align: center; padding-bottom: 16px; line-height: 1.4!important;}\n</style>"
          }
        },
        "richtext_zaqd4P": {
          "type": "richtext",
          "settings": {
            "content": "<p>The leadership at LifePharm stems from family. Wickson, Winston and Letisha joined their father at the helm of his company to help carry out his vision and to drive the company forward. Excellent leadership, marketing know-how and operations from our executive team family keeps LifePharm widely regarded as one of the leading direct selling companies in the world.</p>"
          }
        }
      },
