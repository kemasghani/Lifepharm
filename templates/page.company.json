    "lp_history": {
      "type": "lp-history",
      "blocks": {
        "event_01": {
          "type": "event",
          "settings": {
            "image": "shopify://shop_images/lp-history-1929.png",
            "date": "1929",
            "text": "Dr. John Ralston Davidson begins working with egg bioactive growth factors, initially focused on research for cancer patients."
          }
        },
        "event_02": {
          "type": "event",
          "settings": {
            "image": "shopify://shop_images/lp-history-1943.png",
            "date": "1943",
            "text": "Dr. Davidson passes without receiving sufficient funding. His research is thought to have died with him."
          }
        },
        "event_03": {
          "type": "event",
          "settings": {
            "image": "shopify://shop_images/lp-history-1990s.png",
            "date": "1990s",
            "text": "Norwegian researcher Dr. Bjodne Eskeland, later a LifePharm Emeritus Advisory Board Member, uncovers Dr. Davidson’s work and begins his own clinical studies on egg bioactive growth factors."
          }
        },
        "event_04": {
          "type": "event",
          "settings": {
            "image": "shopify://shop_images/lp-history-2006.png",
            "date": "2006",
            "text": "Dr. Eskeland publishes the first scientific paper on egg bioactive growth factors, showing a 24% reduction in cortisol, the body’s primary stress hormone."
          }
        },
        "event_05": {
          "type": "event",
          "settings": {
            "image": "shopify://shop_images/lp-history-2011.png",
            "date": "2011",
            "text": "Dr. Eskeland partners with LifePharm to refine the manufacturing process using state-of-the-art Hygienic Evaporative Cooling technology. LifePharm officially opens its doors."
          }
        },
        "event_06": {
          "type": "event",
          "settings": {
            "image": "shopify://shop_images/lp-history-2012.png",
            "date": "July 2012",
            "text": "LAMININE is featured on American Health Journal."
          }
        },
        "event_07": {
          "type": "event",
          "settings": {
            "image": "shopify://shop_images/lp-history-2014.png",
            "date": "Nov 2014",
            "text": "LAMININE is listed in the 2015 Physicians’ Desk Reference, putting the research directly into the hands of practising physicians."
          }
        },
        "event_08": {
          "type": "event",
          "settings": {
            "image": "shopify://shop_images/lp-history-2016.png",
            "date": "Nov 2016",
            "text": "IMMUNE+++ research is published and presented at the American College of Nutrition."
          }
        },
        "event_09": {
          "type": "event",
          "settings": {
            "image": "shopify://shop_images/lp-history-2018.png",
            "date": "Aug 2018",
            "text": "Dr. Rafael Gonzalez, a leading longevity researcher, publishes a study showing LAMININE helps support and protect telomeres, the key to slowing cellular ageing and promoting long-term health."
          }
        },
        "event_10": {
          "type": "event",
          "settings": {
            "image": "shopify://shop_images/lp-history-2019.png",
            "date": "Feb 2019",
            "text": "LAMININE is featured on Innovations in Medicine."
          }
        },
        "event_11": {
          "type": "event",
          "settings": {
            "image": "shopify://shop_images/lp-history-2020-03.png",
            "date": "Mar 2020",
            "text": "Dr. Alexander Hinek discovers that egg bioactive growth factors increase skin cell proliferation, collagen, elastin and fibronectin."
          }
        },
        "event_12": {
          "type": "event",
          "settings": {
            "image": "shopify://shop_images/lp-history-2020-05.png",
            "date": "May 2020",
            "text": "LAMIDERM APEX wins the Monde Selection Gold Award."
          }
        },
        "event_13": {
          "type": "event",
          "settings": {
            "image": "shopify://shop_images/lp-history-2020-09.png",
            "date": "Sept 2020",
            "text": "LAMIDERM APEX receives U.S. Patent No. 10,786,442 for skin regeneration. The formula is ours, and only ours."
          }
        }
      },
