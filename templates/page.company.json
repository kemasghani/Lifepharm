        "richtext_WiVU8U": {
          "type": "richtext",
          "disabled": true,
          "settings": {
            "content": "<h2>How it Started</h2><p>LifePharm Founder and CEO Wicky Suyanto grew up in Indonesia, where health was often neglected and entrepreneurial opportunities could be a challenge. He vowed to create a company where healthy living and financial independence was an achievable reality for anyone. In 2011, he launched LifePharm with this mission.</p>"
          }
        },
        "image_bfnfTr": {
          "type": "image",
          "disabled": true,
          "settings": {
            "image": "shopify://shop_images/quote.png",
            "width_mode": "full_width",
            "max_width": 500,
            "mobile_max_width": 400
          }
        },
        "richtext_8MEi93": {
          "type": "richtext",
          "disabled": true,
          "settings": {
            "content": "<p><em>“I founded LifePharm on the belief that health and wealth go hand-in-hand: you need wealth to sustain health, and health to attain wealth. I wanted to create an opportunity where both are attainable. This is a life worth living, because life is precious.”</em></p><p><strong>- WICKY SUYANTO, CEO & FOUNDER</strong></p>"
          }
        },
