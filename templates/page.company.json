            "show_controls": false,
            "column_size": "4",
            "title": "Balance",
            "heading_tag": "h4",
            "content": "<p>Balance means finding a middle ground between the company’s and customer’s needs. Put yourself in the customers’ shoes while doing what’s best for the company.</p>",
            "link_url": "",
            "link_text": "",
            "link_style": "link"
