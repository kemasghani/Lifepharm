            "show_controls": false,
            "column_size": "4",
            "title": "Integrity",
            "heading_tag": "h4",
            "content": "<p>Integrity means being honest and trustworthy in everything we do. This includes the quality of products we create, the commissions we payout, and the decisions we make.</p>",
            "link_url": "",
            "link_text": "",
            "link_style": "link"
          }
