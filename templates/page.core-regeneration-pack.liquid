{%- assign crp_product = all_products['core-regeneration-pack'] -%}
{%- assign crp_variant = crp_product.selected_or_first_available_variant -%}
{%- assign free_ship_cents = 15000 -%}
{%- assign crp_save = 0 -%}
{%- if crp_variant.compare_at_price > crp_variant.price -%}
  {%- assign crp_save = crp_variant.compare_at_price | minus: crp_variant.price -%}
  {%- assign crp_pct = crp_save | times: 100.0 | divided_by: crp_variant.compare_at_price | round -%}
{%- endif -%}

<style>
  @font-face { font-family: "CRP Metropolis"; src: url("{{ 'Metropolis-Regular.woff2' | file_url }}") format("woff2"); font-weight: 400; font-style: normal; font-display: swap; }
  @font-face { font-family: "CRP Metropolis"; src: url("{{ 'Metropolis-Medium.woff2' | file_url }}") format("woff2"); font-weight: 500; font-style: normal; font-display: swap; }
  @font-face { font-family: "CRP Metropolis"; src: url("{{ 'Metropolis-SemiBold.woff2' | file_url }}") format("woff2"); font-weight: 600; font-style: normal; font-display: swap; }
  @font-face { font-family: "CRP Metropolis"; src: url("{{ 'Metropolis-Bold.woff2' | file_url }}") format("woff2"); font-weight: 700; font-style: normal; font-display: swap; }
  /* Everything is scoped under .crp so the theme header, menu and footer are untouched. */
  .crp {
    --orange: #FF8F00;
    --orange-soft: #FFF4E5;
    --ink: #181818;
    --muted: #45433f;
    --line: #E6E2DA;
    --cream: #FAF7F2;
    --night: #03060d;
    --p: 16px; /* one size for every paragraph on the page */
    color: var(--ink);
    letter-spacing: 0.4px;
    font-family: "CRP Metropolis", Metropolis, sans-serif;
  }
  .crp button, .crp input { font-family: inherit; }
  /* The store theme sets text-align: start on every button; center ours. */
  .crp button { text-align: center; }
  .crp .crp-atc, .crp .crp-sb__btn, .crp .crp-qty button { display: inline-flex; align-items: center; justify-content: center; }
  .crp *, .crp *::before, .crp *::after { box-sizing: border-box; letter-spacing: 0.4px; }
  .crp img { max-width: 100%; height: auto; display: block; }
  /* Paragraph/body text: 0.1px letter spacing (headlines and subheads stay 0.4px). */
  .crp p, .crp li, .crp li span { letter-spacing: 0.1px; }
  .crp li b, .crp-perks b { letter-spacing: 0.4px; }
  .crp h1, .crp h2, .crp h3 { font-family: "Playfair Display", serif !important; font-weight: 400; margin: 0; line-height: 1.2; letter-spacing: 0.4px; }
  :where(.crp) p { margin: 0; }
  .crp-wrap { max-width: 1200px; margin: 0 auto; padding-inline: 16px; }
  .crp-band { padding-block: clamp(56px, 8vw, 96px); }
  .crp-h2 { font-size: clamp(30px, 4.2vw, 44px); }
  .crp-lede { font-size: var(--p); line-height: 1.6; color: var(--muted); max-width: 680px; margin-top: 14px; }
  .crp-head { text-align: center; } .crp-head .crp-lede { margin-inline: auto; }

  /* ---------- Buy box ---------- */
  .crp-buy { display: grid; grid-template-columns: 1fr; gap: 28px; padding-block: 24px 64px; }
  @media (min-width: 900px) { .crp-buy { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 56px; padding-block: 40px 80px; align-items: start; } .crp-gal { position: sticky; top: 24px; } }

  .crp-gal { min-width: 0; }
  .crp-gal__main { position: relative; border-radius: 12px; overflow: hidden; background: #fff; }
  .crp-gal__track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; scroll-behavior: smooth; }
  .crp-gal__track::-webkit-scrollbar { display: none; }
  .crp-gal__slide { flex: 0 0 100%; scroll-snap-align: center; aspect-ratio: 1 / 1; display: grid; place-items: center; }
  .crp-gal__slide img { width: 100%; height: 100%; object-fit: contain; }
  .crp-gal__arrow { position: absolute; top: 50%; transform: translateY(-50%); width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--line); background: rgba(255,255,255,.92); color: var(--ink); display: grid; place-items: center; cursor: pointer; padding: 0; }
  .crp-gal__arrow:hover { border-color: var(--ink); }
  .crp-gal__arrow--prev { left: 12px; } .crp-gal__arrow--next { right: 12px; }
  .crp-gal__arrow svg { width: 18px; height: 18px; }
  .crp-gal__thumbs { display: flex; gap: 10px; margin-top: 12px; overflow-x: auto; scrollbar-width: none; }
  .crp-gal__thumbs button { flex: 0 0 76px; height: 76px; padding: 0; border: 1px solid var(--line); border-radius: 8px; background: #fff; cursor: pointer; overflow: hidden; }
  .crp-gal__thumbs button[aria-current="true"] { border: 2px solid var(--orange); }
  .crp-gal__thumbs img { width: 100%; height: 100%; object-fit: contain; }
  .crp-gal.is-single .crp-gal__arrow, .crp-gal.is-single .crp-gal__thumbs { display: none; }

  .crp-info { min-width: 0; display: flex; flex-direction: column; }
  .crp-title { font-size: clamp(32px, 4vw, 40px); color: var(--ink); }
  #frontrow-badge { position: relative; display: flex; margin-top: 10px; }
  .iframe-frontrow { width: 100%; margin: 0; border: 0; }
  .iframe-modal-frontrow { display: none; position: fixed; z-index: 99999999; left: 0; top: 0; right: 0; bottom: 0; width: 100%; height: 100%; overflow: hidden; }
  .crp-pts { list-style: none; margin: 32px 0 0; padding: 0; display: grid; gap: 10px; }
  .crp-pts li { display: grid; grid-template-columns: 22px 1fr; gap: 10px; font-size: var(--p); line-height: 1.45; }
  .crp-pts svg { width: 22px; height: 22px; padding: 4px; border-radius: 50%; background: var(--orange-soft); color: var(--orange); }

  .crp-price { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; margin-top: 34px; }
  .crp-price__now { font-size: 30px; font-weight: 700; line-height: 1; }
  .crp-price__was { font-size: 19px; text-decoration: line-through; color: var(--muted); line-height: 1; }
  .crp-save { display: inline-flex; align-items: center; padding: 6px 12px; border-radius: 999px; background: #FFE3BF; color: #A84B00; font-size: 13px; font-weight: 700; line-height: 1; }

  .crp-buyrow { display: flex; gap: 12px; margin-top: 30px; }
  .crp-qty { flex: none; display: inline-flex; align-items: center; width: 128px; height: 58px; border: 1px solid var(--line); border-radius: 56px; overflow: hidden; }
  .crp-qty button { width: 42px; height: 100%; border: 0; background: none; font-size: 20px; cursor: pointer; color: var(--ink); }
  .crp-qty input { width: 44px; height: 100%; border: 0; text-align: center; font: inherit; font-size: 16px; color: var(--ink); -moz-appearance: textfield; background: none; }
  .crp-qty input::-webkit-outer-spin-button, .crp-qty input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .crp-atc { flex: 1; min-width: 0; min-height: 58px; border: 0; border-radius: 56px; background: var(--orange); color: #fff; font: inherit; font-size: 17px; font-weight: 700; letter-spacing: 0.4px; cursor: pointer; transition: filter .15s; }
  .crp-atc:hover { filter: brightness(.95); }
  .crp-atc:focus-visible, .crp-sb__btn:focus-visible, .crp summary:focus-visible { outline: 3px solid var(--ink); outline-offset: 2px; }
  .crp-atc[disabled] { opacity: .6; cursor: default; }

  .crp-perks { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; margin-top: 22px; }
  .crp-perks > div { display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center; }
  .crp-perks svg { width: 30px; height: 30px; color: var(--orange); }
  .crp-perks b { display: block; font-size: 14px; font-weight: 600; line-height: 1.3; }
  @media (max-width: 420px) { .crp-perks b { font-size: 12.5px; } .crp-perks svg { width: 26px; height: 26px; } }

  .crp-acc { margin-top: 28px; border-top: 1px solid var(--line); }
  .crp-acc details { border-bottom: 1px solid var(--line); }
  .crp-acc summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 20px 2px; cursor: pointer; font-size: 18px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.4px; }
  .crp-acc summary::-webkit-details-marker { display: none; }
  .crp-acc summary::after { content: ""; flex: none; width: 14px; height: 14px; background: linear-gradient(currentColor, currentColor) center / 14px 2px no-repeat, linear-gradient(currentColor, currentColor) center / 2px 14px no-repeat; transition: transform .2s; }
  .crp-acc details[open] summary::after { transform: rotate(45deg); }
  .crp-acc__body { padding: 0 2px 20px; font-size: var(--p); line-height: 1.6; }
  .crp-acc__body > * + * { margin-top: 12px !important; }
  .crp-acc__h { font-weight: 700; }
  .crp-acc__body > .crp-acc__h--gap { margin-top: 24px !important; }
  .crp-inside { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .crp-inside li { padding-left: 14px; border-left: 3px solid var(--orange); }
  .crp-inside b { display: block; }
  .crp-inside span { font-size: var(--p); color: var(--muted); }
  .crp-certs { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 8px 12px; }
  .crp-certs li { display: grid; grid-template-columns: 18px 1fr; gap: 8px; font-size: var(--p); line-height: 1.35; }
  .crp-certs svg { width: 18px; height: 18px; color: var(--orange); margin-top: 1px; }

  /* ---------- 1. Intro over soft cell illustration ---------- */
  .crp-hero { position: relative; overflow: hidden; background: #FDF3E9; color: var(--ink); }
  .crp-hero__img { position: absolute; inset: 0; width: 100%; height: 100% !important; object-fit: cover; object-position: 70% 50%; }
  .crp-hero::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(253,243,233,.92) 0%, rgba(253,243,233,.7) 40%, rgba(253,243,233,0) 68%); }
  .crp-hero__in { position: relative; z-index: 1; min-height: clamp(460px, 44vw, 600px); display: flex; flex-direction: column; justify-content: center; padding-block: 72px; }
  .crp-hero h2 { font-size: clamp(32px, 4.4vw, 50px); max-width: 600px; color: var(--ink); }
  .crp-hero p { font-size: var(--p); line-height: 1.65; max-width: 540px; margin-top: 20px; color: #3d3b38; }
  .crp-hero p + p { margin-top: 16px; }
  @media (max-width: 760px) {
    .crp-hero { display: flex; flex-direction: column; }
    .crp-hero::after { display: none; }
    .crp-hero__img { position: static; order: 2; height: auto !important; aspect-ratio: 4 / 3; object-position: 82% 50%; }
    .crp-hero__in { order: 1; min-height: 0; padding-top: 56px; padding-bottom: 28px; }
  }

  /* ---------- 2. Benefits carousel ---------- */
  .crp-benhead { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; }
  .crp-benhead .crp-lede { margin-top: 12px; }
  .crp-car { display: flex; gap: 10px; flex: none; }
  .crp-car button { width: 48px; height: 48px; border-radius: 50%; border: 1px solid var(--ink); background: #fff; color: var(--ink); display: grid; place-items: center; cursor: pointer; padding: 0; }
  .crp-car button:hover:not([disabled]) { background: var(--ink); color: #fff; }
    .crp-car svg { width: 18px; height: 18px; }
  .crp-bens { display: grid; gap: 20px; margin-top: 32px; grid-auto-flow: column; grid-auto-columns: calc((100% - 60px) / 4); overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; scroll-behavior: smooth; }
  .crp-bens::-webkit-scrollbar { display: none; }
  .crp-ben { scroll-snap-align: start; border-radius: 16px; overflow: hidden; background: #fff; border: 1px solid var(--line); display: flex; flex-direction: column; }
  .crp-ben img { width: 100%; height: auto !important; aspect-ratio: 4 / 5 !important; object-fit: cover; object-position: 50% 15%; }
  .crp-ben__t { padding: 20px 20px 24px; }
  .crp-ben h3 { font-size: 24px; }
  .crp-ben p { font-size: var(--p); line-height: 1.6; margin-top: 8px; color: var(--muted); }
  @media (max-width: 1099px) { .crp-bens { grid-auto-columns: calc((100% - 40px) / 3); } }
  @media (max-width: 899px) { .crp-bens { grid-auto-columns: calc((100% - 20px) / 2); } }
  @media (max-width: 599px) {
    .crp-bens { grid-auto-columns: 84%; gap: 14px; }
    .crp-benhead { flex-direction: column; align-items: stretch; text-align: center; }
    .crp-benhead .crp-lede { margin-inline: auto; }
    .crp-car { justify-content: center; order: 2; margin-top: 4px; }
  }

  /* ---------- 3. Ingredients + technology ---------- */
  .crp-ingsec { background: var(--orange-soft); }
  .crp-ing { display: grid; grid-template-columns: 1fr; gap: 28px; margin-top: 12px; align-items: center; }
  @media (min-width: 960px) { .crp-ing { grid-template-columns: 1fr minmax(300px, 380px) 1fr; gap: 32px; } }
  .crp-ing__fig { position: relative; margin: 0; aspect-ratio: 1; max-width: 380px; width: 100%; justify-self: center; }
  .crp-ing__fig::before { content: ""; position: absolute; inset: 6%; border-radius: 50%; background: radial-gradient(circle at 50% 45%, #fff 0%, #fff 55%, #FFE7C7 100%); }
  .crp-ing__fig img { position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: 100% !important; object-fit: contain; object-position: 50% 100%; filter: drop-shadow(0 18px 18px rgba(60,40,10,.18)); }
  .crp-ing__col h3 { font-family: inherit !important; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.4px; color: var(--orange); margin-bottom: 6px; }
  .crp-ing__col h3 span { color: var(--muted); font-weight: 400; letter-spacing: 0.4px; text-transform: none; font-size: 14px; margin-left: 6px; }
  .crp-ing details { border-bottom: 1px solid rgba(255,143,0,.28); }
  .crp-ing summary { list-style: none; display: flex; align-items: center; gap: 14px; padding: 18px 0; cursor: pointer; }
  .crp-ing summary::-webkit-details-marker { display: none; }
  .crp-ing summary i { flex: none; width: 36px; height: 36px; border-radius: 50%; background: #fff; border: 1px solid var(--line); display: grid; place-items: center; font-style: normal; font-size: 13px; font-weight: 700; color: var(--orange); }
  .crp-ing summary b { flex: 1; font-size: 17px; font-weight: 700; line-height: 1.3; }
  .crp-ing details[open] summary i { background: var(--orange); border-color: var(--orange); color: #fff; }
  .crp-ing details p { padding: 0 0 18px 0; font-size: var(--p); line-height: 1.6; color: var(--muted); }
  @media (min-width: 960px) {
    .crp-ing__col--l { text-align: right; }
    .crp-ing__col--l summary { flex-direction: row-reverse; }
  }
  @media (max-width: 959px) { .crp-ing { gap: 0; } .crp-ing__fig { order: -1; max-width: 300px; margin-bottom: 20px; } }

  /* ---------- 4. Science ---------- */
  .crp-sci { display: grid; grid-template-columns: 1fr; gap: 20px; margin-top: 44px; }
  @media (min-width: 860px) { .crp-sci { grid-template-columns: 1fr 1fr; gap: 24px; } }
  .crp-sci__g { border: 1px solid var(--line); border-radius: 20px; overflow: hidden; display: grid; grid-template-columns: 36% 1fr; }
  .crp-sci__ph { position: relative; background: radial-gradient(ellipse at 50% 60%, #fff 0%, #FFF4E5 75%); overflow: hidden; }
  .crp-sci__ph img { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 86%; max-width: 240px; height: auto; filter: drop-shadow(0 16px 16px rgba(60,40,10,.18)); }
  .crp-sci__s { padding: 26px 22px; }
  .crp-sci__s + .crp-sci__s { border-top: 1px solid var(--line); }
  .crp-sci__n { font-family: "Playfair Display", serif; font-size: clamp(38px, 4.4vw, 50px); line-height: 1; color: var(--orange); white-space: nowrap; }
  .crp-sci__n small { font-size: .45em; margin-left: 2px; }
  .crp-sci__s b { display: block; font-size: 17px; line-height: 1.35; margin-top: 10px; }
  .crp-sci__s p { font-size: var(--p); line-height: 1.55; color: var(--muted); margin-top: 6px; }
  @media (max-width: 520px) { .crp-sci__g { grid-template-columns: 1fr; } .crp-sci__ph { height: 220px; } .crp-sci__ph img { width: auto; height: 88% !important; } }
  .crp-more { text-align: center; margin-top: 52px; font-size: var(--p); }
  .crp-more a { color: var(--ink); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }

  /* ---------- 5. What to expect ---------- */
  .crp-exp { background: var(--cream); }
  .crp-tl { list-style: none; margin: 48px 0 0; padding: 0; display: grid; grid-template-columns: 1fr; }
  .crp-tl li { position: relative; padding: 0 0 36px 44px; }
  .crp-tl li:last-child { padding-bottom: 0; }
  .crp-tl li::before { content: ""; position: absolute; left: 7px; top: 8px; bottom: -8px; width: 2px; background: rgba(255,143,0,.35); }
  .crp-tl li:last-child::before { display: none; }
  .crp-tl li::after { content: ""; position: absolute; left: 0; top: 4px; width: 16px; height: 16px; border-radius: 50%; background: var(--orange); box-shadow: 0 0 0 5px var(--cream); }
  .crp-tl__when { font-family: "Playfair Display", serif; font-size: 30px; line-height: 1; color: var(--orange); }
  .crp-tl h3 { font-family: inherit !important; font-size: 18px; font-weight: 700; margin-top: 10px; }
  .crp-tl p { font-size: var(--p); line-height: 1.6; margin-top: 8px; color: var(--muted); max-width: 520px; }
  @media (min-width: 860px) {
    .crp-tl { grid-template-columns: repeat(4, 1fr); gap: 28px; }
    .crp-tl li { padding: 40px 0 0; }
    .crp-tl li::before { left: 8px; right: -36px; top: 7px; bottom: auto; width: auto; height: 2px; }
    .crp-tl li:last-child::before { display: block; right: 0; background: linear-gradient(90deg, rgba(255,143,0,.35), rgba(255,143,0,0)); }
    .crp-tl li::after { top: 0; }
  }

  /* ---------- 6. How to use ---------- */
  .crp-how { list-style: none; margin: 44px 0 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 14px; counter-reset: step; }
  @media (min-width: 900px) { .crp-how { grid-template-columns: repeat(4, 1fr); gap: 24px; } }
  .crp-how li { counter-increment: step; display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: 16px; overflow: hidden; background: #fff; }
  .crp-how li > h3, .crp-how li > p { padding-inline: 18px; }
  .crp-how li > p { padding-bottom: 22px; }
  .crp-how__img { position: relative; overflow: hidden; }
  .crp-how__img img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .crp-how h3 { font-family: inherit !important; font-size: 17px; font-weight: 700; margin-top: 18px; display: flex; align-items: center; gap: 10px; }
  .crp-how h3::before { content: counter(step); flex: none; width: 30px; height: 30px; border-radius: 50%; background: var(--orange); color: #fff; font-size: 15px; font-weight: 700; display: grid; place-items: center; }
  .crp-how p { font-size: var(--p); line-height: 1.55; color: var(--muted); margin-top: 6px; }
  .crp-tip { margin: 32px auto 0; max-width: 760px; text-align: center; font-size: var(--p); line-height: 1.6; color: var(--muted); }
  .crp-tip b { color: var(--ink); }

  /* ---------- 7. Reviews ---------- */
  .crp-revs { display: grid; grid-template-columns: 1fr; gap: 20px; margin-top: 40px; }
  @media (min-width: 860px) { .crp-revs { grid-template-columns: 1fr 1fr; gap: 24px; } }
  .crp-rev { background: #fff; border: 1px solid var(--line); border-radius: 20px; padding: 26px 24px; display: flex; flex-direction: column; gap: 18px; }
  .crp-rev__top { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .crp-stars { color: var(--orange); font-size: 18px; letter-spacing: 0.4px; }
  .crp-rev__who { font-family: "Playfair Display", serif; font-size: 22px; line-height: 1.2; }
  .crp-rev blockquote { margin: 0; }
  .crp-rev blockquote p { font-size: var(--p); line-height: 1.65; }

  /* ---------- Fine print ---------- */
  .crp-fine { padding-block: 28px; font-size: 13px; line-height: 1.6; color: var(--muted); }
  .crp-fine p + p { margin-top: 8px; }
  .crp-fine a { color: var(--ink); }

  /* ---------- Sticky bottom bar (same design as the IBO Sharing Hub) ---------- */
  .crp-sb { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; display: grid; grid-template-columns: 48px minmax(0, 1fr) auto; gap: 12px; align-items: center;
    padding: 10px max(16px, env(safe-area-inset-right, 0px)) calc(10px + env(safe-area-inset-bottom, 0px)) max(16px, env(safe-area-inset-left, 0px));
    background: var(--orange); color: #fff; box-shadow: 0 -6px 20px rgba(0,0,0,.18); letter-spacing: 0.4px;
    transform: translateY(110%); transition: transform .3s ease; }
  .crp-sb.is-on { transform: none; }
  .crp-sb img { width: 48px; height: 48px; object-fit: contain; border-radius: 8px; background: #fff; }
  .crp-sb__t { display: grid; min-width: 0; line-height: 1.25; }
  .crp-sb__t b { font-size: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .crp-sb__t span { font-size: 19px; font-weight: 700; }
  .crp-sb__t s { font-size: 15px; font-weight: 400; margin-left: 6px; }
  .crp-sb__save { display: inline-block; margin-left: 8px; padding: 3px 9px; border-radius: 999px; background: #FFE3BF; color: #A84B00; font-size: 12px; font-weight: 700; font-style: normal; vertical-align: 2px; white-space: nowrap; }
  .crp-sb__btn { white-space: nowrap; padding: 10px 26px; min-height: 46px; border: 0; border-radius: 56px; background: #fff; color: var(--orange); font: inherit; font-size: 16px; font-weight: 700; cursor: pointer; }
