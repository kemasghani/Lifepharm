    <img src="{{ crp_product.featured_image | image_url: width: 500 }}" alt="" width="48" height="48">
    <div class="crp-sb__t"><b>{{ crp_product.title }}</b><span>{{ crp_variant.price | money_without_trailing_zeros }}{%- if crp_save > 0 -%}<s>{{ crp_variant.compare_at_price | money_without_trailing_zeros }}</s><em class="crp-sb__save">Save {{ crp_save | money_without_trailing_zeros }}</em>{%- endif -%}</span></div>
    <button type="button" class="crp-sb__btn" data-atc tabindex="-1">Add to cart</button>
  </div>
</div>

<script>
(function () {
  var root = document.getElementById('crp'); if (!root) return;
  var $ = function (s, el) { return (el || root).querySelector(s); };
  var $$ = function (s, el) { return Array.prototype.slice.call((el || root).querySelectorAll(s)); };

  /* ---- Gallery: swipe/scroll, arrows, thumbnails. Works for any number of
     product images; with one image the arrows and thumbnails hide. ---- */
  var gal = $('#crp-gal'), track = $('#crp-track'), slides = $$('.crp-gal__slide'), thumbs = $$('#crp-thumbs button');
  if (slides.length < 2) gal.classList.add('is-single');
  function cur() { return Math.round(track.scrollLeft / (track.clientWidth || 1)); }
  function go(i) { i = (i + slides.length) % slides.length; track.scrollTo({ left: i * track.clientWidth }); mark(i); }
  function mark(i) { thumbs.forEach(function (t, k) { t.setAttribute('aria-current', k === i ? 'true' : 'false'); }); }
  $$('.crp-gal__arrow').forEach(function (b) { b.addEventListener('click', function () { go(cur() + Number(b.dataset.dir)); }); });
  thumbs.forEach(function (t, k) { t.addEventListener('click', function () { go(k); }); });
  var st; track.addEventListener('scroll', function () { clearTimeout(st); st = setTimeout(function () { mark(cur()); }, 60); }, { passive: true });
  track.addEventListener('keydown', function (e) { if (e.key === 'ArrowRight') { e.preventDefault(); go(cur() + 1); } if (e.key === 'ArrowLeft') { e.preventDefault(); go(cur() - 1); } });
  mark(0);

  /* ---- Accordion: opening one closes the others ---- */
  var accs = $$('#crp-acc details');
  accs.forEach(function (d) { d.addEventListener('toggle', function () { if (d.open) accs.forEach(function (o) { if (o !== d) o.open = false; }); }); });
  /* Same for the ingredients list (across both columns) */
  var ings = $$('.crp-ing details');
  ings.forEach(function (d) { d.addEventListener('toggle', function () { if (d.open) ings.forEach(function (o) { if (o !== d) o.open = false; }); }); });

  /* ---- Benefits carousel arrows ---- */
  var bens = $('#crp-bens'), carBtns = $$('[data-car]');
  function step() { var c = bens.children[0], g = parseFloat(getComputedStyle(bens).columnGap) || 0; return c.getBoundingClientRect().width + g; }
  /* Loops: Next on the last card goes back to the first, Previous on the first goes to the end. */
  carBtns.forEach(function (b) { b.addEventListener('click', function () {
    var dir = Number(b.dataset.car), max = bens.scrollWidth - bens.clientWidth;
    if (dir > 0 && bens.scrollLeft >= max - 4) bens.scrollTo({ left: 0 });
    else if (dir < 0 && bens.scrollLeft <= 4) bens.scrollTo({ left: max });
    else bens.scrollBy({ left: dir * step() });
  }); });

  /* ---- Quantity ---- */
  var qty = $('#crp-qty');
  function q() { var n = parseInt(qty.value, 10); return isNaN(n) || n < 1 ? 1 : Math.min(n, 20); }
  $$('[data-q]').forEach(function (b) { b.addEventListener('click', function () { qty.value = Math.max(1, Math.min(20, q() + Number(b.dataset.q))); }); });
  qty.addEventListener('change', function () { qty.value = q(); });

  /* ---- Add to cart: add.js keeps the IBO referral that's already on the cart,
     then opens the cart page. Falls back to the plain /cart/add link. ---- */
  var vid = root.dataset.variant;
  $$('[data-atc]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var n = q(), label = btn.textContent;
      btn.disabled = true; btn.textContent = 'Adding…';
      fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ items: [{ id: Number(vid), quantity: n }] }) })
        .then(function (r) { if (!r.ok) throw new Error('add failed'); window.location.href = '/cart'; })
        .catch(function () { window.location.href = '/cart/add?id=' + vid + '&quantity=' + n; });
    });
  });

  /* ---- Sticky bar: slides up as soon as the main Add to cart button is
     scrolled out of sight, and hides again when you scroll back up to it.
     It also hides once the disclaimer/footer reaches the screen, so nothing
     is pinned at the bottom at the end of the page. ---- */
  var bar = $('#crp-sb'), mainBtn = $('#crp-atc'), barBtn = $('button', bar), endMark = $('.crp-fine');
  function check() {
    var vh = window.innerHeight || document.documentElement.clientHeight;
    var on = mainBtn.getBoundingClientRect().bottom <= 0 && endMark.getBoundingClientRect().top > vh;
    bar.classList.toggle('is-on', on);
    /* Lift the Gorgias chat button above the bar while the bar is showing */
    document.documentElement.style.setProperty('--crp-sb-h', bar.offsetHeight + 'px');
    document.documentElement.classList.toggle('crp-sb-on', on);
    bar.setAttribute('aria-hidden', on ? 'false' : 'true');
    barBtn.tabIndex = on ? 0 : -1;
  }
  addEventListener('scroll', check, { passive: true }); addEventListener('resize', check); check();

  /* ---- Test mode, only with ?crpdebug=1 in the address: shows page measurements
     so we can see what a phone thinks is below the footer. Customers never see it. ---- */
  if (/[?&]crpdebug=1/.test(location.search)) {
    var dbg = document.createElement('pre');
    dbg.style.cssText = 'position:fixed;top:70px;left:6px;right:6px;z-index:2147483647;margin:0;padding:8px;background:rgba(0,0,0,.85);color:#0f0;font:11px/1.35 monospace;white-space:pre-wrap;max-height:60vh;overflow:auto;pointer-events:none';
    document.body.appendChild(dbg);
    var R = function (n) { return Math.round(n); };
    function report() {
      var de = document.documentElement, b = document.body, vv = window.visualViewport;
      var lines = [
        'innerH ' + innerHeight + '  clientH ' + de.clientHeight + '  vv ' + (vv ? R(vv.height) + ' off ' + R(vv.offsetTop) : '-'),
        'scrollY ' + R(scrollY) + '  docH ' + de.scrollHeight + '  bodyH ' + R(b.getBoundingClientRect().height),
        'scroller ' + (document.scrollingElement || {}).tagName + '  html ov ' + getComputedStyle(de).overflowY + ' h ' + getComputedStyle(de).height + '  body ov ' + getComputedStyle(b).overflowY + ' h ' + getComputedStyle(b).height + ' pos ' + getComputedStyle(b).position,
        'body cls: ' + b.className,
        'bar top ' + R(bar.getBoundingClientRect().top) + ' on ' + bar.classList.contains('is-on'),
        '--- tallest things ending below the footer:'
      ];
      var main = document.querySelector('main'), mb = main ? main.getBoundingClientRect().bottom + scrollY : 0;
      lines.push('main bottom ' + R(mb));
      Array.prototype.slice.call(document.querySelectorAll('body *')).filter(function (e) {
        var r = e.getBoundingClientRect(); return r.height > 0 && r.bottom + scrollY > mb + 20;
      }).slice(0, 12).forEach(function (e) {
        var r = e.getBoundingClientRect(), c = getComputedStyle(e);
        lines.push(e.tagName + (e.id ? '#' + e.id.slice(0, 30) : '') + '.' + String(e.className).slice(0, 40) + ' top ' + R(r.top + scrollY) + ' h ' + R(r.height) + ' ' + c.position + ' ' + c.display);
      });
      dbg.textContent = lines.join('\n');
    }
    addEventListener('scroll', report, { passive: true }); addEventListener('resize', report); setInterval(report, 1500); report();
  }
})();
</script>
