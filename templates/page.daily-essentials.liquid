{%- assign show_join = true -%}
{%- assign kit = all_products['enrollment-kit'] -%}
{%- assign kit_v = kit.selected_or_first_available_variant -%}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=Lato:wght@400;700&display=swap">
<style>
  /* Everything is scoped under .ibp so it can't restyle the rest of the store.
     Same design system as the store theme: Playfair Display headings, Lato body,
     #181818 text, #FF8F00 pill buttons (56px radius). */
  .ibp {
    --bg: #ffffff; --ink: #181818; --accent: #FF8F00; --accent-ink: #ffffff; --line: #E7E5E0;
    --band-h: 40px; --band-gray: #7A7A7A;
    background: var(--bg); color: var(--ink);
    font-family: 'Lato', -apple-system, 'Helvetica Neue', Arial, sans-serif;
    font-size: 16px; line-height: 1.6; letter-spacing: 0.4px;
  }
  .ibp *, .ibp *::before, .ibp *::after { box-sizing: border-box; }
  .ibp a:focus-visible, .ibp button:focus-visible, .ibp [role="radio"]:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  .ibp-page { max-width: 1120px; margin: 0 auto; padding: 48px 16px 56px; display: flex; flex-direction: column; }
  .ibp h1, .ibp h2 { font-family: 'Playfair Display', Georgia, serif; font-weight: 400; letter-spacing: 0.5px; margin: 0; text-wrap: balance; color: var(--ink); text-align: center; }
  .ibp h1 { font-size: clamp(36px, 5.4vw, 52px); line-height: 1.1; }

  /* ---- Intro ---- */
  .ibp-intro { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 18px; text-align: center; }
  .ibp-intro p { margin: 0; font-size: 18px; }
  .ibp-intro .ibp-intro-cta { margin-top: 6px; }
  .ibp-br-desk { display: none; }

  /* ---- Pack cards: pick one ---- */
  .ibp-packs { list-style: none; margin: 52px 0 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: 24px; }
  .ibp-card { position: relative; cursor: pointer; background: #fff; border: 1px solid var(--line); border-radius: 20px; padding: 0 22px 26px; overflow: hidden; display: flex; flex-direction: column; gap: 14px; text-align: center; transition: border-color .15s, box-shadow .15s, opacity .2s, filter .2s; }
  .ibp-card:hover { border-color: #cfccc5; }
  /* once a pack is picked, the other two fade to gray */
  .ibp-packs.has-pick .ibp-card[aria-checked="false"] { opacity: 0.45; filter: grayscale(1); }
  .ibp-packs.has-pick .ibp-card[aria-checked="false"]:hover { opacity: 0.75; }
  /* selected pack: orange outline + check in the top band */
  /* selected pack: thick orange outline, warm tint, lifted, button turns solid "Selected" */
  .ibp-card[aria-checked="true"] { border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent), 0 10px 28px rgba(255, 143, 0, 0.18); background: #FFF8EF; }
  .ibp-card[aria-checked="true"] .ibp-img { mix-blend-mode: multiply; }
  .ibp-pick { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 54px; margin-top: 4px; border: 2px solid var(--accent); border-radius: 56px; background: #fff; color: var(--accent); font-size: 17px; font-weight: 700; letter-spacing: 0.4px; text-transform: uppercase; }
  .ibp-card:hover .ibp-pick { background: #FFF3E3; }
  .ibp-pick-on { display: none; align-items: center; gap: 8px; }
  .ibp-card[aria-checked="true"] .ibp-pick { background: var(--accent); color: #fff; }
  .ibp-card[aria-checked="true"] .ibp-pick-off { display: none; }
  .ibp-card[aria-checked="true"] .ibp-pick-on { display: inline-flex; }
  .ibp-band { position: relative; margin: 0 -22px; min-height: var(--band-h); display: flex; align-items: center; justify-content: center; background: var(--band-gray); color: #fff; font-size: 14px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .ibp-card--best .ibp-band { background: var(--accent); }
  .ibp-check { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); width: 24px; height: 24px; border-radius: 50%; background: #fff; color: var(--accent); display: none; align-items: center; justify-content: center; }
  .ibp-card:not(.ibp-card--best) .ibp-check { color: var(--band-gray); }
  .ibp-card[aria-checked="true"] .ibp-check { display: flex; }
  .ibp-img { width: 100%; max-width: 300px; aspect-ratio: 1; object-fit: contain; display: block; margin: 0 auto; border-radius: 12px; }
  .ibp .ibp-card h2 { font-size: 26px; }
  .ibp-line { margin: 0; }
  .ibp-inside-h { color: var(--accent); margin: 0 0 4px; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; }
  .ibp-inside ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  .ibp-inside li { font-size: 15.5px; line-height: 1.5; }
  .ibp-price { display: flex; flex-direction: column; align-items: center; gap: 8px; padding-top: 14px; border-top: 1px solid var(--line); }
  .ibp-save { font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--accent); background: #FFEFD9; border-radius: 56px; padding: 4px 14px; }
  .ibp-price-row { display: flex; flex-direction: column; align-items: center; gap: 0; font-variant-numeric: tabular-nums; }
  .ibp-sale { font-size: 28px; line-height: 1.2; font-weight: 700; }
  .ibp-compare { text-decoration: line-through; }

  /* ---- The two buttons under the cards ---- */
  .ibp-buy { margin: 56px 0 0; background: #F7F6F3; box-shadow: 0 0 0 100vmax #F7F6F3; clip-path: inset(0 -100vmax); padding-block: 48px; display: flex; flex-direction: column; align-items: center; gap: 18px; }
  .ibp-buy[hidden] { display: none; }
  .ibp-buy { transition: opacity .5s ease, transform .5s ease; }
  .ibp-buy.is-entering { opacity: 0; transform: translateY(24px); }
  .ibp .ibp-buy h2 { font-size: clamp(28px, 4vw, 36px); line-height: 1.2; }
  .ibp-selected { margin: 0; text-align: center; font-size: 18px; }
  .ibp-selected strong { font-weight: 700; }
  .ibp-btns { width: 100%; max-width: 720px; display: grid; grid-template-columns: 1fr; gap: 16px; margin-top: 6px; }
  .ibp-option { background: #fff; border: 1px solid var(--line); border-radius: 20px; padding: 26px 22px; display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center; height: 100%; }
  .ibp-option-sub { margin: 0 0 12px; font-size: 15.5px; }
  .ibp-option .ibp-cta { margin-top: auto; }
  .ibp-option-h { margin: 0; font-size: 18px; font-weight: 700; }
  .ibp .ibp-cta { width: 100%; display: flex; align-items: center; justify-content: center; min-height: 54px; border: 2px solid var(--accent); cursor: pointer; background: var(--accent); color: var(--accent-ink); font: inherit; font-size: 17px; font-weight: 700; letter-spacing: 0.4px; text-transform: uppercase; padding: 12px 18px; border-radius: 56px; text-decoration: none; white-space: nowrap; }
  .ibp .ibp-cta--outline { background: #fff; color: var(--accent); }
  .ibp .ibp-cta:hover { filter: brightness(0.96); }
  .ibp .ibp-cta[aria-busy="true"] { opacity: 0.7; pointer-events: none; }
  .ibp .ibp-cta[aria-disabled="true"] { opacity: 0.4; cursor: not-allowed; filter: none; }
  .ibp-note { font-size: 13.5px; }

  .ibp-link { border: 0; background: none; padding: 0; font: inherit; color: var(--accent); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }

  /* ---- Starter Kit pop-up: centered window on desktop, bottom sheet on phones ---- */
  .ibp-kit { border: 0; padding: 0; width: min(460px, calc(100vw - 32px)); max-height: calc(100dvh - 32px); overflow: hidden; border-radius: 20px; background: #fff; color: var(--ink); box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25); text-align: center; }
  .ibp-kit::backdrop { background: rgba(24, 24, 24, 0.55); }
  .ibp-kit[open] { display: flex; flex-direction: column; }
  /* only the inside scrolls, so the X (pinned to the pop-up's corner) never scrolls away */
  .ibp-kit-body:focus { outline: none; }
  .ibp-kit-body { overflow-y: auto; -webkit-overflow-scrolling: touch; overscroll-behavior: contain; padding: 44px 28px 28px; display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .ibp-kit-close { position: absolute; z-index: 2; top: 12px; right: 12px; box-shadow: 0 1px 4px rgba(0, 0, 0, 0.12); width: 40px; height: 40px; border: 0; border-radius: 50%; background: #F4F3F0; color: var(--ink); cursor: pointer; display: flex; align-items: center; justify-content: center; padding: 0; }
  .ibp-kit-img { width: 100%; max-width: 220px; height: auto; display: block; border-radius: 12px; }
  .ibp .ibp-kit h2 { font-size: 28px; line-height: 1.2; }
  .ibp-kit-sub { margin: 0; }
  .ibp .ibp-kit-list { list-style: none; margin: 4px 0 8px; padding: 0; text-align: left; display: flex; flex-direction: column; gap: 10px; font-size: 15.5px; line-height: 1.5; }
  .ibp .ibp-kit-list li { position: relative; padding-left: 20px; list-style: none; }
  .ibp .ibp-kit-list li::before { content: ""; position: absolute; left: 2px; top: 0.6em; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }
  .ibp-kit .ibp-cta { flex: none; }
  .ibp-kit-fee { margin: 0 0 4px; font-size: 14px; color: #5f5d58; }
  @media (max-width: 639px) {
    .ibp-kit { width: 100vw; max-width: 100vw; margin: auto 0 0; border-radius: 20px 20px 0 0; max-height: 88dvh; }
    .ibp-kit-body { padding: 40px 20px calc(24px + env(safe-area-inset-bottom)); }
    .ibp-kit[open] { animation: ibp-sheet-up .25s ease-out; }
    .ibp-kit-img { max-width: 160px; }
  }
  @keyframes ibp-sheet-up { from { transform: translateY(100%); } to { transform: translateY(0); } }
  @media (prefers-reduced-motion: reduce) { .ibp-kit[open] { animation: none; } }

  .ibp-disclaimer { margin: 40px auto 0; max-width: 80ch; font-size: 12px; line-height: 1.5; text-align: center; }

  @media (min-width: 640px) {
    .ibp-btns { grid-template-columns: 1fr 1fr; align-items: stretch; }
    .ibp-btns > :only-child { grid-column: 1 / -1; max-width: 360px; width: 100%; justify-self: center; }
  }
  @media (min-width: 960px) {
    .ibp-br-desk { display: inline; }
    .ibp-packs { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 0; }
    /* subgrid: band, image, name, description, what's inside, price share rows across the cards,
       so prices line up even when a name wraps. */
    .ibp-card { display: grid; grid-row: span 7; grid-template-rows: subgrid; row-gap: 14px; }
    .ibp-band { margin-bottom: 10px; }
    .ibp-card h2 { align-self: center; }
    .ibp-price { align-self: end; }
  }
  @media (prefers-reduced-motion: reduce) { .ibp-card { transition: none; } }
</style>

<div class="ibp">
<div class="ibp-page">

  <section class="ibp-intro" aria-labelledby="ibp-h">
    <h1 id="ibp-h">Four Daily Essentials. Three Ways to Get Them.</h1>
    <p>Every pack brings together LAMININE, OMEGA&#8314;&#8314;&#8314;, DIGESTIVE&#8314;&#8314;&#8314; and IMMUNE&#8314;&#8314;&#8314;,<br class="ibp-br-desk"> the foundation of a complete daily wellness routine.*</p>
    <p class="ibp-intro-cta"><strong>Select a pack below to get started.</strong></p>
  </section>

  <ul class="ibp-packs" role="radiogroup" aria-label="Choose your pack">
  {%- assign p_ph = all_products['powerhouse-pack'] -%}
  {%- assign v_ph = p_ph.selected_or_first_available_variant -%}
  <li class="ibp-card" role="radio" aria-checked="false" tabindex="0" data-variant="{{ v_ph.id }}" data-name="Powerhouse Pack" data-price="{{ v_ph.price | money }}">
      <div class="ibp-band">Start Here</div>
      <img class="ibp-img" src="{{ p_ph.featured_image | image_url: width: 720 }}" alt="Powerhouse Pack" width="300" height="300" loading="lazy">
      <h2>Powerhouse Pack</h2>
      <p class="ibp-line">All four daily essentials in classic bottles.</p>
      <div class="ibp-inside">
        <p class="ibp-inside-h">What's inside</p>
        <ul>
          <li>1 LAMININE (30-count)</li>
          <li>1 OMEGA&#8314;&#8314;&#8314; (30-count)</li>
          <li>1 DIGESTIVE&#8314;&#8314;&#8314; (30-count)</li>
          <li>1 IMMUNE&#8314;&#8314;&#8314; (30-count)</li>
        </ul>
      </div>
      <div class="ibp-price">
        <div class="ibp-price-row"><span class="ibp-sale">{{ v_ph.price | money }}</span>{%- if v_ph.compare_at_price > v_ph.price %}<span class="ibp-compare">{{ v_ph.compare_at_price | money }}</span>{%- endif %}</div>
        <span class="ibp-save">{%- if v_ph.compare_at_price > v_ph.price %}Save {{ v_ph.compare_at_price | minus: v_ph.price | money_without_trailing_zeros }}{%- if v_ph.price >= 15000 %} + {% endif %}{%- endif %}{%- if v_ph.price >= 15000 %}Free Shipping{%- endif %}</span>
      </div>
      <span class="ibp-pick" aria-hidden="true"><span class="ibp-pick-off">Select Pack</span><span class="ibp-pick-on">Selected</span></span>
    </li>
  {%- assign p_rf = all_products['refive-pack'] -%}
  {%- assign v_rf = p_rf.selected_or_first_available_variant -%}
  <li class="ibp-card" role="radio" aria-checked="false" tabindex="-1" data-variant="{{ v_rf.id }}" data-name="REFIVE" data-price="{{ v_rf.price | money }}">
      <div class="ibp-band">Perfect for On-the-Go</div>
      <img class="ibp-img" src="{{ p_rf.featured_image | image_url: width: 720 }}" alt="REFIVE" width="300" height="300" loading="lazy">
