  </section>

  {%- if show_join and kit_v.available %}<dialog class="ibp-kit" id="ibp-kit" aria-labelledby="ibp-kit-h">
    <button type="button" class="ibp-kit-close" id="ibp-kit-close" aria-label="Close"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button>
    <div class="ibp-kit-body" tabindex="-1" autofocus>
    <img class="ibp-kit-img" src="{{ kit.featured_image | image_url: width: 600 }}" alt="IBO Starter Kit" width="300" height="300">
    <h2 id="ibp-kit-h">Your FREE IBO Starter Kit</h2>
    <p class="ibp-kit-sub">Included free when you join with any pack ({{ kit_v.price | money_without_trailing_zeros }} value).</p>
    <ul class="ibp-kit-list">
      <li><strong>Your own IBO website</strong> to share LifePharm with others</li>
      <li><strong>A private Virtual Office</strong> for your reports, resources and company updates</li>
      <li><strong>Training to help you get started:</strong> how-to tips, conversation scripts, social media guidance, and how commissions, bonuses and IBO pricing work</li>
    </ul>
    <p class="ibp-kit-fee">€20 renewal fee billed annually.</p>
    <button type="button" class="ibp-cta" id="ibp-kit-join">Join as an IBO</button>
    </div>
  </dialog>{%- endif %}

  <p class="ibp-disclaimer">*These statements have not been evaluated by the Food and Drug Administration. These products are not intended to diagnose, treat, cure, or prevent any disease. Individual results may vary.</p>

</div>
</div>

<script>
  (function () {
    const cards = [...document.querySelectorAll('.ibp-card[role="radio"]')];
    const buy = document.getElementById('ibp-buy');
    let selected = null;   // nothing pre-selected
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Gentle scroll: eases in and out over ~0.9s instead of the browser's quick jump.
    let glide = 0;
    function glideTo(y) {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const end = Math.max(0, Math.min(y, max)), start = window.scrollY, dist = end - start;
      if (reduceMotion || Math.abs(dist) < 2) { window.scrollTo(0, end); return; }
      const dur = Math.min(1100, Math.max(600, Math.abs(dist) * 0.9));
      const t0 = performance.now(), id = ++glide;
      const ease = t => t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
      const stop = () => { glide++; };
      window.addEventListener('wheel', stop, { once: true, passive: true });
      window.addEventListener('touchstart', stop, { once: true, passive: true });
      (function step(now) {
        if (id !== glide) return;   // the shopper scrolled themselves: let go
        const t = Math.min(1, (now - t0) / dur);
        window.scrollTo(0, start + dist * ease(t));
        if (t < 1) requestAnimationFrame(step);
      })(t0);
    }

    function select(card, scroll) {
      selected = card;
      cards.forEach(c => {
        const on = c === card;
        c.setAttribute('aria-checked', on ? 'true' : 'false');
        c.tabIndex = on ? 0 : -1;
      });
      document.querySelector('.ibp-packs').classList.add('has-pick');
      if (buy.hidden) {
        // the two options appear once a pack is picked: fade + slide up into place
        buy.hidden = false;
        if (!reduceMotion) { buy.classList.add('is-entering'); requestAnimationFrame(() => requestAnimationFrame(() => buy.classList.remove('is-entering'))); }
      }
      // bring the two buttons into view, unless they're already fully on screen
      if (scroll) {
        const r = buy.getBoundingClientRect();
        if (r.top < 0 || r.bottom > window.innerHeight) {
          const target = window.scrollY + r.top - (r.height < window.innerHeight ? (window.innerHeight - r.height) / 2 : 0);
          glideTo(target);
        }
      }
    }

    cards.forEach((c, i) => {
      c.addEventListener('click', () => select(c, true));
      c.addEventListener('keydown', e => {
        if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); select(c, true); }
        const step = (e.key === 'ArrowRight' || e.key === 'ArrowDown') ? 1 : (e.key === 'ArrowLeft' || e.key === 'ArrowUp') ? -1 : 0;
        if (step) { e.preventDefault(); const n = cards[(i + step + cards.length) % cards.length]; select(n, false); n.focus(); }
      });
    });

    // Both buttons add to the shopper's EXISTING cart (keeps the IBO referral) and then open the cart page.
    // No pack picked yet: the buttons just take the shopper back up to the packs.
    function needPack() {
      if (selected) return false;
      glideTo(window.scrollY + document.querySelector('.ibp-packs').getBoundingClientRect().top - 24);
      return true;
    }

    async function addAndGo(btn, items, attributes) {
      btn.setAttribute('aria-busy', 'true');
      try {
        const r = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ items })
        });
        if (!r.ok) throw new Error('add failed');
        if (attributes) {
          await fetch('/cart/update.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ attributes })
          });
        }
        location.href = '/cart';
      } catch (err) {
        btn.removeAttribute('aria-busy');
        location.href = '/cart/add?id=' + items[0].id + '&quantity=1';
      }
    }

    document.getElementById('ibp-buy-ibo').addEventListener('click', e => {
      if (needPack()) return;
      addAndGo(e.currentTarget, [{ id: Number(selected.dataset.variant), quantity: 1 }]);
    });

    // Join as an IBO: pack + Starter Kit, marked the same way the US store marks enrollments
    // (kit line property enrollmentkit=true, cart attributes IsEnrollment / EnrollmentType).
    const join = document.getElementById('ibp-join');
    const kit = document.getElementById('ibp-kit');
    if (kit && typeof kit.showModal === 'function') {
      document.getElementById('ibp-kit-open').addEventListener('click', () => kit.showModal());
      document.getElementById('ibp-kit-close').addEventListener('click', () => kit.close());
      kit.addEventListener('click', e => { if (e.target === kit) kit.close(); });   // tap the dark background to close
      document.getElementById('ibp-kit-join').addEventListener('click', () => { kit.close(); join.click(); });
    }
    if (join) join.addEventListener('click', e => {
      if (needPack()) return;
      addAndGo(e.currentTarget, [
        { id: Number(selected.dataset.variant), quantity: 1 },
        { id: Number(join.dataset.kit), quantity: 1, properties: { enrollmentkit: 'true' } }
      ], { IsEnrollment: 'true', EnrollmentType: 'IBO' });
    });
  })();
</script>
