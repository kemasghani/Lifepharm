        <p class="ibp-inside-h">What's inside</p>
        <ul>
          <li>30 sachets per box</li>
          <li>Each sachet: 2 LAMININE capsules, 1 OMEGA&#8314;&#8314;&#8314; softgel, 1 DIGESTIVE&#8314;&#8314;&#8314; capsule, 1 IMMUNE&#8314;&#8314;&#8314; tablet</li>
        </ul>
      </div>
      <div class="ibp-price">
        <div class="ibp-price-row"><span class="ibp-sale">{{ v_rf.price | money }}</span>{%- if v_rf.compare_at_price > v_rf.price %}<span class="ibp-compare">{{ v_rf.compare_at_price | money }}</span>{%- endif %}</div>
        <span class="ibp-save">{%- if v_rf.compare_at_price > v_rf.price %}Save {{ v_rf.compare_at_price | minus: v_rf.price | money_without_trailing_zeros }}{%- if v_rf.price >= 15000 %} + {% endif %}{%- endif %}{%- if v_rf.price >= 15000 %}Free Shipping{%- endif %}</span>
      </div>
      <span class="ibp-pick" aria-hidden="true"><span class="ibp-pick-off">Select Pack</span><span class="ibp-pick-on">Selected</span></span>
    </li>
  {%- assign p_gf = all_products['powerhouse'] -%}
  {%- assign v_gf = p_gf.selected_or_first_available_variant -%}
  <li class="ibp-card ibp-card--best" role="radio" aria-checked="false" tabindex="-1" data-variant="{{ v_gf.id }}" data-name="Go Fast Powerhouse Pack" data-price="{{ v_gf.price | money }}">
      <div class="ibp-band">Best Value</div>
      <img class="ibp-img" src="{{ p_gf.featured_image | image_url: width: 720 }}" alt="Go Fast Powerhouse Pack" width="300" height="300" loading="lazy">
      <h2>Go Fast Powerhouse Pack</h2>
      <p class="ibp-line">Four times the supply of every essential, for you or your family.</p>
      <div class="ibp-inside">
        <p class="ibp-inside-h">What's inside</p>
        <ul>
          <li>1 LAMININE (120-count)</li>
          <li>1 OMEGA&#8314;&#8314;&#8314; (120-count)</li>
          <li>1 DIGESTIVE&#8314;&#8314;&#8314; (120-count)</li>
          <li>1 IMMUNE&#8314;&#8314;&#8314; (120-count)</li>
        </ul>
      </div>
      <div class="ibp-price">
        <div class="ibp-price-row"><span class="ibp-sale">{{ v_gf.price | money }}</span>{%- if v_gf.compare_at_price > v_gf.price %}<span class="ibp-compare">{{ v_gf.compare_at_price | money }}</span>{%- endif %}</div>
        <span class="ibp-save">{%- if v_gf.compare_at_price > v_gf.price %}Save {{ v_gf.compare_at_price | minus: v_gf.price | money_without_trailing_zeros }}{%- if v_gf.price >= 15000 %} + {% endif %}{%- endif %}{%- if v_gf.price >= 15000 %}Free Shipping{%- endif %}</span>
      </div>
      <span class="ibp-pick" aria-hidden="true"><span class="ibp-pick-off">Select Pack</span><span class="ibp-pick-on">Selected</span></span>
    </li>
  </ul>

  <section class="ibp-buy" id="ibp-buy" aria-labelledby="ibp-buy-h" hidden>
    <h2 id="ibp-buy-h">How Would You Like to Order?</h2>
    <div class="ibp-btns">
      <div class="ibp-option">
        <p class="ibp-option-h">Already an IBO?</p>
        <p class="ibp-option-sub">Check out with your IBO account email.</p>
        <button type="button" class="ibp-cta" id="ibp-buy-ibo">Buy as an IBO</button>
      </div>
      {%- if show_join and kit_v.available %}<div class="ibp-option">
        <p class="ibp-option-h">New to LifePharm?</p>
        <p class="ibp-option-sub">Get a <strong>FREE IBO Starter Kit</strong> ({{ kit_v.price | money_without_trailing_zeros }} value) with your pack. <button type="button" class="ibp-link" id="ibp-kit-open" aria-haspopup="dialog">What's included?</button></p>
        <button type="button" class="ibp-cta" id="ibp-join" data-kit="{{ kit_v.id }}">Join as an IBO</button>
