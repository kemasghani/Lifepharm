        <span class="exs-review-name">Ken M.</span>
      </li>
      <li class="exs-review">
        <p>“I have <strong>a lot less sugar cravings</strong> compared to before. The thing I noticed the most about Extrim is <strong>an increase in energy without feeling jittery.</strong> I feel really great.”</p>
        <span class="exs-review-name">Walburga B.</span>
      </li>
      <li class="exs-review">
        <p>“I started by taking one extrim shape in the morning before breakfast and <strong>it curbed my cravings all day long.</strong> … I have <strong>great energy without the jittery feeling.</strong>”</p>
        <span class="exs-review-name">Jeanne C.</span>
      </li>
      <li class="exs-review">
        <p>“Because of my graceful age, it's important to me to stay healthy and strong. … but there is something that I am not proud about myself—<strong>my addiction to ice cream.</strong> … I have a product to <strong>help me stay away from my bad health habits.</strong>”</p>
        <span class="exs-review-name">Irene S.</span>
      </li>
      <li class="exs-review">
        <p>“I have <strong>less cravings</strong> ever since I started taking Extrim. I love to eat, but <strong>Extrim has helped control my appetite.</strong>”</p>
        <span class="exs-review-name">Tobias N.</span>
      </li>
    </ul>
    <div class="exs-carousel-nav">
      <button type="button" class="exs-arrow" id="exs-prev" aria-label="Previous testimonials"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      <div class="exs-dots" id="exs-dots"></div>
      <button type="button" class="exs-arrow" id="exs-next" aria-label="Next testimonials"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    </div>
    <a class="exs-cta exs-cta-bottom" href="#exs-offer">CLAIM YOUR OFFER</a>
  </section>

  <p class="exs-disclaimer">*These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease. Individual results may vary.</p>

  <!-- Exit-intent pop-up: shown once per visit when the shopper looks like they're leaving -->
  <dialog class="exs-exit" id="exs-exit" aria-labelledby="exs-exit-h">
    <div class="exs-exit-inner">
      <button type="button" class="exs-exit-close" id="exs-exit-close" aria-label="Close"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button>
      <h2 id="exs-exit-h">Wait! Are You Sure You Want to Miss Out on This Deal?</h2>
      <p>Buy 2 bottles of Extrim Shape and get the 3rd bottle free.</p>
      <img class="exs-exit-img" src="{{ product.featured_image | image_url: width: 460 }}" alt="Extrim Shape: buy 2 bottles, get 1 free" width="230" height="230">
      <span class="exs-badge">Special Offer - Ends November 15</span>
      <div class="exs-price-row">
        <span class="exs-sale-price">{{ variant.price | money }}</span>
        {%- if has_discount %}
        <span class="exs-compare-price">{{ variant.compare_at_price | money }}</span>
        {%- endif %}
      </div>
      <span class="exs-per-bottle">(${{ variant.price | divided_by: 300.0 | round }} a bottle)</span>
      <a class="exs-cta" id="exs-exit-cta" href="/cart/{{ variant.id }}:1?checkout">Order Now</a>
      <button type="button" class="exs-exit-no" id="exs-exit-no">No thanks</button>
    </div>
  </dialog>

</div>
</div>

<script>
  (function () {
    // Variant rendered by Liquid from the Buy 2 Extrim, Get 1 Free product.
    const VARIANT = {{ variant.id }};
    const qty = 1;
    const $ = id => document.getElementById(id);

    // Testimonial carousel: one "page" = as many cards as fit (3 desktop, 2 tablet, 1 phone).
    const track = $('exs-review-track'), dots = $('exs-dots');
    const cardStep = () => track.children[0].getBoundingClientRect().width + 16;
    const perView = () => Math.max(1, Math.round((track.clientWidth + 16) / cardStep()));
    const pages = () => Math.ceil(track.children.length / perView());
    const page = () => Math.round(track.scrollLeft / (cardStep() * perView()));
    const goTo = n => track.scrollTo({ left: Math.min(n * perView() * cardStep(), track.scrollWidth - track.clientWidth) });
    function drawDots() {
      dots.innerHTML = '';
      for (let i = 0; i < pages(); i++) {
        const d = document.createElement('button');
        d.type = 'button';
        d.setAttribute('aria-label', `Show testimonials page ${i + 1}`);
        d.addEventListener('click', () => goTo(i));
        dots.appendChild(d);
      }
      syncNav();
    }
    function syncNav() {
      const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
      const p = atEnd ? pages() - 1 : page();
      [...dots.children].forEach((d, i) => d.setAttribute('aria-current', i === p ? 'true' : 'false'));
      $('exs-prev').disabled = track.scrollLeft <= 4;
      $('exs-next').disabled = atEnd;
    }
    $('exs-prev').addEventListener('click', () => goTo(page() - 1));
    $('exs-next').addEventListener('click', () => goTo(page() + 1));
    track.addEventListener('scroll', syncNav, { passive: true });
    window.addEventListener('resize', drawDots);
    drawDots();

    // Order Now: add the pack to the shopper's EXISTING cart, then go to checkout.
    // This keeps the IBO referral the store saved on the cart. A /cart/<variant>:<qty> permalink
    // would start a fresh cart and drop that referral, so it is only the fallback.
    let ordering = false;
    async function checkout(e) {
      e.preventDefault();
      ordering = true;
      const btn = e.currentTarget, fallback = btn.href;
      btn.setAttribute('aria-busy', 'true');
      try {
        const r = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ items: [{ id: Number(VARIANT), quantity: qty }] })
        });
        if (!r.ok) throw new Error('add failed');
        location.href = '/checkout';
      } catch (err) {
        location.href = fallback;
      }
    }
    $('exs-cta').addEventListener('click', checkout);
    $('exs-exit-cta').addEventListener('click', checkout);

    // Exit-intent pop-up. Shows at most once per visit, never in the first 5 seconds, and never
    // after the shopper has clicked Order Now.
    //  - Desktop: the mouse leaves through the top of the window (toward the tabs / back button).
    //  - Phones (no mouse): a quick scroll back up after they've scrolled past the offer box.
    const exit = $('exs-exit');
    let armed = false;
    setTimeout(() => { armed = true; }, 5000);
    const seen = () => { try { return sessionStorage.getItem('exsExitSeen') === '1'; } catch (err) { return false; } };
    function openExit() {
      if (!armed || ordering || seen() || exit.open || typeof exit.showModal !== 'function') return;
      try { sessionStorage.setItem('exsExitSeen', '1'); } catch (err) {}
      exit.showModal();
    }
    const closeExit = () => exit.close();
    $('exs-exit-close').addEventListener('click', closeExit);
    $('exs-exit-no').addEventListener('click', closeExit);
    exit.addEventListener('click', e => { if (e.target === exit) closeExit(); }); // click on the dark backdrop

    document.addEventListener('mouseout', e => {
      if (!e.relatedTarget && e.clientY <= 0) openExit();
    });

    if (window.matchMedia('(pointer: coarse)').matches) {
      const offer = $('exs-offer');
      let lastY = window.scrollY, lastT = performance.now(), passedOffer = false;
      window.addEventListener('scroll', () => {
        const y = window.scrollY, t = performance.now();
        if (offer.getBoundingClientRect().bottom < 0) passedOffer = true;
        const speed = (lastY - y) / Math.max(t - lastT, 1); // px per ms, positive when scrolling up
        if (passedOffer && speed > 1.5 && y < lastY - 60) openExit();
        lastY = y; lastT = t;
      }, { passive: true });
    }
  })();
</script>
