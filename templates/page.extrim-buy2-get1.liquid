{%- assign youtube_id = "jsswizZ6Zno" -%}
{%- assign product = all_products['buy-2-extrim-get-1-free'] -%}
{%- assign variant = product.selected_or_first_available_variant -%}
{%- assign has_discount = false -%}
{%- if variant.compare_at_price > variant.price -%}
  {%- assign has_discount = true -%}
  {%- assign discount_pct = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round -%}
{%- endif -%}

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=Lato:wght@400;700&display=swap">
<style>
  /*
    Everything is scoped under .exs so it can't restyle the theme's header, menu or footer.
    Same design system as the Gut Defense System page; product accent is the Extrim Shape violet.
  */
  .exs {
    --bg: #ffffff;
    --surface: #F7F6F3;
    --ink: #181818;
    --ink-70: #181818;
    --ink-soft: #181818;
    --extrim: #7A4BB0;
    --extrim-soft: #F3EEF9;
    --accent: #FF8F00;
    --accent-ink: #ffffff;
    --line: #E7E5E0;

    background: var(--bg);
    color: var(--ink);
    font-family: 'Lato', -apple-system, 'Helvetica Neue', Arial, sans-serif;
    font-size: 16px;
    line-height: 1.6;
    letter-spacing: 0.4px;
    /* lets the ingredients photo measure this wrapper (cqw) so it can bleed to the screen edge */
    container-type: inline-size;
  }
  .exs *, .exs *::before, .exs *::after { box-sizing: border-box; }
  .exs a { color: var(--accent); }
  .exs a:focus-visible, .exs button:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }

  .exs-page { max-width: 1040px; margin: 0 auto; padding-block: 28px 56px; padding-inline: 16px; display: flex; flex-direction: column; }

  .exs h1, .exs h2 { font-family: 'Playfair Display', Georgia, serif; font-weight: 400; letter-spacing: 0.5px; margin: 0; text-wrap: balance; color: var(--ink); }
  .exs h1 { font-size: clamp(32px, 5vw, 44px); line-height: 1.12; }
  .exs h2 { font-size: clamp(28px, 4vw, 36px); line-height: 1.2; }

  /* ---- Intro: headline, full-width video, then two columns of copy ---- */
  .exs-intro { width: 100%; max-width: 960px; margin: 0 auto; display: flex; flex-direction: column; gap: 32px; }
  .exs .exs-intro h1 { text-align: center; font-size: clamp(40px, 5.6vw, 52px); line-height: 1.1; }
  .exs-video { width: 100%; aspect-ratio: 16 / 9; border-radius: 20px; overflow: hidden; background: #141412; }
  .exs-video iframe { display: block; width: 100%; height: 100%; border: 0; }

  .exs-copy-cols { display: grid; grid-template-columns: 1fr; gap: 28px; margin-top: 10px; }
  .exs-copy { display: flex; flex-direction: column; gap: 14px; text-align: center; }
  .exs-copy p { margin: 0; color: var(--ink-70); font-size: 16px; line-height: 1.6; }
  .exs-copy .exs-lead { color: var(--extrim); font-weight: 700; font-size: clamp(24px, 2.8vw, 28px); line-height: 1.35; text-transform: uppercase; letter-spacing: 0.5px; }
  /* underline on the key stat */
  .exs-lead mark { color: inherit; background: none; padding: 0; text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 5px; }

  /* Right column: Meet Extrim Shape */
  .exs-meet { margin: 0; padding: 24px; background: var(--surface); border-radius: 16px; display: flex; flex-direction: column; gap: 12px; text-align: center; }
  .exs .exs-meet h2 { font-size: clamp(28px, 4vw, 36px); letter-spacing: 0.5px; }
  .exs-meet p { margin: 0; color: var(--ink-70); font-size: 16px; }
  .exs-meet strong { color: var(--ink); font-weight: 700; }

  /* ---- Pack / offer: full-width light purple band. The box-shadow + clip-path pair paints the
     color out to both screen edges without changing the layout or adding horizontal scroll. ---- */
  .exs-offer { margin: 56px auto 0; width: 100%; max-width: 960px; background: var(--extrim-soft); box-shadow: 0 0 0 100vmax var(--extrim-soft); clip-path: inset(0 -100vmax); padding-block: 48px; display: grid; grid-template-columns: 1fr; gap: 24px; }
  .exs-offer-media, .exs-offer-buy { display: flex; flex-direction: column; gap: 18px; min-width: 0; }
  .exs-offer h2 { text-align: center; }
  /* multiply blends the photo's white background into the band color */
  .exs-pack-img { width: 100%; max-width: 420px; height: auto; display: block; margin-inline: auto; border-radius: 12px; mix-blend-mode: multiply; }

  .exs-deal { display: flex; flex-direction: column; align-items: center; gap: 5px; }
  .exs-offer h2 { margin-bottom: -8px; }
  .exs-badge { margin-bottom: 14px; font-size: 15px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: #fff; background: var(--extrim); border-radius: 56px; padding: 5px 14px; }
  .exs-price-row { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; justify-content: center; font-variant-numeric: tabular-nums; }
  .exs-sale-price { font-size: 28px; line-height: 1.2; }
  .exs-compare-price { color: var(--ink-70); text-decoration: line-through; }
  .exs-per-bottle { font-size: 13.5px; line-height: 1.3; color: var(--ink-soft); margin-top: -4px; }
  .exs-includes { margin: 0; font-size: 14.5px; color: var(--ink-70); text-align: center; }

  .exs .exs-cta { display: flex; align-items: center; justify-content: center; background: var(--accent); color: var(--accent-ink); font-size: 18px; text-transform: uppercase; font-weight: 700; letter-spacing: 0.4px; padding: 16px 28px; border-radius: 56px; text-decoration: none; }
  .exs .exs-cta:hover { filter: brightness(0.96); }
  .exs .exs-cta[aria-busy="true"] { opacity: 0.7; pointer-events: none; }

  .exs-trust { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .exs-trust li { display: flex; gap: 10px; align-items: flex-start; font-size: 16px; }
  .exs-trust svg { flex-shrink: 0; margin-top: 4px; }
  .exs-fine { font-size: 12.5px; color: var(--ink-soft); text-align: center; margin: 0; }

  /* ---- How it works: egg growth factors + Block, Burn, Boost ---- */
  /* Text column + lifestyle photo; stacks on phones, side by side from 900px */
  /* Full-width light gray band, same technique as the offer band */
  .exs-how { margin: 0 auto; width: 100%; max-width: 960px; background: var(--surface); box-shadow: 0 0 0 100vmax var(--surface); clip-path: inset(0 -100vmax); padding-block: 56px; display: grid; grid-template-columns: 1fr; gap: 32px; }
  .exs-how-text { display: flex; flex-direction: column; gap: 26px; min-width: 0; }
  .exs-how-card:first-child { padding-top: 0; }
  .exs-how h2 { text-align: center; letter-spacing: 0.5px; margin-top: 10px; }
  .exs-how-grid { list-style: none; margin: 0; padding: 0; width: 100%; display: grid; grid-template-columns: 1fr; }
  /* Each item: icon on the left, title and text beside it */
  .exs-how-card { padding-block: 18px; display: grid; grid-template-columns: 54px 1fr; column-gap: 18px; row-gap: 6px; align-content: start; }
  .exs-how-icon { grid-row: span 2; width: 54px; height: 54px; border-radius: 50%; background: #fff; color: var(--extrim); display: flex; align-items: center; justify-content: center; }
  /* phones: photo runs edge to edge and down to the bottom of the gray band (cancels the 16px page gutters and 56px band padding) */
  .exs-how-photo { width: calc(100% + 32px); max-width: none; height: auto; margin: 0 -16px -56px; aspect-ratio: 4 / 3; object-fit: cover; object-position: center 30%; display: block; }
  /* !important is needed: the store's custom.css forces "h1, h2, h3 { font-family: Playfair Display !important }" */
  .exs .exs-how-card h3 { margin: 4px 0 0; font-family: 'Lato', -apple-system, 'Helvetica Neue', Arial, sans-serif !important; font-style: normal; font-size: 17px; font-weight: 700; line-height: 1.3; letter-spacing: 0.5px; text-transform: uppercase; color: var(--extrim); }
  .exs-how-card p { margin: 0; color: var(--ink-70); font-size: 16px; }
  .exs-how-card p strong { color: var(--ink); }

  /* ---- Testimonials ---- */
  .exs-reviews { margin: 66px auto 0; width: 100%; max-width: 960px; padding-bottom: 30px; display: flex; flex-direction: column; align-items: center; gap: 24px; }
  .exs-reviews h2 { text-align: center; letter-spacing: 0.5px; }
  /* Carousel: a horizontal scroll-snap row. 1 card shows on phones, 2 on tablets, 3 on desktop.
     Swipe works natively; the arrows and dots below just scroll the row. */
  .exs-review-grid { --per: 1; list-style: none; margin: 0; padding: 2px 0; width: 100%; display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - (var(--per) - 1) * 16px) / var(--per)); gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; scrollbar-width: none; }
  .exs-review-grid::-webkit-scrollbar { display: none; }
  .exs-review { scroll-snap-align: start; }
  .exs-carousel-nav { display: flex; align-items: center; gap: 14px; }
  .exs-carousel-nav button.exs-arrow { width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line); background: #fff; color: var(--ink); cursor: pointer; display: flex; align-items: center; justify-content: center; padding: 0; }
  .exs-carousel-nav button.exs-arrow:disabled { opacity: 0.35; cursor: default; }
  .exs-dots { display: flex; gap: 8px; }
  .exs-dots button { width: 8px; height: 8px; border-radius: 50%; border: 0; padding: 0; background: var(--line); cursor: pointer; }
  .exs-dots button[aria-current="true"] { background: var(--extrim); }
  .exs-review { background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 22px 22px 20px; display: flex; flex-direction: column; justify-content: space-between; gap: 14px; }
  .exs-review p { margin: 0; color: var(--ink-70); font-size: 16px; }
  .exs-review p strong { color: var(--ink); }
  .exs-review-name { font-weight: 700; color: var(--extrim); font-size: 16px; text-transform: uppercase; letter-spacing: 0.5px; }
  .exs .exs-cta-bottom { flex: none; width: 100%; max-width: 360px; }

  /* ---- Exit-intent pop-up ---- */
  .exs-exit { border: 0; padding: 0; margin: auto; width: min(440px, calc(100vw - 32px)); max-height: calc(100dvh - 32px); overflow: auto; border-radius: 20px; background: #fff; color: var(--ink); box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25); }
  .exs-exit::backdrop { background: rgba(24, 24, 24, 0.55); }
  .exs-exit-inner { position: relative; padding: 44px clamp(28px, 7vw, 44px) 32px; display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center; }
  .exs .exs-exit h2 { font-size: 28px; line-height: 1.2; }
  .exs-exit p { margin: 0; }
  .exs-exit-img { width: 100%; max-width: 230px; height: auto; display: block; }
  .exs-exit .exs-badge { margin: 4px 0 2px; font-size: 13px; white-space: nowrap; }
  @media (max-width: 420px) { .exs-exit .exs-badge { font-size: 12px; letter-spacing: 0.03em; } }
  .exs-exit .exs-price-row { justify-content: center; }
  .exs .exs-exit .exs-cta { width: 100%; margin-top: 8px; }
  .exs-exit-close { position: absolute; top: 10px; right: 10px; width: 36px; height: 36px; border: 0; border-radius: 50%; background: var(--surface); color: var(--ink); cursor: pointer; display: flex; align-items: center; justify-content: center; padding: 0; }
  .exs-exit-no { border: 0; background: none; padding: 6px; font: inherit; font-size: 14px; color: var(--ink); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }

  .exs-disclaimer { margin: 48px auto 0; max-width: 80ch; font-size: 12px; line-height: 1.5; color: var(--ink-soft); text-align: center; }

  @media (prefers-reduced-motion: reduce) { .exs * { transition: none !important; } }
  @media (min-width: 900px) {
    .exs-copy-cols { grid-template-columns: 1fr 1fr; gap: 40px; align-items: start; }
    .exs-copy, .exs-meet { text-align: left; }
    .exs-offer { grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; }
    .exs-offer h2 { text-align: left; }
    .exs-deal { align-items: flex-start; }
    .exs-price-row { justify-content: flex-start; }
    .exs-includes, .exs-fine { text-align: left; }
    .exs-review-grid { --per: 3; }
    /* Split band: the section spans the full window (cqw = the .exs wrapper's width) and is cut
       exactly in half, so the photo starts at the screen's center line and runs to its right edge.
       The text sits much closer to the left edge than the rest of the page's content (35% of that gap)
       (--gutter = the gap between the 960px content column and the window edge). */
    .exs-how { --gutter: calc((100cqw - min(960px, min(1040px, 100cqw) - 32px)) / 2); max-width: none; width: 100cqw; margin-left: calc(50% - 50cqw); grid-template-columns: 1fr 1fr; gap: 0; }
    .exs-how-text { padding-left: max(16px, calc(var(--gutter) * 0.35)); padding-right: 48px; }
    .exs-how h2 { text-align: left; }
    /* photo runs the full height of the gray band: negative margins cancel its 56px padding */
    .exs-how-photo { height: 0; min-height: calc(100% + 112px); margin: -56px 0; width: 100%; max-width: none; aspect-ratio: auto; object-position: center 25%; }
  }
  @media (min-width: 640px) and (max-width: 899px) {
    .exs-review-grid { --per: 2; }
  }
  .exs-offer { scroll-margin-top: 100px; }
</style>

<div class="exs">
<div class="exs-page">

  <section class="exs-intro" aria-labelledby="exs-intro-h">
    <h1 id="exs-intro-h">There's More to<br> Blood Sugar Than You&nbsp;Think</h1>

    <div class="exs-video">
      <iframe src="https://www.youtube.com/embed/{{ youtube_id }}" title="Extrim Shape video" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen loading="lazy"></iframe>
    </div>

    <div class="exs-copy-cols">
      <div class="exs-copy">
        <p class="exs-lead">Did you know that <mark>nearly 1&nbsp;in&nbsp;4 adults over&nbsp;65</mark> worldwide live with diabetes?</p>
        <p>
          As we age, maintaining healthy blood sugar levels becomes increasingly important. Understanding
          how your body manages blood sugar is an important part of supporting your overall wellness.
        </p>
      </div>

      <div class="exs-meet">
        <h2>Meet Extrim Shape</h2>
        <p>
          Supporting healthy blood sugar levels is an important part of overall wellness, especially as we age.
        </p>
        <p>
          <strong>Extrim Shape</strong> brings together LifePharm's proprietary egg bioactive growth factors and
          carefully selected botanical ingredients in one convenient daily formula.*
        </p>
      </div>
    </div>
  </section>

  <!-- Pack / offer -->
  <section class="exs-offer" id="exs-offer" aria-labelledby="exs-offer-h">
    <div class="exs-offer-media">
      <img class="exs-pack-img" src="{{ product.featured_image | image_url: width: 840 }}" alt="Extrim Shape: buy 2 bottles, get 1 free" width="420" height="420">
    </div>

    <div class="exs-offer-buy">
      <h2 id="exs-offer-h">{{ product.title }}</h2>
      <div class="exs-deal">
        <span class="exs-badge">Special Offer - Ends November 15</span>
        <div class="exs-price-row">
          <span class="exs-sale-price" id="exs-sale-price">{{ variant.price | money }}</span>
          {%- if has_discount %}
          <span class="exs-compare-price" id="exs-compare-price">{{ variant.compare_at_price | money }}</span>
          {%- endif %}
        </div>
        {%- comment -%} The pack is 3 bottles, so the per-bottle price is the pack price / 3, rounded to the dollar. {%- endcomment -%}
        <span class="exs-per-bottle">(${{ variant.price | divided_by: 300.0 | round }} a bottle)</span>
      </div>

      <a class="exs-cta" id="exs-cta" href="/cart/{{ variant.id }}:1?checkout">Order Now</a>

      <ul class="exs-trust">
        <li><svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M3 9.5L7 13.5L15 4.5" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>60-day money-back guarantee</span></li>
        <li><svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M3 9.5L7 13.5L15 4.5" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Made in USA · FDA-registered facility · cGMP · Clean Label Certified</span></li>
      </ul>
      <p class="exs-fine">Taxes and shipping calculated at checkout.</p>
    </div>
  </section>

  <!-- Ingredients: copy supplied by the user 2026-10-22 -->
  <section class="exs-how" aria-labelledby="exs-how-h">
    <div class="exs-how-text">
    <h2 id="exs-how-h">Inside the Extrim Formula</h2>
    <ul class="exs-how-grid">
      <li class="exs-how-card">
        <span class="exs-how-icon"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3C8.5 3 5.5 8.5 5.5 13.5a6.5 6.5 0 0 0 13 0C18.5 8.5 15.5 3 12 3Z"/></svg></span>
        <h3>Egg Bioactive Growth Factors</h3>
        <p>LifePharm's proprietary growth factors, researched for their potential to <strong>support healthy blood sugar levels.</strong>*</p>
      </li>
      <li class="exs-how-card">
        <span class="exs-how-icon"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6l7-3Z"/></svg></span>
        <h3>Block Blend</h3>
        <p>A targeted combination of ingredients that helps <strong>manage cravings for sugary foods</strong> and <strong>supports healthy blood sugar levels.</strong>*</p>
      </li>
      <li class="exs-how-card">
        <span class="exs-how-icon"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21c3.9 0 6.5-2.7 6.5-6.3 0-3.4-2.4-5.6-3.7-8.7-.6 1.9-1.6 3-2.8 3.6C12.4 6.6 11 4.4 9 3c.3 3-1.3 5-2.5 6.7C5.8 10.9 5.5 12.3 5.5 14.7 5.5 18.3 8.1 21 12 21Z"/></svg></span>
        <h3>Burn Blend</h3>
        <p>A blend of plant extracts that <strong>supports healthy metabolism</strong>, <strong>helps manage appetite</strong>, and <strong>maintains healthy blood sugar levels.</strong>*</p>
      </li>
      <li class="exs-how-card">
        <span class="exs-how-icon"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 3L5 13.5h6L10 21l8-10.5h-6L13 3Z"/></svg></span>
        <h3>Boost Blend</h3>
        <p>A combination of plant-based ingredients that helps you <strong>feel full</strong> and <strong>stay regular.</strong>*</p>
      </li>
    </ul>
    </div>
    <img class="exs-how-photo" src="https://cdn.shopify.com/s/files/1/0885/0128/9269/files/Extrim-Bottle-3.png?v=1792629506&width=960" alt="Smiling woman holding a bottle of Extrim Shape" width="800" height="1004" loading="lazy">
  </section>

  <!-- Testimonials: approved endorsements from the "LifePharm Endorsements" sheet, Extrim tab.
       Weight-loss lines are left out on purpose; "…" marks where a testimonial was shortened. -->
  <section class="exs-reviews" aria-labelledby="exs-reviews-h">
    <h2 id="exs-reviews-h">What People Are Saying About Extrim Shape</h2>
    <ul class="exs-review-grid" id="exs-review-track" aria-label="Testimonials, swipe or use the arrows for more">
      <li class="exs-review">
