{%- comment -%}
  Gut Defense System landing page (template: page.gut-fuel-pack-landing).
  No {% layout 'lp' %}: this uses the theme's normal layout, so the store header/menu and footer show.

  Product: "Gut Defense System" (formerly Gut Fuel Pack), handle gut-defense-system,
  product 10806318825781, variant 53593877152053 (SKU S201010401).
  Price, compare-at price and variant come from the product itself, so changes in Shopify admin show here.
  If the product URL/handle ever changes again, update 'gut-defense-system' on the next line.
  The fallback values keep Order Now working until you do.
{%- endcomment -%}
{%- assign gds = all_products['gut-defense-system'] -%}
{%- assign gds_variant = gds.selected_or_first_available_variant -%}
{%- if gds_variant -%}
  {%- assign gds_variant_id = gds_variant.id -%}
  {%- assign gds_price = gds_variant.price -%}
  {%- assign gds_compare = gds_variant.compare_at_price | default: gds_variant.price -%}
{%- else -%}
  {%- assign gds_variant_id = 53593877152053 -%}
  {%- assign gds_price = 21900 -%}
  {%- assign gds_compare = 33200 -%}
{%- endif -%}
{%- comment -%} Pack photo: the product's own image, or this file if the product has none. {%- endcomment -%}
{%- if gds.featured_image -%}
  {%- assign gds_image = gds.featured_image | image_url: width: 840 -%}
{%- else -%}
  {%- assign gds_image = 'https://cdn.shopify.com/s/files/1/0885/0128/9269/files/GutFuelPack-NA.png?v=1790023995' -%}
{%- endif -%}
{%- assign gds_save_pct = 0 -%}
{%- if gds_compare > gds_price -%}
  {%- assign gds_save_pct = gds_compare | minus: gds_price | times: 100 | divided_by: gds_compare -%}
{%- endif -%}

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=Lato:wght@400;700&display=swap">
<style>
  /*
    Everything is scoped under .gds so it can't restyle the theme's header, menu or footer
    (now that this page uses the normal theme layout instead of 'lp').
    Same design system as the LAMININE & OMEGA+++ page; product accent is DIGESTIVE+++ green.
  */
  .gds {
    --bg: #ffffff;
    --surface: #F7F6F3;
    --ink: #181818;
    --ink-70: rgba(24, 24, 24, 0.7);
    --ink-soft: #666666;
    --digestive-green: #3DAE2B;
    --digestive-soft: #EEF7EC;
    --accent: #FF8F00;
    --accent-ink: #ffffff;
    --line: #E7E5E0;

    background: var(--bg);
    color: var(--ink);
    font-family: 'Lato', -apple-system, 'Helvetica Neue', Arial, sans-serif;
    font-size: 16px;
    line-height: 1.6;
    letter-spacing: 0.4px;
  }
  .gds *, .gds *::before, .gds *::after { box-sizing: border-box; }
  .gds a { color: var(--accent); }
  .gds a:focus-visible, .gds button:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }

  .gds-page { max-width: 1040px; margin: 0 auto; padding-block: 28px 56px; padding-inline: 16px; display: flex; flex-direction: column; }

  .gds h1, .gds h2 { font-family: 'Playfair Display', Georgia, serif; font-weight: 400; letter-spacing: 1.12px; margin: 0; text-wrap: balance; color: var(--ink); }
  .gds h1 { font-size: clamp(32px, 5vw, 44px); line-height: 1.12; }
  .gds h2 { font-size: clamp(26px, 3.4vw, 32px); line-height: 1.2; }
  .gds sup { font-size: 0.6em; line-height: 0; vertical-align: 0; position: relative; top: -0.55em; letter-spacing: 0; margin-left: 0.04em; }

  /* ---- Intro: full-width video, then headline, then two columns of copy ---- */
  .gds-intro { width: 100%; max-width: 960px; margin: 0 auto; display: flex; flex-direction: column; gap: 32px; }
  .gds .gds-intro h1 { text-align: center; font-size: clamp(34px, 5.6vw, 52px); line-height: 1.1; }
  .gds-video { width: 100%; aspect-ratio: 16 / 9; border-radius: 20px; overflow: hidden; background: #141412; }
  .gds-video iframe { display: block; width: 100%; height: 100%; border: 0; }

  .gds-copy-cols { display: grid; grid-template-columns: 1fr; gap: 28px; }
  .gds-copy { display: flex; flex-direction: column; gap: 14px; }
  .gds-copy p { margin: 0; color: var(--ink-70); font-size: 18px; line-height: 1.6; }

  /* Right column: the two parts of the system */
  .gds-parts { list-style: none; margin: 0; padding: 8px 24px; background: var(--digestive-soft); border-radius: 16px; display: flex; flex-direction: column; }
  .gds-part { display: flex; gap: 16px; align-items: flex-start; padding-block: 18px; }
  .gds-part-icon { flex-shrink: 0; width: 36px; height: 36px; color: var(--digestive-green); margin-top: 2px; }
  .gds-part + .gds-part { border-top: 1px solid rgba(61, 174, 43, 0.22); }
  .gds-part p { margin: 0; color: var(--ink-70); }
  .gds-part strong { color: var(--ink); font-weight: 700; }

  /* ---- Pack / offer box (same layout as the LAMININE & OMEGA+++ page) ---- */
  .gds-offer { margin: 48px auto 0; width: 100%; max-width: 960px; border: 1px solid var(--line); border-radius: 20px; padding-block: 30px; padding-inline: clamp(18px, 4vw, 40px); display: grid; grid-template-columns: 1fr; gap: 24px; }
  .gds-offer-media, .gds-offer-buy { display: flex; flex-direction: column; gap: 18px; min-width: 0; }
  .gds-offer h2 { text-align: center; }
  .gds-pack-img { width: 100%; max-width: 420px; height: auto; display: block; margin-inline: auto; border-radius: 12px; }

  .gds-deal { display: flex; flex-direction: column; align-items: center; gap: 5px; }
  .gds-badge { font-size: 14px; font-weight: 700; color: #fff; background: var(--digestive-green); border-radius: 56px; padding: 5px 14px; }
  .gds-price-row { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; justify-content: center; font-variant-numeric: tabular-nums; }
  .gds-sale-price { font-size: 28px; }
  .gds-compare-price { color: var(--ink-70); text-decoration: line-through; }
  .gds-includes { margin: 0; font-size: 14.5px; color: var(--ink-70); text-align: center; }

  .gds-buy-row { display: flex; gap: 12px; align-items: stretch; }
  .gds-qty { display: flex; align-items: center; border: 1px solid var(--line); border-radius: 56px; overflow: hidden; flex-shrink: 0; }
  .gds-qty button { width: 44px; height: 100%; min-height: 52px; border: 0; background: none; font: inherit; font-size: 20px; cursor: pointer; color: var(--ink); }
  .gds-qty button:disabled { color: var(--line); cursor: default; }
  .gds-qty output { min-width: 28px; text-align: center; font-weight: 700; font-variant-numeric: tabular-nums; }
  .gds .gds-cta { flex: 1; display: flex; align-items: center; justify-content: center; background: var(--accent); color: var(--accent-ink); font-weight: 700; letter-spacing: 0.4px; padding: 16px 28px; border-radius: 56px; text-decoration: none; }
  .gds .gds-cta:hover { filter: brightness(0.96); }
  .gds .gds-cta[aria-busy="true"] { opacity: 0.7; pointer-events: none; }

  .gds-trust { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .gds-trust li { display: flex; gap: 10px; align-items: flex-start; font-size: 16px; }
  .gds-trust svg { flex-shrink: 0; margin-top: 4px; }
  .gds-fine { font-size: 12.5px; color: var(--ink-soft); text-align: center; margin: 0; }

  .gds-disclaimer { margin: 48px auto 0; max-width: 80ch; font-size: 12px; line-height: 1.5; color: var(--ink-soft); text-align: center; }

  @media (prefers-reduced-motion: reduce) { .gds * { transition: none !important; } }
  @media (min-width: 900px) {
    .gds-copy-cols { grid-template-columns: 1fr 1fr; gap: 40px; align-items: start; }
  }
  @media (min-width: 900px) {
    .gds-offer { grid-template-columns: 1fr 1fr; gap: 40px; align-items: start; }
    .gds-offer h2 { text-align: left; }
    .gds-deal { align-items: flex-start; }
    .gds-price-row { justify-content: flex-start; }
    .gds-includes, .gds-fine { text-align: left; }
  }
</style>

