<script>
  (function () {
    // Values rendered by Liquid from the Gut Defense System product (prices in cents).
    const VARIANT = {{ gds_variant_id | json }};
    const UNIT_SALE = {{ gds_price | json }}, UNIT_COMPARE = {{ gds_compare | json }};
    const MAX_QTY = 10;
    let qty = 1;

    const $ = id => document.getElementById(id);
    const fmt = cents => '$' + (cents / 100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');

    function render() {
      $('gds-qty').textContent = qty;
      $('gds-qty-minus').disabled = qty <= 1;
      $('gds-qty-plus').disabled = qty >= MAX_QTY;
      $('gds-sale-price').textContent = fmt(UNIT_SALE * qty);
      if ($('gds-compare-price')) $('gds-compare-price').textContent = fmt(UNIT_COMPARE * qty);
      $('gds-cta').href = `/cart/${VARIANT}:${qty}?checkout`;
    }
    $('gds-qty-minus').addEventListener('click', () => { if (qty > 1) { qty--; render(); } });
    $('gds-qty-plus').addEventListener('click', () => { if (qty < MAX_QTY) { qty++; render(); } });
    render();

    // Order Now: add the pack to the shopper's EXISTING cart, then go to checkout.
    // This keeps the IBO referral the store saved on the cart. A /cart/<variant>:<qty> permalink
    // would start a fresh cart and drop that referral, so it is only the fallback.
    $('gds-cta').addEventListener('click', async e => {
      e.preventDefault();
      const btn = e.currentTarget, fallback = btn.href;
      btn.setAttribute('aria-busy', 'true');
      try {
        const r = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ items: [{ id: Number(VARIANT), quantity: qty }] })
        });
        if (!r.ok) throw new Error('add failed');
        location.href = '/checkout';
      } catch (err) {
        location.href = fallback;
      }
    });
  })();
</script>