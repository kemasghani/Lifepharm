      "blocks": {
        "item_RLgGdn": {
          "type": "item",
          "settings": {
            "column_size": "3",
            "title": "",
            "heading_tag": "h4",
            "content": "<h6><strong>Based on a recent clinical study it has now been shown that LAMININE lowers the level of the stress hormone cortisol in our bodies.</strong></h6><p><br/>A vicious cycle often occurs in the relationship between joint pain and stress.</p><p><br/>The difficulties which arise from living with chronic pain creates stress...</p><p><br/>and this stress causes muscle tension and increased pain along with worsening symptoms.</p><p><strong><br/>The worsening symptoms lead back to more stress.</strong></p>",
            "link_url": "",
            "link_text": "",
            "link_style": "link"
          }
        },
