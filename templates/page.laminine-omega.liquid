  <!-- IBO contact
       Wiring: IBO links use ?ref=<web alias> (HubSpot "web alias" = Exigo "login name").
       The store's referral app already looks the IBO up and saves name (+ replicated-site email when it
       provides one) to localStorage; the script below reads it. Contact button shows only if that email exists. Show the Contact button only when an email is on file;
       hide the whole card when there's no referral. -->
  <p class="disclaimer">*These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease. Study results reflect normal-range markers in small study groups; individual results may vary.<br /><br /></p>

</div>

  <section class="ibo" id="ibo" aria-live="polite" hidden></section>


<script>
  // ----- Quantity + price -----
  const UNIT_SALE = 223.50, UNIT_COMPARE = 398.00;
  const PACK = '50552364302553';
  let qty = 1;
  // EU store money format: €1.234,50
  const fmt = n => '€' + n.toFixed(2).replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, '.');
  function renderQty() {
    document.getElementById('qty').textContent = qty;
    document.getElementById('qty-minus').disabled = qty <= 1;
    document.getElementById('sale-price').textContent = fmt(UNIT_SALE * qty);
    document.getElementById('compare-price').textContent = fmt(UNIT_COMPARE * qty);
    document.getElementById('cta').href = `https://europe.lifepharm.com/cart/${PACK}:${qty}?checkout`;
  }
  document.getElementById('qty-minus').addEventListener('click', () => { if (qty > 1) { qty--; renderQty(); } });
  document.getElementById('qty-plus').addEventListener('click', () => { if (qty < 10) { qty++; renderQty(); } });
  renderQty();

  // Order Now: add the pack to the shopper's EXISTING cart, then go to checkout.
  // This keeps the IBO referral the store saved on the cart (e.g. "Referral" / "referrer_webalias").
  // A /cart/<variant>:<qty> permalink would start a fresh cart and drop that referral, so it is only the fallback.
  document.getElementById('cta').addEventListener('click', async e => {
    e.preventDefault();
    const btn = e.currentTarget, fallback = btn.href;
    btn.setAttribute('aria-busy', 'true');
    try {
      const r = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: [{ id: Number(PACK), quantity: qty }] })
      });
      if (!r.ok) throw new Error('add failed');
      location.href = '/checkout';
    } catch (err) {
      location.href = fallback;
    }
  });

  // ----- IBO contact card (example data for the preview) -----
  // IBO lookup. The store's referral app (Sync Engine) resolves ?ref=<web alias / Exigo login name>
  // and saves the IBO to localStorage as "sync_engine_referral":
  //   {"webalias":"happy","id":"1003836","firstName":"...","lastName":"...","email":null,...}
  // On shop.lifepharm.com this section reads that record. "RetailDirect" is the app's corporate
  // fallback when there's no referral, so the card stays hidden for it.
  // Outside the store (this preview), localStorage is a different origin, so a sample card shows instead.
  const ON_STORE = /(^|\.)lifepharm\.com$/i.test(location.hostname);
  const SAMPLE_IBO = { first: 'IBO', last: 'Name', email: 'ibo@example.com' };
  // Turns a referral-app record into what the card needs. "RetailDirect" = corporate fallback, no IBO.
  function toIbo(r) {
    if (!r || !r.firstName || /^retaildirect$/i.test(r.webalias || '')) return null;
    // Email = the IBO's replicated-site email. No valid email -> no Contact button (name still shows).
    const email = String(r.email || '').trim();
    return { first: r.firstName, last: r.lastName || '', email: /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) ? email : '' };
  }
  // NA store: the referral app saves the IBO here after its own lookup.
  function readReferral() {
    try { return toIbo(JSON.parse(localStorage.getItem('sync_engine_referral') || 'null')); }
    catch (e) { return null; }
  }
  // EU store (and fallback anywhere): the store only keeps the alias, so look the IBO up with the
  // referral app's own search (/apps/teqnavi/referral/search). Alias comes from ?ref= or the cart.
  async function lookupByAlias() {
    let alias = new URLSearchParams(location.search).get('ref');
    if (!alias) {
      try { const c = await fetch('/cart.js').then(r => r.json()); alias = c.attributes && (c.attributes.referrer_webalias || c.attributes.Referral); } catch (e) {}
    }
    if (!alias || /^retaildirect$/i.test(alias)) return null;
    const r = await fetch('/apps/teqnavi/referral/search?term=' + encodeURIComponent(alias));
    if (!r.ok) return null;
    const list = await r.json();
    return toIbo((Array.isArray(list) ? list : []).find(x => String(x.webalias || '').toLowerCase() === alias.toLowerCase()));
  }
  const esc = s => s.replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

  function renderIbo(ibo) {
    const el = document.getElementById('ibo');
    if (!ibo) {
      el.innerHTML = '';
      el.hidden = true;
      return;
    }
    el.hidden = false;
    const name = `${ibo.first} ${ibo.last}`.trim();
    el.innerHTML = `
      <div class="ibo-card">
        <div>
          <div class="ibo-label">You are now shopping with</div>
          <div class="ibo-name">${esc(name)}</div>
        </div>
        ${ibo.email ? `
        <div class="ibo-actions">
          <a class="ibo-btn" id="ibo-contact" href="mailto:${esc(ibo.email)}?subject=${encodeURIComponent('Question about the LAMININE & OMEGA+++ Pack')}">Contact ${esc(ibo.first)}</a>
          <div class="ibo-email" id="ibo-email" hidden>
            <code id="ibo-email-text">${esc(ibo.email)}</code>
            <button type="button" id="ibo-copy">Copy</button>
          </div>
        </div>` : ''}
      </div>`;
    const btn = document.getElementById('ibo-contact');
    if (btn) {
      // Reveal the address too, so it works even where mailto links don't open.
      btn.addEventListener('click', () => { document.getElementById('ibo-email').hidden = false; });
      document.getElementById('ibo-copy').addEventListener('click', e => {
        const b = e.currentTarget;
        navigator.clipboard.writeText(ibo.email).then(() => { b.textContent = 'Copied'; }).catch(() => {
          const r = document.createRange(); r.selectNodeContents(document.getElementById('ibo-email-text'));
          const s = getSelection(); s.removeAllRanges(); s.addRange(r);
        });
      });
    }
  }
  if (!ON_STORE) {
    renderIbo(SAMPLE_IBO);
  } else {
    // The referral app can finish a moment after page load, so check its saved record a few times,
    // then fall back to looking the alias up directly (this is what makes the name work on EU).
    (async () => {
      for (let i = 0; i < 4; i++) {
        const ibo = readReferral();
        if (ibo) return renderIbo(ibo);
        await new Promise(r => setTimeout(r, 500));
      }
      renderIbo(await lookupByAlias().catch(() => null));
    })();
    window.addEventListener('storage', e => { if (e.key === 'sync_engine_referral') renderIbo(readReferral()); });
  }
</script>
