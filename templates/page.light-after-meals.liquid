        .then(function () { _cdBusy = false; });
    }
    function go(variant, code, diffuser, btn) {
      setBtnLoading(btn);
      var items = [{ id: variant, quantity: 1 }];
      if (diffuser) items.push({ id: CN_CART.refill.variant, quantity: 1, selling_plan: CN_CART.refill.sellingPlan });
      /* ADD the chosen item(s) to the cart (no clearing — shoppers manage quantity in the drawer),
         then OPEN THE DRAWER so they stay on the page. Checkout goes to the discounted /checkout
         (skips the cart page + its referral gate). On failure, fall back to a direct redirect. */
      addToCart(items)
        .then(function () { return fetch("/cart.js", { headers: { "Accept": "application/json" } }); })
        .then(function (r) { return r.json(); })
        .then(function (cart) { recomputeCode(cart); renderDrawer(cart); openDrawer(); restoreBtn(btn); })
        .catch(function () { _cdCheckoutUrl = co(code); window.location.href = _cdCheckoutUrl; });
    }
    function buySingle(btn) { go(CN_CART.single.variant, "MEAL10", false, btn); }

    function renderDrawer(cart) {
      var items = (cart && cart.items) || [];
      var box = document.getElementById("cd-items"), cnt = document.getElementById("cd-count");
      /* Preview the checkout discount so the drawer "looks like they're saving": subtotal,
         discount line (MEAL10 -$10 / MEAL20 -$20), discounted total, savings. */
      var subtotal = cart && cart.total_price != null ? cart.total_price : 0;
      var has3 = false, has1 = false;
      items.forEach(function (it) { if (it.id == CN_CART.triple.variant) has3 = true; if (it.id == CN_CART.single.variant) has1 = true; });
      var disc = has3 ? 2000 : (has1 ? 1000 : 0), code = has3 ? "MEAL20" : "MEAL10", total = Math.max(0, subtotal - disc);
      if (cnt) cnt.textContent = cart && cart.item_count != null ? cart.item_count : items.length;
      var sEl = document.getElementById("cd-subtotal"); if (sEl) sEl.textContent = _cdMoney(subtotal);
      var dRow = document.getElementById("cd-discrow"), dLab = document.getElementById("cd-disclabel"), dAmt = document.getElementById("cd-disc"), sv = document.getElementById("cd-save");
      if (disc > 0) { if (dRow) dRow.hidden = false; if (dLab) dLab.textContent = code; if (dAmt) dAmt.textContent = "-" + _cdMoney(disc); if (sv) { sv.hidden = false; sv.textContent = "You're saving " + _cdMoney(disc) + " at checkout"; } }
      else { if (dRow) dRow.hidden = true; if (sv) sv.hidden = true; }
      var tEl = document.getElementById("cd-total"); if (tEl) tEl.textContent = _cdMoney(total);
      updateNav(cart && cart.item_count != null ? cart.item_count : items.length);
      if (box) box.innerHTML = items.map(function (it) {
        var sub = it.selling_plan_allocation ? '<div class="cd-it-s">Subscription</div>' : "";
        var img = it.image ? '<img class="cd-it-img" src="' + it.image + '" alt="">' : '<div class="cd-it-img"></div>';
        var k = it.key;
        var qty = '<div class="cd-qty"><button type="button" class="cd-q cd-dec" data-key="' + k + '" aria-label="Decrease quantity">&minus;</button><span class="cd-qn">' + it.quantity + '</span><button type="button" class="cd-q cd-inc" data-key="' + k + '" aria-label="Increase quantity">+</button><button type="button" class="cd-rm" data-key="' + k + '">Remove</button></div>';
        var wasUnit = Math.max(it.compare_at_price || 0, WAS[it.id] || 0);
        var wasLine = (wasUnit > it.final_price) ? wasUnit * it.quantity : 0;
        var priceHtml = (wasLine ? '<span class="cd-was">' + _cdMoney(wasLine) + '</span>' : '') + '<span class="cd-now">' + _cdMoney(it.final_line_price) + '</span>';
        return '<div class="cd-it">' + img +
          '<div class="cd-it-mid"><div class="cd-it-t">' + (it.product_title || it.title) + '</div>' + sub + qty + '</div>' +
          '<div class="cd-it-p">' + priceHtml + '</div></div>';
      }).join("");
    }
    /* View the cart WITHOUT touching it (non-destructive) — the floating cart button uses this,
       so reopening never resets a shopper's selection. */
    function openCart() {
      fetch("/cart.js", { headers: { "Accept": "application/json" } })
        .then(function (r) { return r.json(); })
        .then(function (cart) { recomputeCode(cart); renderDrawer(cart); openDrawer(); })
        .catch(function () {});
    }
    function openDrawer() {
      var o = document.getElementById("cd-overlay"), d = document.getElementById("cart-drawer-lp");
      if (o) o.classList.add("open");
      if (d) { d.classList.add("open"); d.setAttribute("aria-hidden", "false"); }
      document.body.style.overflow = "hidden";
    }
    function closeDrawer() {
      var o = document.getElementById("cd-overlay"), d = document.getElementById("cart-drawer-lp");
      if (o) o.classList.remove("open");
      if (d) { d.classList.remove("open"); d.setAttribute("aria-hidden", "true"); }
      document.body.style.overflow = "";
    }
    (function () {
      var x = document.getElementById("cd-close"), keep = document.getElementById("cd-keep"),
          ov = document.getElementById("cd-overlay"), coBtn = document.getElementById("cd-checkout");
      if (x) x.addEventListener("click", closeDrawer);
      if (keep) keep.addEventListener("click", closeDrawer);
      if (ov) ov.addEventListener("click", closeDrawer);
      if (coBtn) coBtn.addEventListener("click", function (e) { e.preventDefault(); if (_cdCheckoutUrl) window.location.href = _cdCheckoutUrl; });
      document.addEventListener("keydown", function (e) { if (e.key === "Escape") closeDrawer(); });
      /* Quantity +/- and Remove, delegated on the items container so it survives re-renders. */
      var itemsBox = document.getElementById("cd-items");
      if (itemsBox) itemsBox.addEventListener("click", function (e) {
        var b = e.target.closest("button[data-key]"); if (!b) return;
        var key = b.getAttribute("data-key"), row = b.closest(".cd-it"), qn = row ? row.querySelector(".cd-qn") : null;
        var cur = qn ? (parseInt(qn.textContent, 10) || 1) : 1;
        if (b.classList.contains("cd-rm")) changeQty(key, 0);
        else if (b.classList.contains("cd-inc")) changeQty(key, cur + 1);
        else if (b.classList.contains("cd-dec")) changeQty(key, cur - 1);
      });
      /* Floating cart button = non-destructive reopen. On load, show current count. */
      var nav = document.getElementById("navCart");
      if (nav) nav.addEventListener("click", function (e) { e.preventDefault(); openCart(); });
      fetch("/cart.js", { headers: { "Accept": "application/json" } }).then(function (r) { return r.json(); }).then(function (cart) { updateNav(cart && cart.item_count != null ? cart.item_count : 0); }).catch(function () {});
    })();

    /* secondary CTAs: #offer jump links + every /discount/ link (announce, hero, mid-page)
       -> single bottle. The #order-cta button is handled separately (respects pack + diffuser). */
    document.querySelectorAll('a[href="#offer"]').forEach(function (a) {
      a.addEventListener("click", function (e) { e.preventDefault(); buySingle(e.currentTarget); });
    });
    document.querySelectorAll('a[href*="/discount/"]').forEach(function (a) {
      if (a.id === "order-cta") return;
      a.addEventListener("click", function (e) { e.preventDefault(); buySingle(e.currentTarget); });
    });

    /* ---------- trust marquee ---------- */
    var SVG = {
      shield: '<svg viewBox="0 0 24 24"><path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>',
      bpa: '<svg viewBox="0 0 24 24"><path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/><path d="M4 4l16 16"/></svg>'
    };
    var ITEMS = [
      { svg: "shield", label: "90-Day Money-Back Guarantee" },
      { chip: true, plain: true, logo: "{{ 'truemed-orange.svg' | asset_url }}", label: "FSA Eligible" },
      { logo: "{{ 'bbb.webp' | asset_url }}", logoOnly: true, label: "BBB Accredited Business" },
      { chip: true, logoOnly: true, logo: "{{ 'asa-logo.svg' | asset_url }}", label: "American Society on Aging" },
      { svg: "bpa", label: "BPA Free" }
    ];
    var track = document.getElementById("marquee-track");
    if (track) {
      var html = ITEMS.map(function (it) {
        if (it.chip) return '<span class="m-item chip' + (it.plain ? " nobg" : "") + '"><img class="m-logo" src="' + it.logo + '" alt="' + it.label + '">' + (it.logoOnly ? "" : '<span class="m-lab">' + it.label + "</span>") + "</span>";
        if (it.logoOnly) return '<span class="m-item"><img class="m-logo" src="' + it.logo + '" alt="' + it.label + '"></span>';
        if (it.logo) return '<span class="m-item"><img class="m-logo" src="' + it.logo + '" alt="' + it.label + '"><span class="m-lab">' + it.label + "</span></span>";
        return '<span class="m-item"><span class="m-ic">' + SVG[it.svg] + '</span><span class="m-lab">' + it.label + "</span></span>";
      }).join("");
      track.innerHTML = html + html;
    }

    /* ---------- problem hub ---------- */
    var spokes = document.querySelectorAll(".spoke");
    spokes.forEach(function (s) {
      s.addEventListener("click", function (e) {
        e.preventDefault();
        var wasOpen = s.classList.contains("open");
        spokes.forEach(function (o) { o.classList.remove("open"); });
        if (!wasOpen) s.classList.add("open");
      });
    });

    /* ---------- comparison ---------- */
    var glance = document.querySelector(".glance");
    if (glance) {
      glance.addEventListener("click", function (e) {
        if (e.target.closest("a")) return;
        glance.classList.toggle("open");
      });
    }

    /* ---------- FAQ accordion ---------- */
    document.querySelectorAll(".faq-item").forEach(function (item) {
      var q = item.querySelector(".faq-q"), a = item.querySelector(".faq-a");
      q.addEventListener("click", function () {
        var open = item.classList.contains("open");
        document.querySelectorAll(".faq-item.open").forEach(function (o) { o.classList.remove("open"); o.querySelector(".faq-a").style.maxHeight = null; });
        if (!open) { item.classList.add("open"); a.style.maxHeight = a.scrollHeight + "px"; }
      });
    });

    /* ---------- buy tabs ---------- */
    var PLANS = {
      single: {
        variant: CN_CART.single.variant,
        was: "$49", now: "$39", save: "You save $10", badge: "$10", cta: "Get My Bottle, Save $10", code: "MEAL10",
        includes: ["1 CELLNERGY Hydration System (650 mL / 22 oz)", "6-element mineral diffuser installed inside", "90-day money-back guarantee", "HSA / FSA accepted"]
      },
      triple: {
        variant: CN_CART.triple.variant,
        was: "$119", now: "$99", save: "You save $20", badge: "$20", cta: "Get My 3-Pack, Save $20", code: "MEAL20",
        includes: ["3 CELLNERGY Hydration Systems (650 mL / 22 oz)", "6-element mineral diffuser installed inside", "90-day money-back guarantee", "HSA / FSA accepted"]
      }
    };
    var currentPlan = "single";
    var elWas = document.getElementById("p-was"), elNow = document.getElementById("p-now"),
        elSave = document.getElementById("p-save"), elCta = document.getElementById("order-cta"),
        elInc = document.getElementById("p-includes"), elAmt = document.getElementById("save-amt"),
        buyTabs = [].slice.call(document.querySelectorAll(".buy-tab"));
    function applyPlan(key) {
      var p = PLANS[key];
      if (!p) return;
      currentPlan = key;
      if (elWas) elWas.textContent = p.was;
      if (elNow) elNow.textContent = p.now;
      if (elSave) elSave.textContent = p.save;
      if (elAmt) elAmt.textContent = p.badge;
      if (elInc) elInc.innerHTML = p.includes.map(function (i) { return "<li>" + i + "</li>"; }).join("");
      if (elCta) { elCta.textContent = p.cta; elCta.setAttribute("href", co(p.code)); }
      buyTabs.forEach(function (t) {
        var on = t.getAttribute("data-plan") === key;
        t.classList.toggle("active", on);
        t.setAttribute("aria-selected", on ? "true" : "false");
      });
    }
    buyTabs.forEach(function (t) {
      t.addEventListener("click", function () { applyPlan(t.getAttribute("data-plan")); });
    });
    applyPlan("single");
    var _bump = document.getElementById("diffuser-bump");
    if (_bump) _bump.addEventListener("change", function () { applyPlan(currentPlan); });

    /* main order button: AJAX-add the selected pack (+ diffuser if checked), then redirect
       to the discounted /checkout. preventDefault stops navigation to the fallback href. */
    if (elCta) elCta.addEventListener("click", function (e) {
      e.preventDefault();
      var p = PLANS[currentPlan] || PLANS.single;
      var bump = document.getElementById("diffuser-bump");
      go(p.variant, p.code, !!(bump && bump.checked), e.currentTarget);
    });

    /* ---------- order CTA: its href is the discounted checkout link (set per plan in applyPlan);
       clicking just navigates. AddToCart pixel is handled by lp.liquid's click-listener. ---------- */

    /* ---------- video poster fallback ---------- */
    ["ph-vid", "vid-inside", "vid-offer"].forEach(function (id) {
      var v = document.getElementById(id);
      if (!v) return;
      v.addEventListener("error", function () {
        var img = document.createElement("img");
        img.src = v.getAttribute("poster") || "";
        img.alt = v.getAttribute("aria-label") || "";
        v.replaceWith(img);
      });
    });

    /* ---------- reveals + (desktop-only) Lenis smooth scroll ---------- */
    var lenis = null;
    function raf(t) { if (lenis) lenis.raf(t); requestAnimationFrame(raf); }
    /* Lenis only on non-touch/desktop. On phones (esp. the Facebook/Instagram in-app browser)
       it adds a heavy always-on loop + an external script that can error, and native scroll is
       smoother. Reveals below fall back to the native scroll listener. */
    if (!(window.matchMedia && window.matchMedia("(pointer: coarse)").matches)) {
      var _lenisScript = document.createElement("script");
      _lenisScript.src = "https://unpkg.com/lenis@1.3.21/dist/lenis.min.js";
      _lenisScript.onload = function () {
        if (!window.Lenis) return;
        lenis = new Lenis({ lerp: 0.09, smoothWheel: true });
        window.__lenis = lenis;
        requestAnimationFrame(raf);
        if (lenis.on) lenis.on("scroll", revealInView);
      };
      document.head.appendChild(_lenisScript);
    }
    var reveals = [].slice.call(document.querySelectorAll(".reveal"));
    function revealInView() {
      var h = window.innerHeight || document.documentElement.clientHeight;
      for (var i = reveals.length - 1; i >= 0; i--) {
        if (reveals[i].getBoundingClientRect().top < h * 0.9) { reveals[i].classList.add("in"); reveals.splice(i, 1); }
      }
    }
    revealInView();
    if (lenis && lenis.on) lenis.on("scroll", revealInView);
    window.addEventListener("scroll", revealInView, { passive: true });
    window.addEventListener("resize", revealInView);
    setTimeout(revealInView, 300);
    setTimeout(revealInView, 1200);

    /* ---------- anchor smooth scroll ---------- */
    document.querySelectorAll('a[href^="#"]').forEach(function (a) {
      a.addEventListener("click", function (e) {
        var id = a.getAttribute("href");
        if (id.length < 2 || id === "#offer") return; // #offer buttons add to cart, don't scroll
        var target = document.querySelector(id);
        if (!target) return;
        e.preventDefault();
        if (lenis && lenis.scrollTo) lenis.scrollTo(target, { offset: -60 });
        else target.scrollIntoView({ behavior: "smooth" });
      });
    });
  })();
  </script>

