    "lp_sci_chapters": {
      "type": "lp-sci-chapters",
      "blocks": {
        "ch_1": {
          "type": "chapter",
          "settings": {
            "image": "shopify://shop_images/repair_your_cells.jpg",
            "title": "Natural repair slows with age",
            "text": "<p>Your body is always working to repair itself, but as we get older that process can slow down. LifePharm products help give it a natural boost, using fertilised avian eggs rich in growth factors, tiny messengers extracted at their peak activity.</p>"
          }
        },
        "ch_2": {
          "type": "chapter",
          "settings": {
            "image": "shopify://shop_images/fgf-2_science.jpg",
            "title": "Growth factors send the signal",
            "text": "<p>Growth factors in our egg extract, such as FGF-2, signal stem cells towards the areas of the body that need support. There, stem cells can help repair and renew tissue.</p>"
          }
        },
        "ch_3": {
          "type": "chapter",
          "settings": {
            "image": "shopify://shop_images/in_our_nature.jpg",
            "title": "Building blocks for renewal",
            "text": "<p>The extract also contains other cellular factors and amino acids, the building blocks of protein. Your body uses them to maintain tissue, renew cells and make hormones and neurotransmitters.</p>"
          }
        },
        "ch_4": {
          "type": "chapter",
          "settings": {
            "image": "shopify://shop_images/healthy_aging.jpg",
            "title": "What the studies suggest",
            "text": "<p>Research suggests this combination of growth factors, cellular factors and amino acids may help:*</p><ul><li>Support your body’s natural repair</li><li>Maintain healthy joints and cartilage</li><li>Support healthy ageing</li></ul>"
          }
        }
      },
      "block_order": [
        "ch_1",
        "ch_2",
        "ch_3",
        "ch_4"
      ],
      "settings": {
        "anchor": "how-it-works",
        "eyebrow": "How it works",
        "heading": "From egg to <em>renewal</em>",
        "text": "<p>Four steps, from a single ingredient to the way your body renews itself.</p>"
      }
    },
