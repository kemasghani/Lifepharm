      "settings": {
        "eyebrow": "The Regeneration Company",
        "heading": "Cellular Renewal Starts <em>Here</em>",
        "text": "<p>Your body already knows how to repair itself. We give it what it needs to do that, backed by a U.S. patent, 20 years of research and a standard most supplement companies never bother to meet.</p>",
        "image": "shopify://shop_images/lp-science-hero-dna.jpg",
        "image_alt": "DNA helix made of capsules among green plants",
        "jump_label": "On this page",
        "link_1_label": "Explore the science",
        "link_1_url": "#how-it-works",
        "link_2_label": "See the studies",
        "link_2_url": "#studies",
        "card_value": "",
        "card_label": ""
