{% layout none %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Share Cellnergy Cream</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Figtree:wght@400;500;600;700&display=swap">
<style>
  :root{
    --ground:#FBF6EF;      /* warm off-white, biased toward brand orange */
    --card:#FFFFFF;
    --ink:#2B2521;         /* warm near-black */
    --muted:#8B8177;       /* warm grey */
    --line:#EDE4D8;        /* hairline */
    --orange:#F58220;      /* LifePharm brand orange */
    --orange-dark:#D96A0E;
    --orange-soft:#FDEBD8;
    --wa:#25D366;          /* WhatsApp */
    --sms:#31C75A;         /* messages */
    --mail:#5B7FE0;        /* email */
    --shadow:0 10px 30px rgba(43,37,33,.10);
    --shadow-btn:0 4px 14px rgba(43,37,33,.08);
  }
  @media (prefers-color-scheme:dark){
    :root:not([data-theme="light"]){
      --ground:#171310; --card:#221C17; --ink:#F5EDE3; --muted:#B3A597;
      --line:#332A22; --orange:#FF9436; --orange-dark:#F58220; --orange-soft:#3A2A18;
      --shadow:0 12px 34px rgba(0,0,0,.45); --shadow-btn:0 4px 14px rgba(0,0,0,.35);
    }
  }
  :root[data-theme="dark"]{
    --ground:#171310; --card:#221C17; --ink:#F5EDE3; --muted:#B3A597;
    --line:#332A22; --orange:#FF9436; --orange-dark:#F58220; --orange-soft:#3A2A18;
    --shadow:0 12px 34px rgba(0,0,0,.45); --shadow-btn:0 4px 14px rgba(0,0,0,.35);
  }
  *{box-sizing:border-box}
  body{background:var(--ground);color:var(--ink);font-family:"Figtree",system-ui,-apple-system,sans-serif;
    margin:0;line-height:1.5;-webkit-font-smoothing:antialiased;}
  .wrap{max-width:440px;margin:0 auto;padding:26px 20px 40px;}
  .kicker{font-size:.72rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--orange-dark);
    display:flex;align-items:center;gap:8px;}
  .kicker::before{content:"";width:22px;height:2px;background:var(--orange);border-radius:2px;}
  h1{font-family:"Fredoka",sans-serif;font-weight:700;font-size:2rem;line-height:1.08;margin:14px 0 6px;
    text-wrap:balance;letter-spacing:-.01em;}
  h1 .name{color:var(--orange-dark);}
  .lede{color:var(--muted);font-size:1.02rem;margin:0 0 22px;}

  .card{background:var(--card);border:1px solid var(--line);border-radius:22px;box-shadow:var(--shadow);
    overflow:hidden;margin-bottom:22px;}
  .card .photo{background:var(--orange-soft);display:flex;align-items:center;justify-content:center;padding:18px;}
  .card .photo img{width:150px;height:150px;object-fit:contain;filter:drop-shadow(0 8px 18px rgba(43,37,33,.15));}
  .card .body{padding:16px 18px 20px;}
  .prod-name{font-family:"Fredoka",sans-serif;font-weight:600;font-size:1.15rem;margin:0;}
  .prod-sub{color:var(--muted);font-size:.9rem;margin:2px 0 14px;}
  .perk{display:flex;align-items:center;gap:10px;background:var(--orange-soft);color:var(--orange-dark);
    font-weight:700;font-size:.92rem;border-radius:12px;padding:11px 13px;}
  .perk svg{flex:none}

  .link-label{font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);
    margin:22px 2px 8px;}
  .link-row{display:flex;gap:8px;align-items:stretch;}
  .link-box{flex:1;min-width:0;background:var(--card);border:1px solid var(--line);border-radius:13px;
    padding:12px 14px;font-size:.86rem;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
    display:flex;align-items:center;}
  .copy-btn{flex:none;border:none;cursor:pointer;background:var(--ink);color:var(--ground);border-radius:13px;
    padding:0 16px;font-family:inherit;font-weight:700;font-size:.86rem;}

  .share-title{font-family:"Fredoka",sans-serif;font-weight:600;font-size:1.05rem;margin:28px 2px 12px;}
  .btns{display:flex;flex-direction:column;gap:11px;}
  .sbtn{display:flex;align-items:center;gap:14px;width:100%;text-decoration:none;cursor:pointer;
    background:var(--card);border:1px solid var(--line);border-radius:16px;padding:14px 16px;
    color:var(--ink);font-family:inherit;font-weight:600;font-size:1.02rem;box-shadow:var(--shadow-btn);
    transition:transform .12s ease, box-shadow .12s ease;}
  .sbtn:active{transform:scale(.985);}
  .sbtn .ic{width:42px;height:42px;border-radius:12px;display:flex;align-items:center;justify-content:center;flex:none;color:#fff;}
  .sbtn .chev{margin-left:auto;color:var(--muted);flex:none;}
  .sbtn.primary{background:var(--orange);border-color:transparent;color:#fff;box-shadow:0 8px 20px rgba(245,130,32,.35);}
  .sbtn.primary .chev{color:rgba(255,255,255,.85);}
  .ic-wa{background:var(--wa);} .ic-sms{background:var(--sms);} .ic-mail{background:var(--mail);}
  .ic-copy{background:var(--ink);} .ic-more{background:rgba(255,255,255,.22);}

  .foot{display:flex;gap:10px;align-items:flex-start;margin-top:24px;color:var(--muted);font-size:.86rem;}
  .foot svg{flex:none;margin-top:2px;color:var(--orange);}

  .toast{position:fixed;left:50%;bottom:26px;transform:translateX(-50%) translateY(20px);opacity:0;
    background:var(--ink);color:var(--ground);font-weight:700;font-size:.9rem;padding:11px 18px;border-radius:999px;
    box-shadow:var(--shadow);transition:opacity .2s ease, transform .2s ease;pointer-events:none;z-index:9;}
  .toast.show{opacity:1;transform:translateX(-50%) translateY(0);}
  @media (prefers-reduced-motion:reduce){*{transition:none !important;}}
  :focus-visible{outline:3px solid var(--orange);outline-offset:2px;border-radius:8px;}
</style>
</head>
<body>
<div class="wrap">
  <div class="kicker">LifePharm Ambassador</div>
  <h1>You're in, <span class="name" id="name">Sonia</span>! 🎉</h1>
  <p class="lede">Here's your personal link. Tap a button below to share it — your message is ready, just pick a friend and send.</p>

  <div class="card">
    <div class="photo"><img src="data:image/png;base64," alt="Cellnergy Power Cream"></div>
    <div class="body">
      <p class="prod-name">Cellnergy Power Cream</p>
      <p class="prod-sub">The one product to share to start earning.</p>
      <div class="perk">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12v10H4V12"/><path d="M2 7h20v5H2z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
        Your friends get <strong>10% off</strong> their first subscription
      </div>

      <div class="link-label">Your link</div>
      <div class="link-row">
        <div class="link-box" id="linkText">shop.lifepharm.com/…</div>
        <button class="copy-btn" id="copyInline">Copy</button>
      </div>
    </div>
  </div>

  <div class="share-title">Share it in one tap</div>
  <div class="btns">
    <a class="sbtn primary" id="waBtn" target="_blank" rel="noopener">
      <span class="ic ic-wa"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.9c0 1.76.46 3.45 1.34 4.95L2 22l5.3-1.39a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm5.8 14.06c-.25.69-1.44 1.32-1.99 1.4-.53.08-1.17.11-1.89-.12-.44-.14-1-.32-1.72-.64-3.03-1.31-5-4.36-5.16-4.57-.15-.2-1.23-1.64-1.23-3.13 0-1.49.78-2.22 1.06-2.53.28-.3.61-.38.81-.38.2 0 .41 0 .58.01.19.01.44-.07.69.53.25.6.86 2.09.94 2.24.08.15.13.33.02.53-.1.2-.15.33-.3.5-.15.18-.32.4-.46.53-.15.15-.31.32-.13.62.18.3.79 1.3 1.7 2.11 1.17 1.04 2.16 1.36 2.46 1.51.3.15.47.13.65-.08.18-.2.75-.87.95-1.17.2-.3.4-.25.67-.15.27.1 1.72.81 2.01.96.3.15.5.22.57.35.07.13.07.72-.18 1.41Z"/></svg></span>
      WhatsApp
      <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
    </a>
    <a class="sbtn" id="smsBtn">
      <span class="ic ic-sms"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3C6.5 3 2 6.8 2 11.5c0 2.2 1 4.2 2.7 5.7-.2 1.3-.8 2.6-1.6 3.5-.2.2 0 .6.3.5 1.9-.4 3.4-1.1 4.4-1.8 1.3.4 2.7.6 4.2.6 5.5 0 10-3.8 10-8.5S17.5 3 12 3Z"/></svg></span>
      Text message
      <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
    </a>
    <a class="sbtn" id="mailBtn">
      <span class="ic ic-mail"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></span>
      Email
      <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
    </a>
    <button class="sbtn" id="copyBtn">
      <span class="ic ic-copy"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg></span>
      Copy link
      <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
    </button>
    <button class="sbtn" id="moreBtn" hidden>
      <span class="ic ic-more" style="background:var(--orange-dark)"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"/></svg></span>
      More options…
      <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
    </button>
  </div>

  <div class="foot">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
    <span>You earn your commission when a friend orders through <strong>your</strong> link — sharing is always free.</span>
  </div>
</div>

<div class="toast" id="toast">Copied! ✓</div>

<script>
  (function(){
    var q = new URLSearchParams(location.search);
    var name = q.get('name') || 'Sonia';
    var ref  = q.get('ref')  || 'sonia-demo';        // ambassador's UpPromote referral handle
    var url  = 'https://shop.lifepharm.com/products/cellnergy-power-cream?sca_ref=' + encodeURIComponent(ref);
    var msg  = "Thought you'd love this — LifePharm Cellnergy Power Cream. Here's 10% off your first subscription:";
    var full = msg + ' ' + url;

    document.getElementById('name').textContent = name;
    document.getElementById('linkText').textContent = url.replace(/^https?:\/\//,'');

    document.getElementById('waBtn').href  = 'https://wa.me/?text=' + encodeURIComponent(full);
    document.getElementById('smsBtn').href = 'sms:?&body=' + encodeURIComponent(full);
    document.getElementById('mailBtn').href= 'mailto:?subject=' + encodeURIComponent('A little something I think you’ll love') + '&body=' + encodeURIComponent(full);

    var toast = document.getElementById('toast'), t;
    function ping(text){ toast.textContent = text; toast.classList.add('show'); clearTimeout(t); t=setTimeout(function(){toast.classList.remove('show');},1600); }
    function copy(){ (navigator.clipboard ? navigator.clipboard.writeText(url) : Promise.reject()).then(function(){ping('Link copied! ✓');},function(){ var ta=document.createElement('textarea');ta.value=url;document.body.appendChild(ta);ta.select();try{document.execCommand('copy');ping('Link copied! ✓');}catch(e){}document.body.removeChild(ta);}); }
    document.getElementById('copyBtn').addEventListener('click', copy);
    document.getElementById('copyInline').addEventListener('click', copy);

    if (navigator.share) {
      var more = document.getElementById('moreBtn');
      more.hidden = false;
      more.addEventListener('click', function(){ navigator.share({ text: msg, url: url }).catch(function(){}); });
    }
  })();
</script>
</body>
</html>
