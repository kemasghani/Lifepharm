  #cart-drawer-lp .cd-row{display:flex;align-items:center;justify-content:space-between;font-size:14px;color:var(--gray);margin-bottom:8px}
  #cart-drawer-lp .cd-discrow{color:var(--ok);font-weight:700}
  #cart-drawer-lp .cd-disc-l{display:inline-flex;align-items:center;gap:6px}
  #cart-drawer-lp .cd-discrow svg{width:15px;height:15px}
  #cart-drawer-lp .cd-totrow{padding-top:10px;border-top:1px solid var(--line)}
  #cart-drawer-lp .cd-save{margin:8px 0 14px;font-size:13.5px;font-weight:800;color:var(--orange)}
  #cart-drawer-lp .cd-note{font-size:11.5px;color:var(--muted);line-height:1.45;margin:0 0 14px}
  #cart-drawer-lp .cd-checkout{display:flex;align-items:center;justify-content:center;gap:8px;background:var(--orange);color:#fff;font-weight:800;font-size:16.5px;padding:15px;border-radius:999px;text-decoration:none;box-shadow:0 8px 22px rgba(245,130,32,.35)}
  #cart-drawer-lp .cd-checkout svg{width:15px;height:15px}
  #cart-drawer-lp .cd-keep{display:block;width:100%;margin-top:12px;background:none;border:none;color:var(--muted);font-size:13.5px;text-decoration:underline;cursor:pointer}
  @media(max-width:480px){#cart-drawer-lp{width:100%;max-width:100%}}
  .nav-cart{position:relative;background:none;border:none;cursor:pointer;padding:6px;display:inline-flex;align-items:center;color:var(--ink);margin-left:2px}
  .nav-cart svg{width:24px;height:24px;stroke:var(--ink);fill:none;stroke-width:2}
  .nav-cart:hover svg{stroke:var(--orange)}
  .nav-cart-count{position:absolute;top:-3px;right:-5px;min-width:18px;height:18px;padding:0 5px;border-radius:999px;background:var(--orange);color:#fff;font-size:11px;font-weight:800;display:flex;align-items:center;justify-content:center;line-height:1}
</style>
<div id="cd-overlay"></div>
<aside id="cart-drawer-lp" aria-hidden="true" aria-label="Your cart">
  <div class="cd-head">
    <span class="cd-h-title">Cart</span>
    <span class="cd-count" id="cd-count">0</span>
    <button type="button" class="cd-close" id="cd-close" aria-label="Close">&times;</button>
  </div>
  <div class="cd-items" id="cd-items"></div>
  <div class="cd-foot">
    <div class="cd-row cd-subrow"><span>Subtotal</span><span id="cd-subtotal">$0.00</span></div>
    <div class="cd-row cd-discrow" id="cd-discrow" hidden><span class="cd-disc-l"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20.6 13.4L11 3.8a2 2 0 0 0-1.4-.6H4v5.6a2 2 0 0 0 .6 1.4l9.6 9.6a2 2 0 0 0 2.8 0l3.6-3.6a2 2 0 0 0 0-2.8z"/><circle cx="7.5" cy="7.5" r="1.2" fill="currentColor"/></svg> <span id="cd-disclabel">HABIT10</span></span><span id="cd-disc">-$0.00</span></div>
    <div class="cd-totrow"><span class="l">Total</span><span class="r" id="cd-total">$0.00</span></div>
    <div class="cd-save" id="cd-save" hidden>You're saving $0.00 at checkout</div>
    <p class="cd-note">Discount applied automatically at checkout. Shipping &amp; taxes calculated at checkout.</p>
    <a href="#" class="cd-checkout" id="cd-checkout">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M6 10V8a6 6 0 0 1 12 0v2"/><rect x="4" y="10" width="16" height="10" rx="2"/></svg>
      Checkout
    </a>
    <button type="button" class="cd-keep" id="cd-keep">Continue reading</button>
  </div>
</aside>


<script>
(function(){
  var SINGLE={variant:53040002400565,code:"HABIT10"},TRIPLE={variant:53003471388981,code:"HABIT20"},DIFF=53049168167221,SKIO=710885900597;
  /* Regular ("was") prices in cents for the strikethrough, matching the page: bottle $49,
     3-pack $119, diffuser refill $25 (first payment is 25% off). Used only as a fallback if
     the variant's own compare-at price isn't returned by /cart.js. */
  var WAS={};WAS[SINGLE.variant]=4900;WAS[TRIPLE.variant]=11900;WAS[DIFF]=2500;
  var buyBtn=document.getElementById("buyBtn"),diff=document.getElementById("diffuser"),cur=SINGLE;
  var _cdDest=null;
  function _cdMoney(c){return "$"+(Math.round(c)/100).toFixed(2);}
  function updateNav(n){var nc=document.getElementById("navCartCount");if(nc){nc.textContent=n;nc.hidden=!n;}}
  /* Pick the checkout discount code from what's actually in the cart: 3-pack -> HABIT20,
     otherwise -> HABIT10. Keeps the applied code correct no matter how they built the cart. */
  function recomputeCode(cart){
    var has3=false;(cart&&cart.items||[]).forEach(function(it){if(it.id==TRIPLE.variant)has3=true;});
    _cdDest="https://shop.lifepharm.com/discount/"+(has3?TRIPLE.code:SINGLE.code)+"?redirect=/checkout";
  }
  var _cdBusy=false;
  /* Change a line's quantity in place (0 removes it), then re-render from the returned cart.
     This is what makes the reset unnecessary: shoppers adjust here instead of re-clicking CTAs. */
  function changeQty(key,qty){
    if(_cdBusy)return;_cdBusy=true;
    fetch("/cart/change.js",{method:"POST",headers:{"Content-Type":"application/json","Accept":"application/json"},body:JSON.stringify({id:key,quantity:qty})})
      .then(function(r){return r.json();})
      .then(function(cart){recomputeCode(cart);renderDrawer(cart);})
      .catch(function(){})
      .then(function(){_cdBusy=false;});
  }
  function renderDrawer(cart){
    var items=(cart&&cart.items)||[];
    var box=document.getElementById("cd-items"),cnt=document.getElementById("cd-count");
    /* Preview the checkout discount so the drawer "looks like they're saving." The codes are
       fixed-dollar (HABIT10 = $10 off, HABIT20 = $20 off) and applied at checkout via the
       permalink, so we mirror them here: subtotal, discount line, discounted total, savings. */
    var subtotal=cart&&cart.total_price!=null?cart.total_price:0;
    var has3=false,has1=false;
    items.forEach(function(it){if(it.id==TRIPLE.variant)has3=true;if(it.id==SINGLE.variant)has1=true;});
    var disc=has3?2000:(has1?1000:0),code=has3?TRIPLE.code:SINGLE.code,total=Math.max(0,subtotal-disc);
    if(cnt)cnt.textContent=cart&&cart.item_count!=null?cart.item_count:items.length;
    var sEl=document.getElementById("cd-subtotal");if(sEl)sEl.textContent=_cdMoney(subtotal);
    var dRow=document.getElementById("cd-discrow"),dLab=document.getElementById("cd-disclabel"),dAmt=document.getElementById("cd-disc"),sv=document.getElementById("cd-save");
    if(disc>0){if(dRow)dRow.hidden=false;if(dLab)dLab.textContent=code;if(dAmt)dAmt.textContent="-"+_cdMoney(disc);if(sv){sv.hidden=false;sv.textContent="You're saving "+_cdMoney(disc)+" at checkout";}}
    else{if(dRow)dRow.hidden=true;if(sv)sv.hidden=true;}
    var tEl=document.getElementById("cd-total");if(tEl)tEl.textContent=_cdMoney(total);
    updateNav(cart&&cart.item_count!=null?cart.item_count:items.length);
    if(box)box.innerHTML=items.map(function(it){
      var sub=it.selling_plan_allocation?'<div class="cd-it-s">Subscription</div>':"";
      var img=it.image?'<img class="cd-it-img" src="'+it.image+'" alt="">':'<div class="cd-it-img"></div>';
      var k=it.key;
      var qty='<div class="cd-qty"><button type="button" class="cd-q cd-dec" data-key="'+k+'" aria-label="Decrease quantity">&minus;</button><span class="cd-qn">'+it.quantity+'</span><button type="button" class="cd-q cd-inc" data-key="'+k+'" aria-label="Increase quantity">+</button><button type="button" class="cd-rm" data-key="'+k+'">Remove</button></div>';
      var wasUnit=Math.max(it.compare_at_price||0,WAS[it.id]||0);
      var wasLine=(wasUnit>it.final_price)?wasUnit*it.quantity:0;
      var priceHtml=(wasLine?'<span class="cd-was">'+_cdMoney(wasLine)+'</span>':'')+'<span class="cd-now">'+_cdMoney(it.final_line_price)+'</span>';
      return '<div class="cd-it">'+img+'<div class="cd-it-mid"><div class="cd-it-t">'+(it.product_title||it.title)+'</div>'+sub+qty+'</div><div class="cd-it-p">'+priceHtml+'</div></div>';
    }).join("");
  }
  function openDrawer(){var o=document.getElementById("cd-overlay"),d=document.getElementById("cart-drawer-lp");if(o)o.classList.add("open");if(d){d.classList.add("open");d.setAttribute("aria-hidden","false");}document.body.style.overflow="hidden";}
  function closeDrawer(){var o=document.getElementById("cd-overlay"),d=document.getElementById("cart-drawer-lp");if(o)o.classList.remove("open");if(d){d.classList.remove("open");d.setAttribute("aria-hidden","true");}document.body.style.overflow="";}
  /* View the cart WITHOUT touching it (non-destructive) — this is what the header cart icon
     uses, so reopening never resets a shopper's selection. Sets the discounted checkout URL
     from whatever's actually in the cart (single vs 3-pack) so Checkout still applies a code. */
  function openCart(){
    fetch("/cart.js",{headers:{"Accept":"application/json"}})
      .then(function(r){return r.json();})
      .then(function(cart){recomputeCode(cart);renderDrawer(cart);openDrawer();})
      .catch(function(){});
  }
  /* ADD the chosen item(s) to the cart (no clearing — shoppers manage quantity in the drawer),
     then OPEN THE DRAWER so they stay on the page. Checkout goes to the discounted /checkout
     (skips the cart page + its referral gate). On failure, fall back to a direct redirect so
     buying never breaks. */
  function go(plan,withDiff){
    var items=[{id:plan.variant,quantity:1}];
    if(withDiff)items.push({id:DIFF,quantity:1,selling_plan:SKIO});
    fetch("/cart/add.js",{method:"POST",headers:{"Content-Type":"application/json","Accept":"application/json"},body:JSON.stringify({items:items})})
      .then(function(){return fetch("/cart.js",{headers:{"Accept":"application/json"}});})
      .then(function(r){return r.json();})
      .then(function(cart){recomputeCode(cart);renderDrawer(cart);openDrawer();})
      .catch(function(){_cdDest="https://shop.lifepharm.com/discount/"+plan.code+"?redirect=/checkout";window.location.href=_cdDest;});
  }
  document.querySelectorAll(".plan").forEach(function(p){p.addEventListener("click",function(){cur=(p.dataset.now==="$99")?TRIPLE:SINGLE;});});
  if(buyBtn)buyBtn.addEventListener("click",function(e){e.preventDefault();go(cur,diff&&diff.checked);});
  document.querySelectorAll('a[href*="/discount/"]').forEach(function(a){if(a===buyBtn)return;a.addEventListener("click",function(e){e.preventDefault();go(SINGLE,false);});});
  var _x=document.getElementById("cd-close"),_k=document.getElementById("cd-keep"),_ov=document.getElementById("cd-overlay"),_co=document.getElementById("cd-checkout");
  if(_x)_x.addEventListener("click",closeDrawer);
  if(_k)_k.addEventListener("click",closeDrawer);
  if(_ov)_ov.addEventListener("click",closeDrawer);
  if(_co)_co.addEventListener("click",function(e){e.preventDefault();if(_cdDest)window.location.href=_cdDest;});
  document.addEventListener("keydown",function(e){if(e.key==="Escape")closeDrawer();});
  /* Quantity +/- and Remove, delegated on the items container so it keeps working after each
     re-render. Decrement below 1 removes the line. */
  var _items=document.getElementById("cd-items");
  if(_items)_items.addEventListener("click",function(e){
    var b=e.target.closest("button[data-key]");if(!b)return;
    var key=b.getAttribute("data-key"),row=b.closest(".cd-it"),qn=row?row.querySelector(".cd-qn"):null;
    var cur=qn?(parseInt(qn.textContent,10)||1):1;
    if(b.classList.contains("cd-rm"))changeQty(key,0);
    else if(b.classList.contains("cd-inc"))changeQty(key,cur+1);
    else if(b.classList.contains("cd-dec"))changeQty(key,cur-1);
  });
  /* Header cart icon = non-destructive reopen. On load, show the current cart count so a
     returning shopper sees what they already have. */
  var _nav=document.getElementById("navCart");
  if(_nav)_nav.addEventListener("click",function(e){e.preventDefault();openCart();});
  fetch("/cart.js",{headers:{"Accept":"application/json"}}).then(function(r){return r.json();}).then(function(cart){updateNav(cart&&cart.item_count!=null?cart.item_count:0);}).catch(function(){});
})();
</script>
