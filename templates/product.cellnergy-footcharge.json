    "lp_overview": {
      "type": "lp-pdp-overview",
      "settings": {
        "image": "shopify://shop_images/CellnergyFOOTCHARGE-withbox.png",
        "image_fit": "contain",
        "caption": "Cellnergy FootCharge and its box",
        "media_position": "start",
        "eyebrow": "Why FootCharge",
        "heading": "Regeneration From the Ground Up",
        "text": "<p>Cellnergy FootCharge brings full-body regeneration from the ground up by stimulating the nerve-rich zones in your feet. It combines CellWave™ Bioactivation, Terahertz Resonance and Infrared Thermotherapy to help restore neuromuscular communication, support circulation and support cellular energy production.</p><p>Whether you’re dealing with fatigue, numbness or stress, it helps your body rebalance through a daily, drug-free ritual.</p>",
        "chips_label": "Regenerative Support For",
        "chips": "Nervous system support, Circulation, Nerve-related discomfort, Balance and coordination, Cellular energy, Nerve fatigue, Restorative sleep",
        "note_label": "",
        "note": ""
      },
      "blocks": {
        "stat_1": {
          "type": "stat",
          "settings": {
            "value": "6",
            "label": "Smart modes"
          }
        },
        "stat_2": {
          "type": "stat",
          "settings": {
            "value": "10",
            "label": "Intensity levels"
          }
        },
        "stat_3": {
          "type": "stat",
          "settings": {
            "value": "2",
            "label": "Heat levels"
          }
        },
        "stat_4": {
          "type": "stat",
          "settings": {
            "value": "15 min",
            "label": "Auto-off session"
          }
        }
      },
      "block_order": [
        "stat_1",
        "stat_2",
        "stat_3",
        "stat_4"
      ]
    },
    "lp_tech": {
      "type": "lp-pdp-cards",
      "settings": {
        "style": "image",
        "columns": 3,
        "background": "none",
        "eyebrow": "The Technology",
        "heading": "Three Technologies, One Daily Ritual",
        "text": "<p>Together they create a complete regenerative experience, designed to help restore your feet, your nervous system and your overall wellbeing.</p>",
        "disclaimer": ""
      },
      "blocks": {
        "card_1": {
          "type": "card",
          "settings": {
            "image": "shopify://shop_images/AdobeStock_912094788.jpg",
            "label": "Low-frequency waves",
            "title": "CellWave™ Bioactivation",
            "text": "<p>Gentle low-frequency waves stimulate your nerves and neuromuscular pathways. This may awaken dormant signalling between brain and body, supporting balance, coordination and nervous system vitality.</p>"
          }
        },
        "card_2": {
          "type": "card",
          "settings": {
            "image": "shopify://shop_images/AdobeStock_1439178340.jpg",
            "label": "About 1 THz",
            "title": "Terahertz Resonance",
            "text": "<p>Terahertz resonance helps reactivate cellular activity by harmonising your body’s natural electromagnetic rhythms, supporting renewed energy and functional vitality at the cellular level.</p>"
          }
        },
        "card_3": {
          "type": "card",
          "settings": {
            "image": "shopify://shop_images/AdobeStock_1338758573.jpg",
            "label": "38 to 45°C",
            "title": "Infrared Thermotherapy",
            "text": "<p>Soothing, controlled heat reaches deep into your tissues to help boost circulation and oxygenation. Better blood flow supports cellular repair and recovery while easing tension and discomfort.</p>"
          }
        }
      },
      "block_order": [
        "card_1",
        "card_2",
        "card_3"
      ]
    },
    "lp_modes": {
      "type": "lp-pdp-cards",
      "settings": {
        "style": "number",
        "columns": 3,
        "background": "sand",
        "eyebrow": "6 Smart Modes",
        "heading": "A Mode for How You Feel Today",
        "text": "<p>Pair any mode with one of 2 heat levels and 10 intensity levels.</p>",
        "disclaimer": "*If you have any medical concerns or conditions, please consult a physician before use. This product is intended for educational and research purposes to support general wellness. It is not designed to diagnose, treat, cure or prevent any disease. When used as directed, it poses no risk of illness or injury."
      },
      "blocks": {
        "card_1": {
          "type": "card",
          "settings": {
            "title": "Relax",
            "text": "<p>Supports deeper, more restorative sleep and helps reduce nerve-related fatigue for renewed energy.*</p>"
          }
        },
        "card_2": {
          "type": "card",
          "settings": {
            "title": "Knead",
            "text": "<p>Helps boost circulation and ease muscle tension and discomfort.*</p>"
          }
        },
        "card_3": {
          "type": "card",
          "settings": {
            "title": "Tap",
            "text": "<p>Helps sharpen reaction time, supporting balance, coordination, agility and confident mobility.*</p>"
          }
        },
        "card_4": {
          "type": "card",
          "settings": {
            "title": "Squeeze",
            "text": "<p>Helps support nerve sensitivity and brain-body communication, for responsiveness, mental clarity and focus.*</p>"
          }
        },
        "card_5": {
          "type": "card",
          "settings": {
            "title": "Pulse",
            "text": "<p>Helps support metabolism and ease numbness, tingling and neuropathy-related discomfort.*</p>"
          }
        },
        "card_6": {
          "type": "card",
          "settings": {
            "title": "Strength",
            "text": "<p>Helps support stability and power, and helps maintain muscle tone.*</p>"
          }
        }
      },
      "block_order": [
        "card_1",
        "card_2",
        "card_3",
        "card_4",
        "card_5",
        "card_6"
      ]
    },
    "lp_how": {
      "type": "lp-pdp-split",
      "settings": {
        "image": "shopify://shop_images/lp-pdp-footcharge-seated.jpg",
        "caption": "Sit down, bare feet flat on the pads",
        "image_fit": "cover",
        "media_position": "start",
        "background": "none",
        "eyebrow": "How to Use",
        "heading": "15 Minutes, Up to Twice a Day",
        "text": ""
      },
      "blocks": {
        "step_1": {
          "type": "step",
          "settings": {
            "text": "<p>Sit comfortably and place your bare feet on the FootCharge pads.</p>"
          }
        },
        "step_2": {
          "type": "step",
          "settings": {
            "text": "<p>Hold the power button for 3 seconds to turn the device on.</p>"
          }
        },
        "step_3": {
          "type": "step",
          "settings": {
            "text": "<p>Choose one of the 6 smart modes.</p>"
          }
        },
        "step_4": {
          "type": "step",
          "settings": {
            "text": "<p>Pick one of the 2 heat levels.</p>"
          }
        },
        "step_5": {
          "type": "step",
          "settings": {
            "text": "<p>Adjust the 10 intensity levels to your comfort.</p>"
          }
        },
        "note_6": {
          "type": "note",
          "settings": {
            "icon": "drop",
            "text": "Tip: moisten your feet with a damp towel first. Damp feet in full contact with the pads improve conductivity."
          }
        },
        "note_7": {
          "type": "note",
          "settings": {
            "icon": "clock",
            "text": "Each session switches off after 15 minutes. Use 15 to 30 minutes per session, up to twice daily, and no more than 60 minutes a day."
          }
        },
        "row_8": {
          "type": "row",
          "settings": {
            "label": "Certifications",
            "value": "<p>Patent-pending, CE, UL, ISO 9001, ISO 14001, PSE, RoHS, FCC</p>"
          }
        },
        "row_9": {
          "type": "row",
          "settings": {
            "label": "Warranty",
            "value": "<p>One year from the date of purchase</p>"
          }
        }
      },
      "block_order": [
        "step_1",
        "step_2",
        "step_3",
        "step_4",
        "step_5",
        "note_6",
        "note_7",
        "row_8",
        "row_9"
      ]
    },
    "lp_timeline": {
      "type": "lp-pdp-timeline",
      "settings": {
        "eyebrow": "What to Expect",
        "heading": "Benefits That Build Over Time",
        "subheading": "Use it daily and the benefits build. Here’s what to look for, and when.",
        "next_label": "What comes next"
      },
      "blocks": {
        "phase_1": {
          "type": "phase",
          "settings": {
            "image": "shopify://shop_images/AdobeStock_1273796619.jpg",
            "label": "1 to 30 minutes",
            "title": "Warmth and Relief",
            "text": "<p>As soon as your feet are on the pads, gentle warmth and bioactivation begin. Low-frequency stimulation and infrared heat help awaken tired nerves and soothe tension, so you may feel immediate relief and deep relaxation.*</p>"
          }
        },
        "phase_2": {
          "type": "phase",
          "settings": {
            "image": "shopify://shop_images/lp-hover-cellnergy-footcharge.jpg",
            "label": "1 to 3 days",
            "title": "Steadier and More Rested",
            "text": "<p>Continued use helps reawaken dormant nerve pathways and support microcirculation. You may notice less numbness, more stable movement, quicker reactions and more restorative sleep.*</p>"
          }
        },
        "phase_3": {
          "type": "phase",
          "settings": {
            "image": "shopify://shop_images/lp-pdp-footcharge-seated-wide.jpg",
            "label": "1 month and beyond",
            "title": "A Daily Ritual That Lasts",
            "text": "<p>Over time, FootCharge helps support cellular energy, nerve pathways and coordination from the ground up. You may feel less discomfort, less stress and steadier energy through the day, without the crash.*</p>"
          }
        }
      },
      "block_order": [
        "phase_1",
        "phase_2",
        "phase_3"
      ]
    },
    "lp_faq": {
      "type": "lp-pdp-faq",
      "settings": {
        "heading": "Still Deciding? Start Here.",
        "button_label": "View All FAQs",
        "contact_label": "Contact Us",
        "q_who": "Who is [product] for?",
        "q_how": "How do I use [product]?",
        "q_when": "When will I notice a difference?"
      },
      "blocks": {
        "item_1": {
          "type": "item",
          "settings": {
            "question": "Why Do I Feel Tingling?",
            "answer": "<p>The tingling comes from CellWave™ Bioactivation. If it feels too strong, lower the intensity with the “-” button.</p>"
          }
        },
        "item_2": {
          "type": "item",
          "settings": {
            "question": "Why Does It Switch Off After 15 Minutes?",
            "answer": "<p>The 15-minute timer is part of how FootCharge works. After a session your body needs time to absorb the benefits, and continuous use can reduce how well your feet respond. The timer keeps every session effective and avoids overstimulation.</p>"
          }
        },
        "item_3": {
          "type": "item",
          "settings": {
            "question": "I Turned the Intensity Up but Feel No Difference",
            "answer": "<p>Make sure both feet are damp and in full contact with both pads.</p>"
          }
        },
        "item_4": {
          "type": "item",
          "settings": {
            "question": "How Long Does the Battery Last?",
            "answer": "<p>A full charge takes up to 3 hours and covers several 15-minute sessions. Battery life varies with how often and how intensely you use it.</p>"
          }
        },
        "item_5": {
          "type": "item",
          "settings": {
            "question": "What Is the Warranty?",
            "answer": "<p>FootCharge comes with a one-year warranty from the date of purchase. If your device develops a fault in that time, contact our Customer Service team. The warranty does not cover damage from not following the instruction manual, mishandling, or repair by an unauthorised party.</p>"
          }
        },
        "item_6": {
          "type": "item",
          "settings": {
            "question": "What If It Isn’t Right for Me?",
            "answer": "<p>Then you don’t pay for it. Every LifePharm product comes with a 60-day money-back guarantee. Let us know within 60 days of delivery and we’ll refund you in full.</p>"
          }
        }
      },
      "block_order": [
        "item_1",
        "item_2",
        "item_3",
        "item_4",
        "item_5",
        "item_6"
      ]
    },
