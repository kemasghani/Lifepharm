      "blocks": {
        "item_1": {
          "type": "item",
          "settings": {
            "question": "What Is ThermalWave Technology?",
            "answer": "<p>A blend of a natural sensory agent and infrared minerals that makes the cream self-warming. It creates a soothing warmth on your skin and joints and helps stimulate blood flow.*</p>"
          }
        },
        "item_2": {
          "type": "item",
          "settings": {
            "question": "Where Do the Growth Factors Come From?",
            "answer": "<p>From fertilised avian eggs sourced from a USDA-inspected farm in the USA. The hens are raised cage-free on high-quality whole grains, and no chemicals or extreme heat are used in processing.</p>"
          }
        },
        "item_3": {
          "type": "item",
          "settings": {
            "question": "Can I Use It With Other Creams or Supplements?",
            "answer": "<p>Yes. It does not interfere with other creams, medication or supplements. It also pairs well with the Cellnergy Wellness device and LAMININE.</p>"
          }
        },
        "item_4": {
          "type": "item",
          "settings": {
            "question": "Who Should Not Use It?",
            "answer": "<p>It is suitable for anyone over 12. If you are pregnant, nursing or have a medical condition, please speak to your physician first.</p>"
          }
        },
        "item_5": {
          "type": "item",
          "settings": {
