    "lp_tech": {
      "type": "lp-pdp-cards",
      "settings": {
        "style": "number",
        "columns": 4,
        "background": "sand",
        "eyebrow": "The Technology",
        "heading": "Four Technologies, One Bottle",
        "text": "<p>One 15-minute conditioning process. No electricity required.</p>",
        "disclaimer": "*These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease."
      },
      "blocks": {
        "card_1": {
          "type": "card",
          "settings": {
            "title": "Mineral Activation",
            "text": "<p>A replaceable Mineral Activation Diffuser holds essential trace minerals that condition your water as it rests in the bottle.</p>"
          }
        },
        "card_2": {
          "type": "card",
          "settings": {
            "title": "Alkaline Conditioning",
            "text": "<p>Helps raise your water to a pH of about 8 to 9.5, depending on the water you start with, for a smooth taste.</p>"
          }
        },
        "card_3": {
          "type": "card",
          "settings": {
            "title": "Molecular Hydrogen",
            "text": "<p>1.1 mg/L (1,100 ppb) of dissolved hydrogen after 15 minutes, independently measured by H2 Analytics (2026). More than twice the 0.5 mg/L industry threshold.*</p>"
          }
        },
        "card_4": {
          "type": "card",
          "settings": {
            "title": "Far-Infrared and Terahertz",
            "text": "<p>Far-infrared mineral media and terahertz-frequency technology add a further layer to the non-powered conditioning system.</p>"
          }
        }
      },
      "block_order": [
        "card_1",
        "card_2",
        "card_3",
        "card_4"
      ]
    },
