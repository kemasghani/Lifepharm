0, 1) 8%)","button_background":"","button_text_color":"","chart_background":"","chart_text_color":"","chart_true_false_color":""}},"scrolling_text_gnHJtw":{"type":"scrolling-text","settings":{"full_width":true,"text":"60 Day Money Back Guarantee","text_size":"medium","text_style":"fill","scrolling_mode":"auto","scrolling_speed":10,"background":"#f9f9f9","background_gradient":"linear-gradient(168deg, rgba(255, 143, 0, 1) 10%, rgba(255, 162, 44, 1) 53%, rgba(248, 189, 113, 1) 94%)","text_color":"#ffffff","text_gradient":""}},"custom_liquid_AWCKD3":{"type":"custom-liquid","disabled":true,"name":"Custom Liquid","settings":{"full_width":true,"remove_vertical_spacing":false,"remove_horizontal_spacing":false,"liquid":"<!-- CUSTOM LIQUID COMPONENT CODE -->\n<!-- Copy this entire code into a Custom Liquid component in your Shopify theme customizer -->\n\n<!-- Certification Logos Section -->\n<div class=\"certification-logos-{{ section.id }}\" style=\"margin: 20px 0; text-align: center;\">\n  <div class=\"logos-container\" style=\"display: flex; justify-content: center; align-items: center; gap: 15px; flex-wrap: wrap;\">\n    \n    <!-- CE Logo -->\n    <button class=\"cert-logo\" data-modal=\"ce-modal-{{ section.id }}\" style=\"background: none; border: none; cursor: pointer; padding: 5px;\">\n      <img src=\"{{ 'ce_logo.png' | file_url }}\" alt=\"CE Certification\" style=\"width: 60px; height: 60px; transition: transform 0.2s;\">\n    <\/button>\n\n    <!-- RoHS Logo -->\n    <button class=\"cert-logo\" data-modal=\"rohs-modal-{{ section.id }}\" style=\"background: none; border: none; cursor: pointer; padding: 5px;\">\n      <img src=\"{{ 'rohs_logo.png' | file_url }}\" alt=\"RoHS Compliant\" style=\"width: 60px; height: 60px; transition: transform 0.2s;\">\n    <\/button>\n\n    <!-- PSE Logo -->\n    <button class=\"cert-logo\" data-modal=\"pse-modal-{{ section.id }}\" style=\"background: none; border: none; cursor: pointer; padding: 5px;\">\n      <img src=\"{{ 'pse_logo.png' | file_url }}\" alt=\"PSE Certification\" style=\"width: 60px; height: 60px; transition: transform 0.2s;\">\n    <\/button>\n\n    <!-- Patent Pending Logo -->\n    <button class=\"cert-logo\" data-modal=\"patent-modal-{{ section.id }}\" style=\"background: none; border: none; cursor: pointer; padding: 5px;\">\n      <img src=\"{{ 'patent_pending_logo.png' | file_url }}\" alt=\"Patent Pending\" style=\"width: 60px; height: 60px; transition: transform 0.2s;\">\n    <\/button>\n\n    <!-- UL Logo -->\n    <button class=\"cert-logo\" data-modal=\"ul-modal-{{ section.id }}\" style=\"background: none; border: none; cursor: pointer; padding: 5px;\">\n      <img src=\"{{ 'ul_logo.png' | file_url }}\" alt=\"UL Certification\" style=\"width: 60px; height: 60px; transition: transform 0.2s;\">\n    <\/button>\n  <\/div>\n<\/div>\n\n<!-- Modal Overlay -->\n<div id=\"modal-overlay-{{ section.id }}\" style=\"display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; justify-content: center; align-items: center;\">\n  \n  <!-- CE Modal -->\n  <div id=\"ce-modal-{{ section.id }}\" class=\"modal-content\" style=\"display: none; background: white; padding: 30px; border-radius: 15px; max-width: 400px; width: 90%; margin: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.3); position: relative;\">\n    <button class=\"modal-close\" style=\"position: absolute; top: 15px; right: 15px; background: none; border: none; font-size: 24px; cursor: pointer; color: #999;\">&times;<\/button>\n    <h3 style=\"color: #ff6b35; margin-bottom: 15px; font-size: 18px;\">CE<\/h3>\n    <p style=\"line-height: 1.5; color: #333;\">This product complies with the relevant European Union directives for health, safety, and environmental protection. It signifies that the manufacturer has assessed the product and deemed it to meet the necessary EU standards to be sold within the European Economic Area (EEA).<\/p>\n  <\/div>\n\n  <!-- RoHS Modal -->\n  <div id=\"rohs-modal-{{ section.id }}\" class=\"modal-content\" style=\"display: none; background: white; padding: 30px; border-radius: 15px; max-width: 400px; width: 90%; margin: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.3); position: relative;\">\n    <button class=\"modal-close\" style=\"position: absolute; top: 15px; right: 15px; background: none; border: none; font-size: 24px; cursor: pointer; color: #999;\">&times;<\/button>\n    <h3 style=\"color: #ff6b35; margin-bottom: 15px; font-size: 18px;\">ROHS COMPLIANT<\/h3>\n    <p style=\"line-height: 1.5; color: #333;\">This product meets the requirements of the Restriction of Hazardous Substances Directive, which restricts the use of specific hazardous materials in electrical and electronic equipment. These materials include lead, mercury, cadmium, and others, and they must be below certain threshold limits.<\/p>\n  <\/div>\n\n  <!-- PSE Modal -->\n  <div id=\"pse-modal-{{ section.id }}\" class=\"modal-content\" style=\"display: none; background: white; padding: 30px; border-radius: 15px; max-width: 400px; width: 90%; margin: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.3); position: relative;\">\n    <button class=\"modal-close\" style=\"position: absolute; top: 15px; right: 15px; background: none; border: none; font-size: 24px; cursor: pointer; color: #999;\">&times;<\/button>\n    <h3 style=\"color: #ff6b35; margin-bottom: 15px; font-size: 18px;\">PSE<\/h3>\n    <p style=\"line-height: 1.5; color: #333;\">Product Safety Electrical Appliance & Material: In Japan, PSE is a mandatory safety certification for electrical appliances and materials. This ensures products meet specific safety standards before being sold in Japan.<\/p>\n  <\/div>\n\n  <!-- Patent Modal -->\n  <div id=\"patent-modal-{{ section.id }}\" class=\"modal-content\" style=\"display: none; background: white; padding: 30px; border-radius: 15px; max-width: 400px; width: 90%; margin: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.3); position: relative;\">\n    <button class=\"modal-close\" style=\"position: absolute; top: 15px; right: 15px; background: none; border: none; font-size: 24px; cursor: pointer; color: #999;\">&times;<\/button>\n    <h3 style=\"color: #ff6b35; margin-bottom: 15px; font-size: 18px;\">PATENT PENDING<\/h3>\n    <p style=\"line-height: 1.5; color: #333;\">A patent application for an invention has been fulfilled with the USPTO but has not yet been granted or issued.<\/p>\n  <\/div>\n\n  <!-- UL Modal -->\n  <div id=\"ul-modal-{{ section.id }}\" class=\"modal-content\" style=\"display: none; background: white; padding: 30px; border-radius: 15px; max-width: 400px; width: 90%; margin: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.3); position: relative;\">\n    <button class=\"modal-close\" style=\"position: absolute; top: 15px; right: 15px; background: none; border: none; font-size: 24px; cursor: pointer; color: #999;\">&times;<\/button>\n    <h3 style=\"color: #ff6b35; margin-bottom: 15px; font-size: 18px;\">UL<\/h3>\n    <p style=\"line-height: 1.5; color: #333;\">Stands for Underwriters Laboratories, a global safety certification company. It indicates that a product has been tested and certified by UL Solutions to meet specific safety standards. This certification assures consumers that the product is designed to protect against hazards like electric shock and fire.<\/p>\n  <\/div>\n<\/div>\n\n<style>\n  .certification-logos-{{ section.id }} .cert-logo img:hover {\n    transform: scale(1.1);\n  }\n  \n  @media (max-width: 768px) {\n    .certification-logos-{{ section.id }} .logos-container {\n      gap: 10px !important;\n    }\n    .certification-logos-{{ section.id }} .cert-logo img {\n      width: 45px !important;\n      height: 45px !important;\n    }\n    .certification-logos-{{ section.id }} .modal-content {\n      margin: 10px !important;\n      padding: 20px !important;\n    }\n  }\n<\/style>\n\n<script>\ndocument.addEventListener('DOMContentLoaded', function() {\n  const sectionId = '{{ section.id }}';\n  const logos = document.querySelectorAll('.certification-logos-' + sectionId + ' .cert-logo');\n  const overlay = document.getElementById('modal-overlay-' + sectionId);\n  const closeButtons = document.querySelectorAll('#modal-overlay-' + sectionId + ' .modal-close');\n  \n  \/\/ Open modal on click\/tap\n  logos.forEach(logo => {\n    logo.addEventListener('click', function() {\n      const modalId = this.getAttribute('data-modal');\n      const modal = document.getElementById(modalId);\n      \n      \/\/ Hide all modals first\n      document.querySelectorAll('#modal-overlay-' + sectionId + ' .modal-content').forEach(m => m.style.display = 'none');\n      \n      \/\/ Show selected modal\n      modal.style.display = 'block';\n      overlay.style.display = 'flex';\n      document.body.style.overflow = 'hidden'; \/\/ Prevent background scrolling\n    });\n  });\n  \n  \/\/ Close modal functionality\n  function closeModal() {\n    overlay.style.display = 'none';\n    document.body.style.overflow = ''; \/\/ Restore scrolling\n  }\n  \n  \/\/ Close on X button\n  closeButtons.forEach(btn => {\n    btn.addEventListener('click', closeModal);\n  });\n  \n  \/\/ Close on overlay click\n  overlay.addEventListener('click', function(e) {\n    if (e.target === overlay) {\n      closeModal();\n    }\n  });\n  \n  \/\/ Close on ESC key\n  document.addEventListener('keydown', function(e) {\n    if (e.key === 'Escape' && overlay.style.display === 'flex') {\n      closeModal();\n    }\n  });\n  \n  \/\/ Touch support for mobile long press (optional)\n  let pressTimer;\n  logos.forEach(logo => {\n    logo.addEventListener('touchstart', function(e) {\n      pressTimer = setTimeout(() => {\n        \/\/ Trigger the same action as click for long press\n        this.click();\n      }, 500); \/\/ 500ms for long press\n    });\n    \n    logo.addEventListener('touchend', function() {\n      clearTimeout(pressTimer);\n    });\n    \n    logo.addEventListener('touchmove', function() {\n      clearTimeout(pressTimer);\n    });\n  });\n});\n<\/script>","background":"","background_gradient":"","text_color":""}},"before_after_image_ieK6Jg":{"type":"before-after-image","disabled":true,"custom_css":[".section-stack__intro {flex: 1 0 530px; max-width: 750px; width: auto;}",".section-stack__main {flex: 1 1 450px; min-width: 320px; max-width: 750px; width: auto;}",".text-center {text-align: center;}"],"settings":{"full_width":true,"subheading":"","title":"{{ product.metafields.custom.heading_before_after.value }}","content":"{{ product.metafields.custom.content_before_after | metafield_tag }}","before_image":"{{ product.metafields.custom.image_1_before_after.value }}","after_image":"{{ product.metafields.custom.image_2_before_after.value }}","expand_image":false,"text_position":"center","before_after_text_position":"top","before_text":"Before","after_text":"After","drag_initial_position":60,"background":"#f9f9f9","background_gradient":"","text_color":"#181818","before_text_color":"#ffffff","after_text_color":"#ffffff","drag_cursor_background":"#ffffff","drag_cursor_color":"#ff8f00"}},"scrolling_text_bihmkB":{"type":"scrolling-text","disabled":true,"settings":{"full_width":true,"text":"Feeling young • Joint Pain • Sleep • Stress","text_size":"medium","text_style":"fill","scrolling_mode":"auto","scrolling_speed":10,"background":"#f9f9f9","background_gradient":"linear-gradient(168deg, rgba(255, 143, 0, 1) 10%, rgba(252, 184, 0, 1) 65%, rgba(255, 255, 255, 1) 100%)","text_color":"#ffffff","text_gradient":""}},"scrolling_text_GKpgyU":{"type":"scrolling-text","disabled":true,"settings":{"full_width":true,"text":"Making optimal well-being attainable for all.","text_size":"medium","text_style":"fill","scrolling_mode":"auto","scrolling_speed":10,"background":"rgba(0,0,0,0)","background_gradient":"","text_color":"#ffffff","text_gradient":"linear-gradient(144deg, rgba(255, 228, 49, 1), rgba(249, 32, 32, 1) 100%)"}},"media_with_text_UCaJMK":{"type":"media-with-text","blocks":{"image_8DzHRG":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/AdobeStock_912094788.jpg","media_width":50,"media_position":"end","text_position":"place-self-center-start text-start","icon":"none","icon_width":48,"subheading":"","title":"Built for Daily Use. Ready to Travel.","content":"<p>•      <strong>Adjustable Height: 60cm – 160cm — <\/strong>Reach any treatment area — knees, lower back, shoulders, neck. The telescoping pole adjusts across a full range from floor level to above the shoulder, so no area is out of reach.<\/p><p> •      <strong>Multi-Angle Positioning — <\/strong>Dial in the exact angle for the area you’re targeting. The device stays locked in place throughout your entire session — coverage is consistent, not approximate. <\/p><p>•      <strong>Hands-Free Therapy — <\/strong>Sit, stand, or lie back while your Cellnergy Wellness Device does the work. Read. Rest. Recover. Your session runs without you holding a thing.<\/p><p>•      <strong>Foldable Tripod Design — <\/strong>The tripod base folds down quickly into a compact form for easy storage between sessions or packing for travel. Takes seconds.<\/p><p>•      <strong>Electrophoretic Anti-Rust Coating — <\/strong>The steel is treated with an electrophoretic process that forms a protective anti-rust layer at the surface level — not just on it. Built to hold up in any environment, long-term.<\/p><p>•      <strong>Carry Bag Included — <\/strong>A dedicated<br\/>carry bag comes in the box. Take your full Cellnergy setup anywhere — a second home, a hotel room, a friend’s place.<\/p><p><em>Compatible With: Cellnergy Wellness Device (sold separately)<\/em><\/p>","link_text":"","link_url":"","background":"#f9f9f9","background_gradient":"","text_color":"#181818","text_gradient":"linear-gradient(151deg, rgba(255, 143, 0, 1) 8%, rgba(255, 143, 0, 1) 8%)","button_background":"","button_text_color":""}},"image_4PHNF4":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/CellnergyStand-Full-Shorter.png","media_width":50,"media_position":"start","text_position":"place-self-center-start text-start","icon":"none","icon_width":48,"subheading":"","title":"Why It Matters","content":"<p><strong>Consistency Is What Creates Results<\/strong><\/p><p>The clinical evidence behind Cellnergy is built on consistent, daily use. The stand removes the single biggest barrier to that consistency — the physical effort of holding the device in position for a full session, every day.<\/p><p>Users who complete full, uninterrupted sessions are the ones who feel the difference. The stand makes that the default, not the exception.<\/p>","link_text":"","link_url":"","background":"#f9f9f9","background_gradient":"","text_color":"#181818","text_gradient":"linear-gradient(151deg, rgba(255, 143, 0, 1) 8%, rgba(255, 143, 0, 1) 8%)","button_background":"","button_text_color":""}}},"block_order":["image_8DzHRG","image_4PHNF4"],"custom_css":[".prose ul,.prose ol {row-gap: 1.4em;}",".prose ul,.list-disc {list-style: square;}"],"settings":{"full_width":false,"alternate_media_position":false,"spacing":"none"}},"timeline_rPwewV":{"type":"timeline","blocks":{"slide_Hzj9Vp":{"type":"slide","settings":{"image":"shopify:\/\/shop_images\/AdobeStock_1439178340.jpg","navigation_label":"1–30 Minutes","subheading":"1–30 Minutes","title":"","content":"<p>As soon as you place your feet on the Cellnergy FootCharge pad, gentle waves of warmth and bioactivation begin to flow through your body. Low-frequency stimulation and infrared thermotherapy help awaken tired nerves, soothe tension, and may spark your body’s regenerative response—you may experience immediate relief and deep relaxation. <\/p>"}},"slide_VVAtmd":{"type":"slide","settings":{"image":"shopify:\/\/shop_images\/AdobeStock_1338758573.jpg","navigation_label":"1–3 Days","subheading":"1–3 Days","title":"","content":"<p>Continued use helps reawaken dormant pathways in the nervous system and improve microcirculation. Your cells may begin responding at the frequency of optimal health—helping to relieve numbness, restore muscle tone, and enhance the connection between your brain and body. You may experience more stable movement, quicker reactions, and more restorative sleep.  <\/p>"}},"slide_gheRD3":{"type":"slide","settings":{"image":"shopify:\/\/shop_images\/AdobeStock_1273796619.jpg","navigation_label":"1 Month & Beyond","subheading":"1 Month & Beyond","title":"","content":"<p>Over time, Cellnergy FootCharge works to help restore cellular energy, repair nerve pathways, and improve coordination from the ground up. You may experience less pain, less stress, and an increase in stable energy throughout the day without the crash—this daily ritual becomes a powerful ally in your regeneration journey. <\/p>"}}},"block_order":["slide_Hzj9Vp","slide_VVAtmd","slide_gheRD3"],"disabled":true,"custom_css":[".subheading {font-weight: 700; color: #ff8f00 !important; margin-top: 10px !important; font-style: italic; font-size: large;}",".timeline__nav-item[aria-current=\"true\"]:before {border-color: #181818; background-color: #181818;}"],"settings":{"full_width":false,"background":"#f9f9f9","background_gradient":"linear-gradient(167deg, rgba(249, 249, 249, 1) 28%, rgba(255, 255, 255, 1) 45%, rgba(255, 255, 255, 1) 70%)","text_color":"rgba(0,0,0,0)"}},"faq_XwdKmx":{"type":"faq","blocks":{"item_TkNQcT":{"type":"item","disabled":true,"settings":{"title":"{{ product.metafields.custom.header_1.value }}","content":"<p>{{ product.metafields.custom.value_1 | metafield_tag }}<\/p>"}},"item_bUCdd8":{"type":"item","disabled":true,"settings":{"title":"{{ product.metafields.custom.header_2.value }}","content":"<p>{{ product.metafields.custom.value_2 | metafield_tag }}<\/p>"}},"item_nCDBHn":{"type":"item","disabled":true,"settings":{"title":"{{ product.metafields.custom.header_3.value }}","content":"<p>{{ product.metafields.custom.value_3 | metafield_tag }}<\/p>"}},"item_89mDbk":{"type":"item","disabled":true,"setti