    "lp_overview": {
      "type": "lp-pdp-overview",
      "settings": {
        "image": "shopify://shop_images/lp-hover-cellnergy-wellness-stand.jpg",
        "image_fit": "cover",
        "caption": "Cellnergy Wellness Stand",
        "media_position": "start",
        "eyebrow": "Hands-Free Therapy",
        "heading": "Your Therapy. Hands-Free. Exactly Where You Need It.",
        "text": "<p>The Cellnergy Wellness Stand holds your device at the precise height and angle you need, completely hands-free. It folds away for storage or travel and is built from coated steel that won’t rust.</p><p>Already own the Cellnergy Wellness Device? The stand changes how, and where, you use it every day.</p>",
        "chips_label": "",
        "chips": "",
        "note_label": "",
        "note": ""
      },
      "blocks": {
        "stat_1": {
          "type": "stat",
          "settings": {
