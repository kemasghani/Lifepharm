    "lp_features": {
      "type": "lp-pdp-cards",
      "settings": {
        "style": "icon",
        "columns": 3,
        "background": "sand",
        "eyebrow": "Built for Daily Use",
        "heading": "Built for Daily Use. Ready to Travel.",
        "text": "",
        "disclaimer": ""
      },
      "blocks": {
        "card_1": {
          "type": "card",
          "settings": {
            "icon": "refresh",
            "title": "Adjustable Height",
            "text": "<p>The telescoping pole adjusts from 60cm to 160cm, so knees, lower back, shoulders and neck are all within reach.</p>"
          }
        },
        "card_2": {
          "type": "card",
          "settings": {
            "icon": "sparkle",
            "title": "Multi-Angle Positioning",
            "text": "<p>Set the exact angle for the area you’re targeting. The device stays locked in place for the whole session, so coverage is consistent.</p>"
          }
        },
        "card_3": {
          "type": "card",
          "settings": {
            "icon": "heart",
            "title": "Hands-Free Sessions",
            "text": "<p>Sit, stand or lie back while your Cellnergy Wellness Device does the work. Read, rest and recover without holding a thing.</p>"
          }
        },
        "card_4": {
          "type": "card",
          "settings": {
            "icon": "check",
            "title": "Foldable Tripod",
            "text": "<p>The tripod base folds down in seconds into a compact form, for storage between sessions or packing for travel.</p>"
          }
        },
        "card_5": {
          "type": "card",
          "settings": {
            "icon": "shield",
            "title": "Anti-Rust Coating",
            "text": "<p>An electrophoretic coating forms a protective anti-rust layer on the steel, built to hold up in any room for the long term.</p>"
          }
        },
        "card_6": {
          "type": "card",
          "settings": {
            "icon": "truck",
            "title": "Carry Bag Included",
            "text": "<p>Take your full Cellnergy set-up anywhere: a second home, a hotel room or a friend’s place.</p>"
          }
        }
      },
      "block_order": [
        "card_1",
        "card_2",
        "card_3",
        "card_4",
        "card_5",
        "card_6"
      ]
    },
