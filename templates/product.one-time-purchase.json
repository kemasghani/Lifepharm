    "lp_faq": {
      "type": "lp-pdp-faq",
      "settings": {
        "heading": "Still Deciding? Start Here.",
        "button_label": "View All FAQs",
        "contact_label": "Contact Us",
        "q_who": "",
        "q_how": "",
        "q_when": ""
      },
      "blocks": {
        "item_1": {
          "type": "item",
          "settings": {
            "question": "What Settings Does the Device Have?",
            "answer": "<p>There are four settings: 0 is off, 1 is high speed with low heat, 2 is low speed with high heat, and 3 is medium speed with high heat.</p>"
          }
        },
        "item_2": {
          "type": "item",
          "settings": {
            "question": "Can I Use It on My Scalp?",
            "answer": "<p>Yes. Hold it 20 to 30 cm from your scalp, as long as there are no open wounds.</p>"
          }
        },
        "item_3": {
          "type": "item",
          "settings": {
            "question": "Does It Emit Electromagnetic Radiation?",
            "answer": "<p>No. The device has been tested with an electromagnetic radiation detector and does not emit radiation.</p>"
          }
        },
        "item_4": {
          "type": "item",
          "settings": {
            "question": "Can I Use It If I Have a Health Condition?",
            "answer": "<p>If you have a pre-existing health concern or condition, please speak to your healthcare provider before using the device.</p>"
          }
        },
        "item_5": {
          "type": "item",
          "settings": {
            "question": "What Is the Warranty?",
            "answer": "<p>Your device comes with a one-year warranty from the date of purchase. If it develops a fault in that time, contact our Customer Service team. The warranty does not cover damage from not following the instruction manual, mishandling, or repair by an unauthorised party.</p>"
          }
        },
        "item_6": {
          "type": "item",
          "settings": {
            "question": "What If It Isn’t Right for Me?",
            "answer": "<p>Then you don’t pay for it. Every LifePharm product comes with a 60-day money-back guarantee. Let us know within 60 days of delivery and we’ll refund you in full.</p>"
          }
        }
      },
      "block_order": [
        "item_1",
        "item_2",
