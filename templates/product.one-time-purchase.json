          "settings": {
            "icon": "none",
            "icon_width": 20,
            "page": "",
            "title": "How to Use",
            "lp_how_steps": false,
            "content": "<ol><li>Choose a setting: 1 for high speed and low heat, 2 for low speed and high heat, or 3 for medium speed and high heat.</li><li>Hold the device 20 to 30 cm (8 to 12 inches) away from your body.</li><li>Move it in slow sweeping or circular motions, over bare skin or clothing.</li><li>Spend 10 minutes on each area, in the morning or evening.</li></ol><p>Use in 10-minute intervals, then switch the device off for at least 5 minutes to cool down.</p><p>Not for use on open wounds, near metal implants, or during pregnancy or menstruation.</p>"
          }
        },
