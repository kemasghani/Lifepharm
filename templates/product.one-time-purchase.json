    "lp_tech": {
      "type": "lp-pdp-cards",
      "settings": {
        "style": "icon",
        "columns": 3,
        "background": "none",
        "eyebrow": "The Technology",
        "heading": "Three Technologies, One Device",
        "text": "<p>Each works at a different depth, so together they support your body from the skin down to the cells.</p>",
        "disclaimer": ""
      },
      "blocks": {
        "card_1": {
          "type": "card",
          "settings": {
            "icon": "cell",
            "label": "Terahertz waves",
            "title": "Terahertz Waves (THz)",
            "text": "<p>May help activate healthy cells, supporting cellular regeneration, tissue repair and overall vitality.*</p>"
          }
        },
        "card_2": {
          "type": "card",
          "settings": {
            "icon": "sparkle",
            "label": "630 nm",
            "title": "Red Light Therapy",
            "text": "<p>Reaches deeper than other light colours to help boost cellular energy (ATP), supporting collagen production, circulation and recovery.*</p>"
          }
        },
        "card_3": {
          "type": "card",
          "settings": {
            "icon": "heart",
            "label": "Controlled warmth",
            "title": "Heat Therapy",
            "text": "<p>Delivers gentle, controlled heat to targeted areas to help improve blood flow, ease muscle tension and discomfort, and promote relaxation.*</p>"
          }
        }
      },
      "block_order": [
        "card_1",
        "card_2",
        "card_3"
      ]
    },
