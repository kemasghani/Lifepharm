        "eyebrow": "Benefits",
        "heading": "Support That Builds Session by Session",
        "text": "",
        "disclaimer": "*This product is used for self-education and research purposes to support general wellbeing. It is not intended to treat disease or to prevent impairment of human health. When used according to directions, it does not present any potential risk of illness or injury."
      },
      "blocks": {
        "card_1": {
          "type": "card",
          "settings": {
            "title": "Renewed-Looking Skin",
            "text": "<p>Supports collagen and fibroblast production for skin that looks rejuvenated.*</p>"
          }
        },
        "card_2": {
          "type": "card",
          "settings": {
            "title": "Better Circulation",
            "text": "<p>Helps increase blood circulation, aiding nutrient delivery and waste removal.*</p>"
          }
        },
        "card_3": {
          "type": "card",
          "settings": {
            "title": "Everyday Comfort",
            "text": "<p>Helps reduce inflammation and supports overall comfort.*</p>"
          }
        },
        "card_4": {
          "type": "card",
          "settings": {
            "title": "A More Youthful Look",
            "text": "<p>Helps soften the look of wrinkles, fine lines and age spots.*</p>"
          }
        },
        "card_5": {
          "type": "card",
          "settings": {
            "title": "Faster Recovery",
            "text": "<p>Helps support recovery after physical activity.*</p>"
          }
        },
        "card_6": {
          "type": "card",
          "settings": {
            "title": "A Brighter Mood",
            "text": "<p>Supports a positive mood and a general sense of wellbeing.*</p>"
